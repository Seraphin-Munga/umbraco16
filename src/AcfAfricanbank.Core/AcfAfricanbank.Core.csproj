<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Web.Website transitively brings in Web.Common / Core / Infrastructure -->
    <PackageReference Include="Umbraco.Cms.Web.Website" Version="17.7.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pins transitive dependencies above their vulnerable resolved
         versions (NU1902/NU1903) - patch-level bumps only, same major/
         minor line already in use. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <PackageReference Include="MessagePack" Version="3.1.9" />
  </ItemGroup>

</Project>

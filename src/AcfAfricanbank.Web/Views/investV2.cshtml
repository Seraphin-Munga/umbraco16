               .accordion {
                 font-weight: bold; /* Explicitly setting font-weight */
                 font-family: Montserrat, sans-serif; /* Specifying the font family */
                 background-color: #fff;
                 color: #012B60;
                 cursor: pointer;
                 padding: 16px;
                 width: 100%;
                 text-align: left;
                 font-size: 15px;
                 transition: 0.4s;
                 border-radius: 0px;
                 border: solid 1px #efefef;
              /*    margin-bottom: 10px; Space between inactive accordion buttons */
                 position: relative; /* Needed for absolute positioning of the arrow */
               }
               
               .accordion::after {
                 content: '\276F'; /* Heavy Chevron Unicode character */
                 font-size: 15px; /* Adjust as needed */
                 color: #012B60;
                 position: absolute;
                 right: 20px;
                 top: 50%;
                 transform: translateY(-50%) rotate(90deg);
                 transition: transform 0.4s;
               }
               
              button.accordion.active{
                 color: #012B60 !important; 
              }

               .active::after {
                     transform: translateY(-50%) rotate(-90deg);
               }
               
               .myPanel {
                    border: solid 1px #efefef;
                    font-family: Montserrat, sans-serif;
                    padding: 37px 50px 25px 22px;
                    background-color: #fff;
                    color: #012B60;
                    display: none;
                    overflow: hidden;
                    border-top: none;
                    margin-top: -20px !important;
               }
               
               .myPanel p {
                       font-weight: 400;
               }
               
                 .faqHeader {
                   font: normal normal bold 30px/52px Montserrat;
                   letter-spacing: 0px;
                   color: #F9F9F9;
                   opacity: 1;
                   margin: 0 auto; /* This ensures that the margin is auto on both sides for block-level centering */
                   padding: 20px 0; /* Adds some padding above and below the text */
                 }

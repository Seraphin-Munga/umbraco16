<script>


const scrollContainer = document.getElementById('scrollContainer');
const dots = document.getElementById('dots').children;
const items = scrollContainer.getElementsByClassName('scroll-item');

// Update dots on scroll
scrollContainer.addEventListener('scroll', () => {
  let scrollLeft = scrollContainer.scrollLeft;
  let itemWidth = items[0].offsetWidth + 10; // +10 margin
  let index = Math.round(scrollLeft / itemWidth);

  for (let i = 0; i < dots.length; i++) {
    dots[i].classList.toggle('active', i === index);
  }
});

// Make dots clickable
for (let i = 0; i < dots.length; i++) {
  dots[i].addEventListener('click', () => {
    let itemWidth = items[0].offsetWidth + 10; // +10 margin
    scrollContainer.scrollTo({
      left: i * itemWidth,
      behavior: 'smooth'
    });
  });
}



            // Accordion Script (if applicable)
    $(".accordion").click(function() {
        $(this).toggleClass("active");
        var myPanel = $(this).next(".myPanel");
        var wasOpen = myPanel.css("display") === "block";

        $(".myPanel").css("display", "none");
        $(".accordion").removeClass("active");

        if (!wasOpen) {
            myPanel.css("display", "block");
            $(this).addClass("active");
        }
    });
    
    
    
    
    
$(document).ready(function() {
    function togglePanelCustom() {
      if ($(window).width() <= 767) {
        $('.rmv').removeClass('container');
      } else {
        $('.rmv').addClass('container');
      }
    }

    // Initial check
    togglePanelCustom();

    // Handle window resize
    $(window).on('resize', function() {
      togglePanelCustom();
    });
  });
    
</script>
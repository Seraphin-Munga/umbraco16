<script>
    $(document).ready(function () {
        $("#myTabs a").click(function (e) {
            e.preventDefault();

            // Remove "active" class from all tabs
            $("#myTabs a").removeClass("active");
            $(".tab-content > div").removeClass("in active");

            // Add "active" class to the clicked tab
            $(this).addClass("active");

            // Show the corresponding tab content
            $($(this).attr("href")).addClass("in active");
        });

        $(".fa-play").on("click", function (clickEvent) {

            var e = clickEvent; // Capture the click event



            var videoPath = $(e.currentTarget).closest('.ab-video').data('video');

            if (videoPath) {
                var video = $('.videoPlatformPlayer')[0];
                var path = videoPath.trim() + '?autoplay=1';

                video.src = path;


                $('#generic').modal('show');
            }
        });

        $('#generic').on('hide.bs.modal', function (modalEvent) {
            debugger
            var e = modalEvent; // Capture the modal hide event
            var video = $('.videoPlatformPlayer')[0];
            var videoPath = $(e.currentTarget).closest('.ab-video').data('video');
            video.src = '';
            if (videoPath) {
                var path = videoPath.trim();

                video.src = '';

            }
        });
    });
</script>

<script>


    $(document).ready(function () {
        $(".faq-item").click(function () {
            var $faqItem = $(this);
            var $siblings = $faqItem.siblings(".faq-item");

            // Check if the clicked item is already active
            var isActive = $faqItem.hasClass("active");

            // Remove "active" class and hide content for all items
            $(".faq-item").removeClass("active");
            $(".content").hide(); // hide all content

            // Toggle visibility and classes for siblings
            $siblings.find(".item-content .content:visible")
                .toggleClass("disable-content")
                .toggle(200);
            $siblings.find(".download-icon .fa-long-arrow-up")
                .toggleClass("fa-long-arrow-up fa-long-arrow-down");

            // Toggle visibility and classes for the clicked item
            if (!isActive) {
                $faqItem.addClass("active");
                $faqItem.find(".item-content .content")
                    .toggleClass("active-content")
                    .toggle(200);
                $faqItem.find(".download-icon .fa-long-arrow-up")
                    .toggleClass("fa-long-arrow-up fa-long-arrow-down");
            }
        });





        $("#cmbCategories").change(function () {
            var selected = $("#cmbCategories option:selected").val();
            $('.sectionHeading').each(function () {
                if (selected == 'allcategories' || selected == '') { // show all categories
                    $(this).show();
                } else {
                    if ($(this).context.id == selected) {
                        $(this).show();
                    } else {
                        $(this).hide();
                    }
                }
            });
        });
    });
</script>

<div class="container fraud-container">
    <div class="row">
        <div class="col-sm-12 col-md-7">
            <h2 class="title">@card.Value("cardTitle")</h2>
            <p class="description">@card.Value("cardDescription")</p>


            @card.Value("cardDescriptionLongText")

        </div>
        <div class="col-sm-12 col-md-5">
            <h2 class="title-report flex-container">@heroBody.Value("bodyTitle")</h2>
            @if (cardItems != null)
            {
                var caritems = cardItems.Value<IEnumerable<NCcard>>("cardItemDetail");
                foreach (var item in caritems)
                {
                    var image = item.Value<IPublishedContent>("NCcardIcon").Url;
                    <div class="flex-container">
                        <div>
                            <span class="nCcardTitle">@item.Value("nCcardTitle")</span>
                        </div>
                        <div class="circle">
                            <img class="image-icon" src="@image" />
                        </div>
                    </div>
                }
            }
        </div>
    </div>
    <div>
        <ul class="nav nav-tabs" id="myTabs">
            @if (tabs != null)
            {
                int tabCounter = 1;
                foreach (var item in tabs)
                {
                    <li class="custom-class">
                        <a class="btn btn-primary btn-tab @(tabCounter == 1 ? "active" : "")" data-toggle="tab" href="#@tabCounter">@item.Value("TabSubItemTitle")</a>
                    </li>
                    tabCounter++;
                }
            }
        </ul>
    </div>


@section Scripts {
<script>
    $(document).ready(function () {

        var imageBgCss = "url('/media/qfmlaia5/website-comms-banner_1442x658-44.jpg')";
       var imageMdCss = "url('/media/fo5fleiw/abw2310_ar_landingpage_banner_mobile.jpg')";
        var imageSmCss = "url('/media/fo5fleiw/abw2310_ar_landingpage_banner_mobile.jpg')";

        var CheckScreenSize;

        (CheckScreenSize = function () {
            var _width = $(window).outerWidth();
            var _height = $(window).outerHeight();

            if (_width < 414) {
                $(".hero-static-banner").css("background-image", imageSmCss);
            }
            else {
                $(".hero-static-banner").css("background-image", imageBgCss);
            }
        })();

        $(window).resize(CheckScreenSize);
    });
</script>

    @@media (min-width: 800px) and (max-width: 840px) {
        .hero-static-caption {
           top: -60px;
        } 
        .infoGraphic-container {
            width: 110%;
            margin: 0px -44px;
            margin-bottom: 30px;
            margin-top: -16px;
        }
    }
    @@media (min-width: 1280px) and (max-width: 1280px) {
        .hero-static-caption {
           top: -60px;
        }

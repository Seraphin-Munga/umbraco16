@inherits Umbraco.Web.Mvc.UmbracoViewPage<ContentModels.JobSearch>
@using ContentModels = Umbraco.Web.PublishedModels;
@using Web.Helpers
@{
    Layout = "Master.cshtml";
    var altTextImage = Model.Value("alternateImageText");
}

<style>
.active {
    color: #fff !important;
}
    .job-search {
        width: 100% !important;
    }
    .hero-static-caption {
        top: 0px;
    }    
    .infoGraphic-container {
        width: 88%;
        margin: auto;
        margin-bottom: 45px;
        margin-top: 55px;
        /*background-color: #e5ebf0 !important; #00346A*/
    }
    .desktop-video{
        margin: auto;
        display: block !important; 
        border-width: 0px;
    }

     .mobile-video {
        display: none;
        border-width: 0px;
    }
    @@media(max-width:767px) {
        .desktop-video{
           display: none !important; 
        }

        .mobile-video {
           display: block  !important;
        }
        
    }
    
    @@media (min-width: 280px) and (max-width: 767px) {
        .hero-static-caption {
           top: -60px;
        } 
        .infoGraphic-container {
            width: 100%;
            margin: 0px;
            margin-bottom: 30px;
            margin-top: -16px;
        }
    }
     @@media (min-width: 1024px) and (max-width: 1025px) {
        .hero-static-caption {
           top: -60px;
        } 
        .infoGraphic-container {
            width: 111%;
            margin: 0px -54px;
            margin-bottom: 30px;
            margin-top: -16px;
        }
    }
    @@media (min-width: 768px) and (max-width: 769px) {
        .hero-static-caption {
           top: -60px;
        } 
        .infoGraphic-container {
            width: 119%;
            margin: 0px -70px;
            margin-bottom: 30px;
            margin-top: -16px;
        }

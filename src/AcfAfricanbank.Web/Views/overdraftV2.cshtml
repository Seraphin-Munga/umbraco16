@section scripts
{

<script>
$(document).ready(function(){
 
        $(".accordion-button").click(function(){

    var isCollapsed = $(this).hasClass('collapsed');
           $(".accordion-button").removeClass('collapsed');
           if(isCollapsed == false) {
            $(this).toggleClass("collapsed");
           }
 
           
var isCollapsedContent = $(this).parent().next(".accordion-collapse").hasClass('collapse');
            $(".accordion-collapse").addClass('collapse');
            if(isCollapsedContent == true) {
                $(this).parent().next(".accordion-collapse").toggleClass('collapse');
           }
 
           
 
        });
 
    });

</script>
    <script type="text/javascript">

    function getMobileOperatingSystem()
    {
        var userAgent = navigator.userAgent || navigator.vendor || window.opera;

        if (/windows phone/i.test(userAgent)) {
            return "Windows Phone";
        }

        if (/android/i.test(userAgent)) {
            return "Android";
        }

        if (/iPad|iPhone|iPod/.test(userAgent) && !window.MSStream) {
            return "iOS";
        }

        return "unknown";
    }



  

    $(".btn_ok_modal").click(function () {
        $('#generic').modal('hide');
    });

    </script>
}
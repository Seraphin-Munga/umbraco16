                        marketingObj.isAlternativeNumberContactable = chkIsCall
                        marketingObj.isCellphoneContactable = chkIsSms,
                        marketingObj.isMailContactable = chkIsEmail,
                        marketingObj.isOptIn = isSubscription
                    $('.hang-tight').show('slow');
                    var token = $('input[name="__RequestVerificationToken"]')[0].value;
                    $.ajax({
                        headers: { '__RequestVerificationToken': token },
                        type: "POST",
                        url: '@Url.Action("SaveConsent", "Custom")',
                        data: JSON.stringify(marketingObj),
                        contentType: "application/json; charset=utf-8",
                        dataType: "json",
                        success: function (data) {
                            $('#generic')[0].children[0].children[0].children[0].children[1].innerHTML = 'Thank you!';
                            $('#generic').modal('show');
                        },
                        error: function (error) {
                            console.log(error);

<script>
document.addEventListener("DOMContentLoaded", function () {

    function setupScrollIndicator(containerId, indicatorId) {
        const container = document.getElementById(containerId);
        const dots = document.querySelectorAll(`#${indicatorId} .dot`);
        const sections = container.querySelectorAll(".scroll-section");

        function updateActiveDot() {
            const scrollLeft = container.scrollLeft;
            const width = container.clientWidth;
            const index = Math.round(scrollLeft / width);
            dots.forEach((dot, i) => dot.classList.toggle("active", i === index));
        }

        // Dot click -> scroll
        dots.forEach((dot, i) => {
            dot.addEventListener("click", () => {
                container.scrollTo({
                    left: i * container.clientWidth,
                    behavior: "smooth"
                });
            });
        });

        // Scroll -> update active dot
        container.addEventListener("scroll", () => {
            requestAnimationFrame(updateActiveDot);
        });

        // Initial state
        updateActiveDot();
    }

    // Initialize scroll indicators
    setupScrollIndicator("scroll-container0", "scrollIndicator");
    setupScrollIndicator("scroll-container2", "scrollIndicator2");
    setupScrollIndicator("scroll-container3", "scrollIndicator3");
    setupScrollIndicator("scroll-container4", "scrollIndicator4");

    // --- Tab dots (special case) ---
    const tabContainer = document.getElementById("go_to_tab_content");
    const tabDots = document.querySelectorAll("#scrollIndicator1 .dot1");

    function updateTabDot() {
        const scrollLeft = tabContainer.scrollLeft;
        const tabWidth = tabContainer.scrollWidth / tabDots.length;
        const index = Math.round(scrollLeft / tabWidth);
        tabDots.forEach((dot, i) => dot.classList.toggle("active", i === index));
    }

    tabDots.forEach((dot, i) => {
        dot.addEventListener("click", () => {
            const scrollAmount = (tabContainer.scrollWidth / tabDots.length) * i;
            tabContainer.scrollTo({ left: scrollAmount, behavior: "smooth" });
        });
    });

    tabContainer.addEventListener("scroll", () => {
        requestAnimationFrame(updateTabDot);
    });

    // On resize -> re-check both
    window.addEventListener("resize", () => {
        document.querySelectorAll(".scroll-section").forEach((_, idx) => {
            setupScrollIndicator(`scroll-container${idx}`, `scrollIndicator${idx}`);
        });
        updateTabDot();
    });

});
  document.addEventListener("DOMContentLoaded", function () {

            const slider = document.querySelector(".tabs-scroll .nav-tabs");
            const tabs = document.querySelectorAll(".tabs-scroll .loan-summary");
            const dots = document.querySelectorAll(".carousel-indicators-custom .indicator");
        
            if (!slider || !tabs.length || !dots.length) return;
        
        
            function setIndicator(index) {
                dots.forEach((dot, i) => {
                    dot.classList.toggle("active", i === index);
                });
            }
        

            function getTargetScroll(index) {
        
                let target = tabs[index].offsetLeft;
        
                // if last tab, go to maximum available scroll
                if (index === tabs.length - 1) {
                    target = slider.scrollWidth - slider.clientWidth;
                }
        
                return target;
            }

            
            // Update indicator while scrolling
            slider.addEventListener("scroll", function () {
            
                let activeIndex = 0;
                let minDistance = Infinity;
            
                tabs.forEach((tab, index) => {
            
                    const distance = Math.abs(
                        getTargetScroll(index) - slider.scrollLeft
                    );
            
                    if (distance < minDistance) {
                        minDistance = distance;
                        activeIndex = index;
                    }
            
                });

            setIndicator(activeIndex);

            });



              // Indicator click
           dots.forEach((dot, index) => {

    dot.addEventListener("click", function (e) {

        e.preventDefault();

        slider.scrollTo({
            left: getTargetScroll(index),
            behavior: "smooth"
        });

        // Trigger the actual tab
        tabs[index].querySelector("a").click();

        setIndicator(index);

    });

});

        });
</script>

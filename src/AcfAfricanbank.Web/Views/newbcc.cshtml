.accordion::after {
    content: '\276F';
    display: inline-block;
    font-size: 12px;
    color: #012B60;
    font-family: Arial, sans-serif;
    position: absolute;
    right: 20px;
    top: 50%;
    transform: translateY(-50%) rotate(90deg);
    transition: transform 0.4s;
}
               

               

<script>
(function () {
  'use strict';

  function onReady(fn) {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', fn, { once: true });
    } else {
      fn();
    }
  }

  // Convert "#CommercialPropertyFinance" or "#tab-CommercialPropertyFinance" → "CommercialPropertyFinance"
  function keyFromHash(hash) {
    if (!hash) return null;
    let k = hash.replace(/^#/, '');
    k = k.replace(/^tab-/, '');
    return k || null;
  }

  // Find panes across both containers matching this key
  function findMatchingPanes(key) {
    const sel = [
      `.tab-content-1 #tab-${key}`,
      `.tab-content-2 #tab-${key}`,
      `.tab-content-1 #${key}`,
      `.tab-content-2 #${key}`
    ].join(', ');
    return Array.from(document.querySelectorAll(sel));
  }

  function clearAll() {
    // Clear nav active
    document.querySelectorAll('#go_to_tab_content li').forEach(li => li.classList.remove('active'));
    // Clear all panes
    document.querySelectorAll('.tab-content-1 .tab-pane, .tab-content-2 .tab-pane').forEach(p => {
      p.classList.remove('active', 'show');
      p.setAttribute('aria-hidden', 'true');
    });
  }

  function setActiveNavByKey(key) {
    const li = document.querySelector(`#go_to_tab_content li[data-tab-id="${key}"]`);
    if (li) li.classList.add('active');
  }

  function updateMortgageContainer(key) {
    const container = document.querySelector('.mortgage-container');
    if (!container) return;
    container.classList.remove('col-md-12', 'col-sm-12', 'col-md-9', 'col-sm-9');
    if (key === 'BusinessLoans') {
      container.classList.add('col-md-9', 'col-sm-9');
    } else {
      container.classList.add('col-md-12', 'col-sm-12');
    }
  }

  function showByKey(key, updateUrl) {
    if (!key) return;

    const panes = findMatchingPanes(key);
    if (!panes.length) return;

    clearAll();

    // Activate nav
    setActiveNavByKey(key);

    // Activate matching panes
    panes.forEach(p => {
      p.classList.add('active', 'show');
      p.setAttribute('aria-hidden', 'false');
    });

    // Update URL hash to canonical form
    if (updateUrl) {
      const canonical = `#${panes[0].id}`;
      if (location.hash !== canonical) {
        history.replaceState(null, '', canonical);
      }
    }

    // Update mortgage container column classes
    updateMortgageContainer(key);
  }

  onReady(function () {
    // Initial activation from hash or fallback to first active li
    const initialKey =
      keyFromHash(location.hash) ||
      document.querySelector('#go_to_tab_content li.active')?.getAttribute('data-tab-id') ||
      document.querySelector('#go_to_tab_content li')?.getAttribute('data-tab-id');

    if (initialKey) {
      showByKey(initialKey, !!location.hash);
    }

    // Click handler for nav tabs
    document.querySelectorAll('#go_to_tab_content a.tab-switcher').forEach(a => {
      a.addEventListener('click', function (e) {
        e.preventDefault();
        const key =
          this.closest('li')?.getAttribute('data-tab-id') ||
          keyFromHash(this.getAttribute('href'));
        showByKey(key, true);
      });
    });

    // Browser back/forward handler
    window.addEventListener('hashchange', function () {
      const key = keyFromHash(location.hash);
      showByKey(key, false);
    });
  });
})();
</script>


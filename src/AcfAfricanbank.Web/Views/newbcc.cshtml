 <script>


      function enableCarouselSwipe(carouselId) {
        var carousel = document.getElementById(carouselId);
        if (!carousel || typeof jQuery === "undefined") return;

        var $carousel = jQuery(carousel);
        var inner = carousel.querySelector(".carousel-inner");
        var startX = 0;
        var startY = 0;
        var currentX = 0;
        var dragging = false;
        var draggingHorizontally = false;
        var direction = null; // "next" | "prev"
        var activeItem = null;
        var peekItem = null;
        var width = 0;
        var threshold = 40; // px

        // Let touch/pointer drags work for vertical page scroll too
        carousel.style.touchAction = "pan-y";

        function getItems() {
          return Array.prototype.slice.call(inner.querySelectorAll(".item"));
        }

        function setActiveIndicator(item) {
          var index = getItems().indexOf(item);
          var indicators = carousel.querySelectorAll(".carousel-indicators li");
          for (var i = 0; i < indicators.length; i += 1) {
            indicators[i].classList.toggle("active", i === index);
          }
        }

        function resetPeekItem() {
          if (!peekItem) return;
          peekItem.style.display = "";
          peekItem.style.position = "";
          peekItem.style.top = "";
          peekItem.style.left = "";
          peekItem.style.width = "";
          peekItem.style.transform = "";
          peekItem.style.transition = "";
          peekItem = null;
        }

        // Position the upcoming slide off-screen on the correct side so it
        // can be dragged into view alongside the active slide.
        function preparePeekItem() {
          var items = getItems();
          var index = items.indexOf(activeItem);
          var targetIndex;

          if (direction === "next") {
            targetIndex = index + 1 >= items.length ? 0 : index + 1;
          } else {
            targetIndex = index - 1 < 0 ? items.length - 1 : index - 1;
          }

          peekItem = items[targetIndex];
          peekItem.style.display = "block";
          peekItem.style.position = "absolute";
          peekItem.style.top = "0";
          peekItem.style.left = "0";
          peekItem.style.width = "100%";
          peekItem.style.transform =
            "translate3d(" + (direction === "next" ? width : -width) + "px, 0, 0)";
        }

        function finishDrag(commit) {
          dragging = false;

          if (!draggingHorizontally || !activeItem) {
            if (activeItem) {
              activeItem.style.transform = "";
              activeItem.style.transition = "";
            }
            resetPeekItem();
            activeItem = null;
            return;
          }

          var outgoing = activeItem;
          var incoming = peekItem;
          var transitionStyle = "transform 220ms ease-out";

          outgoing.style.transition = transitionStyle;
          if (incoming) incoming.style.transition = transitionStyle;

          if (commit && incoming) {
            var outTarget = direction === "next" ? -width : width;
            outgoing.style.transform = "translate3d(" + outTarget + "px, 0, 0)";
            incoming.style.transform = "translate3d(0, 0, 0)";

            outgoing.addEventListener("transitionend", function handler() {
              outgoing.removeEventListener("transitionend", handler);
              outgoing.classList.remove("active");
              outgoing.style.transition = "";
              outgoing.style.transform = "";
              incoming.style.transition = "";
              incoming.style.transform = "";
              incoming.style.display = "";
              incoming.style.position = "";
              incoming.style.top = "";
              incoming.style.left = "";
              incoming.style.width = "";
              incoming.classList.add("active");
              setActiveIndicator(incoming);
            });
          } else {
            outgoing.style.transform = "translate3d(0, 0, 0)";
            if (incoming) {
              incoming.style.transform =
                "translate3d(" + (direction === "next" ? width : -width) + "px, 0, 0)";
            }

            outgoing.addEventListener("transitionend", function handler() {
              outgoing.removeEventListener("transitionend", handler);
              outgoing.style.transition = "";
              outgoing.style.transform = "";
              resetPeekItem();
            });
          }

          activeItem = null;
        }

        carousel.addEventListener("pointerdown", function (e) {
          if (e.pointerType === "mouse" && e.button !== 0) return;
          startX = e.clientX;
          startY = e.clientY;
          currentX = startX;
          dragging = true;
          draggingHorizontally = false;
          direction = null;
          activeItem = inner.querySelector(".item.active");
          width = carousel.offsetWidth;
          $carousel.carousel("pause");
          if (carousel.setPointerCapture) {
            carousel.setPointerCapture(e.pointerId);
          }
        });

        carousel.addEventListener("pointermove", function (e) {
          if (!dragging || !activeItem) return;
          currentX = e.clientX;
          var deltaX = currentX - startX;
          var deltaY = e.clientY - startY;

          if (!draggingHorizontally) {
            if (Math.abs(deltaX) < 10 && Math.abs(deltaY) < 10) return;
            if (Math.abs(deltaX) <= Math.abs(deltaY)) return;
            draggingHorizontally = true;
            direction = deltaX < 0 ? "next" : "prev";
            preparePeekItem();
          }

          // Stop the page from scrolling horizontally while dragging the slide.
          e.preventDefault();

          // Don't let the slide travel past its resting position in the
          // direction opposite the gesture that started the drag.
          var boundedDeltaX = deltaX;
          if ((direction === "next" && deltaX > 0) || (direction === "prev" && deltaX < 0)) {
            boundedDeltaX = 0;
          }

          activeItem.style.transform = "translate3d(" + boundedDeltaX + "px, 0, 0)";
          if (peekItem) {
            var base = direction === "next" ? width : -width;
            peekItem.style.transform = "translate3d(" + (base + boundedDeltaX) + "px, 0, 0)";
          }
        });

        carousel.addEventListener("pointerup", function () {
          if (!dragging) return;
          var deltaX = currentX - startX;
          finishDrag(draggingHorizontally && Math.abs(deltaX) > threshold);
        });

        carousel.addEventListener("pointercancel", function () {
          if (!dragging) return;
          finishDrag(false);
        });
      }

      enableCarouselSwipe("financingCarousel");
      enableCarouselSwipe("nextCarousel");
    
  </script>
@*thirdtabscript*@

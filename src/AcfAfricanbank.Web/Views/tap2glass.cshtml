    // Accordion 4 active tsbs Script start here
    $(document).ready(function() {
    // Existing code for tab functionality
    $('.tabcard').on('click', function() {
        var target = $(this).data('target');
        
        if ($(target).hasClass('active')) {
            $(target).removeClass('active').slideUp();
        } else {
            $('.tabcontent').removeClass('active').slideUp();
            $(target).addClass('active').slideDown();
        }
    });

    // Activate the appropriate tab based on the URL hash
    function activateTabFromHash() {
        var hash = window.location.hash;

        if (hash) {
            // Remove 'active' class from all tabs and tab panes
            $('.nav-tabs .active').removeClass('active');
            $('.tab-pane.active').removeClass('active in');

            // Activate the tab corresponding to the hash
            $('a[href="' + hash + '"]').tab('show');
            $(hash).addClass('active in');

            // Scroll to the active tab
            $('html, body').animate({
                scrollTop: $(hash).offset().top
            }, 300); // Adjust the duration as needed
        }
    }

    // Run on page load
    activateTabFromHash();

    // Run on hash change
    $(window).on('hashchange', function() {
        activateTabFromHash();
    });

    // Accordion Script (if applicable)
    $(".accordion").click(function() {
        $(this).toggleClass("active");
        var panel = $(this).next(".panel");
        var wasOpen = panel.css("display") === "block";

        $(".panel").css("display", "none");
        $(".accordion").removeClass("active");

        if (!wasOpen) {
            panel.css("display", "block");
            $(this).addClass("active");
        }
    });
});

</script>





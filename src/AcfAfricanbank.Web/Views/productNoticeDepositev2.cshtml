                /***************** End of set color**********************/
            });
    
            $('#input-month1').on('input', function () {
                var loanterm = $(this).val();
                var newloanterm;
                if (loanterm >= 3 && loanterm <= 7)
                    newloanterm = 7;
                else if (loanterm >= 8 && loanterm <= 9)
                    newloanterm = 9;
                else if (loanterm >= 10 && loanterm <= 12)
                    newloanterm = 12;
                else if (loanterm >= 13 && loanterm <= 18)
                    newloanterm = 18;
                else if (loanterm >= 19 && loanterm <= 24)
                    newloanterm = 24;
                else  if (loanterm >= 25 && loanterm <= 30)
                    newloanterm = 30;
                else  if (loanterm >= 31 && loanterm <= 36)
                    newloanterm = 36;
                else  if (loanterm >= 37 && loanterm <= 42)
                    newloanterm = 42;
                else  if (loanterm >= 43 && loanterm <= 48)
                    newloanterm = 48;
                else  if (loanterm >= 49 && loanterm <= 60)
                    newloanterm = 60;
                else
                    newloanterm = 72
    
                $('#term1').val(newloanterm);
                $('#ddSpanner').text(newloanterm+' months');
    
                var nloan;
                var dot_check = $("#input-Amount1").val().includes(".");
                var valid_value = $("#input-Amount1").val();
                valid_value = valid_value.replace(/\s/g,'');
    
    
                if(dot_check === true){
                    nloan = valid_value.slice(0,-3);
                    nloan = nloan.substring(1);
                }
    
                else {
                    nloan = valid_value.substring(1);
                }
    
                installmentEstimator(nloan, newloanterm);
                /******set color for range slider********************/
                var valPercent = (loanterm - parseInt($('#input-month1').attr('min'))) /
                    (parseInt($('#input-month1').attr('max')) - parseInt($('#input-month1').attr('min')));
                $('#input-month1').css('background-image', '-webkit-gradient(linear, 0% 0%, 100% 0%, color-stop(' + valPercent + ', #88BC47), color-stop(' + valPercent + ', #002B60))');
                /***************** End of set color**********************/
            });
    



     $(document).ready(function () {

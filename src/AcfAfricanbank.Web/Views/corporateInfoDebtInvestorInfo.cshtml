@inherits Umbraco.Web.Mvc.UmbracoViewPage<ContentModels.PageCorporateInformation>
@using Web.Utilities
@using ContentModels = Umbraco.Web.PublishedModels

@{
    Layout = "Master.cshtml";
    // All Current Page Children
    var Children = Model.Children;

    // Get specific Children
    var HeroHeader = Children?.Where(c => c.ContentType.Alias.ToLower() == "heroheader").FirstOrDefault();
    var HeroShoulder = Children?.Where(c => c.ContentType.Alias.ToLower() == "heroshoulder").FirstOrDefault();
    var heroKneesInvestor = (HeroKneesInvestor)Children?.Where(c => c.ContentType.Alias.ToLower() == "herokneesinvestor").FirstOrDefault();
    var heroBody = Children?.Where(c => c.ContentType.Alias.ToLower() == "herobody").FirstOrDefault();
    //var heroBody = (HeroBody)Children?.Where(c => c.ContentType.Alias.ToLower() == "herobody").FirstOrDefault();
    var linkToVault = heroBody.Value("bodyDescription");
    var tabBody = (TabBody)heroBody.Children(x => x.ContentType.Alias.ToLower() == "tabbody").FirstOrDefault();

    var categories = Model.Value<IEnumerable<string>>("reportCategories") ?? new List<string>();

    var _heroBodyInvestor = (HeroBodyInvestor)heroBody.Children?.Where(c => c.ContentType.Alias.ToLower() == "herobodyinvestor").FirstOrDefault();

    //var labelData = _heroBodyInvestor.Labels.FirstOrDefault();
    //var reportTitle = labelData.Value("label");

    var _reportHeaders = _heroBodyInvestor.Cards.ToList().Where(x => x.Value("subTitle").ToString() != "").ToList().Select(xx => xx.Value("subTitle")).Distinct();

    var heroKnees = (HeroKnees)Children?.Where(c => c.ContentType.Alias.ToLower() == "heroknees").FirstOrDefault();
    //var tabKnees = (TabBody)heroKnees.Children(x => x.ContentType.Alias.ToLower() == "tabbody").FirstOrDefault();
}
<style>
    .margin-bottom-minus-60 .archive {
        margin-bottom: -70px;
    }

    .press-release-section .report-section-heading h2 {
        margin-top: -22px;
    }

    .text-container.reporting .report-files {
        margin-top: 0px;
    }
    .body-desc{
        margin-top: -46px;
        border-top: 1px solid #d0cbcb;
    }
    @@media (min-width: 280px) and (max-width: 428px) {
        .press-release-section .report-section-heading h2 {
            font-size: 38px;
            font-weight: 200;
            line-height: 1.42;
            text-align: center;
            margin-bottom: -57px;
            margin-top: 22px;
        }
    }
</style>
<!-- HERO BANNER -->
@Html.Partial("_pageHeaderImage", HeroHeader as ContentModels.HeroHeader)

<!-- HERO CONTINUED-->
@Html.Partial("_pageShoulder", HeroShoulder as ContentModels.HeroShoulder)

<!-- FAQ INFORMATION-->
<div class="container margin-bottom-minus-60">
    <div class="campaign-product-container full">

        <div class="row text-container">
            @Html.Raw(heroKneesInvestor.Description)
        </div>
    </div>
</div>
@* HERO Body*@
<div class="container">
    <div class="campaign-product-container">
        <div class="margin-top-20 visible-xs"></div>

        <div class="row text-container reporting">
            <div class="row inline-checklist"></div>
            <hr class="body-desc" />
            <div class="row report-files">
                @*<div class="col-xs-12 col-sm-12 col-md-12">
             filter code start
            <div class="row investor-dropdown" style="margin-top:-40px;">
                <div class="col-sm-2 margin-top-10">
                    <div class="dropdown-label pull-left ng-binding">
                        <h2 style="font-size: 24px;text-align: right;line-height: 41px;color: #88bc47;font-weight: 500;">Filter</h2>
                    </div>
                </div>

                <div class="col-sm-5 margin-top-10">
                    <div class="press-release-dropdown" style="padding: 0px;">
                        <select ng-model="year" ng-init="ABL" class="ng-pristine ng-untouched ng-valid ng-not-empty">
                            @{
                                int iterator = 0;
                                foreach (var _cardHeader in _reportHeaders)
                                {
                                    var _dropdownList = (IEnumerable<NCdownload>)_heroBodyInvestor.Cards.Where(x => x.Value("subTitle").ToString() == _cardHeader.ToString()).ToList();
                                    foreach (var dpList in _dropdownList)
                                    {
                                    <option>@dpList.SubTitle</option>
                                    }

                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="col-sm-5 margin-top-10">


                    <div class="input-group addon">
                        <span class="input-group-addon" style="background-color:white; border:none"><i class="fa fa-search" style="color:#88bc47"></i></span>
                        <input id="SearchKeyUp" class="form-control ng-pristine ng-untouched ng-valid ng-empty" type="text" ng-model="searchTerm" ng-init="searchTerm = ''" placeholder="Search Term" onkeyup="ValidateSearch();">
                    </div>
                    <br>
                    <div id="notFoundDiv" style="color: red; font-weight: bold; display:none;">No Records Found</div>
                    <script src="/scripts/searchInput.min.js"></script>



                </div>
            </div>
            @* end filter code*@
            </div>
            @{
                int columnDesign = 0;
                int columnDesign1 = 0;
                string col_offset = "col-md-offset-6";


                        <div class="col-xs-12 col-sm-12 col-md-6">
                            <h3 style="font-size: 15px;color: #88bc47;">African Bank Limited (ABL)</h3>
                            @foreach (var _cardHeader in _reportHeaders)
                            {
                                if (columnDesign1 < 3)
                                {
                                    <div>
                                            <p style="color: #464855;margin-bottom: 5px;font-size: 14px;font-weight: 600;">@_cardHeader</p>
                                        @*@{
                                            if (_cardHeader.ToString() != "Presentation")

                                            {
                                                <h3 style="margin-bottom: 25px;font-size: 16px;">@_cardHeader</h3>
                                            }
                                            else
                                            {
                                                <h3></h3>
                                            }
                                        }*@
                                        <div class="row">
                                            @{
                                                var _downloads1 = (IEnumerable<NCdownload>)_heroBodyInvestor.Cards.Where(x => x.Value("subTitle").ToString() == _cardHeader.ToString()).ToList();
                                                foreach (var download in _downloads1)
                                                {
                                                    if (download.Value("File") == null)
                                                    {
                                                        <div class="col-sm-12 margin-bottom-10">
                                                           <div class="row">
                                                                    <div class="col-sm-8 col-xs-10">
                                                                        @Html.Raw(download.Title)
                                                                    </div>
                                                                    <div class="col-sm-3 hidden-xs">
                                                                        <i style="font-size:0.8em; float:right;">None</i>
                                                                    </div>
                                                                    <div class="col-sm-1 col-xs-2">
                                                                        <i class="fa fa-download" style="float: right;padding-left: 13px;font-size: 14px;"></i>
                                                                    </div>
                                                                </div>
                                                        </div>

                                                    }
                                                    else
                                                    {
                                                        double umbracoBytes = Convert.ToDouble(download.File.Value("UmbracoBytes"));
                                                        double fileSize = umbracoBytes / 1024000;
                                                        <div class="col-sm-12 margin-bottom-10">
                                                            <a target="_blank" href="@download.File.Url">

                                                                <div class="row">
                                                                    <div class="col-sm-8 col-xs-10">
                                                                        @Html.Raw(download.Title)
                                                                    </div>
                                                                    <div class="col-sm-3 hidden-xs">
                                                                        <i style="font-size:0.8em; float:right;">(@Math.Round(fileSize, 2) MB)</i>
                                                                    </div>
                                                                    <div class="col-sm-1 col-xs-2">
                                                                        <i class="fa fa-download" style="float: right;padding-left: 13px;font-size: 14px;"></i>
                                                                    </div>
                                                                </div>
                                                            </a>
                                                        </div>
                                                    }
                                                }
                                            }
                                        </div>
                                    </div>
                                }
                                ++columnDesign1;
                            }


                        </div>

                <div class="col-xs-12 col-sm-12 col-md-6">
                    <h3 style="font-size: 15px;color: #88bc47;">African Bank Holding Limited (ABHL)</h3>
                    @foreach (var _cardHeader in _reportHeaders)
                    {
                        if (columnDesign >= 3)
                        {
                            <div>
                                <p style="color: #464855;margin-bottom: 5px;font-size: 14px;font-weight: 600;">@_cardHeader</p>
                                @*@{
                                    if (_cardHeader.ToString() != "Presentation")
                                    {
                                       
                                        <h3 style="margin-bottom: 25px;font-size: 16px;">@_cardHeader</h3>
                                    }
                                    else
                                    {
                                        <h3></h3>
                                    }
                                }*@
                                <div class="row">
                                    @{
                                        var _downloads = (IEnumerable<NCdownload>)_heroBodyInvestor.Cards.Where(x => x.Value("subTitle").ToString() == _cardHeader.ToString()).ToList();
                                        foreach (var download in _downloads)
                                        {
                                            if (download.Value("File") == null)
                                            {
                                                <div style="margin-left:4%" class="col-sm-12 margin-bottom-10">
                                                    <div class="row">
                                                        <a target="_blank" href="@download.Value("Title")">
                                                            <div class="pull-left">@download.Value("Description")</div>
                                                        </a>
                                                    </div>

                                                    <div class="row" style="font-style: italic; font-size: x-small; display:inline-block">

                                                    </div>
                                                </div>

                                            }
                                            else
                                            {
                                                double umbracoBytes = Convert.ToDouble(download.File.Value("UmbracoBytes"));
                                                double fileSize = umbracoBytes / 1024000;
                                                <div class="col-sm-12 margin-bottom-10">
                                                    <a target="_blank" href="@download.File.Url">

                                                        <div class="row">
                                                            <div class="col-sm-8 col-xs-10">
                                                                @Html.Raw(download.Title)
                                                            </div>
                                                            <div class="col-sm-3 hidden-xs">
                                                                <i style="font-size:0.8em; float:right;">(@Math.Round(fileSize, 2) MB)</i>
                                                            </div>
                                                            <div class="col-sm-1 col-xs-2">
                                                                <i class="fa fa-download" style="float: right;padding-left: 13px;font-size: 14px;"></i>
                                                            </div>
                                                        </div>
                                                    </a>
                                                </div>
                                            }
                                        }
                                    }
                                </div>
                            </div>
                        }
                        ++columnDesign;
                    }
                </div>






            }
        </div>
    </div>
</div>


@*Html.Partial("_pageDocumentAbView", tabKnees as ContentModels.TabBody)*@
<div class="container">
    <div class="press-release-section reports investor full">
        <div class="report-section-heading">
            <h2>Archives</h2>
        </div>
    </div>
</div>
@Html.Partial("_pageDocumentView", tabBody as ContentModels.TabBody)

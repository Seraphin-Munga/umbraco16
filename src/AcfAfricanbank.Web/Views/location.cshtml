@section scripts {
    <script type="text/javascript">
    
     //  const firstLink = document.querySelectorAll("link");
    setTimeout(function() {
        
         const firstLink = document.querySelectorAll('link[rel="stylesheet"][href="https://storelocatorcdn.places.digital/css/style.css"]');
       
             //document.styleSheets[0].disabled = true;
            //console.log( document.styleSheet);
            
            
            // Remove the <link> element if it exists
           if (firstLink && firstLink.length > 0) {
             // firstLink.parentNode.removeChild(firstLink);
             
           firstLink[0].remove();
            }
            
           document.querySelectorAll(".arrow-wrap").forEach(el => { 
             const timeText = $("#the-time").children(1).text();
             if (timeText === "CLOSED") {
                 
                  el.remove();
                  const ss=el;
                  $("#the-time").append(ss);
                  $(".arrow-wrap").css("margin-right", "50px");
                 // $("#the-time").prepend(el);
                  
              }
            });
            
         
            
           
        
    }, 3000);
       
      
        
        $(document).ready(function() {
            // need to add code in live site//
           setTimeout(function() {
               //mycode//
                
                var $elementToStore = $("#LB_Details_wrap"); 
            var $parent = $elementToStore.parent();  
                
                  $parent.appendTo("#LB_Nearby_locations");
                
              var elements = document.getElementsByClassName("nearby_location");
           
           var domainname = window.location.origin;
           
           var replacename = "https://publishing.v5.stg.africanbankdmz.net";
           
           for(var i=0; i < elements.length; i++)
           {
              var url = elements[i].querySelector('a').href;
              
            url =  url.replaceAll(replacename, domainname);
            
            elements[i].querySelector('a').setAttribute("href" , url);
           } 
           var findmoreurl = document.getElementById("find-more-locations-button") 
           
            var findmorelink = findmoreurl.href;
             
             findmorelink = findmorelink.replaceAll(replacename, domainname);
             
              findmoreurl.setAttribute("href" , findmorelink);
              
           },4000);
           
                
            
            

@inherits Umbraco.Web.Mvc.UmbracoViewPage
@using CustomModels = Web.Models;
@using ContentModels = Umbraco.Web.PublishedModels;
@using Web.Helpers
@using Umbraco.Core.Services;


@{
    Layout = "Master.cshtml";
    var children = Model.Children;
    var heroHeader = children?.Where(c => c.ContentType.Alias.ToLower() == "heroheader").FirstOrDefault();
    var heroBody = children?.Where(c => c.ContentType.Alias.ToLower() == "herobody").FirstOrDefault();
    
    var header= heroBody.Children.Where(c => c.Name == "Headers").FirstOrDefault();
    var myheader = header.Value<IEnumerable<IPublishedElement>>("tabBodyContent");
    var headers = myheader.Where(c => c.ContentType.Alias == "nCTabGenericContent").FirstOrDefault().Value<IEnumerable<IPublishedElement>>("sectionContent");
 
    ContentModels.TabBody cardheader = null;
    var partialName1 = header.Value("PartialViewName");
    cardheader = (TabBody)header;
    
    var cardsection = heroBody.Children.Where(c => c.Name == "Cards").FirstOrDefault();
    var mainCard = cardsection.Value<IEnumerable<IPublishedElement>>("tabBodyContent");
    var cards = mainCard?.Where(c => c.ContentType.Alias == "nCTabGenericContent").FirstOrDefault().Value<IEnumerable<IPublishedElement>>("sectionContent");
    var idfirstcard = 0;
    
    ContentModels.TabBody cardheader2 = null;
    var partialName2 = cardsection.Value("PartialViewName");
    cardheader2 = (TabBody)cardsection;
    
    var faq = heroBody.Children.Where(c => c.Name == "FAQ").FirstOrDefault();
    var faqsection = faq.Value<IEnumerable<IPublishedElement>>("tabBodyContent");
    var faqs = faqsection?.Where(c => c.ContentType.Alias == "nCTabGenericContent").FirstOrDefault().Value<IEnumerable<IPublishedElement>>("sectionContent");
    var noCampx1 = 1;
      
    ContentModels.TabBody createOwnWorldOfBankingfaq = null;
    var partialName = faq.Value("PartialViewName");
    createOwnWorldOfBankingfaq = (TabBody)faq;
    
    var blog = heroBody.Children.Where(c => c.Name == "Blogs").FirstOrDefault();
    var blogsection = blog.Value<IEnumerable<IPublishedElement>>("tabBodyContent");
    var blogs = blogsection?.Where(c => c.ContentType.Alias == "nCTabGenericContent").FirstOrDefault().Value<IEnumerable<IPublishedElement>>("sectionContent");
    
    ContentModels.TabBody blogheader = null;
    var partialNameblog = blog.Value("PartialViewName");
    blogheader = (TabBody)blog;
    
    var youtubelink = heroBody.Children.Where(c => c.Name == "Youtube").FirstOrDefault();
    var youtubesection = youtubelink.Value<IEnumerable<IPublishedElement>>("tabBodyContent");
    var youtube = youtubesection?.Where(c => c.ContentType.Alias == "nCTabGenericContent").FirstOrDefault().Value<IEnumerable<IPublishedElement>>("sectionContent");
    
    ContentModels.TabBody youtubeheader = null;
    var partialNameyoutube = youtubelink.Value("PartialViewName");
    youtubeheader = (TabBody)youtubelink;
    
    var headerImage_large = heroHeader?.Value<IPublishedContent>("image")?.Url;
}


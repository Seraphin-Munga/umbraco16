@inherits Umbraco.Web.Mvc.UmbracoTemplatePage<ContentModels.PageCampaign>
@using ContentModels = Umbraco.Web.PublishedContentModels;
@using CustomModels = acf_africanbankv1.Models
@using AfricanBank.Cms.Portal.Helpers;
@using acf_africanbankv1.Helpers
@{
    Layout = "Master.cshtml";
    var children = Model.Content.Children;
    var heroHeader = children?.Where(c => c.DocumentTypeAlias.ToLower() == "heroheader").FirstOrDefault();
    var heroShoulder = children?.Where(c => c.DocumentTypeAlias.ToLower() == "heroshoulder").FirstOrDefault();

    var heroBody = children?.Where(c => c.DocumentTypeAlias.ToLower() == "herobody").FirstOrDefault();
    ContentModels.TabBody surveyQuestionData = null;
    ContentModels.TabBody bankingCardData = null;
    ContentModels.TabBody tabWaysToBank = null;
    ContentModels.TabBody myWorldTermsAndConditions = null;

    var tabBodyItems = heroBody.Children.OfType<TabBody>();
    tabBodyItems.ToList().ForEach(x =>
    {
        if (x.Name == "Survey Questions")
        {
            surveyQuestionData = (TabBody)x;
        }
        else if (x.GetPropertyValue("partialViewName").ToString() == "partialHeroChest")
        {
            tabWaysToBank = (TabBody)x;
        }
        else if (x.GetPropertyValue("partialViewName").ToString() == "_renderPDFData")
        {
            myWorldTermsAndConditions = (TabBody)x;
        }
        else
        {
            bankingCardData = (TabBody)x;
        }
    });

    var sectionCardsContent = (ICollection<IPublishedContent>)tabWaysToBank.TabBodyContent.Where(c => c.DocumentTypeAlias == "nCTabGenericContent").FirstOrDefault().GetPropertyValue("sectionContent");
    var myWorldTAndCs = (IEnumerable<IPublishedContent>)myWorldTermsAndConditions.TabBodyContent.Where(c => c.DocumentTypeAlias == "nCTabGenericContent").FirstOrDefault().GetPropertyValue("sectionContent");

    var heroChest = children?.Where(c => c.DocumentTypeAlias.ToLower() == "herochest").FirstOrDefault();
    var chestTitle = heroChest?.GetPropertyValue("chestTitle").ToString();
    var chestDescription = heroChest?.GetPropertyValue("chestDescription").ToString();
    var chestCards = heroChest?.Children?.Where(c => c.DocumentTypeAlias.ToLower() == "card");

    var _bankingItemsModel = new CustomModels.Benefits
    {
        Header = chestTitle,
        Description = chestDescription,
        BenefitCards = sectionCardsContent.Select(c => c as Card).ToList()
    };

    IEnumerable<IPublishedContent> bodyButtons = (IEnumerable<IPublishedContent>)heroBody.Children.Where(c => c is ContentModels.EbankItabstractButton);
    ContentModels.EbankItabstractButton openNowButton = null;
    ContentModels.EbankItabstractButton registerNowButton = null;
    ContentModels.EbankItabstractButton androidDownloadNow = null;
    ContentModels.EbankItabstractButton iosDownloadNow = null;
    ContentModels.EbankItabstractButton downloadNow = null;

    foreach (var button in bodyButtons)
    {
        if (button.GetPropertyValue("EbankItbuttonText").ToString().Contains("Register / Login"))
        {
            openNowButton = (ContentModels.EbankItabstractButton)button;
        }
        else if (button.GetPropertyValue("EbankItbuttonText").ToString().Contains("Register Now"))
        {
            registerNowButton = (ContentModels.EbankItabstractButton)button;

        }

        else if (button.GetPropertyValue("EbankItbuttonText").ToString().Contains("Android"))
        {
            androidDownloadNow = (ContentModels.EbankItabstractButton)button;
        }
        else if (button.GetPropertyValue("EbankItbuttonText").ToString().Contains("iOS"))
        {
            iosDownloadNow = (ContentModels.EbankItabstractButton)button;
        }
        else
        {
            downloadNow = (ContentModels.EbankItabstractButton)button;
        }
    }

    var openNowButtonLink = "#";
    openNowButtonLink = string.IsNullOrEmpty(openNowButton?.EbankItbuttonInternalLink?.Url) ?
    openNowButton?.EbankItbuttonExternalLink :
    openNowButton.EbankItbuttonInternalLink?.Url;
    openNowButtonLink = (string.IsNullOrEmpty(openNowButtonLink)) ? "#" : openNowButtonLink;

    var registerNowButtonLink = "#";
    registerNowButtonLink = string.IsNullOrEmpty(registerNowButton?.EbankItbuttonInternalLink?.Url) ?
    registerNowButton?.EbankItbuttonExternalLink :
    registerNowButton.EbankItbuttonInternalLink?.Url;
    registerNowButtonLink = (string.IsNullOrEmpty(registerNowButtonLink)) ? "#" : registerNowButtonLink;

    var onlineButtonText = registerNowButton.GetPropertyValue("EbankItbuttonText");

    var popupAppTitle = "Download African App using one of the following";
    var popQRCode = "/media/51852/image001.png";
    var popAndroidApp = "/media/51814/googleplaystoredownloadimagelink.png";
    var popIOsApp = "/media/51813/appstoredownloadimagelink.png";
}
<style type="text/css">
    .margin-bottom-20 {
        margin-bottom: 20px !important;
    }

    #sendOptOut {
        background-color: #88bc47;
        border: none;
    }

    .form-horizontal .control-label {
        text-align: unset;
    }

    .hang-tight {
        display: none;
    }

    .hero-description {
        display: none !important;
    }

    .switch-content-view > p {
        display: block;
        font-size: 28px;
        font-weight: 800;
    }

    label {
        text-transform: none;
    }

    .campaign-button {
        padding: 16px 35px;
        font-size: 16px;
        color: #88bc47;
        text-align: center;
        font-weight: normal;
        -webkit-font-smoothing: antialiased;
        transition: all 1s ease;
        display: inline-block;
        cursor: pointer;
        background: none;
        text-decoration: underline;
    }

        .campaign-button:hover {
            color: white;
        }

    .title-text {
        margin-top: 14px;
        margin-bottom: 40px;
        text-align: center;
        font-size: 32px;
    }

    .campaign-textarea-color {
        color: #002b60;
    }

    li:hover {
        transition: 0.3s;
        color: #88bc47;
        font-size: large;
    }

    li {
        transition: 0.3s;
    }

    .dropdown-styleset {
        text-align: center;
        padding: unset;
    }

    .hr-styleset {
        margin: 5px 0px 5px 5px;
        text-align: center;
        margin-right: 6%;
        margin-left: 6%;
        border-color: #1717175c;
    }

    .wrapper-dropdown-3 {
        position: relative;
        margin: 0 auto;
        padding: 10px;
        background: #001e44;
        border-radius: 7px;
        border: 1px solid rgba(0,0,0,0.15);
        box-shadow: 0 1px 1px rgba(50,50,50,0.1);
        cursor: pointer;
        outline: none;
        font-weight: bold;
        color: #ffffff;
        right: 0px;
    }

        .wrapper-dropdown-3 .dropdown {
            position: absolute;
            top: 140%;
            left: 0;
            right: 0;
            z-index: 50;
            background: #507096;
            color: #f1f3f0;
            border-radius: inherit;
            border: 1px solid rgba(0, 0, 0, 0.24);
            box-shadow: 1px 2px 10px rgba(0,0,0,0.5);
            font-weight: normal;
            -webkit-transition: all 0.5s ease-in;
            -moz-transition: all 0.5s ease-in;
            -ms-transition: all 0.5s ease-in;
            -o-transition: all 0.5s ease-in;
            transition: all 0.5s ease-in;
            list-style: none;
            opacity: 0;
            pointer-events: none;
        }

            .wrapper-dropdown-3 .dropdown:after {
                content: "";
                width: 0px;
                height: 0px;
                position: absolute;
                bottom: 100%;
                right: 54px;
                border-width: 0px 9px 13px 8px;
                border-style: solid;
                border-color: #507096 transparent;
            }

            .wrapper-dropdown-3 .dropdown:before {
            }

            .wrapper-dropdown-3 .dropdown li a {
                display: block;
                padding: 10px;
                text-decoration: none;
                color: #8aa8bd;
                border-bottom: 1px solid #e6e8ea;
                box-shadow: inset 0 1px 0 rgba(255,255,255,1);
                -webkit-transition: all 0.3s ease-out;
                -moz-transition: all 0.3s ease-out;
                -ms-transition: all 0.3s ease-out;
                -o-transition: all 0.3s ease-out;
                transition: all 0.3s ease-out;
            }

            .wrapper-dropdown-3 .dropdown li i {
                float: right;
                color: inherit;
            }

            .wrapper-dropdown-3 .dropdown li:first-of-type a {
                border-radius: 7px 7px 0 0;
            }

            .wrapper-dropdown-3 .dropdown li:last-of-type a {
                border: none;
                border-radius: 0 0 7px 7px;
            }
            /* Hover state */
            .wrapper-dropdown-3 .dropdown li:hover a {
                background: #f3f8f8;
            }
        /* Active state */
        .wrapper-dropdown-3.active .dropdown {
            opacity: 1;
            pointer-events: auto;
        }
    /* No CSS3 support */
    .no-opacity .wrapper-dropdown-3 .dropdown,
    .no-pointerevents .wrapper-dropdown-3 .dropdown {
        display: none;
        opacity: 1; /* If opacity support but no pointer-events support */
        pointer-events: auto; /* If pointer-events support but no pointer-events support */
    }

    .no-opacity .wrapper-dropdown-3.active .dropdown,
    .no-pointerevents .wrapper-dropdown-3.active .dropdown {
        display: block;
    }

    @@media (max-width: 360px) {
        .switch-content-view > p {
            font-size: 15px;
        }

        .switch-mobi-view {
            text-align: center;
        }
    }
</style>

<!-- HERO Header -->
@Html.Partial("_pageHeaderImage", heroHeader as ContentModels.HeroHeader)
<!-- HERO Shoulder-->
@Html.Partial("_pageShoulder", heroShoulder as ContentModels.HeroShoulder)
<!-- HERO Chest-->
<!-- HERO Body-->
@Html.Partial("_optOutQuestions", surveyQuestionData as ContentModels.TabBody)

<div class="green-pointer-banking-campaign"></div>
<div class="hover-block"></div>
<div class="container">
    <div class="row">
        @*<img src="@imageValuePath" alt="every swipe counts rewards" />*@
    </div>
</div>
<div class="container">
    <div class="mega-tabs" style="margin-top:-42px">
        <!-- Nav tabs -->
        <ul class="nav nav-tabs eq-height" role="tablist">
            <li role="presentation" class="online-banking-li">
                The new way of banking
            </li>
        </ul>
    </div>
</div>

<div class="container payments-section full margin-bottom-30">
    <div class="margin-top-20 visible-xs"></div>
    <div class="row">
        <h4 class="container margin-bottom-20 align-center">@tabWaysToBank.GetPropertyValue("partialViewClassName")</h4>
        @{
            int cardIterator = 0;
            bool increaseCardHeight = false;

            foreach (var item in sectionCardsContent)
            {

                if (cardIterator == (int)sectionCardsContent.Count() - 1)
                {
                    increaseCardHeight = true;
                }
                var cardTitle = item.GetPropertyValue<string>("cardTitle");
                var cardDesc = item.GetPropertyValue<string>("cardDescription");
                var icon = item.GetPropertyValue<IPublishedContent>("cardIcon");
                <div class="col-sm-4 margin-bottom-20">
                    <div class="@(increaseCardHeight ? "cellphone-button-banking-campaign" : "")">
                        <div class="text-left center-align white-link-color richtextbox-blue-bg">
                            <img src="@icon.Url" alt="@icon.GetPropertyValue("altTag")" class="image-center-resizer" />
                            <p class="title blue-color font-size-20">@cardTitle</p>
                            <p>@cardDesc</p>
                        </div>
                    </div>
                    @{
                        if (!cardTitle.Contains("App"))
                        {
                            <div class="col-md-4 center-align margin-bottom-20 margin-right-50 banking-options-buttons">
                                <a href="@registerNowButtonLink" class="button span-buttons green-button" id="">
                                    @onlineButtonText
                                </a>
                            </div>
                        }
                        else
                        {
                            <div class="col-md-4 center-align margin-bottom-20 margin-left-50 banking-options-buttons">
                                <span class="button span-buttons green-button view_OnlineApps downloadNow" data-item="@popupAppTitle*@popQRCode*@popAndroidApp*@popIOsApp" target="_blank">@downloadNow.EbankItbuttonText</span>
                            </div>
                        }
                    }
                </div>
                cardIterator += 1;
            }
        }
    </div>
</div>

<!-- NUMBER TO CALL -->
<div class="number-to-call">
    <p style="text-align: center;">1 <span>Number to call</span></p>
    <h4 class="bolder" style="text-align: center;">0861 123 456</h4>
    @{
        int pipeIterator = 0;
        foreach (var item in myWorldTAndCs)
        {
            if (!item.GetPropertyValue("categoryName").ToString().Contains("Pricing Guide"))
            {
                var linkString = ((ContentModels.File)item.GetPropertyValue("ebankITDocument")).Url;
                <a rel="noopener noreferrer" href="@linkString" target="_blank" class="tAndC">
                    @item.GetPropertyValue("ebankITTitle").ToString()
                </a>
                @*if (pipeIterator <= 1)
                {
                    <span>&#124;</span>
                }*@
            }
            pipeIterator += 1;
        }
    }
</div>


@section scripts
{
    <script type="text/javascript">

        function addFormValidation() {

            $('.form-horizontal').bootstrapValidator({
                feedbackIcons: {
                    valid: 'glyphicon glyphicon-ok-sign',
                    invalid: 'glyphicon glyphicon-remove-sign',
                    validating: 'glyphicon glyphicon-refresh'
                },
                fields: {
                    'ddInputResult0': {
                       validators: {
                                callback: {
                                    callback: function (value, validator, $field) {
                                        debugger;
                                        // apply Luhn formula for check-digits
                                        var idNumber = value;
                                        var tempTotal = 0;
                                        var checkSum = 0;
                                        var multiplier = 1;
                                        var i = 0;

                                        // Section to validate min and max loan application acceptable years

                                        if (null === idNumber || 0 === idNumber.length) return !1;

                                        var tempDate = new Date(idNumber.substring(0, 2), idNumber.substring(2, 4) - 1, idNumber.substring(4, 6));
                                        var id_year = new Date().getFullYear() - tempDate.getFullYear();
                                        if (id_year > 100) { id_year = id_year - 100; }
                                        if ((id_year >= 18) && (id_year <= 79)) {

                                            if (13 !== idNumber.length || isNaN(parseFloat(idNumber)) && isFinite(idNumber)) {
                                                return false;
                                            }
                                            else {
                                                for (i = 0; i < 13; ++i) {
                                                    tempTotal = parseInt(idNumber.charAt(i)) * multiplier;
                                                    if (tempTotal > 9) {
                                                        tempTotal = parseInt(tempTotal.toString().charAt(0)) + parseInt(tempTotal.toString().charAt(1));
                                                    }
                                                    checkSum = checkSum + tempTotal;
                                                    multiplier = (multiplier % 2 === 0) ? 1 : 2;
                                                }
                                                if ((checkSum % 10) !== 0) {
                                                    return !1;
                                                }
                                                else {
                                                    return !0;
                                                }
                                            }
                                        }
                                    }, message: "A valid numeric ID is required."
                                },
                                stringLength: {
                                    max: 13,
                                    message: 'ID Number can only be 13 digits only'
                                },
                                regexp: {
                                    regexp: /^[0-9]{1,13}$/,
                                    message: 'The ID Number can only consist of alphanumeric characters'
                                }
                            }
                    },
                    'firstName': {
                        message: 'Value inserted is not valid',
                        validators: {
                            notEmpty: {
                                message: 'Name required'
                            },
                            regexp: {
                                regexp: /^[a-zA-Z]/,
                                message: 'Please insert a valid name'
                            }, stringLength: {
                                max: 30,
                                message: 'Please make sure that the name is 30 max characters long.'
                            }
                        }
                    },
                    'cellPhone': {
                        message: 'Cellphone number entered is not valid',
                        validators: {
                            notEmpty: {
                                message: 'Cellphone number required'
                            },
                            numeric: {
                                message: 'Value entered can only be numeric'
                            },
                            stringLength: {
                                min: 10,
                                max: 10,
                                message: 'Cellphone can only be 10 characters long'
                            }
                        }
                    },
                    'email': {
                        message: 'Value inserted is not valid',
                        validators: {
                            notEmpty: {
                                message: 'Enter a valid email address'
                            },
                            regexp: {
                                regexp: /^[-a-z0-9~!$%^&*_=+}{\'?]+(\.[-a-z0-9~!$%^&*_=+}{\'?]+)*@@([a-z0-9_][-a-z0-9_]*(\.[-a-z0-9_]+)*\.(aero|arpa|biz|com|coop|edu|gov|info|int|mil|museum|name|net|org|pro|travel|mobi|[a-z][a-z])|([0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}))(:[0-9]{1,5})?$/i,
                                message: 'Please enter a valid email address'
                            }, stringLength: {
                                max: 30,
                                message: 'Please make sure only number is inserted.'
                            }
                        }
                    }
                }
            });
        }
        $(document).ready(function () {
        // OptOut Send start
         addFormValidation();

        $('#sendOptOut').on('click', function (e) {
            debugger;
            e.preventDefault();
            if (isFormValid()) {
                $('.hang-tight').show('slow');
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("SendSurveyMail", "Custom")',
                    data: $('.form-horizontal').serialize(),
                }).done(function (html) {
                    debugger;
                    console.log(html);
                }).fail(function (e) {
                    debugger;
                    console.log(e.responseText);
                });
                setTimeout(function () {
                    $('.hang-tight').hide('slow');
                    debugger;

                    $('#generic')[0].children[0].children[0].children[0].children[1].innerHTML = 'Thank you!';
                    $('#generic').modal('show');
                    if ($('#sendOptOut').attr('disabled') === 'disabled') {
                        $('#sendOptOut').removeAttr('disabled');
                    }
                }, 5000);
            }
        });
        function isFormValid() {
            var isControlEmpty = true;
            return isControlEmpty;
        }
        // OptOut Send end
    });
    </script>
}
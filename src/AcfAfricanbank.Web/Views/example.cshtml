<style>
.cookie-notice {
    display:none;
}
.zoom-in {
  opacity: 0;
  transform: scale(0.85);
  transition: transform 1s ease, opacity 1s ease;
  will-change: transform, opacity;
}

.zoom-in.visible {
  opacity: 1;
  transform: scale(1);
}
.qqheader {
    display: none;  /* Hide by default */
    opacity:0;
}
.card-upsale {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border: 1px solid #f2f2f2;
    padding: 20px;
    margin: 15px;
    border-radius: 29px;
    height: 170px;
    box-shadow: rgba(50, 50, 105, 0.10) 0px 2px 15px 0px, rgba(0, 0, 0, 0.05) 0px 1px 1px 0px;
}
.major-title {
    font-weight: 200 !important;
    font-size: 72px !important;
    line-height: 1;
}
.span-major-title {
    font-weight: 700 !important;
    font-size: 72px !important;
    font-style: italic !important;
}
.header_tab.active {
    color: #fff !important;
}

    .custom-select {
    position: relative;
    display: inline-block;

}

select #title {
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    width: 100%;
    padding: 12px 35px 12px 15px;
    border: 2px solid #012B60;
    border-radius: 4px;
    background: white;
    font-size: 16px;
}

.custom-select::after {
    content: '\25BC'; /* Down arrow */
    font-size: 14px;
    color: #012B60;
    position: absolute;
    right: 15px;
    top: 40%;
    transform: translateY(-50%);
    pointer-events: none;
    transition: transform 0.3s ease;
}

/* Optional: Rotate arrow when select is focused */
select:focus ~ .custom-select::after {
    transform: translateY(-50%) rotate(180deg);
}

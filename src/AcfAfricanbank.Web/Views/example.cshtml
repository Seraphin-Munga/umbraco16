@*docupload styles*@
#status ul {
    list-style: none;
    padding-left: 0;
}

/* Style each list item */
#status ul li {
    position: relative;
    padding-left: 31px; /* Space for the checkmark */
    font-size: 14px;
}

/* Add a checkmark before each list item */
#status ul li:before {
   content: "";/* Unicode for checkmark */
   font-family: "Glyphicons Halflings";
   font-size: 17px;
    position: absolute;
    left: 0;
    top: 0;
    color: #5DC300; 

}
#step4 {
    position: relative;
    padding-bottom: 50px; /* Adjust based on button height */
}

#submitBtn {
    position: absolute;
    bottom: 10px;
    right: 0px;
}
@*end docupload styles*@

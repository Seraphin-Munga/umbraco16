    <div id="amountModalinv" class="model_overlay hidden">
        <div class="modal_dialog">
            <div class="modal_content">
                <div class="modal_header">
                    <i class="material-icons close-icon" onclick="closeDialog('amountModalinv')">close</i>
                </div>
                <div class="modal_body">
                    <h2>How much are you looking to invest?</h2>
                    <p>We offer personal loans from <strong>R 500</strong> to <strong>R 5 000 000 000</strong></p>

                    <div class="input_container">
                        <label for="loanAmount">Your Amount</label>
                        <input type="text" id="loanAmount" name="loanAmount" placeholder="Enter loan amount" oninput="syncInputWithTrackBar(this.value)">
                        <span class="error-message" id="error-message">Please enter a value between R 2 000 and R 350 000</span>
                    </div>

                    <div class="slider-container">
                        <input type="range" id="loanRange" name="loanRange" min="2000" max="350000" step="1000" value="2000"
                               oninput="syncInputWithTrackBar(this.value)">
                        <div class="range-labels">
                            <span>R 2 000.00</span>
                            <span>R 350 000.00</span>
                        </div>
                    </div>
                </div>
                <div class="modal_footer">
                    <button class="btn btn-primary" onclick="submitLoanAmount('amountModal')">Get Started</button>
                </div>
            </div>
        </div>
    </div>


    <div id="amountModal" class="model_overlay hidden">
        <div class="modal_dialog">
            <div class="modal_content">
                <div class="modal_header">
                    <i class="material-icons close-icon" onclick="closeDialog('amountModal')">close</i>
                </div>
                <div class="modal_body">



                    <h2 class="color-brand-1 mt-15 mb-20">How much are you looking for the personal loan?</h2>
                    <!--Calculator -->
                    <div class="calculator-form ">
                        <p class="cal-loan-disclaimer" id="" style="padding:5px 0px">Please enter Loan amount between <bold>R2 000</bold> to <bold>R500 000</bold></p>
                        <label class="cal-amount">Amount</label>

                        <input id="input-Amount1" class="loan-inpt" type="text" value="2000" onkeypress="return (event.charCode == 8 || event.charCode == 0 || event.charCode == 13) ? null : event.charCode >= 48 && event.charCode <= 57">



                        <div class="range-wrap">
                            <div class="range-value" id="rangeV1"></div>
                            <input id="slide-range1" type="range" class="loan-range" min="2000" max="500000" step="500" value="2000">
                        </div>


                        <div class="loans" style="margin-bottom: -7px">
                            <div class="col-1" style="text-align: left; font-size:14px">R2 000</div>
                            <div></div>
                            <div class="col-2" style="text-align: right; font-size:14px">R500 000</div>
                        </div>

                        <label class="cal-amount">Repayment Term</label>
                        <select class="loan-select-term" id="term1">
                            <option value="7">7 Months</option>
                            <option value="9">9 Months</option>
                            <option value="12">12 Months</option>
                            <option value="18">18 Months</option>
                            <option value="24">24 Months</option>
                            <option value="30">30 Months</option>
                            <option value="36">36 Months</option>
                            <option value="42">42 Months</option>
                            <option value="48">48 Months</option>
                            <option value="60">60 Months</option>
                            <option value="72">72 Months</option>
                        </select>



                        <div class="range-wrap">
                            <div class="range-value" id="rangeV2"></div>
                            <input id="input-month1" type="range" class="loan-range" min="7" max="72" value="7">
                        </div>


                        <div class="Months" style="margin-bottom: -7px">
                            <div class="col-1" style="text-align: left; font-size:14px">7 Months</div>
                            <div></div>
                            <div class="col-2" style="text-align: right; font-size:14px">72 Months</div>
                        </div>

                        <label class="cal-amount">Monthly Repayment will be</label>

                        <input id="installment_calc1" class="loan-inpt-return" type="text" value="879.53" readonly>

                    </div>


                </div>
                <div class="modal_footer">
                    <button class="btn btn-primary" onclick="submitLoanAmount('amountModal')">Get Started</button>
                </div>
            </div>
        </div>
    </div>
    <div id="creditQuestionsModal" class="model_overlay hidden">

<div class="qqcontainer">


    @*<form id="frmCallMeBack">*@
        @Html.AntiForgeryToken()
        <input id="sessionId" type="hidden" value="@(Guid.NewGuid().ToString())" />
        <input id="processID" type="hidden" value="" />
        <div id="step2" class="step">
            <h1 class="color-brand-1 major-title1 mt-15 mb-20">Enter Your Details</h1>
            <p class="font-md color-brand-1 mb-20">Please enter your details below to get started.</p>
            <div id="globalError"></div>
            <div class="accordion active" onclick="toggleAccordion('personalDetailsAccordion')">

                Personal Details
                <i class="material-symbols-outlined check-icon" style="display: none;">check</i>
                <i class="material-icons">expand_less</i>
            </div>

            <div id="personalDetailsAccordion" class="accordion_content" style="display:block">

                <label for="fullname">Your Title and Fullnames</label>
                <div class="input-group">
                    <span class="input-group-addon" id="basic-addon1">
                        <select id="title">
                            <option>Title</option>
                            <option value="Mr">Mr</option>
                            <option value="Mrs">Mrs</option>
                            <option value="Ms">Ms</option>
                        </select>
                    </span>
                    <input type="text" id="fullname" name="fullname" placeholder="Enter your full name" class="rounded-right fullname-reset" class="form-control" aria-describedby="basic-addon1">

                </div>
                <span class="error-message" id="fullname-error"></span>
                <span class="error-message" id="title-error"></span>

                <label for="idnumber">Your ID Number</label>
                <div class="input-group">
                    <input type="text" id="idnumber" name="idnumber" placeholder="Enter your ID number" maxlength="13" min-length="8">
                </div>
                <span class="error-message" id="idnumber-error"></span>

                <label for="mobile">Your Cellphone Number</label>
                <div class="input-group">
                    <span class="input-group-addon" id="basic-addon1">+27</span>
                    <input type="tel" id="mobile" class="rounded-right mobile-reset" placeholder="Enter Mobile Number" maxlength="9" aria-describedby="basic-addon1">
                </div>
                <span class="error-message" id="mobile-error"></span>

                <label for="email">Your Email Address</label>
                <div class="input-group">
                    <input type="text" id="email-id" class="rounded-right mobile-reset" placeholder="Enter your email" aria-describedby="basic-addon1">
                </div>
                <span class="error-message" id="email-error"></span>

            </div>

            <div id="income_accordion" class="accordion" onclick="toggleAccordion('incomeExpenses')">
                Income &amp; Expenses
                <i class="material-symbols-outlined check-icon" style="display: none;">check</i>
                <i class="material-icons">expand_more</i>
            </div>
            <div id="incomeExpenses" class="accordion_content">


                <label for="salaryandfrequency">Your Gross Salary and frequency</label>
                <div class="input-group">
                    <span class="currency-prefix">R</span>
                    <input type="text" id="grosssalary" name="grosssalary" placeholder="0" oninput="formatCurrency(this)" class="rounded-right fullname-reset" class="form-control" aria-describedby="basic-addon1">
                    <span class="input-group-addon gross-addon" id="basic-addon2">
                        <select id="grosssalary-select" name="grosssalary" class="select-class-groccery">
                            <option value="M">Monthly</option>
                            <option value="F">Fortnightly</option>
                            <option value="W">Weekly</option>
                        </select>
                    </span>
                </div>
                <span class="error-message" id="grosssalary-error"></span>


                <label for="income">Your Net Income</label>
                <div class="input-group-R">
                    <span class="currency-prefix">R</span>
                    <input type="text" id="income" name="income" placeholder="0" oninput="formatCurrency(this)" class="rounded-right fullname-reset" class="form-control" aria-describedby="basic-addon1">
                </div>
                <span class="error-message" id="income-error"></span>

                <label for="expenses">Your Living Expenses</label>

                <div class="input-group-R">
                    <span class="currency-prefix">R</span>
                    <input type="text" id="expenses" name="expenses" placeholder="0" oninput="formatCurrency(this)" class="rounded-right fullname-reset" class="form-control" aria-describedby="basic-addon1" onfocus="openDialog('expensivemodal')">

                </div>
                <span class="error-message" id="expenses-error"></span>
            </div>

            <div id="address_accordion" class="accordion hidden" onclick="toggleAccordion('addressDetails')">
                Address
                <i class="material-symbols-outlined check-icon" style="display: none;">check</i>
                <i class="material-icons">expand_more</i>
            </div>
            <div id="addressDetails" class="accordion_content">
                <label for="address">Province</label>


                <div class="autocomplete">
                    <input type="text" id="province" placeholder="Start typing a province..." />
                    <div id="autocomplete-list" class="autocomplete-items"></div>
                    @* <span class="glyphicon glyphicon-menu-down"></span>*@
                </div>
                <span class="error-message" id="province-error"></span>

                <label for="address">Address</label>
                <div class="input-group">
                    <input type="text" id="address" name="address" placeholder="Enter your Address">
                </div>
                <span class="error-message" id="address-error"></span>

                <label for="postalcode">Postal Code</label>
                <div class="input-group">
                    <input type="text" id="postalcode" name="postalcode" placeholder="Enter your postal code">
                </div>
                <span class="error-message" id="postalcode-error"></span>
            </div>
            @*522025*@
            <div id="employment_accordion" class="accordion" onclick="toggleAccordion('employmentDetailsAccordion')">
                Employment Details
                <i class="material-symbols-outlined check-icon" style="display: none;">check</i>
                <i class="material-icons">expand_more</i>
            </div>
            <div id="employmentDetailsAccordion" class="accordion_content">

                <label for="selectyourbank">Select Your Bank</label>
                <div class="custom-select-wrapper">
                    <select id="yourbank" name="yourbank">
                    </select>
                    <span class="glyphicon glyphicon-menu-down"></span>
                </div>
                <span class="error-message" id="yourbank-error"></span>

                <label for="selectyouremployeeType">Select Your Employment Sector</label>
                <div class="custom-select-wrapper">
                    <select id="employeeType" name="employeeType">
                        <option value="RET">Other</option>
                        <option value="PER">Personal</option>
                    </select>
                    <span class="glyphicon glyphicon-menu-down"></span>
                </div>

                <span class="error-message" id="employeeType-error"></span>
                
                <label for="youremployer">Search Your Employer</label>
                <div class="search-controls">
                    <input type="text" id="youremployer" name="youremployer" placeholder="African Bank">
                    <span class="glyphicon glyphicon-search"></span>
                </div>
                <span class="error-message" id="youremployer-error"></span>


                <label for="occupationstatus">Select Your Employment Status</label>
                <div class="custom-select-wrapper">
                    <select id="occupationstatus" name="occupationstatus">
                        <option value="STE">State Pension / Grant</option>
                        <option value="SEL">Micro entrepreneur</option>
                        <option value="SEA">Seasonal Worker</option>
                        <option value="PRO">Professionals/ Entrepreneurs</option>
                        <option value="PEN">Pensioner</option>
                        <option value="FUL">Full time</option>
                        <option value="CON">Contract workers</option>
                        <option value="COM">Pure Commission Earners</option>
                    </select>
                    <span class="glyphicon glyphicon-menu-down"></span>
                </div>
                <span class="error-message" id="occupationstatus-error"></span>

                <label for="occupationtype">Select Your Occupation Type</label>
                <div class="custom-select-wrapper">
                    <select id="occupationtype" name="occupationtype">
                        <option value="">Select Occupation Type</option>
                        <option value="permanent">Permanent</option>
                        <option value="contract">Contract</option>
                    </select>
                    <span class="glyphicon glyphicon-menu-down"></span>
                </div>
                <span class="error-message" id="occupationtype-error"></span>

                <label for="employmentstartdate">Your Employment Start Date</label>
                <div class="form-group">
                    <div class="input-group">
                        <input type="text" id="datetimeInput" placeholder="Employee start Date">
                        <span class="input-group-addon" id="calendarIcon">
                            <span class="glyphicon glyphicon-calendar"></span>
                        </span>
                    </div>
                </div>
                <span class="error-message" id="datetimeInput-error"></span>
                <!--   <a href="#" class="verify-number" onclick="openDialog('otpModal')">Verify Number</a> -->
            </div>
            @*end522025*@
            <div class="buttons">
                <button class="btn btn-tertiary" onclick="nextStep(1)">Back</button>
                <button class="btn btn-primary" onclick="openCreditCheckModal()">Next</button>
            </div>
        </div>


   @* </form>*@



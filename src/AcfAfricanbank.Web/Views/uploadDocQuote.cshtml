    })
    function addFormValidation() {
    $('#form_fields').bootstrapValidator({
        feedbackIcons: {
            valid: 'glyphicon glyphicon-ok-sign',
            invalid: 'glyphicon glyphicon-remove-sign',
            validating: 'glyphicon glyphicon-refresh'
        },
        fields: {
            'FormFields.identityNumber': {
                validators: {
                    notEmpty: {
                        message: 'The ID / Passport Number is required and cannot be empty'
                    },
                    regexp: {
                        regexp: /^[0-9]{1,13}$/,
                        message: 'The ID number must be numeric and up to 13 digits'
                    },
                    stringLength: {
                        max: 13,
                        message: 'The ID number can only be 13 digits'
                    },
                    callback: {
                        callback: function (value, validator, $field) {
                            if (!value || value.length !== 13 || isNaN(value)) {
                                return {
                                    valid: false,
                                    message: 'Invalid ID number format'
                                };
                            }

                            // Age check logic
                            var yob = parseInt(value.substring(0, 2), 10);
                            var now = new Date();
                            var currentYear = now.getFullYear();
                            yob = yob + 2000 > currentYear ? yob + 1900 : yob + 2000;

                            var age = currentYear - yob;
                            if (age < 18 || age > 69) {
                                return {
                                    valid: false,
                                    message: 'Your age should be between 18 and 69'
                                };
                            }

                            return true;
                        }
                    }
                }
            },
            'FormFields.mobileNumber': {
                validators: {
                    notEmpty: {
                        message: 'Cell phone number is required'
                    },
                    regexp: {
                        regexp: /^[0-9]{10,12}$/,
                        message: 'Enter a valid phone number (10–12 digits)'
                    }
                }
            },
            'FormFields.firstName': {
                validators: {
                    notEmpty: {
                        message: 'Name is required'
                    },
                    stringLength: {
                        max: 30,
                        message: 'Name must be less than 30 characters'
                    }
                }
            },
            'FormFields.lastName': {
                validators: {
                    notEmpty: {
                        message: 'Surname is required'
                    },
                    stringLength: {
                        max: 30,
                        message: 'Surname must be less than 30 characters'
                    }
                }
            },
            'FormFields.email': {
                validators: {
                    notEmpty: {
                        message: 'Email is required'
                    },
                    emailAddress: {
                        message: 'Please enter a valid email address'
                    }
                }
            }
        }
    });
}
</script>

        <div id="personaloanoffers">
            <h1 id="loanOfferTitle" class="color-brand-1 mt-15 mb-20  text-center">Your Loan Offers</h1>
            <p class="font-md color-brand-1 mb-20 text-center">Please see your indicative offers from the below.</p>
            <!-- Filter Cards -->

@inherits Umbraco.Web.Mvc.UmbracoViewPage
@using AcfAfricanbank.Core.Models.Forms
@using ContentModels = Umbraco.Web.PublishedModels;
@using Web.Helpers;
@using System.Configuration;
@using CustomModels = Web.Models;

@{
	Layout = "Master.cshtml";
	
	var children = Model.Children;
	

    // Get specific Children
    var heroHeader = children?.Where(c => c.ContentType.Alias.ToLower() == "heroheader").FirstOrDefault();
    var heroShoulder = children?.Where(c => c.ContentType.Alias.ToLower() == "heroshoulder").FirstOrDefault();

    var heroChest = children?.Where(c => c.ContentType.Alias.ToLower() == "herochest").FirstOrDefault();

     var heroBody = children?.Where(c => c.ContentType.Alias.ToLower() == "herobody").FirstOrDefault();
     var bodyCards = heroBody.Children.Where(c => c.ContentType.Alias.ToLower() == "card").FirstOrDefault();
     var heroKnees = children?.Where(c => c.ContentType.Alias.ToLower() == "heroknees").FirstOrDefault();
     
      var faq = heroBody.Children.Where(c => c.Name == "FAQ").FirstOrDefault();
      var faqcontent = faq.Value<IEnumerable<IPublishedElement>>("tabBodyContent");
      var faqcontentqa = faqcontent.Where(c => c.ContentType.Alias == "nCTabGenericContent").FirstOrDefault().Value<IEnumerable<IPublishedElement>>("sectionContent");
      
      var saveCard = heroBody.Children.Where(c => c.Name == "Save with African").FirstOrDefault();
      var saveCardAfricanBank = saveCard.Value<IEnumerable<IPublishedElement>>("tabBodyContent");
      var saveCards = saveCardAfricanBank.Where(c => c.ContentType.Alias == "nCTabGenericContent").FirstOrDefault().Value<IEnumerable<IPublishedElement>>("sectionContent");
      
      
      var noticeCard = heroBody.Children.Where(c => c.Name == "Discovering Notice").FirstOrDefault();
      var noticedCard = noticeCard.Value<IEnumerable<IPublishedElement>>("tabBodyContent");
      var noticedCards = noticedCard.Where(c => c.ContentType.Alias == "nCTabGenericContent").FirstOrDefault().Value<IEnumerable<IPublishedElement>>("sectionContent");
      
  
      var noCampx1 = 1;
    

     
         var kneesTabHeaders = heroKnees?.Children?.Select(c => c.Value("title")?.ToString()).ToList();
    var findOutMoreTab = heroKnees?.Children?
        .Where(c => c.ContentType.Alias.ToLower() == "findoutmore").FirstOrDefault();
    var creditLifeInsuranceTab = heroKnees?.Children?
        .Where(c => c.ContentType.Alias.ToLower() == "creditlifeinsurance").FirstOrDefault();
    var creditLifeInsuranceTab_Credit = heroKnees?.Children?
    .Where(c => c.ContentType.Alias.ToLower() == "creditlifeinsurancecredit").FirstOrDefault();
}


<link rel="stylesheet" href="/css/projectmagic.css" />

@* the fun starts here *@


<!--section 1-->

        
@foreach (var item in saveCards.Select((value, index) => new { Value = value, Index = index }))
{
    var cardIcon = item.Value.Value<IPublishedContent>("nCcardIcon")?.Url;
    var title = item.Value.Value<string>("nCcardTitle");
    var description = item.Value.Value<string>("mediumDescription");
    
    <section class="@(item.Index % 2 == 0 ? "section-800 bg-grey-60" : "section-800")">
        <div class="container">
            <div class="row d-flex align-items-center row-change">
                @if (item.Index % 2 == 0)
                {
                    <div class="col-xl-6 col-lg-6 col-md-6">
                        <img class="d-block" src="@cardIcon" alt="iori" />
                    </div>
                }
                
                <div class="col-xl-6 col-lg-6 col-md-6">
                    <h1 class="color-brand-1 mt-15 mb-20">@title</h1>
                    <p class="font-md color-brand-1">@Html.Raw(description)</p>
                </div>
                
                @if (item.Index % 2 != 0 || item.Index == saveCards.Count() - 1)
                {
                    <div class="col-xl-6 col-lg-6 col-md-6">
                        <img class="d-block" src="@cardIcon" alt="iori" />
                    </div>
                }
            </div>
        </div>
    </section>
}

        
        
        
        


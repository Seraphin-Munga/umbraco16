let currentIndex = 0;

function renderTimeline() {
  const container = document.getElementById('timeline-bar');
  container.innerHTML = '';

  years.forEach((year, index) => {
    const wrapper = document.createElement('div');
    wrapper.className = 'timeline-item';
    wrapper.onclick = () => setActive(index);

    const isActive = index === currentIndex;

    if (isActive) {
      const img = document.createElement('img');
      img.src = images[index];
      img.className = 'thumbnail-img';
      wrapper.appendChild(img);
    } else {
      const dot = document.createElement('div');
      dot.className = 'dot' + (index < currentIndex ? ' active' : '');
      wrapper.appendChild(dot);

      const label = document.createElement('div');
      label.className = 'year-label';
      label.textContent = year;
      wrapper.appendChild(label);
    }

    container.appendChild(wrapper);

    if (index < years.length - 1) {
      const seg = document.createElement('div');
      seg.className = 'segment' + (index < currentIndex ? ' active' : '');
      container.appendChild(seg);
    }
  });

  const nextWrapper = document.createElement('div');
  nextWrapper.className = 'next-wrapper';
  const nextBtn = document.createElement('button');
  nextBtn.className = 'cta-button';
  nextBtn.textContent = '➤';
  nextBtn.onclick = () => goNext();
  nextWrapper.appendChild(nextBtn);
  container.appendChild(nextWrapper);
}

function setActive(index) {
  currentIndex = index;
  const data = content[index];
  document.getElementById("main-heading").innerHTML = data.heading;
  document.getElementById("sub-heading").textContent = data.subheading;
  document.getElementById("image-display").innerHTML =
    '<img src="' + images[currentIndex] + '" alt="Slide" />';
  renderTimeline();
}

function goNext() {
  currentIndex = (currentIndex + 1) % years.length;
  setActive(currentIndex);
}

setActive(0);
</script>            

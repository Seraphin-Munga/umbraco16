                                </div>
                                @*<div class="download-icon faq-button"><i class="fas fa-long-arrow-alt-down" aria-hidden="true"></i></div>*@
                            </div>
                            
                            <div class="row">
                              <div class="col-lg-12 col-md-12" style="/* width: 100%; */text-align: center;padding: 20px;">
                                <img width="80%" src="@cardUrl" />
                            </div>
                            
                        <div class="col-md-12" >

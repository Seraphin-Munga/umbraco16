                               <span>Download PDF</span>
                             </a>
                            </div>
                            
                            </div>
                         
                        } 
                        else
                        {
                            <div class="faq-item">
                                <div class="item-content">
                                   
                                    <h4 class="title text-uppercase">
                                      <img src="/media/455muwk3/component-13-1.svg"/>
                                        @Q
                                    </h4>
                                    <div class="faq content">
                                        @A
                                    </div>
                                </div>
                            </div>
                         }
                        intCounter+=1;
                    }
                    
                }
            }
        @* End here *@
          
         
     </div>
    </div>
    </div>
 

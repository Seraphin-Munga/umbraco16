    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transition: transform 0.2s;
  }

  .step-card:hover {
    transform: translateY(-4px);
  }

  .step-icon {
    width: 50px;
    height: 50px;
    margin-bottom: 12px;
  }

  .step-number {
    color: #26bf41;
    font-weight: 600;
    margin-bottom: 8px;
  }

  .step-title {
    font-weight: 700;
    font-size: 16px;
    margin-bottom: 6px;
    color: #002B60;
  }

  .step-desc {
    font-size: 14px;
    color: #002B60;
    line-height: 1.5;
  }

  /* Desktop view */
  @@media screen and (min-width: 600px) {
    .steps-container {
      flex-direction: row;
      justify-content: center;
    }

    .step-card {
      width: 30%;
    }
  }
</style>


<!--styles for cards section with image on top start here-->

<style>
:root{
  --cardCustomListitem-width:320px;
  --cardCustomListitem-bg:#ffffff;
  --cardCustomListitem-shadow: 0 6px 18px rgba(11,31,54,0.08);
  --primary:#063e6b;
  --muted:#8aa3bf;
  --dot-inactive:#dfe9ef;
  --dot-active:#26bf41;
  font-family: "Montserrat", Arial, sans-serif;
}

/* carousel wrapper */
.cardCustomListitems-wrapper{ max-width:100%; margin:0 auto; position:relative; }

.cardCustomListitems-viewport{
  padding-top:10px;
  width:100%;
  overflow-x: auto;             /* allow horizontal scroll */
  scroll-snap-type: x mandatory;/* snap to cards */
  -webkit-overflow-scrolling: touch; /* smooth scroll on iOS */
  padding-bottom: 8px;
}

.cardCustomListitems-track {
  display: flex;
  gap: 12px;
  justify-content: center;
}

.cardCustomListitem{
  flex: 0 0 auto;               /* necessary for horizontal scroll */
  scroll-snap-align: start;
  min-width: var(--cardCustomListitem-width);
  max-width: var(--cardCustomListitem-width);
  background:var(--cardCustomListitem-bg);
  border-radius:10px;
  box-shadow:var(--cardCustomListitem-shadow);
  overflow:hidden;
  color:var(--primary);
  display:flex;
  flex-direction:column;
  text-decoration:none;
}

.cardCustomListitem-image{
  width:100%;
  height:160px;
  background:#eef3f8;
  display:block;
  overflow:hidden;
}
.cardCustomListitem-image img{ width:100%; height:100%; object-fit:cover; display:block; }

.cardCustomListitem-body{ padding:16px; display:flex; flex-direction:column; gap:12px; flex:1 1 auto; }
.cardCustomListitem-title{ font-size:18px; font-weight:700; margin:0; color:#072948;text-align: left; }
.cardCustomListitem-excerpt{ font-size:14px; color:#4b6b86; line-height:1.45; min-height:70px; }
.cardCustomListitem-meta{ display:flex; flex-direction: column; gap:12px;  }


.read-time{ font-size:12px; color:var(--muted); }

.btn-learn{
  display:inline-block;
  padding:8px 14px;
  border-radius:6px;
  border:1px solid var(--primary);
  background: #fff;
  color:var(--primary);
  font-weight:600;
  text-decoration:none;
  font-size:13px;
  width: 112px;
}
.btn-learn:focus, .btn-learn:hover{ background:var(--primary); color:#fff; outline:none; box-shadow:0 6px 12px rgba(6,62,107,0.18); }

/* dots */
.cardCustomListitems-dots{ display:none; justify-content:center; gap:0px; padding-top:12px; padding-top: 10px; padding-bottom: 10px; margin-top:10px;}
.cardCustomListitems-dots button{
  width:10px; height:10px; border-radius:50%; border:0; background:var(--dot-inactive); padding:0; cursor:pointer;
}
.cardCustomListitems-dots button[aria-pressed="true"]{ background:var(--dot-active); box-shadow:0 2px 6px rgba(38,191,65,0.25); }

/* responsive */
@@media (max-width:420px){
  :root{ --cardCustomListitem-width:92%; }
  .cardCustomListitems-track{ gap:12px; }
  .cardCustomListitems-dots{ display:flex; gap:10px;}
  .cardCustomListitems-track { justify-content: flex-start; }

/* focus ring for accessibility */
.cardCustomListitem:focus-within{ outline: 3px solid #ffbf47; border-radius:10px; }

/* hide scrollbar on webkit */
.cardCustomListitems-viewport::-webkit-scrollbar { display: none; }
</style>


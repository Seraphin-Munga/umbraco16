<style>

/*Contact us styles start here*/
.floating-btn {
    position: fixed;
    top: 40%;
    right: -54px;
    transform: translateY(-50%) rotate(-90deg);
    z-index: 999;
    width: 148px;
    height: 38px;
    display: flex;
    justify-content: center;
    align-items: center;
    text-decoration: none;
    cursor: pointer;
    padding: 12px 16px;
    color: var(--text-primary-blue, #002B60);
    font-family: Montserrat;
    font-size: 14px;
    font-style: normal;
    font-weight: 600;
    line-height: 20px;
    border-radius: var(--border-radius-md, 2px) var(--border-radius-md, 2px) var(--border-radius-none, 0px) var(--border-radius-none, 0px);
    border-top: 1px solid var(--border-primary, #002B60);
    border-right: 1px solid var(--border-primary, #002B60);
    border-left: 1px solid var(--border-primary, #002B60);
    background: var(--surface-primary, #FFF);
    box-shadow: 0px 6px 12px 0px rgba(0, 0, 0, 0.11);
    transition: background-color 0.3s ease, transform 0.3s ease;
}
.floating-btn:focus {
    outline: 3px solid #ffbf47;
    background-color: #0056b3;
}

/*Contact us styles end here*/


/*Back button styes section start here*/

.back-section button {
    height:112px;
    background: none !important;
    border: none !important;
}


@@media only screen and (max-width: 600px) {
    .back-section button {
        margin-bottom: 3vh;
        margin-top: 3vh;
        height:0px;
    }
}



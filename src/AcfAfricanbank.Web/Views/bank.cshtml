/*Cards Css start here*/
        .business-section {
            padding: 50px 0;
            text-align: center;
        }
        .business-section h2 {
            color: #002F6C;
            font-weight: bold;
        }
        .business-section p {
            color: #4F5B66;
            max-width: 800px;
            margin: 0 auto;
        }
        .account-card {
          
            padding: 20px;
            text-align: left;
            min-height: 250px;
            border-radius: 8px;
            background: var(--Base-White, #FDFDFD);
            
            /* Shadows Light Mode/MD */
            box-shadow: 0px 9px 18px 0px rgba(0, 0, 0, 0.15);
        }
        .card-divider {
            width: 100%;
            height: 1px;
            background-color: #6FCF97;
            margin: 10px 0;
        }
        .btn-learn {
           
           display: flex;
            width: 200px;
            height: 48px;
            padding: 12px 16px;
            justify-content: center;
            align-items: center;
            gap: 8px;
            flex-shrink: 0;
            color: #002B60;
            padding: 10px 20px;
          
            transition: 0.3s;
          
            
            border-radius: var(--border-radius-md, 2px);
            border: 1px solid #002B60;
            background: var(--surface-primary, #FFF);
            
            /* Shadows Light Mode/SM */
            box-shadow: 0px 6px 12px 0px rgba(0, 0, 0, 0.11);

            /* Body/Small/Semibold */
            font-family: Montserrat;
            font-size: 14px;
            font-style: normal;
            font-weight: 600;
            line-height: 20px; /* 142.857% */
        }
        .btn-learn:hover {
            background-color: #002B60;
            color: #fff;
        }
        .btn-apply, .btn-download {
            margin-left: -50px !important;
            display: flex;
            width: 200px;
            height: 48px;
            padding: 12px 16px;
            justify-content: center;
            align-items: center;
            gap: 8px;
            flex-shrink: 0;
            
            
            color: var(--text-primary, #FFF);

            /* Body/Small/Semibold */
            font-family: Montserrat;
            font-size: 14px;
            font-style: normal;
            font-weight: 600;
            line-height: 20px; /* 142.857% */
            border: none;
            padding: 10px 20px;
            border-radius: 2px !important;
         
            font-weight: bold;
            
            border-radius: var(--border-radius-md, 2px);
            background: var(--surface-action, #5DC400);
            
            /* Shadows Light Mode/SM */
            box-shadow: 0px 6px 12px 0px rgba(0, 0, 0, 0.11);
        }
        .btn-apply:hover, .btn-download:hover {
            background-color: #5DC400 !important;
            color:white;
        }
        .card-image {
            position: absolute;
            top: -15px;
            right: 10px;
            width: 80px;
        }
        .get-in-touch {
            position: fixed;
            right: 0;
            top: 50%;
            background: #002F6C;
            color: white;
            padding: 10px;
            writing-mode: vertical-rl;
            text-orientation: mixed;
            border-radius: 8px 0 0 8px;
            cursor: pointer;
        }
        .cards-position{
            top: 50px;
            position: relative;
            margin: 55px 0px;  
        }
        .font-size-24-weight-600 {
         
            color: var(--Brand-AB-Blue, #012B60);
            
            /* Heading/H4/Semibold */
            font-family: Montserrat;
            font-size: 24px;
            font-style: normal;
            font-weight: 600;
            line-height: 32px; /* 133.333% */
        }
        .mtb-40 {
            margin: 40px 0px !important;
        }
        .why-bank-with-us {
            color: var(--Brand-AB-Blue, #012B60);
            /* Heading/H3/Semibold */
            font-family: Montserrat;
            font-size: 30px;
            font-style: normal;
            font-weight: 600;
            line-height: 38px; /* 126.667% */
            margin-top:30px;
            margin-bottom:16px;
        }
        .monthly-fee-p{
            color: var(--Brand-AB-Blue, #012B60);
            /* Body/Medium/Semibold */
            font-family: Montserrat;
            font-size: 16px;
            font-style: normal;
            font-weight: 600;
            line-height: 24px; /* 150% */
        }
        .rates-p{
            color: var(--Brand-AB-Blue, #012B60);
            /* Body/Small/Regular */
            font-family: Montserrat;
            font-size: 14px;
            font-style: normal;
            font-weight: 400;
            line-height: 20px; /* 142.857% */  
        }
/*Cards Css end here*/

@@media (max-width: 768px) {
  /* General mobile adjustments */
  .bank-with-us {
    font-size: 36px !important;
    line-height: 45px !important;
  }
  
  .mr-125{
    margin-right: 125px;
  }
  
  .pr-24{
    position: relative;
    right: 24px;
}
  
   .btn-apply, .btn-download {
    margin-left: 0px !important;
  }
  .plr-30{
    padding-left: 30px;
    padding-right: 30px;
  }
  
  .plr-45{
    padding-left: 45px;
    padding-right: 45px;
  }
  .pr-15{
      padding-right: 15px;
    }
  .bg-nothing-white {
    height: 50px;
  }

  .text-style {
    font-size: 12px !important;
    line-height: 24px !important;
  }

  .why-bank-with-us {
    font-size: 24px !important;
    line-height: 32px !important;
  }

  .sub-text-style {
    font-size: 12px !important;
    line-height: 24px !important;
  }

  /* Card container adjustments */
  .two-cards {
    height: auto !important;
    top: 0 !important;
    padding: 20px 0;
  }

  /* Individual card adjustments */
  .account-card {
    margin-bottom: 30px;
    min-height: auto;
    padding: 15px;
  }

  /* Card content adjustments */
  .font-size-24-weight-600 {
    font-size: 12px !important;
    line-height: 15px !important;
  }

  .account-card-p {
    font-size: 12px !important;
    line-height: 20px !important;
    margin: 20px 0 !important;
  }

  /* Button container adjustments */
  .row > .col-4,
  .row > .col-1 {
    width: 100% !important;
    flex: 0 0 100%;
    max-width: 100%;
  }

  .btn-learn,
  .btn-apply,
  .btn-download {
    width: 123% !important;
    margin-bottom: 10px;
    height: 40px !important;
    font-size: 12px !important;
  }
  
  .btn-apply, .btn-download

  /* Image adjustments */
  .image-section {
    margin-bottom: 0 !important;
  }

  .image-position {
    width: 100% !important;
    max-width: 280px;
    height: auto !important;
    margin: 0 auto !important;
    display: block;
  }

  /* Card icon adjustments */
  .account-card img {
    height: 40px !important;
    width: auto !important;
    margin-top: -10px;
    margin-left: -18px;
  }

  /* Section spacing adjustments */
  #section-1,
  #section-2,
  #section-3 {
    padding: 40px 0 !important;
    height: 100%;
  }
  

  .content-center,
  .content-center-2 {
  
    padding: 20px 0;
  }

  /* Alignment fixes */
  .content-sub-start-2,
  .content-center {
    text-align: start;
  }

  /* Remove negative margins */
  .image-section {
    margin-bottom: 0 !important;
  }

  /* Card divider adjustment */
  .card-divider {
    margin: 15px 0;
  }

  /* Pricing section adjustments */
  .mtb-40 {
    margin: 20px 0 !important;
  }

  .monthly-fee-p {
    font-size: 14px !important;
  }

  .rates-p {
    font-size: 12px !important;
  }
}


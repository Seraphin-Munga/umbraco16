@{
         	Layout = "Master.cshtml";
    	 var Children = Model.Children;
    	 var heroBody = Children?.Where(c => c.ContentType.Alias.ToLower() == "herobody").FirstOrDefault();
    	 var sectioncard = heroBody.Children.Where(c => c.Name == "Tab Body").FirstOrDefault();
         var sectioncardAfricanBank = sectioncard.Value<IEnumerable<IPublishedElement>>("tabBodyContent");
         var sectioncards = sectioncardAfricanBank.Where(c => c.ContentType.Alias == "nCTabGenericContent").FirstOrDefault().Value<IEnumerable<IPublishedElement>>("sectionContent");
         
         var tabcards = heroBody.Children.Where(c => c.Name == "Cards").FirstOrDefault();
         var tabcardsAfricanBank = tabcards.Value<IEnumerable<IPublishedElement>>("tabBodyContent");
         var cards = tabcardsAfricanBank.Where(c => c.ContentType.Alias == "nCTabGenericContent").FirstOrDefault().Value<IEnumerable<IPublishedElement>>("sectionContent");
    
         ContentModels.TabBody createOwnWorldOfBanking = null;
         var partialName = tabcards.Value("PartialViewName");
         createOwnWorldOfBanking = (TabBody)tabcards;
         
         var lastcard = heroBody.Children.Where(c => c.Name == "Last section").FirstOrDefault();
         var lastcardAfricanBank = lastcard.Value<IEnumerable<IPublishedElement>>("tabBodyContent");
         var lastcards = lastcardAfricanBank.Where(c => c.ContentType.Alias == "nCTabGenericContent").FirstOrDefault().Value<IEnumerable<IPublishedElement>>("sectionContent");
         
         
         var firstcard = heroBody.Children.Where(c => c.Name == "First section").FirstOrDefault();
         var firstcardAfricanBank = firstcard.Value<IEnumerable<IPublishedElement>>("tabBodyContent");
         var firstcards = firstcardAfricanBank.Where(c => c.ContentType.Alias == "nCTabGenericContent").FirstOrDefault().Value<IEnumerable<IPublishedElement>>("sectionContent");
      
}


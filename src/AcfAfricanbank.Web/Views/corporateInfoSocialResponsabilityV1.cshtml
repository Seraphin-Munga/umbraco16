@inherits Umbraco.Web.Mvc.UmbracoViewPage<ContentModels.PageCorporateInformation>
@using ContentModels = Umbraco.Web.PublishedModels;
@{
    Layout = "Master.cshtml";
    // All Current Page Children
    var Children = Model.Children;
    // Get specific Children
   
    var heroBody = Children?.Where(c => c.ContentType.Alias.ToLower() == "herobody").FirstOrDefault();
     var contentcard= heroBody.Children.Where(c => c.Name == "Content").FirstOrDefault();
     var contenttabcard = contentcard.Value<IEnumerable<IPublishedElement>>("tabBodyContent");
      var contentcards = contenttabcard.Where(c => c.ContentType.Alias == "nCTabGenericContent").FirstOrDefault().Value<IEnumerable<IPublishedElement>>("sectionContent");
}
 <link rel="stylesheet" href="/css/projectmagic.css" /> 
 
  @{
       int idIterator = 0;
       foreach (var item in contentcards){
            var tabSubItemImage = item.Value<IPublishedContent>("tabSubItemImage")?.Url;
            var tabSubItemIcon = item.Value<IPublishedContent>("tabSubItemIcon")?.Url;
             var title = item.Value<string>("tabSubItemTitle");
            
            
            if (idIterator%2 == 0)
                {
                    <section class="pb-40 pt-40 bg-grey-60">
                        <div class="container">
                          <div class="row align-items-center d-flex row-change md-text-center">
                            <div class="col-xl-6 col-lg-6 col-md-6">
                               <h1 class="color-brand-1 mt-15 mb-20">
                                @title
                                </h1>
                               @item.Value("tabSubItemTextContent")
                              
                            </div>
                            <div class="col-xl-6 col-lg-6 col-md-6">
                              <img
                                class="d-block"
                                src="@tabSubItemImage"
                                alt="iori"
                                
                              /> 
                               
                            </div>
                          </div>
                        </div>
                    </section>
            
            }
                
            else{
                    <section class="pb-40 pt-40">
                        <div class="container">
                          <div class="row align-items-center row-change d-flex flex-row-reverse md-text-center">
                          
                            <div class="col-xl-6 col-lg-6 col-md-6">
                               <h1 class="color-brand-1 mt-15 mb-20">
                                @title
                              </h1>
        
                              
                              <p class="font-md color-brand-1 mt-20">
                                 @item.Value("tabSubItemTextContent")
                              </p>
                            </div>
                            <div class="col-xl-6 col-lg-6 col-md-6">
                              <img
                                class="d-block"
                                src="@tabSubItemImage"
                                alt="iori"
                                
                              /> 
                               
                            </div>
                            
                          </div>
                        </div>
                    </section>
                }
                
                idIterator += 1;
        }
   }
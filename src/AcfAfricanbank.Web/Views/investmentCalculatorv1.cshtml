   <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>


    <!-- Flatpickr JS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>


    <script>
    
    document.addEventListener("DOMContentLoaded", function () {
    const coverSelect = document.getElementById("coverAmount");
    const funeralTypeSelect = document.getElementById("funeralType");
    const dobInput = document.getElementById("personal-dob");
    const memberType = "main_member";
 
    let flatpickrInstance;
 
    initializeFlatpickrOnExistingInputs();
    wipeSession();
 
    // initially disable all buttons
    document.querySelectorAll(".family-button").forEach((btn) => {
      btn.classList.add("disabled");
      btn.style.pointerEvents = "none";
      btn.style.opacity = "0.5";
    });
 
    function getCoverOptions(coverType, memberType, age) {
        const rules = coverRules[coverType]?.[memberType];
        if (!rules) return [];
        for (const rule of rules) {
            if (age >= rule.minAge && age <= rule.maxAge) {
                return rule.options;
            }
        }
        return [];
    }
 
    function validateFamilyButtons() {
      const dob = $('#personal-dob').val();
      const gender = $('#personal-gender').val();
      const coverAmount = $('#coverAmount').val();
 
      const allValid = dob && gender && coverAmount;
 
      document.querySelectorAll(".family-button").forEach((btn) => {
          if (!allValid) {
              btn.classList.add("disabled");
              btn.style.pointerEvents = "none";
              btn.style.opacity = "0.5";
          } else {
              btn.classList.remove("disabled");
              btn.style.pointerEvents = "";
              btn.style.opacity = "";
          }
      });
    }
 
    $('#personal-dob').on('input change', validateAndApplyButtonState);

    $('#coverAmount').on('change', validateAndApplyButtonState);
    $('#personal-gender').on('change', function () {
      $('#personal-gender').removeClass('input-error');
      validateAndApplyButtonState();
    });
 
 
    function calculateAge(dob) {
        const birthDate = new Date(dob);
        const today = new Date();
        let age = today.getFullYear() - birthDate.getFullYear();
        const m = today.getMonth() - birthDate.getMonth();
        if (m < 0 || (m === 0 && today.getDate() < birthDate.getDate())) {
            age--;
        }
        return age;
    }
 
    function updateCoverOptions() {
        const dob = dobInput.value;
        if (!dob) return;
 
        const age = calculateAge(dob);
        const coverType = funeralTypeSelect.value;
        const options = getCoverOptions(coverType, memberType, age);
 
        if (options.length === 0) {
            $('#main-member-errors').show();
            $('#dob-error').text(`Main member must be between 18 and 75 years old for ${coverType} funeral cover.`);
            $('#personal-dob-input').addClass('input-error');
            coverSelect.disabled = true;
        } else {
            $('#main-member-errors').hide();
            $('#personal-dob-input').removeClass('input-error');
            coverSelect.innerHTML = options
                .map(val => `<option value="${val}">R${val.toLocaleString()}</option>`)
                .join('');
            coverSelect.disabled = false;
        }
 
        validateAndApplyButtonState();
    }
 
 
    flatpickrInstance = flatpickr(dobInput, {
        dateFormat: "Y-m-d",
        disableMobile: true,
        appendTo: document.body,
        onChange: updateCoverOptions,
    });
 
    const icon = document.querySelector("#personal-dob-input .dob-icon");
    if (icon) {
        icon.addEventListener("click", () => dobInput.focus());
    }
 
    dobInput.addEventListener("change", updateCoverOptions);
    funeralTypeSelect.addEventListener("change", () => {
        updateCoverOptions();
    });
 
});
 
    
    const labelToKeyMap = {
        "Spouse": "spouse",
        "Child": "child",
        "Parent": "parent",
        "Extended Family": "extended_family"
    };

    let savedMembers = []

    const memberLimits = {
        ab_enhanced_funeral: { spouse: 3, child: 8, parent: 4, extended_family: 8 },
        ab_staff_funeral: { spouse: 3, child: 8, parent: 4, extended_family: 8 },
        ab_foreigner_funeral: { spouse: 1, child: 8, parent: 0, extended_family: 0 }
    };

    const memberCounts = {
        spouse: 0,
        child: 0,
        parent: 0,
        extended_family: 0
    };

    const coverRules = {
        ab_enhanced_funeral: {
            main_member: [
                {
                    minAge: 18,
                    maxAge: 75,
                    options: [
                        5000, 10000, 15000, 20000,25000,30000, 50000, 100000
                    ]
                }
            ],
            spouse: [
                { 
                    minAge: 18, maxAge: 75, options: [5000, 10000, 15000, 20000,25000,30000, 50000, 100000] 
                }
            ],
            child: [
                { minAge: 0, maxAge: 5, options: [5000, 10000, 15000, 20000] },
                { minAge: 6, maxAge: 14, options: [5000, 10000, 15000, 20000] },
                { minAge: 15, maxAge: 25, options: [5000, 10000, 15000, 20000, 25000, 30000, 50000] }
            ],
            parent: [
                { 
                    minAge: 18, maxAge: 85, options: [5000, 10000, 15000, 20000,25000,30000, 50000] 
                }
            ],
            extended_family: [
                { minAge: 0, maxAge: 6, options: [5000, 10000, 15000, 20000] },
                { minAge: 7, maxAge: 18, options: [5000, 10000, 15000, 20000] },
                { minAge: 19, maxAge: 75, options: [5000, 10000, 15000, 20000, 25000, 30000, 50000] }
            ]
        },
        ab_staff_funeral: {
            main_member: [
                {
                    minAge: 18,
                    maxAge: 65,
                    options: [
                        5000, 10000, 15000, 20000,25000,30000, 50000, 100000
                    ]
                }
            ],
            spouse: [
                { 
                    minAge: 18, maxAge: 65, options: [5000, 10000, 15000, 20000,25000,30000, 50000, 100000] 
                }
            ],
            child: [
                { minAge: 0, maxAge: 5, options: [5000, 10000, 15000, 20000] },
                { minAge: 6, maxAge: 14, options: [5000, 10000, 15000, 20000] },
                { minAge: 15, maxAge: 25, options: [5000, 10000, 15000, 20000, 25000, 30000, 50000] }
            ],
            parent: [
                { 
                    minAge: 18, maxAge: 85, options: [5000, 10000, 15000, 20000,25000,30000, 50000] 
                }
            ],
            extended_family: [
                { minAge: 0, maxAge: 6, options: [5000, 10000, 15000, 20000] },
                { minAge: 7, maxAge: 18, options: [5000, 10000, 15000, 20000] },
                { minAge: 19, maxAge: 75, options: [5000, 10000, 15000, 20000, 25000, 30000, 50000] }
            ]
        },
        ab_foreigner_funeral: {
            main_member: [
                {
                    minAge: 18,
                    maxAge: 65,
                    options: [
                        5000, 10000, 15000, 20000,25000,30000, 50000, 100000
                    ]
                }
            ],
            spouse: [
                { 
                    minAge: 18, maxAge: 65, options: [5000, 10000, 15000, 20000,25000,30000, 50000, 100000] 
                }
            ],
            child: [
                { minAge: 0, maxAge: 5, options: [5000, 10000] },
                { minAge: 6, maxAge: 14, options: [5000, 10000, 15000, 20000, 25000, 30000] },
                { minAge: 15, maxAge: 25, options: [5000, 10000, 15000, 20000, 25000, 30000, 50000] }
            ],
            }
    };

    function calculateAge(dob) {
        const birthDate = new Date(dob);
        const today = new Date();
        let age = today.getFullYear() - birthDate.getFullYear();
        const m = today.getMonth() - birthDate.getMonth();
        if (m < 0 || (m === 0 && today.getDate() < birthDate.getDate())) {
            age--;
        }
        return age;
    }

    function getCoverOptions(coverType, memberType, age) {
        const rules = coverRules[coverType]?.[memberType] || [];
        for (const rule of rules) {
            if (age >= rule.minAge && age <= rule.maxAge) {
            return rule.options;
            }
        }
        return [];
    }

    function openDialog(modalId, type = "") {
    const modal = document.getElementById(modalId);
    if (!modal) return;
 
    modal.classList.remove("hidden");
 
    const headingEl = modal.querySelector(".modal_header .heading h2");
    if (headingEl) {
        headingEl.textContent = `${type} Details`;
    }
 
    const parsedLabel = headingEl?.textContent?.replace(" Details", "").trim();
    const normalizedType = labelToKeyMap[parsedLabel];
 
    updateMemberCountDisplay(normalizedType);
 
    const container = modal.querySelector("#extendedFamilyContainer");
    if (container) {
        container.innerHTML = "";
 
        const savedMembers = getMembersFromSession(normalizedType);
        memberCounts[normalizedType] = savedMembers.length;
        
        
 
        updateMemberCountDisplay(normalizedType);
 
        if (savedMembers.length > 0) {
            savedMembers.forEach(member => {
                const wrapper = document.createElement("div");
                wrapper.classList.add("extended-family-wrapper");
 
                const age = member.dateOfBirth ? calculateAge(member.dateOfBirth) : null;
                const funeralType = document.getElementById("funeralType")?.value || "ab_enhanced_funeral"; // default fallback
                const options = age !== null
                    ? getCoverOptions(funeralType, normalizedType, age)
                    : [];
 
                const coverOptionsHtml = options.length > 0
                    ? options.map(val => `<option value="${val}" ${member.coverAmount == val ? "selected" : ""}>R${val.toLocaleString()}</option>`).join('')
                    : `<option disabled>No cover options</option>`;
 
                const row = document.createElement("div");
                row.classList.add("extended-family-row");
                row.innerHTML = `
                    <select class="form-select">
                        <option value="" disabled hidden ${!member.gender ? "selected" : ""}>Gender</option>
                        <option value="male" ${member.gender === "male" ? "selected" : ""}>Male</option>
                        <option value="female" ${member.gender === "female" ? "selected" : ""}>Female</option>
                    </select>
                    <input type="text" class="dob-input" value="${member.dateOfBirth || ""}" placeholder="Date of birth" />
                    <span class="dob-icon glyphicon glyphicon-calendar" style="right: 33px; cursor: pointer;"></span>
                    <select class="form-select cover-amount-select">
                        ${coverOptionsHtml}
                    </select>
                `;
 
                const removeContainer = document.createElement("div");
                removeContainer.classList.add("remove-button-container");
                removeContainer.innerHTML = `
                  <button type="button" onclick="removeExtendedFamilyRow(this.closest('.extended-family-wrapper'), '${normalizedType}')" class="remove-button">
                    <span class="remove-text">Remove</span>
                  </button>
                  <i class="material-icons remove-icon" onclick="removeExtendedFamilyRow(this.closest('.extended-family-wrapper'), '${normalizedType}')">delete</i>
                `;
 
                wrapper.appendChild(row);
                wrapper.appendChild(removeContainer);
                container.appendChild(wrapper);
 
                flatpickr(row.querySelector('.dob-input'), {
                  dateFormat: "Y-m-d",
                  disableMobile: true,
                  appendTo: document.body,
                  onChange: () => saveMembersToSession(normalizedType)
                });
       
              const dobInput = row.querySelector('.dob-input');
 
                      const calendarIcon = row.querySelector('.dob-icon');
 
 
 
                      setupDOBPicker(dobInput, calendarIcon, normalizedType);
                     
                      row.querySelector("select").addEventListener("change", () => {
                        saveMembersToSession(normalizedType);
                      });
            });
        }else {
                // Add one default member row if none exist
                addMemberRow(normalizedType);
            }
    }
}

    function setupDOBPicker(inputEl, iconEl, type = null) {
        const coverSelect = inputEl.closest('.extended-family-row').querySelector('.cover-amount-select');
        const memberError = inputEl.closest('.extended-family-row').querySelector('.member-error');

      // ✅ Check if DOB already selected and cover options already exist

        const hasDOB = inputEl.value?.trim() !== "";

        const hasCoverOptions = [...coverSelect.options].length > 1; // Excludes just the default placeholder

        // ✅ Enable or disable based on initial state

        coverSelect.disabled = !(hasDOB && hasCoverOptions);

        const fp = flatpickr(inputEl, {
            dateFormat: "Y-m-d",
            disableMobile: true,
            appendTo: document.body,
            onChange: (selectedDates, dateStr) => {
            inputEl.value = dateStr;
            updateCoverOptions();
            if (type) saveMembersToSession(type);
            }
        });

        iconEl.addEventListener("click", () => {
            fp.open();
        });

        function updateCoverOptions() {
            const dob = inputEl.value;
            if (!dob) return;

            const age = calculateAge(dob);
            const coverType = document.getElementById("funeralType").value;
            const memberType = type;

            const options = getCoverOptions(coverType, memberType, age);

            if (options.length === 0) {
                coverSelect.disabled = true;

            } else {
               // memberError.remove();
                coverSelect.innerHTML = options
                    .map(val => `<option value="${val}">R${val.toLocaleString()}</option>`)
                    .join('');
                coverSelect.disabled = false;
            }

            if (type) saveMembersToSession(type);
        }

        inputEl.addEventListener("change", updateCoverOptions);
    }
function validateMemberAge(dob, type, funeralType) {

        if (!dob) return { valid: false, message: "Please select a valid date of birth." };



        const birthDate = new Date(dob);

        const now = new Date();



        if (birthDate > now) {

            return { valid: false, message: "Date of birth cannot be in the future." };

        }



        const age = calculateAge(dob);



        if (funeralType === "ab_enhanced_funeral") {

            if (type === "child" && (age < 0 || age > 25)) return { valid: false, message: "Child must be between 0 and 25 years old." };

            if (type === "spouse" && (age < 18 || age > 75)) return { valid: false, message: "Spouse must be between 18 and 75 years old." };

            if (type === "parent" && (age < 18 || age > 85)) return { valid: false, message: "Parent must be between 18 and 85 years old." };

            if (type === "extended_family" && (age < 0 || age > 75)) return { valid: false, message: "Extended Family must be between 0 and 75 years old." };

        }



        if (funeralType === "ab_staff_funeral") {

            if (type === "child" && (age < 0 || age > 25)) return { valid: false, message: "Child must be between 0 and 25 years old." };

            if (type === "spouse" && (age < 18 || age > 65)) return { valid: false, message: "Spouse must be between 18 and 65 years old." };

            if (type === "parent" && (age < 18 || age > 85)) return { valid: false, message: "Parent must be between 18 and 85 years old." };

            if (type === "extended_family" && (age < 0 || age > 75)) return { valid: false, message: "Extended Family must be between 0 and 75 years old." };

        }



        if (funeralType === "ab_foreigner_funeral") {

            if (type === "child" && (age < 0 || age > 25)) return { valid: false, message: "Child must be between 0 and 25 years old." };

            if (type === "spouse" && (age < 18 || age > 65)) return { valid: false, message: "Spouse must be between 18 and 65 years old." };

        }



        return { valid: true };

    }
   function submitModalMembers() {
        const headingLabel = document.querySelector(".modal_header .heading h2").textContent.replace(" Details", "").trim();
        const type = labelToKeyMap[headingLabel];
        const container = document.getElementById("extendedFamilyContainer");
        const memberRows = container.querySelectorAll(".extended-family-row");
 
        let updatedMembers = [];
        let hasErrors = false;
        
        const selectedFuneralType = document.getElementById("funeralType").value;
 
         // ✅ Get the main cover amount from the HTML
    const mainCoverAmount = parseInt(document.getElementById("coverAmount").value);
 
        // Clear previous errors
        container.querySelectorAll(".member-error").forEach(el => el.remove());
 
        memberRows.forEach(row => {
            const gender = row.querySelector("select").value;
            const dob = row.querySelector(".dob-input").value;
            const coverAmount = parseInt(row.querySelector(".cover-amount-select").value);
            const age = calculateAge(dob);
 
 
 
            // Create error message container
            const errorDiv = document.createElement("div");
            errorDiv.className = "member-error";
             
             
            let isValid = true;
 
            // ✅ Validation: coverAmount should not exceed mainCoverAmount
            if (!isNaN(coverAmount) && coverAmount > mainCoverAmount) {
                                createMemberError(row.closest(".extended-family-wrapper"), `Cover amount cannot exceed main cover amount of R${mainCoverAmount}.`);
                isValid = false;
            }
             
             if (!isNaN(gender)) {
                createMemberError(row.closest(".extended-family-wrapper"), `Please Select a gender`);
                isValid = false;
            }
            if (!isNaN(dob)) {
                createMemberError(row.closest(".extended-family-wrapper"), `Please Select a dob`);
                isValid = false;
            }
            // Age validation by type and funeral plan
               const validation = validateMemberAge(dob, type, selectedFuneralType);

            if (!validation.valid) {

                createMemberError(row.closest(".extended-family-wrapper"), validation.message);
                isValid = false;
            }
        
 
            if (!isValid) {
          //  row.closest(".extended-family-wrapper").after(errorDiv); 
            hasErrors = true;
            } else {
                // errorDiv.remove();
            updatedMembers.push({ gender, dateOfBirth: dob, coverAmount });
            }
        });
 
        if (hasErrors) return; // Don't proceed
 
        // Save to global and session
        savedMembers = updatedMembers;
        memberCounts[type] = updatedMembers.length;
        saveMembersToSession(type);
        updateMemberCountDisplay(type);
        toggleNoMembersMessage(type);
        closeDialog("addModal");
    }

    function updateMemberCountDisplay(type) {
    const selectedFuneralType = document.getElementById("funeralType").value;
    const limit = memberLimits[selectedFuneralType]?.[type] ?? 0;
    const count = memberCounts[type];

    const modal = document.querySelector(".modal_overlay:not(.hidden)");
    const countEl = modal?.querySelector(".member-count-display");

    if (countEl) {
        countEl.textContent = `Members: ${count}/${limit}`;
        countEl.style.marginTop = "0.25rem";
        countEl.style.textAlign = "center";
        countEl.style.fontWeight =  count === limit ? "bold" : "normal";
        countEl.style.color = count === limit ? "#52AD00" : "grey";
    }
    // Update the family button label

    const label = Object.keys(labelToKeyMap).find(key => labelToKeyMap[key] === type);

    const familyButtons = document.querySelectorAll(`.family-button[data-label="${label}"]`);

    

    familyButtons.forEach(button => {

        const span = button.querySelector("span");

        if (span) {

        const reachedLimit = count === limit;

        span.innerHTML = `${label} <span class="button-member-count ${reachedLimit ? 'limit-reached' : ''}">(${count}/${limit})</span>`;

        }

    });
    }



    function toggleNoMembersMessage(type) {
    const container = document.getElementById("extendedFamilyContainer");
    const existingMessage = container.querySelector(".no-members-message");

    if (memberCounts[type] === 0) {
        if (!existingMessage) {
        const message = document.createElement("div");
        message.classList.add("no-members-message");
        message.textContent = "No family members added yet.";
        message.style.justifyContent = "center";
        message.style.textAlign = "center";
        message.style.color = "grey";
        message.style.marginTop = "1rem";
        container.appendChild(message);
        }
    } else {
        if (existingMessage) {
        container.removeChild(existingMessage);
        }
    }
    }




    function closeDialog(modalId, event = null) {
        if (!event || event.target.id === modalId) {
               const sessionData = JSON.parse(sessionStorage.getItem("familyMembers") || "{}");
            const updatedData = {};
            let hasModifiedEntry = false;
            const isMemberModified = (member) =>
                member.gender && member.dateOfBirth && member.coverAmount;

            for (const [type, members] of Object.entries(sessionData)) {

                const filtered = members.filter(isMemberModified);

                // Update global count for this member type

                memberCounts[type] = filtered.length;

                if (filtered.length > 0) {

                    updatedData[type] = filtered;

                    hasModifiedEntry = true;

                } else {

                    delete updatedData[type];

                }
                // Refresh display count regardless of whether any are left

                updateMemberCountDisplay(type);

            }

            if (hasModifiedEntry) {

                sessionStorage.setItem("familyMembers", JSON.stringify(updatedData));

            } else {

                sessionStorage.removeItem("familyMembers");

            }
            document.getElementById(modalId).classList.add("hidden");
        }
    }
    
   function addMemberRow() {
        const label = document.querySelector(".modal_header .heading h2").textContent.replace(" Details", "");
        const type = labelToKeyMap[label]; // normalise
        const selectedFuneralType = document.getElementById("funeralType").value;
        const limit = memberLimits[selectedFuneralType][type];
        const modalBody = document.querySelector('.modal_body');
 
        const hasVerticalScrollbar = modalBody.scrollHeight > modalBody.clientHeight;
           
        if (memberCounts[type] >= limit) return;
 
        const container = document.getElementById("extendedFamilyContainer");
 
        // Remove the "no members" message if it exists
        const emptyNotification = container.querySelector(".no-members-message");
        if (emptyNotification) {
            container.removeChild(emptyNotification);
        }
 
        // Create wrapper div
        const wrapper = document.createElement("div");
        wrapper.classList.add("extended-family-wrapper");
 
        // Create the main row
        const row = document.createElement("div");
        row.classList.add("extended-family-row");
        row.innerHTML = `
            <select class="form-select">
            <option value="" disabled selected hidden>Gender</option>
            <option value="male">Male</option>
            <option value="female">Female</option>
            </select>
              <input type="text" class="dob-input" readonly placeholder="Date of birth" />
            <span class="dob-icon glyphicon glyphicon-calendar"></span>
           
            <select class="form-select cover-amount-select" fdprocessedid="s6rzob" disabled>
                <option value="" selected disabled>Amount</option>
            </select>
        `;
 
        // Create the remove button outside the row
        const removeContainer = document.createElement("div");
        removeContainer.classList.add("remove-button-container");
        removeContainer.innerHTML = `
            <button type="button" onclick="removeExtendedFamilyRow(this.closest('.extended-family-wrapper'), '${type}')" class="remove-button">
            <span class="remove-text">Remove</span>
            </button>
            <i class="material-icons remove-icon" onclick="removeExtendedFamilyRow(this.closest('.extended-family-wrapper'), '${type}')">delete</i>
        `;
 
        wrapper.appendChild(row);
        wrapper.appendChild(removeContainer);
        container.appendChild(wrapper);
 
       

        const dobInput = row.querySelector('.dob-input');



        // Disable keyboard on mobile (readonly) and set dynamic placeholder

        const isMobile = window.innerWidth <= 768;

        dobInput.placeholder = isMobile ? "dob" : "Date of Birth";
  const genderSelect = row.querySelector("select");

        const coverSelect = row.querySelector(".cover-amount-select");



         // Get the main cover amount from the HTML

        const mainCoverAmount = parseInt(document.getElementById("coverAmount").value);

        const calendarIcon = row.querySelector('.dob-icon');

 
 



        dobInput.addEventListener("input", () => {

            const wrapper = row.closest(".extended-family-wrapper");

            const dateValue = dobInput.value;

            const funeralType = document.getElementById("funeralType").value;



            const validation = validateMemberAge(dateValue, type, funeralType);

            if (!validation.valid) {

                createMemberError(wrapper, validation.message);

            } else {

                removeErrorBelow(wrapper);

            }



            saveMembersToSession(type);
        });
 
      //  const genderSelect = row.querySelector("select");
       // const coverSelect = row.querySelector(".cover-amount-select");
       
 
     //   const calendarIcon = row.querySelector('.dob-icon');
 
        setupDOBPicker(dobInput, calendarIcon, type);
 
 
        row.querySelector("select").addEventListener("change", () => {
            saveMembersToSession(type); // updated from normalizedType to type
        });
       
        // Listen to cover amount change
 
        row.querySelector(".cover-amount-select").addEventListener("change", () => {
 
        saveMembersToSession(type);
 
        });
 
        // Handle Gender Change
        genderSelect.addEventListener("change", () => {
            removeErrorBelow(wrapper);
            saveMembersToSession(type);
        });
 
       // Handle Cover Amount Change

        coverSelect.addEventListener("change", () => {

            const wrapper = row.closest(".extended-family-wrapper");

            const selectedCoverValue = parseInt(coverSelect.value);



            if (!isNaN(selectedCoverValue) && selectedCoverValue > mainCoverAmount) {

                createMemberError(row.closest(".extended-family-wrapper"), `Cover amount cannot exceed main cover amount of R${mainCoverAmount}.`);

            } else {

                removeErrorBelow(wrapper);
                saveMembersToSession(type);
            }



        });
 
        memberCounts[type]++;
        saveMembersToSession(type);
        toggleNoMembersMessage(type);
 
        if (memberCounts[type] >= limit) {
            disableAddButton(type);
        }
 
        updateMemberCountDisplay(type);
        // Smooth scroll to bottom if scrollbar is present
 
        if (hasVerticalScrollbar) {
 
        modalBody.scrollTo({
 
            top: modalBody.scrollHeight,
 
            behavior: 'smooth'
 
        });
 
        }
    }
   function createMemberError(wrapper, message) {

        removeErrorBelow(wrapper);

        const errorDiv = document.createElement("div");

        errorDiv.className = "member-error";

        errorDiv.textContent = message;

        wrapper.after(errorDiv);

    }
function removeErrorBelow(wrapper) {
        const nextSibling = wrapper.nextElementSibling;
        if (nextSibling && nextSibling.classList.contains("member-error")) {
            nextSibling.remove();
        }
    }

    function removeExtendedFamilyRow(button, type) {
    const wrapper = button.closest(".extended-family-wrapper");
        if (wrapper) {
            // Remove adjacent error message if it exists
            const nextSibling = wrapper.nextElementSibling;
            if (nextSibling && nextSibling.classList.contains("member-error")) {
                nextSibling.remove();
            }
           
            wrapper.remove();
            memberCounts[type]--;
 
            const selectedFuneralType = document.getElementById("funeralType").value;
            const limit = memberLimits[selectedFuneralType][type];
 
            saveMembersToSession(type);
            toggleNoMembersMessage(type);
 
            if (memberCounts[type] < limit) {
            enableAddButton(type);
            }
 
            updateMemberCountDisplay(type);
        }
    }

    function disableAddButton(type) {
        document.querySelectorAll(".addExtendedButton").forEach(btn => {
        const label = btn.textContent.trim().split(" ")[0]; // Spouse, Child, etc.
        if (labelToKeyMap[label] === type) {
            btn.classList.add("disabled-button");
            // btn.disabled = true;
        }
        });
    }
    
    function enableAddButton(type) {
        document.querySelectorAll(".addExtendedButton").forEach(btn => {
        const label = btn.textContent.trim().split(" ")[0]; // Spouse, Child, etc.
        if (labelToKeyMap[label] === type) {
            btn.classList.remove("disabled-button");
            btn.disabled = false;
        }
        });
    }

    function updateFamilyButtonLabels() {
        const funeralType = document.getElementById("funeralType").value;
        const limitConfig = memberLimits[funeralType];
    
        document.querySelectorAll(".family-button").forEach((btn) => {
        const label = btn.getAttribute("data-label"); // e.g., "Child"
        const key = labelToKeyMap[label];
    
        if (key && limitConfig[key] !== undefined) {
            // Find the span inside the button and update its text
            const labelSpan = btn.querySelector("span");
            if (labelSpan) {
            labelSpan.textContent = `${label} (0/${limitConfig[key]})`;
            }
    
            // Handle the disabled-like state for divs
            if (limitConfig[key] === 0) {
            btn.classList.add("disabled");
            btn.style.pointerEvents = "none";
            btn.style.opacity = "0.5";
            } else {
            btn.classList.remove("disabled");
            btn.style.pointerEvents = "";
            btn.style.opacity = "";
            }
        }
        });
    }
       function validateAndApplyButtonState() {

      updateFamilyButtonLabels(); // Run this first to apply funeralType limits



      const dob = $('#personal-dob').val();

      const gender = $('#personal-gender').val();

      const coverAmount = $('#coverAmount').val();

      const allValid = dob && gender && coverAmount;



      // Then restrict based on required field completion

      document.querySelectorAll(".family-button").forEach((btn) => {

          const label = btn.getAttribute("data-label");

          const key = labelToKeyMap[label];

          const limit = memberLimits[document.getElementById("funeralType").value]?.[key];



          if (!allValid || limit === 0) {

              btn.classList.add("disabled");

              btn.style.pointerEvents = "none";

              btn.style.opacity = "0.5";

          }

      });

  }
    function initializeFlatpickrOnExistingInputs() {

    document.querySelectorAll('.dob-input').forEach(input => {

        const fpInstance = flatpickr(input, {

        dateFormat: "Y-m-d",
        disableMobile: true,
        appendTo: document.body,

        });



        // Try to find the corresponding span/icon in the same parent

        const span = input.parentElement.querySelector('.glyphicon-calendar');



        if (span) {

        span.style.cursor = 'pointer'; // Optional: make it visually clickable

        span.addEventListener('click', () => {

            fpInstance.open();

        });

        }

    });

    }
    
    


    function capitalize(str) {
    return str.charAt(0).toUpperCase() + str.slice(1);
    }


    document.getElementById("funeralType").addEventListener("change", () => {
    Object.keys(memberCounts).forEach(k => memberCounts[k] = 0);
    
    validateAndApplyButtonState();
    });

    


    function saveMembersToSession(type) {
        const container = document.getElementById("extendedFamilyContainer");
        const rows = container.querySelectorAll(".extended-family-row");

        const members = Array.from(rows).map(row => {
            const gender = row.querySelector("select").value;
            const dateOfBirth = row.querySelector("input").value;
            const coverAmountStr = row.querySelector(".cover-amount-select").value;
            const coverAmount  = parseInt(coverAmountStr);
            
        return { gender, dateOfBirth, coverAmount };
        });

        memberCounts[type] = members.length;

        const sessionData = JSON.parse(sessionStorage.getItem("familyMembers") || "{}");
        sessionData[type] = members;
        sessionStorage.setItem("familyMembers", JSON.stringify(sessionData));

        updateMemberCountDisplay(type); 
    }

    function getMembersFromSession(type) {
    const sessionData = JSON.parse(sessionStorage.getItem("familyMembers") || "{}");
    return sessionData[type] || [];
    }

    function wipeSession() {
    sessionStorage.removeItem("familyMembers");
    Object.keys(memberCounts).forEach(k => memberCounts[k] = 0);
    validateAndApplyButtonState();
    }
    function showLoader() {
    document.getElementById('loader').style.display = 'flex';
    setTimeout(() => {
        document.getElementById('loader').style.display = 'none';
    }, 800);
}  
        
    $(document).ready(function () {

        function collectFormData() {
            const funeralType = $('#funeralType').val();
            const coverAmount = $('#coverAmount').val();

            const personalDetails = {
                gender: $('#personal-gender').val(),

                  dob: $('#personal-dob').val()
            };

            const familyData = {
                Child: [],
                Parent: [],
                "Extended Family": [],
                Spouse: []
            };

            // Loop through each added family member
            $('#extendedFamilyContainer .member-row').each(function () {
                const type = $(this).data('type');
                const gender = $(this).find('.member-gender').val();
                const dob = $(this).find('.member-dob').val();

                if (type && gender && dob) {
                    familyData[type].push({ gender, dateOfBirth: dob, coverAmount: 90000.00 });
                }
            });

            // Construct the final payload object
            return {
                type: "insurance",
                subType: funeralType,
                personalDetails: {
                    idNumber: "",
                    passportNumber: "",
                    surname: "",
                    firstName: "",
                    dateOfBirth: personalDetails.dob,
                    gender: personalDetails.gender
                },
                insuranceDetails: {
                    coverAmount: parseFloat(coverAmount) || 110000.00,
                    spouses: getMembersFromSession("spouse"),
                    children: getMembersFromSession("child"),
                    parents: getMembersFromSession("parent"),
                    extendedFamily:getMembersFromSession("extended_family"),
                }
            };
        }

    $('.cal-btn').on('click', function () {
        let isValid = true;

        // Clear previous error messages
        $('#main-member-errors').hide();
        $('#gender-error').text('');
        $('#dob-error').text('');
        $('#personal-gender').removeClass('input-error');
        $('#personal-dob-input').removeClass('input-error');

        const personalGender = $('#personal-gender').val();
        const personalDob = $('#personal-dob').val();
        const funeralType = $('#funeralType').val();

        // Validate Gender
        if (!personalGender) {
            $('#gender-error').text('Please select your gender.');
            $('#personal-gender').addClass('input-error');
            isValid = false;
        }

        // Validate DOB
        if (!personalDob) {
            $('#dob-error').text('Please enter your date of birth.');
            $('#personal-dob-input').addClass('input-error');
            isValid = false;
        }

        // Perform main member age validation based on funeral type
        if (personalDob) {
            const age = calculateAge(personalDob);

            if (funeralType === "ab_enhanced_funeral" && (age < 18 || age > 75)) {
                $('#dob-error').text('Main member must be between 18 and 75 years old for Enhanced funeral cover.');
                $('#personal-dob-input').addClass('input-error');
                isValid = false;
            } else if ((funeralType === "ab_staff_funeral" || funeralType === "ab_foreigner_funeral") && (age < 18 || age > 65)) {
                $('#main-member-errors').show();
                $('#dob-error').text(`Main member must be between 18 and 65 years old for ${funeralType} funeral cover.`);
                $('#personal-dob-input').addClass('input-error');
                isValid = false;
            }
        }

        // Show error container if any validation failed
        if (!isValid) {
            $('#main-member-errors').show();
            return;
        }

        const insuranceData = collectFormData(); // get dynamic form data

        $.ajax({
            url: 'https://cxappuat.stg.africanbankdmz.net/businessBanking/CalculateQuote',
            type: 'POST',
           headers: {  // <-- should be "headers", not "header"
        'x-api-key': 'QWRtaW5pc3RyYXRvcjptYW5hZ2U='
    },
            contentType: 'application/json',
            data: JSON.stringify(insuranceData),
            success: function (res) {
                console.log(res);
                $("#premium-value").text(res?.data?.premium || "0.00");

                // Hide the image
                $("#defaultImage").hide();
                  showLoader();
                // Show the premium display block
                $("#premium-display").show();
                  // Scroll to premium display on mobile (or always if preferred)
                if (window.innerWidth <= 768) {
                    $('html, body').animate({
                        scrollTop: $("#premium-display").offset().top - 40 // slight padding
                    }, 600); // duration in ms

                }
            },
            error: function (err) {
                console.error(err);
                alert("An error occurred.");
            }
        });
    });


    });

 </script>
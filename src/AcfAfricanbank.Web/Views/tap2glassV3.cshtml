@@media (max-width: 768px) {
  /* General mobile adjustments */
  #section-1, #section-3 {
    height: auto !important;
    padding: 40px 0 !important;
  }

  .image-position {
    height: auto !important;
    width: 100% !important;
    margin-bottom: 30px !important;
  }

  /* Text adjustments */

    font-size: 36px !important;
    line-height: 45px !important;
  }

  .section-1-p {
    font-size: 16px !important;
    line-height: 24px !important;
  }

  .why-choose-us, .benefit {
    font-size: 24px !important;
    line-height: 32px !important;
  }

  /* Card container adjustments */
  .account-card {
    width: 100% !important;
    margin-bottom: 30px;
    height: auto !important;
    min-height: auto !important;
  }

  /* Card content adjustments */
  .card-body {
    padding: 15px !important;
  }

  .font-size-24-weight-600 {
    font-size: 20px !important;
    line-height: 28px !important;
  }

  /* Button adjustments */
  .btn-learn, .btn-apply, .btn-download, .download-btn {
    width: 100% !important;
    margin: 10px 0 !important;
  }

  /* Card grid adjustments */
  .row > [class^="col-"] {
    width: 100%;
    flex: 0 0 100%;
    max-width: 100%;
  }

  /* Accordion adjustments */
  .section-600, .section-327 {
    height: auto !important;
    padding: 40px 0;
  }

  /* Image section adjustments */
  .image-section {
    margin-bottom: 0 !important;
    text-align: center;
  }

  /* Form elements */
  .custom-img {
    width: 100% !important;
  }

  /* Spacing adjustments */
  .mtb-40, .mtb-60, .mt-40 {
    margin: 20px 0 !important;
  }

  /* Header adjustments */
  .header-section {
    margin: 30px 0 !important;
    text-align: center;
  }

  /* Card list adjustments */
  .custom-bullets li {
    flex-direction: column;
    align-items: flex-start;
  }
}

@inherits Umbraco.Web.Mvc.UmbracoViewPage
@{
	    Layout = "Master.cshtml";
	 
     var children = Model.Children;
var firstChild = children?.FirstOrDefault();

IEnumerable<IPublishedElement> productCards = Enumerable.Empty<IPublishedElement>();

IEnumerable<IPublishedElement> callDepositHerobodyChildrenItems = Enumerable.Empty<IPublishedElement>();


// Find the "Call Deposits" section
IPublishedContent callDepositHerobody = null;

    if (Model.Name == "Call Deposits")
    {
        callDepositHerobody = Umbraco.Content(19109); // Example node for Call
    }
    else if (Model.Name == "Notice Deposits")
    {
        callDepositHerobody = Umbraco.Content(19110); // Example node for Notice
    }
    else if (Model.Name == "Fixed Deposits")
    {
        callDepositHerobody = Umbraco.Content(19111); // Another fallback
    }
 else if (Model.Name == "Online Money Manager (OMM)")
    {
        callDepositHerobody = Umbraco.Content(19112); // Another fallback
    }

 else if (Model.Name == "OMM Notice Deposits")
    {
        callDepositHerobody = Umbraco.Content(19815); // Another fallback
    }
    else if (Model.Name == "OMM Call Deposits")
    {
        callDepositHerobody = Umbraco.Content(19825); // Another fallback
    }
    else if (Model.Name == "OMM Fixed Deposits")
    {
        callDepositHerobody = Umbraco.Content(19829); // Another fallback
    }

IPublishedElement heroShoulder = null;
if (callDepositHerobody?.Children != null)
{
    heroShoulder = callDepositHerobody.Children.FirstOrDefault(c => c.Name == "Hero Shoulder");
    callDepositHerobodyChildrenItems = heroShoulder?.Value<IEnumerable<IPublishedElement>>("items");
}


// Extract product cards from the first child tab
if (firstChild != null)
{
    var tabBodyContent = firstChild.Value<IEnumerable<IPublishedElement>>("tabBodyContent");
    var genericContent = tabBodyContent?
        .FirstOrDefault(c => c.ContentType.Alias == "nCTabGenericContent");

    productCards = genericContent?.Value<IEnumerable<IPublishedElement>>("sectionContent");
}

// Now `callDepositHerobodyChildrenItems` and `productCards` can be safely used further


}


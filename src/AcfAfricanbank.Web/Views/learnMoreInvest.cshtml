});

</script>



<script>
$(document).ready(function () {

 

    function renderActiveTags(periods) {
        const $container = $('#activeFilters');
        $container.empty();

        periods.forEach(period => {
            $container.append(`
                <span class="filter-tag">${period}
                    <span class="remove-tag" data-value="${period}">×</span>
                </span>
            `);
        });
    }

    function filterTable() {
        const selectedPeriods = $('.period-filter:checked').map(function () {
            return $(this).val();
        }).get();

        renderActiveTags(selectedPeriods);

        $('#ratesTable tbody tr').each(function () {
            const period = $(this).find('td:first').text().trim();
            if (selectedPeriods.length === 0 || selectedPeriods.includes(period)) {
                $(this).show();
            } else {
                $(this).hide();
            }
        });

        
    }

    // Checkbox filter change
    $('.period-filter').on('change', function () {
        filterTable();
    });

    // Remove filter tag
    $(document).on('click', '.remove-tag', function () {
        const val = $(this).data('value');
        $(`.period-filter[value="${val}"]`).prop('checked', false);
        filterTable();
    });

    // Clear all filters
    $('#clearPeriods').on('click', function () {
        $('.period-filter').prop('checked', false);
        filterTable();
    });

    // Initialize
    filterTable();
});
</script>


        function getUrlValues(inputs)
        {
            var vars = [], hash;
            var hashes = window.location.href.slice(window.location.href.indexOf('?') + 1).split('&');
            for(var i = 0; i < hashes.length; i++)
            {
                hash = hashes[i].split('=');
                vars.push(hash[0]);
                vars[hash[0]] = hash[1];
                inputs[hash[0]] = hash[1];
            }
            return inputs;
        }
        function call_me(form_name, prodId, call_me_subject, call_me_contact_type) {
            
	    //test

	    var data = {};
		if (iterator > 0) { return; }
            var inputs = document.forms[form_name].getElementsByTagName("input");
            for (var x = 0; x < inputs.length; x++) {
                data[inputs[x].id] = inputs[x].value;
            }
            var utmSource = '@utm_source';
            var utmMedium = '@utm_medium';
            var utmCampaign = '@utm_campaign';

            if (utmSource.length >= 3) {
                data["utm_source"] = utmSource;
                data["utm_medium"] = utmMedium;
                data["utm_campaign"] = utmCampaign;
            }
            if (window.location.href.indexOf("utm_source") > -1) {
              getUrlValues(data);
            }
            $("#form-loader").show();

            var csrfToken = $("input[name='__RequestVerificationToken']").val();
	    ++iterator;
            $.ajax({
                headers: { '__RequestVerificationToken': csrfToken },
                url: '/umbraco/surface/Custom/call_me_request',
                type: "POST",
                dataType: 'json',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ form: data, prodId: prodId, call_me_subject: call_me_subject, call_me_contact_type: call_me_contact_type}),
                success: function (data) {
			debugger;
                    $("#form-loader").hide();
                    if (!data.error) {
                        call_me_success_close();
                        call_me_success();
                    } else {
                        //handling errors
                        if ($("#st-panel-submit")[0].type == "button") {
                            open_call_me();
                            $("#st-panel-submit").submit();
                        } else if ($("#st-panel-submit")[0].type == "submit")
                        {
                            $("#st-panel-submit").submit();
                        }
                    }
                },
                error: function (error) {
                    $("#form-loader").hide();
                    //handling bad request
                    call_me_failed();
                }
            });
        }
        function screenWidth() {
            if (window.screen) {
                return (screen.width);
            } else {
                return (0);
            }
        }
        function screenHeight() {
            if (window.screen) {
                return (screen.height);
            } else {
                return (0);
            }
        }
        function call_me_success() {
            //Display the correct message if request was successful
            $('#call_me_form').hide();
            $('#call_me_success').show();
        }
        function call_me_failed() {
            //Display failed request
            $('#call_me_form').hide();
            $('#call_me_success').show();
            $('.call_me_success_header_title').text("Request failed");
            $('#call_me_success_body').html("Please try again later.");
            $('#call_me_success_body').css("color,red");
            call_me_success_close();
        }
        function call_me_success_close() {
              //timeout to remove success message
              setTimeout(function () {
                    $(".st-panel").removeAttr("style");
                    $('#call_me_form').show();
                    $('#call_me_success').hide(); $("form#frmCallMeBack").bootstrapValidator("destroy");
                    $("form#frmCallMeBack")[0].reset();
                    $('.st-button-main.campaing-call').click();
                    var sbject = "<p>Click call me back to speak to our consultants.</p>";
                    $(".st-panel-tip").html(sbject);
                    $("#form_fields").hide();
                    $("#st-panel-submit").prop('type', 'button');
                    $('.call_me_success_header_title').text("Request for call back received");
                    $('#call_me_success_body').html("Thank you for using our call me <br/>back.We will be in touch soon <br/><br/>From the bank where Everybody is Somebody.");
                    @*$('#call_me_success_body').html("Thank you for requesting us to call you <br/>back.Your request has been sent <br/>successfully and one of our consultants <br/>will contact you shortly.");*@
                    $('#call_me_success_body').css("color,#6b6f82");
					$("#quick-drop-off").hide();
                }, 5000);
            }
	var iterator = 0;
            $(document).ready(function () {
                init_fields();
                $('.st-button-main.campaing-call').click();
            });
        </script>

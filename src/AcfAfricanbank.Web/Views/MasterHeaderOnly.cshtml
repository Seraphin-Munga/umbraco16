        function init_fields() {
            $('#frmCallMeBack').bootstrapValidator({
                feedbackIcons: {
                    valid: 'glyphicon glyphicon-ok-sign',
                    invalid: 'glyphicon glyphicon-remove-sign',
                    validating: 'glyphicon glyphicon-refresh'
                },
                onSuccess: function (e) {
                    e.preventDefault();

                    call_me("frmCallMeBack",@prodID , '@call_me_subject', '@call_me_contact_type');
                },
                fields: {
                    'FormFields.message': {
                        message: '@ResourceHelper.GetResource("GenericContactForm_InvalidValue")',
                        validators: {
                            notEmpty: {
                                message: '@ResourceHelper.GetResource("GenericContactForm_Message_Required")'
                            }, stringLength: {
                                max: 100,
                                message: '@ResourceHelper.GetResource("GenericContactForm_Message_LenghtValMessage")'
                            }
                        },
                        feedbackIcons: {
                            valid: '',
                            invalid: '',
                            validating: ''
                        },
                    },
                    'FormFields.firstName': {
                        message: '@ResourceHelper.GetResource("GenericContactForm_InvalidValue")',
                        validators: {
                            notEmpty: {
                                message: '@ResourceHelper.GetResource("GenericContactForm_FirstName_Required")'
                            },
                            regexp: {
                                regexp: /^[a-zA-Z-\s]+$/,
                                message: '@ResourceHelper.GetResource("GenericContactForm_FirstName_error")'
                            }, stringLength: {
                                max: 30,
                                message: '@ResourceHelper.GetResource("GenericContactForm_FirstName_LenghtValMessage")'
                            }

                        }
                    },
                    "FormFields.lastName": {
                        message: '@ResourceHelper.GetResource("GenericContactForm_InvalidValue")',
                        validators: {
                            notEmpty: {
                                message: '@ResourceHelper.GetResource("GenericContactForm_LastName_Required")'
                            },
                            regexp: {
                                regexp: /^[a-zA-Z-\s]+$/,
                                message: '@ResourceHelper.GetResource("GenericContactForm_LastName_error")'
                            }, stringLength: {
                                max: 30,
                                message: '@ResourceHelper.GetResource("GenericContactForm_LastName_LenghtValMessage")'
                            }
                        }
                    },
                    "FormFields.identityNumber": {
                        validators: {
                            notEmpty: {
                                message: '@ResourceHelper.GetResource("GenericContactForm_SAID_Required")'
                            },
                            regexp: {
                                regexp: /^[0-9]{1,13}$/,
                                message: '@ResourceHelper.GetResource("GenericContactForm_SAID_ValMessage")'
                            },
                            stringLength: {
                                max: 13,
                                message: '@ResourceHelper.GetResource("GenericContactForm_SAID_LenghtValMessage")'
                            },
                            callback: {
                                callback: function (value, validator, $field) {

                                if (value != "") {
							  var idNumber = value;
														  
							  if (!/^\d{13}$/.test(idNumber)) {
								return false;
							  }

							  // Extract the date of birth from the ID number
							  const dob = idNumber.substring(0, 6);
							  var year = parseInt(dob.substring(0, 2), 10);
							  const month = parseInt(dob.substring(2, 4), 10);
							  const day = parseInt(dob.substring(4, 6), 10);

							  // Check if the birth year is valid (assuming someone born in 2001 or later)
							  if (year < 1 || year > 99) {
								return false;
							  }

							  // Adjust the birth year to a full year (2000s for 01-99, 1900s for 00)
							  if (year > 99) {
								year = year + 2000;
							  } else if (year <= 98) {
								year = year + 1900 + 100;
								const _currentDate = new Date();
								if (year > _currentDate.getFullYear()) {
									year = year - 100;
								}
							  }
							
							  const syear = Number(year.toString().slice(2,4)); // Number(idNumber.slice(0, 2));
							  // const month = Number(idNumber.slice(2, 4));
							  const sday = Number(idNumber.slice(4, 6));

							  // Determine birth century
							  const birthCentury = syear < 22 ? 2000 : 1900;

							  // Calculate birthdate
							  const birthdate = new Date(`${birthCentury + syear}-${month}-${sday}`);

							  // Calculate age
							  const currentDate = new Date();
							  const age = currentDate.getFullYear() - birthdate.getFullYear();


							  // Check if the birth month is valid (between 1 and 12)
							  if (month < 1 || month > 12) {
								return false;
							  }

							  // Check if the day is valid for the given month and year
							  const maxDaysInMonth = new Date(year, month, 0).getDate();
							  if (day < 1 || day > maxDaysInMonth) {
								return false;
							  }

							  // Check if the seventh digit (gender) is odd for males and even for females
                              var gendercode = idNumber.substring(6, 10);
                              var gender = parseInt(gendercode) < 5000 ? "female" : "male";
							  

							  // Check if the eighth digit (citizenship) is 0 for South African citizens
                              // get country ID for citzenship
                              var citzenship = parseInt(idNumber.substring(10, 11)) == 0 ? "Yes" : "No";
							  const citizenshipDigit = parseInt(idNumber.charAt(7), 10);
							  if (citzenship !== "Yes") {
								return false;
							  }
								
							  // Calculate the checksum using the Luhn algorithm
							   const idArray = idNumber.split('').map(Number);
							   const checksumDigit = idArray.pop();
							   const sum = idArray.reduceRight((acc, digit, index) => {
								 const double = index % 2 === 0 ? digit * 2 : digit;
								 return acc + (double > 9 ? double - 9 : double);
							   }, 0);
							   const calculatedChecksum = (10 - (sum % 10)) % 10;

							   // Check if the calculated checksum matches the provided checksum 
							   // ...use age check as well as an extra check
							   if (calculatedChecksum !== checksumDigit) {
									if (age >= 18 && age <= 80) {
										return true;
									} else {
										return false;
									}
							   } else {
								   return true;
							   }
							  

							  // All checks passed; the ID number is valid
							  return true;
							}
							}
                        }
						}
                    },
                    'FormFields.email': {
                        message: '@ResourceHelper.GetResource("GenericContactForm_InvalidValue")',
                        validators: {
                            notEmpty: {
                                message: '@ResourceHelper.GetResource("GenericContactForm_Email_Required")'
                            },
                            regexp: {
                                regexp: /^[-a-z0-9~!$%^&*_=+}{\'?]+(\.[-a-z0-9~!$%^&*_=+}{\'?]+)*@@([a-z0-9_][-a-z0-9_]*(\.[-a-z0-9_]+)*\.(aero|arpa|biz|com|coop|edu|gov|info|int|mil|museum|name|net|org|pro|travel|mobi|[a-z][a-z])|([0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}))(:[0-9]{1,5})?$/i,
                                message: '@ResourceHelper.GetResource("GenericContactForm_Email_ValMessage")'
                            },
                            stringLength: {
                                max: 50,
                                message: '@ResourceHelper.GetResource("GenericContactForm_EMAIL_LenghtValMessage")'
                            }
                        }
                    },
                    "FormFields.mobileNumber": {
                        message: '@ResourceHelper.GetResource("GenericContactForm_InvalidValue")',
                        validators: {
                            notEmpty: {
                                message: '@ResourceHelper.GetResource("GenericContactForm_CellPhone_Required")'
                            },
                            numeric: {
                                message: '@ResourceHelper.GetResource("GenericContactForm_CellPhone_NumericValMessage")'
                            },
                            stringLength: {
                                min: 10,
                                max: 10,
                                message: '@ResourceHelper.GetResource("GenericContactForm_CellPhone_LenghtValMessage")'
                            },
                             callback: {
                                callback: function (value, validator, $field) {

                                    var cellNumber = value;
                                    if (null === cellNumber || 0 === cellNumber.length || 10 !== cellNumber.length || cellNumber == '0000000000') return !1; // not 0000000
                                    if ('0' != cellNumber.substring(0,1)) return !1; // starts with 0
                                    return !0;
                                }
                            }
                        }
                    }
                }
            });

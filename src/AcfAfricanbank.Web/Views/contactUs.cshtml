$('#contactNumber,#contactNumber2,#contactNumber3').on('input', function () {
  const value = $(this).val();
  const rsaPattern = /^(0)(6|7|8|1)[0-9]{8}$/;

  if (!rsaPattern.test(value)) {
    $(this).addClass('is-invalid');

  } else {
    $(this).removeClass('is-invalid');
  }
});


$('#identification').on('input', function () {
  const selectedOption = $('input[name="options"]:checked').val();
  const value = $(this).val();
  const isRSAID = selectedOption === '1';
  const rsaPattern = /^[0-9]{13}$/;

  if (isRSAID && !rsaPattern.test(value)) {
    $(this).addClass('is-invalid');
    $('.id-error').text('Enter a valid 13-digit RSA ID number').show();
  } else {
    $(this).removeClass('is-invalid');
    $('.id-error').hide();
  }
});


$('#identification').on('keypress', function (e) {
  const selectedOption = $('input[name="options"]:checked').val();
  if (selectedOption === '1') {
    if (e.which < 48 || e.which > 57) {
      e.preventDefault();
    }
  }
});


function validateFormInputs($form) {
  let hasErrors = false;
  let errorMessages = [];

  $form.find('input[required], select[required]').each(function () {
    const $input = $(this);
    const value = $input.val().trim();

    if (value === '') {
      hasErrors = true;
      const fieldName = $input.attr('name') ||$input.attr('name1') || $input.attr('name2') || 'field';
      errorMessages.push(`The ${fieldName} is required.`);
    }

    // Example of additional field-specific validation (like phone number)
    if ($input.attr('type') === 'tel') {
      const rsaPattern = /^(0)(6|7|8|1)[0-9]{8}$/;
      if (!rsaPattern.test(value)) {
        hasErrors = true;
        errorMessages.push('Enter a valid South African phone number.');
      }
    }

    // Add more field-specific validation if needed...
  });

  if (hasErrors) {
    showGlobalError(errorMessages.join(' '));
  }

  return !hasErrors;
}

function showGlobalError(message) {
  const $errorBox = $('.alert-box.error');
  $errorBox.find('.message').text(message);
  $errorBox.fadeIn();

  setTimeout(() => {
    $errorBox.fadeOut();
  }, 15000);
}


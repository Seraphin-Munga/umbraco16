$(document).ready(function(){
    var rating = 0; // variable to hold the rating

    $('svg .star').on('click', function(event){
      // Use getBoundingClientRect to determine the clicked star's dimensions
      var rect = this.getBoundingClientRect();
      // Calculate click position relative to the star's left boundary
      var clickX = event.clientX - rect.left;
      var starWidth = rect.width;
      // Determine if click is on left half (half rating) or right half (full rating)
      var isHalf = clickX < (starWidth / 2);
      var starIndex = $(this).index();
      
      // Calculate overall rating (stars are zero-indexed)
      rating = starIndex + (isHalf ? 0.5 : 1);

      // Update the fill for each star
      $('svg .star').each(function(index){
        if(index < starIndex){
          // Stars before the clicked star are fully filled
          $(this).attr('fill', '#FFD700');
        } else if(index === starIndex){
          // The clicked star: half fill if click was on left, full fill otherwise
          $(this).attr('fill', isHalf ? 'url(#halfGradient)' : '#FFD700');
        } else {
          // Stars after the clicked star are reset to empty
          $(this).attr('fill', '#FDFDFD');
        }
      });

      console.log("User rated: " + rating);
      // Optionally, store rating in a hidden field, send to server, etc.
    });
  });
  
  

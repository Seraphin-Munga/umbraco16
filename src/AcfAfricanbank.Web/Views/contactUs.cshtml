$(document).ready(function () {
  $('#myTextBox').on('input', function () {
    const text = $(this).val();
    const length = text.length;

    // Update live character count
    $('#charCount').text(length + ' / 300');

    if (length < 10) {
      const remaining = 10 - length;
      $('#error-message')
        .text('Please enter at least 10 characters. ' + remaining + ' more to go.')
        .show();
    } else {
      $('#error-message').hide();
    }
  });
});

$(document).ready(function() {
  const $textarea = $('textarea.form-control.width-691');
  const $charCount = $textarea.next('span.label.label-default');
  const maxLength = 300; // Directly use the known maxlength from HTML

  function updateCharCount() {
    // Trim whitespace and calculate length
    const currentLength = $textarea.val().trim().length;
    const remaining = maxLength - currentLength;
    
    // Update display with both remaining and total
    $charCount.text(remaining + '/' + maxLength + ' Characters');
  }

  // Clear initial whitespace and set up events
  $textarea.val('').on('input', updateCharCount);

  // Initialize count
  updateCharCount();
});


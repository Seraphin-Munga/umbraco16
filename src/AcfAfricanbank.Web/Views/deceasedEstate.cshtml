<style>
* ==========================================
* CUSTOM UTIL CLASSES
* ==========================================
.accordion {
  margin: 40px 0;
}
.accordion .item {
    margin-bottom: 20px;
    background: #F2F2F2 0% 0% no-repeat padding-box;
    box-shadow: 0px 15px 20px #00000029;
    border-radius: 20px;
    border: 1px solid #FFFFFF;
    opacity: 1;
}
.main-title {
    font-size: 32px;
    font-weight: 900;
    color: #000000;
    margin: 40px 0px;
}
.t-p{
    font-size: 15px;
  color: #6B6F82;
  padding: 0px 50px 30px 10px;
}



.t-p li::marker {
   content:"🡢    ";
   color: #C3C3C3;
}

.accordion .item .item-header h2 button.btn.btn-link {
    border: none;
    outline: none;
    font-size: 16px;
    font-weight: 400;
    text-decoration: none;
}
.accordion .item .item-header {
    padding: 5px;
    margin: 2px;
}

.accordion .item .item-header h2 button {
    padding: 5px;
    display: block;
    width: 100%;
}

.hero-static-caption {
    margin-bottom: -50px;
}

.btn-header {
    display: flex;
    align-items: center;
    justify-content:space-between;
}

.btn-header__subtitles {
    display: flex;
    flex-direction:column;
    align-items: start;
}

.btn-header h1 {
    font-size:30px;
    font-weight: 900;
    color:#002B60;
}

.btn-header h2{
   font-size:16px;
    font-weight: 900;
    color:#88BC47; 
}

.btn-header p{
    font-size:14px;
    font-weight: bold;
    color:#000000;
}

.accordion .item .item-header h2 i {
    font-size: 30px;
    width: 60px;
    height: 60px;
    color: #000;
    display: flex;
    justify-content: center;
    align-items: center;
}

button.btn.btn-link.collapsed i {
    transform: rotate(0deg);
}

.title_description {
    margin: 30px 0px;
    color: #000000;
    font-size: 16px;
    padding: 0px;
}

.list_title {
    color: #000000;
    font-weight: 900;
    font-size: 25px;
    padding: 15px 0px;
}

.document_list ul li::marker {
   content:"✓    ";
   color: #88BC47;
   font-weight: bold;
}

button.btn.btn-link i {
    transform: rotate(180deg);
    transition: 0.5s;
}

.product-main_title {
    color: #000000;
    font-weight: 900;
    font-size:28px;
}

.documentList-section {
    background: #f2f2f2;
}

.impacted_product {
        margin-top: 18px;
        padding: 0px;
        font-size: 16px;
    }

.impacted-desc {
    font-size: 16px;
}

.impacted-title {
    font-weight: 900;
    font-size: 18px;
    color: #002B60;
}

.impact-wrapper_title{
    padding: 0px !important;
}

.footer-cta {
    margin:30px 0px;
}

.footer-cta span {
  font-size:18px;
    font-weight: 900;
    color:#88BC47;  
}

.footer-cta__title {
    font-size: 20px;
    line-height: 1.5;
    font-weight: bold;
    color:#000000;
}

.inforgraphic img{
    width:100%;
    height: 100%;
}

.footer-note{
    background: #EEEEEE;
    border-radius: 20px;
}

.footer_subnote{
    padding: 60px 35px;
}

.subnote {
    padding: 30px;
    font-size: 16px;
}

.footer-note_section {
    margin: 40px 0px;
}

.subnote h4 {
    color: #000000;
    font-weight: 900;
    font-size: 17px;
}

.footer-cta__btn {
  margin-top: 20px;
  font-size: 18px;
  font-weight: 200;
  padding: 12px 25px!important;
  background: #88BC47;  
  border: none;
  border-radius: 30px;
}

@@media (min-width: 770px) and (max-width: 5000px) {
    
    .mobile-view {
        display: none;
    }
    
    .desktop-view {
            display:block !important;
        }
}

 @@media (min-width: 319px) and (max-width: 768px) {
        
        .hero-static-caption {
            margin-bottom: -20px;
        }
        
        .impact-wrapper_title{
            padding: 0px !important;
        }
        
        .main-title {
            font-size: 32px;
            font-weight: 900;
            color: #000000;
            margin: 40px 0px;
            padding-left: 20px;
        }
        
        .btn-header p {
            font-size: 14px;
            font-weight: bold;
            color: #000000;
            margin-top: -20px;
        }
        
        .btn-header h2 {
            font-size: 10px;
            font-weight: 900;
            color: #88BC47;
        }

        .list_title {
            color: #000000;
            font-weight: 900;
            font-size: 25px;
            padding: 15px 15px;
        }
        
        .title_description {
            margin: 30px 0px;
            color: #000000;
            font-size: 14px;
            padding: 0px;
}       }
        
        .impacted_product {
            margin-top: 18px;
            padding: 0px;
            font-size: 14px;
        }
        .subnote {
            padding: 10px;
            font-size: 14px;
        }
        
        .footer-note_section {
        margin: 40px 10px;
        }
        
        .product-main_title {
        color: #000000;
        font-weight: 900;
        font-size: 20px;
        }
        
        .desktop-view {
            display:none;
        }
}
</style>



              <script>
           jQuery(document).ready(function () {
            //$('#input-Amount1').autoNumeric('init', { aSep: ' ', aDec: '.', aSign: 'R '});
        
            var curVal = $("#input-Amount1").val(); 
            var view = formatter.format(curVal);
            view = view.replace("ZAR",'R');
            view = view.replace(","," ");
            
            $("#input-Amount1").val(view);
            
            var loan = $("#input-Amount1").val().slice(0,-3);
            var nloan = loan.replace(" ","");
            nloan = nloan.substring(1);
            nnloan = nloan.replace(/\s/g,'');
            
            //nloan.replace(" ","");
            /******set color for range slider********************/
            var valPercent = (nnloan - parseInt($('#slide-range1').attr('min'))) /
                (parseInt($('#slide-range1').attr('max')) - parseInt($('#slide-range1').attr('min')));
            $('#slide-range1').css('background-image', '-webkit-gradient(linear, 0% 0%, 100% 0%, color-stop(' + valPercent + ', #88BC47), color-stop(' + valPercent + ', #002B60))');

            var loanterm = $('.li-hover').attr('data-value');
            var loanspan = $('#term1').val();
            
            if (loanterm === ""){
                loanterm = loanspan;
            } 
            
            var valPercent = (loanspan - parseInt($('#input-month1').attr('min'))) /
                (parseInt($('#input-month1').attr('max')) - parseInt($('#input-month1').attr('min')));
            $('#input-month1').css('background-image', '-webkit-gradient(linear, 0% 0%, 100% 0%, color-stop(' + valPercent + ', #88BC47), color-stop(' + valPercent + ', #002B60))');
            /***************** End of set color**********************/
            $('#error-loanamount1').css('display', 'none');
            installmentEstimator(nnloan, loanspan);
            
            /**************** value bubble show hide on mouse hover*************************/
            $("#slide-range1").on("mouseup", function () {
                $("#rangeV1").css("display", "none");
           
            });
            $("#slide-range1").on("mousedown", function () {
                $("#rangeV1").css("display", "block");
            });
            $("#slide-range2").on("mouseup", function () {
                $("#rangeV2").css("display", "none");
            });
            $("#slide-range2").on("mousedown", function () {
                $("#rangeV2").css("display", "block");
            });
            /**************** end of bubble show hide on mouse hover*************************/
            
            
            /**** Dropdown styler/functionality ******/
            
            function DropDown(el) {
                this.dd = el;
                this.placeholder = this.dd.children('span');
                this.opts = this.dd.find('ul.dropdown > li');
                this.val = '';
                this.index = -1;
                this.initEvents();
            }
            
            DropDown.prototype = {
                initEvents: function () {
                    var obj = this;
    
                    obj.dd.on('click', function (event) {
                        $(this).toggleClass('active');
                        $(this).children('input')[0].innerText = $(this)[0].children[1].innerText;
                        // loop through this: $(this)[0].children[1].children and find a innerHTML = $(this)[0].children[0].innerText + grab i item > $(this)[0].children[1].children[i].dataset.value from there
                        for (var i = 0; i < $(this)[0].children[2].children.length; ++i) {
                            if ($(this)[0].children[1].innerText === $(this)[0].children[2].children[i].innerText) {
                                $("#period")[0].value = $(this)[0].children[2].children[i].dataset.value;
                            }
                        }

                        return false;
                    });

                    obj.opts.on('click', function () {
                        var monthValue = 0;
                        var opt = $(this);
                        obj.val = opt.text();
                        obj.index = opt.index();
                        monthValue = obj.val;
                        obj.placeholder.text(obj.val);
                    });
                },
                getValue: function () {
                    return this.val;
                },
                getIndex: function () {
                    return this.index;
                }
            }
    
            $(function () {
    
                var dd = new DropDown($('#dd'));
    
                $(document).click(function () {
                    // all dropdowns
                    $('.wrapper-dropdown-3').removeClass('active');
                });
    
            });
            /********* dropdwon style end *******/
            
        });


        $('#slide-range1').on('input', function () {
            var newVal = $(this).val();
            var view = formatter.format(newVal);
            view = view.replace("ZAR",'R');
            view = view.replace(","," ");
            $("#input-Amount1").val(view);
            
            /**************display value bubble*********************/
            var newValue = Number((newVal - $('#slide-range1').attr('min')) * 100 / ($('#slide-range1').attr('max') - $('#slide-range1').attr('min')));
            var newPosition = 10 - (newValue * 0.2);
          //  $('#rangeV1').append('<span>' + newVal + '</span>');
            $('#rangeV1').css('left', 'calc(' + newValue + '% + (' + newPosition + 'px))');
            /******************End of dispaly value bubble********************/
            /********************Set color for range slider**********************/
            var valPercent = (newVal - parseInt($('#slide-range1').attr('min'))) /
                (parseInt($('#slide-range1').attr('max')) - parseInt($('#slide-range1').attr('min')));

@*sumit claimcards*@
   @{
       int idIterator = 0;
       foreach (var item in contentcards){
            var tabSubItemImage = item.Value<IPublishedContent>("tabSubItemImage")?.Url;
            var tabSubItemIcon = item.Value<IPublishedContent>("tabSubItemIcon")?.Url;
            
            var title = item.Value<string>("tabSubItemTitle");
            
            Umbraco.Web.Models.Link itemLink = null;
            foreach (var link in (IEnumerable<Umbraco.Web.Models.Link>)item.Value("tabSubItemLinks"))
            {
                itemLink = link;
                break;
            }
            
            if (idIterator%2 == 0)
                {
                    <section class="section-800 ">
                        <div class="container">
                          <div class="row align-items-center d-flex row-change md-text-center">
                            <div class="col-xl-6 col-lg-6 col-md-6">
                               <h1 class="color-brand-1 mt-15 mb-20">
                                @title
                                </h1>
                               @item.Value("tabSubItemTextContent")
                               
                               @if(itemLink !=  null)
                               {
                              <div class="mt-50 text-start">
                                <a href="@itemLink.Url" class="btn btn-brand-1 arrow-right">@itemLink.Name</a>
                              </div>
                              }
                              
                            </div>
                            <div class="col-xl-6 col-lg-6 col-md-6">
                              <img
                                class="d-block"
                                src="@tabSubItemImage"
                                alt="iori"
                                
                              /> 
                               
                            </div>
                          </div>
                        </div>
                    </section>
            
            }
                
            else{
                    <section class="section-800 bg-grey-60">
                        <div class="container">
                          <div class="row align-items-center row-change d-flex flex-row-reverse md-text-center">
                          
                            <div class="col-xl-6 col-lg-6 col-md-6">
                               <h1 class="color-brand-1 mt-15 mb-20">
                                @title
                              </h1>
        
                              
                              <p class="font-md color-brand-1 mt-20">
                                 @item.Value("tabSubItemTextContent")
                              </p>
                            </div>
                            <div class="col-xl-6 col-lg-6 col-md-6">
                              <img
                                class="d-block"
                                src="@tabSubItemImage"
                                alt="iori"
                                
                              /> 
                               
                            </div>
                            
                          </div>
                        </div>
                    </section>
                }
                
                idIterator += 1;
        }
   }

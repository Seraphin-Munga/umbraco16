@inherits Umbraco.Web.Mvc.UmbracoViewPage<ContentModels.PageManageYourAccount>
    @using CustomModels = Web.Models;
    @using ContentModels = Umbraco.Web.PublishedModels;

    @using Web.Helpers;

    @{
    /**/

    Layout = "Master.cshtml";

    // All Current Page Children
    var children = Model.Children;

    // Get specific Children
    var heroHeader = children?.Where(c => c.ContentType.Alias.ToLower() == "heroheader").FirstOrDefault();
    var heroShoulder = children?.Where(c => c.ContentType.Alias.ToLower() == "heroshoulder").FirstOrDefault();
    var heroChest = children?.Where(c => c.ContentType.Alias.ToLower() == "herochest").FirstOrDefault();
    var heroBody = children?.Where(c => c.ContentType.Alias.ToLower() == "herobody").FirstOrDefault();
    var heroKnees = children?.Where(c => c.ContentType.Alias.ToLower() == "heroknees").FirstOrDefault();


 var bodyFooterTitle = heroBody?.Value("bodyFooterTitle").ToString();
 
    var testimonialTab = children?.Where(c => c.ContentType.Alias.ToLower() == "testimonials").FirstOrDefault();
    var contentLists = children?.Where(c => c.ContentType.Alias == "featuresAndFreeServices").ToList();
    var homePageElements = (HomePageElements)Model.Parent.Children.Where(o => o is HomePageElements).FirstOrDefault();
    var uncoveredItemList = contentLists?.Where(c =>
    {
    var val = c.Value("contentListType")?.ToString() ?? string.Empty;
    var type = (!string.IsNullOrEmpty(val)) ? val : string.Empty;

    return type.ToLower() == "credit life uncovered items";
    }).FirstOrDefault();

    // Get Specic properties


    var benefitsModel = new CustomModels.Benefits
    {
    Header = heroChest?.Value("chestTitle").ToString(),
    Description = heroChest?.Value("chestDescription").ToString(),
    BenefitCards = heroChest?.Children?.Where(c => c.ContentType.Alias.ToLower() == "card")?.Select(c => c as Card).ToList()
    };

    var headerImage_large = heroHeader?.Value<IPublishedContent>("image")?.Url;
    var headerImage_medium = heroHeader?.Value<IPublishedContent>("imageMedium")?.Url;
    var headerImage_small = heroHeader?.Value<IPublishedContent>("imageSmall")?.Url;
    
    @*new content*@
      var contentcard= heroBody.Children.Where(c => c.Name == "ContentCards").FirstOrDefault();
      var contenttabcard = contentcard.Value<IEnumerable<IPublishedElement>>("tabBodyContent");
      var contentcards = contenttabcard.Where(c => c.ContentType.Alias == "nCTabGenericContent").FirstOrDefault().Value<IEnumerable<IPublishedElement>>("sectionContent");

         var firstcard = contentcard ?.Children?.Where(c => c.ContentType.Alias.ToLower() == "card");
         var firstcards = firstcard.Select(c => c as Card).ToList();
         
         var applyDocs = firstcards?.Select(c => c as Card).FirstOrDefault();
         var navigate = applyDocs.Value<IEnumerable<Umbraco.Web.Models.Link>>("buttonLink").FirstOrDefault();
         
      var emplyecard= heroBody.Children.Where(c => c.Name == "EmployeCards").FirstOrDefault();
      var emplyeconnectcard = emplyecard.Value<IEnumerable<IPublishedElement>>("tabBodyContent");
      var emplyecards = emplyeconnectcard.Where(c => c.ContentType.Alias == "nCTabGenericContent").FirstOrDefault().Value<IEnumerable<IPublishedElement>>("sectionContent");
       var empcount=0;
       var empcount1=0;
       
      ContentModels.TabBody createOwnWorldOfBanking = null;
      var partialName = emplyecard.Value("PartialViewName");
      createOwnWorldOfBanking = (TabBody)emplyecard;
      
      var kneesTabHeaders = heroKnees?.Children?.Select(c => c.Value("title")?.ToString()).ToList();
    var findOutMoreTab = heroKnees?.Children?
        .Where(c => c.ContentType.Alias.ToLower() == "findoutmore").FirstOrDefault();
}


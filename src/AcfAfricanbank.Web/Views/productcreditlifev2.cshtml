@section scripts
{

   @* <script defer id="customcare-webchat" src="https://africanbank-webchat.gotbot.co.za/js/customcare-webchat.js"></script*@
    <script type="text/javascript" src="@Url.Content("~/Scripts/handlebars-v4.0.5.min.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Common.JS.Library.Ab/Calculator/jquery.xdomainrequest.min.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Common.JS.Library.Ab/Calculator/calculator.js?ver=1")"></script>
    <script type="text/javascript" src="@Url.Content("~/Common.JS.Library.Ab/Calculator/calculator1.min.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Common.JS.Library.Ab/Calculator/calculatorHandler.min.js")"></script>

    <script type="text/javascript">

    $(document).ready(function () {


        var imageBgCss = "url('" + "@headerImage_large" + "')";
        var imageMdCss = "url('" + "@headerImage_medium" + "')";
        var imageSmCss = "url('" + "@(string.IsNullOrEmpty(headerImage_small) ? headerImage_large : headerImage_small)" + "')";
        var CheckScreenSize;
        (CheckScreenSize = function () {
            var _width = $(window).outerWidth();
            var _height = $(window).outerHeight();
            if (_width <= 511) {
                $("#heroHeader").css("background-image", imageSmCss);
            }
            else {
                $("#heroHeader").css("background-image", imageBgCss);
            }
        })();
        $(window).resize(CheckScreenSize);



        $("#loader-rates-form-preloader").hide();

        $(".cancel-button").click(function () {

            $("#collapseExample").bootstrapValidator('resetForm', true);

            $('#collapseExample').collapse('hide');


        });


        $("#rates-form-preloader").hide();


        $('#funeral_claim').bootstrapValidator({
            message: '@ResourceHelper.GetResource("GenericContactForm_InvalidValue")',
            feedbackIcons: {

            },
            onSuccess: function (e) {
                e.preventDefault();
                SubmitFuneralForm();

            },
            fields: {
                'FormFields.Subject': {
                        message: '@ResourceHelper.GetResource("GenericContactForm_InvalidValue")',
                        validators: {
                            notEmpty: {
                                message: '@ResourceHelper.GetResource("GenericContactForm_Subject_Required")'
                            }
                        },
                        feedbackIcons: {
                            valid: '',
                            invalid: '',
                            validating: ''
                        },
                    },
                'FormFields.Message': {
                    message: '@ResourceHelper.GetResource("GenericContactForm_InvalidValue")',
                    validators: {
                        notEmpty: {
                            message: '@ResourceHelper.GetResource("GenericContactForm_Message_Required")'
                        }, stringLength: {
                            max: 100,
                            message: '@ResourceHelper.GetResource("GenericContactForm_Message_LenghtValMessage")'
                        }
                    },
                    feedbackIcons: {
                        valid: '',
                        invalid: '',
                        validating: ''
                    },
                },

                'FormFields.FirstName': {
                    message: '@ResourceHelper.GetResource("GenericContactForm_InvalidValue")',
                    validators: {
                        notEmpty: {
                            message: '@ResourceHelper.GetResource("GenericContactForm_FirstName_Required")'
                        },
                        regexp: {
                            regexp: /^[a-zA-Z]+$/,
                            message: '@ResourceHelper.GetResource("GenericContactForm_FirstName_error")'
                        }, stringLength: {
                            max: 20,
                            message: '@ResourceHelper.GetResource("GenericContactForm_FirstName_LenghtValMessage")'
                        }
                    }
                },
                "FormFields.LastName": {
                    message: '@ResourceHelper.GetResource("GenericContactForm_InvalidValue")',
                    validators: {
                        notEmpty: {
                            message: '@ResourceHelper.GetResource("GenericContactForm_LastName_Required")'
                        },
                        regexp: {
                            regexp: /^[a-zA-Z]+$/,
                            message: '@ResourceHelper.GetResource("GenericContactForm_LastName_error")'
                        }, stringLength: {
                            max: 20,
                            message: '@ResourceHelper.GetResource("GenericContactForm_LastName_LenghtValMessage")'
                        }
                    }
                },

                "FormFields.IdNumber": {
                    message: '@ResourceHelper.GetResource("GenericContactForm_InvalidValue")',
                    validators: {
                        notEmpty: {
                            message: '@ResourceHelper.GetResource("GenericContactForm_SAID_Required")'
                        },
                        regexp: {
                            regexp: /^[a-zA-Z0-9]{1,13}$/,
                            message: '@ResourceHelper.GetResource("GenericContactForm_SAID_ValMessage")'
                        },
                        stringLength: {
                            max: 13,
                            message: '@ResourceHelper.GetResource("GenericContactForm_SAID_LenghtValMessage")'
                        }
                    }
                },
                'FormFields.Email': {
                    message: '@ResourceHelper.GetResource("GenericContactForm_InvalidValue")',
                    validators: {
                        notEmpty: {
                            message: '@ResourceHelper.GetResource("GenericContactForm_Email_Required")'
                        },
                        regexp: {
                            regexp: /^[-a-z0-9~!$%^&*_=+}{\'?]+(\.[-a-z0-9~!$%^&*_=+}{\'?]+)*@@([a-z0-9_][-a-z0-9_]*(\.[-a-z0-9_]+)*\.(aero|arpa|biz|com|coop|edu|gov|info|int|mil|museum|name|net|org|pro|travel|mobi|[a-z][a-z])|([0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}))(:[0-9]{1,5})?$/i,
                            message: '@ResourceHelper.GetResource("GenericContactForm_Email_ValMessage")'
                        }
                    }
                },
                "FormFields.CellPhone": {
                    message: '@ResourceHelper.GetResource("GenericContactForm_InvalidValue")',
                    validators: {
                        notEmpty: {
                            message: '@ResourceHelper.GetResource("GenericContactForm_CellPhone_Required")'
                        },
                        numeric: {
                            message: '@ResourceHelper.GetResource("GenericContactForm_CellPhone_NumericValMessage")'
                        },
                        stringLength: {
                            min: 10,
                            max: 10,
                            message: '@ResourceHelper.GetResource("GenericContactForm_CellPhone_LenghtValMessage")'
                        }
                    }
                }
            }
        });
    });


function SubmitFuneralForm( /*hasSubmit*/) {

    $("#loader-rates-form-preloader").show();
    $("#log-claim-preloader").show();

                var submitedFormDateTime = new Date().toLocaleString()

                var data = {
                    FirstName: $('#FirstNameInput').val().trim(),
                    LastName: $('#LastNameInput').val().trim(),
                    Subject: 'Log a claim online - Log a Claim',
                    ProductID: "1",
                    Email: $('#EmailInput').val().trim(),
                    CellPhone: $('#CellPhoneInput').val().trim(),
                    SAID: $('#SAIDInput').val(),
                    HasSubmit: true,
                    TimeEnteredOnPage: "@DateTime.Now.ToIsoString()",
                    SessionId: $('#sessionId').val(),
                    FreeText: $('#MessageInput').val().trim(),
                    ProcessID: $('#processID').val(),
                    ContactType:'Log a claim Funeral',
                    ExtendedProperties:

                    [
                    {
                    "Key": "SubmitedPageDate",
                    "Value": submitedFormDateTime
                    },
                    {
                    "Key": "CodeName",
                    "Value": navigator.appCodeName
                    },
                    {
                    "Key": "appName",
                    "Value": navigator.appName
                    },
                    {
                    "Key": "appVersion",
                    "Value": navigator.appVersion
                    }
                    ,
                    {
                    "Key": "userAgent",
                    "Value": navigator.userAgent
                    }
                    ,
                    {
                    "Key": "screenWidth",
                    "Value": screenWidth()
                    }
                    ,
                    {
                    "Key": "screenHeight",
                    "Value": screenHeight()
                    },
                    {
                    "Key": "URL",
                    "Value": window.location.href
                    }
                    ]

                    }
                    requestInProgress = true;
                    AJAX.rootPath = $.rootPath;
                    AJAX.headers = $.headers;
                    AJAX.request('/public/contacform/submit', {
                    data: data,

                    success: function (e) {
                        $("#log-claim-preloader").hide();

                        if (e.Status == 'Ok') {
                     //   console.log("The e -->" + JSON.stringify(e.Status));

                        $("form#funeral_claim").bootstrapValidator("resetForm");
                        $("form#funeral_claim")[0].reset();
                            $("#ajax-form-success-log-claim").show();
                            $("#loader-rates-form-preloader").hide();

                    } else {
                      //      console.log("error " + e.Status);

                            $("#ajax-form-error-log-claim").show();
                    }

                    },
                    error: function (req, txt, err) {

                        $("#ajax-form-error-log-claim").show();
                        $("#log-claim-preloader").hide();


                    }
                    });
    }

</script>

}


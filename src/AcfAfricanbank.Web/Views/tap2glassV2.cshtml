$(document).ready(function () {
    // Function to get the currently active tab
    function getActiveTab() {
        const activeTab = $('#go_to_tab_content li.active a');

        if (activeTab.length) {
            const activeTabId = activeTab.attr('href'); // The ID of the active tab content
            const activeTabText = activeTab.find('span').text().trim(); // The text of the active tab
            
            return {
                tabId: activeTabId,
                tabText: activeTabText,
            };
        } else {
            return null;
        }
    }

    // Event listener for tab click
    $('#go_to_tab_content a').on('click', function () {
        // Wait for Bootstrap to process the tab change
        setTimeout(() => {
            const currentTab = getActiveTab();
            if (currentTab) {
                console.log('Tab Clicked!');
                console.log('Active Tab ID:', currentTab.tabId);
                console.log('Active Tab Text:', currentTab.tabText);
                
                // Example action based on the active tab
                if (currentTab.tabId === '#Tap2Glass') {
                    $("#fees, #faq, #combo2btn").show();
                } else {
                    $("#fees, #faq, #combo2btn").hide();
                }
            } else {
                console.log('No active tab found');
            }
        }, 100); // Slight delay to ensure the active class updates
    });

    // Initial load: log the currently active tab
    const initialTab = getActiveTab();
    if (initialTab) {
        console.log('Initial Active Tab ID:', initialTab.tabId);
        console.log('Initial Active Tab Text:', initialTab.tabText);

        // Example initial action based on the active tab
        if (initialTab.tabId === '#BusinessTransactionalAccount') {
            $("#fees, #faq, #combo2btn").hide();
        }
    } else {
        console.log('No active tab found on load');
    }
});

</script>





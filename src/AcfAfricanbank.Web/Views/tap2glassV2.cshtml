<script>

$(document).ready(function() {
    // Accordion Functionality
    $(".accordion").click(function() {
        // Toggle the active class for the clicked accordion button
        $(this).toggleClass("active");
        
        // Get the next panel related to this accordion
        var panel = $(this).next(".panel");

        // Check if the clicked panel is already open
        var wasOpen = panel.is(":visible");

        // Close all panels and remove the active class
        $(".panel").slideUp();
        $(".accordion").removeClass("active");

        // If the clicked panel was not open, open it and add the active class
        if (!wasOpen) {
            panel.slideDown();
            $(this).addClass("active");
        }
    });
});




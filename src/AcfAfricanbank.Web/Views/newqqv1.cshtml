const express = require('express');
const fetch = require('node-fetch');
const app = express();

const PORT = 3000;

app.get('/investment-accounts', async (req, res) => {
  try {
    const response = await fetch('https://stg.api.africanbank.co.za/v2/clients/investments/169/accounts', {
      headers: {
        'X-API-KEY': 'JSBHZA2nQO2YgtwsGArat1b1xIYaWkHz41nYFimU',
        'X-User': 'GRINROD',
        'X-System': 'GRINROD',
        'X-Channel': 'APP',
        'X-Service-Operation': 'auth',
        'X-Session-Id': '67768678678'
      }
    });

    const data = await response.json();
    res.json(data);
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
});

app.listen(PORT, () => {

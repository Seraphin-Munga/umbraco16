    /* Slider container */
    .my-slideshow-container {
      overflow: hidden;
      position: relative;
      width: 100%;
      margin: auto;
    }
    /* Slides wrapper set to flex, width adjusted dynamically via JS */
    .my-slides {
      display: flex;
      transition: transform 0.5s ease;
    }
    .my-slides-1 {
      display: flex;
      transition: transform 0.5s ease;
    }
    .my-slides-2 {
      display: flex;
      transition: transform 0.5s ease;
    }
    /* Each slide takes full container width */
    .my-slide ,
    .my-slide-1 ,
    .my-slide-2 {
      
      box-sizing: border-box;
      padding: 20px;
      background-color: #f5f5f5;
    }
    /* Indicator container styling */
    .slider-indicators ,
    .slider-indicators-1 ,
    .slider-indicators-2 {
      text-align: center;
      margin-top: 15px;
    }
    /* Dot styling */
    .slider-indicators .dot {
      display: inline-block;
      width: 12px;
      height: 12px;
      background: #ccc;
      border-radius: 50%;
      margin: 0 5px;
      cursor: pointer;
    }
    .slider-indicators .dot.active {
      background: #5dc300;
    }


<script>


  $(document).ready(function() {
    $('#btn-calculator').on('click', function(e) {
      e.preventDefault(); // Prevent default anchor behavior
      $('html, body').animate({
        scrollTop: $('#calculator-1').offset().top
      }, 800); // Duration of scroll in milliseconds
    });
  });

(function($){
  $(document).ready(function(){
    // List of loan pages that should go to commercial property finance
    var loanPages = [
      'mortgage-financing',
      'development-funding',
      'mezzanine-funding'
    ];
    
    // Base URL
    var baseUrl = '/en/home/business-banking-v2/borrow/';
    
    $('#learn-more-btn-back button').on('click', function(event){
      event.preventDefault();
      
      var currentPath = window.location.pathname;
      var pathSegment = currentPath.replace(baseUrl, '').split('/')[0];
      
      if (loanPages.indexOf(pathSegment) > -1) {
        window.location.href = baseUrl + '#commercialpropertyfinance';
      } else {
        window.location.href = baseUrl;
      }
    });
  });
})(jQuery);

function handleContainerClass() {
  if ($(window).width() <= 768) {
    $('.back-section .container').removeClass('container');
  } else {
    // Optionally re-add the class on larger screens
    if (!$('.back-section div').hasClass('container')) {
      $('.back-section div').addClass('container');
    }
  }
}

$(document).ready(handleContainerClass);
$(window).resize(handleContainerClass);


        // Accordion Script (if applicable)
    $(".accordion").click(function() {
        $(this).toggleClass("active");
        var myPanel = $(this).next(".myPanel");
        var wasOpen = myPanel.css("display") === "block";

        $(".myPanel").css("display", "none");
        $(".accordion").removeClass("active");

        if (!wasOpen) {
            myPanel.css("display", "block");
            $(this).addClass("active");
        }
    });
 
 
     $(document).ready(function(){
        $('.back-set-button').click(function(e){
            e.preventDefault();

            if (document.referrer) {
                // Use previous URL if available
                window.location.href = document.referrer;
            } else {
                // Fallback if no referrer (direct access)
                window.history.back();
            }
        });
    });



</script>
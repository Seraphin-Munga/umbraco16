<div class="hheader" id="hheader">
</div>
<section class="inv-section">
    <div class="page-title i-container">
        <h1>Calculate your investment returns on <span>SA's best rate!</span></h1>
        <h3>Choose your investment type and make a <span>calculated move!</span></h3>
    </div>
    <div class="calculator-wrap">
        <div class="calculator-section container">
            <div class="row investment-calculator " style="margin-top: 20px;">
                <div class="calculator-form col-md-5">
                    <label class="TxFree-norm-class1">How much do you want to invest?</label><label class="TxFree-error-class1" style="display: none;color:tomato;font-weight: bolder;font-size: 12px;"></label>
                    <input type="text" placeholder="eg. R500" class="investment_amount_input" maxlength="13" oninput="validate_decimal(this);" onkeypress="return isNumber(event)" onkeyup="newInvestmentAmountEntered()" onblur="formatThisVal()" />
                    <label>Which Investment type do you want?</label>
                    <select class="investmentType">
                        <option value="Fixed Deposit">Fixed Deposit</option>
                        <option value="Notice Deposit">Notice Deposit</option>
                        <option value="Access Acumulator">Access Acumulator</option>
                        <option value="TxFree Free">Tax Free</option>
                    </select>
                    <div class="Fixed-inputs-holder investmentType-holder">
                        <label>For how long do you want to invest?</label>
                        <select class="Fixed-select-input dynamic-input"></select>
                        <label>Which payout frequency do you want?</label>
                        <select class="Fixed-payFeq-input dynamic-inputs"></select>
                    </div>
                    <div class="Notice-inputs-holder investmentType-holder" style="display: none;">
                        <label>Monthly Investment Thereafter</label>
                        <input type="text" placeholder="R 0.00" maxlength="13" oninput="validate_decimal(this);" onkeypress="return isNumber(event)" class="thereafter_amount_input" onblur="TAX_FREE_VALIDATION(this)" />
                        <label>Notice Period *</label>
                        <select class="Notice-select-input dynamic-input"></select>
                        <label>Interest Payout Frequency *</label>
                        <select class="Notice-payFeq-input dynamic-inputs"></select>
                    </div>
                    <div class="Access-inputs-holder investmentType-holder" style="display: none;">
                        <label>For how long do you want to invest?</label>
                        <select class="Access-select-input dynamic-input"></select>
                        <label>Interest Payout Frequency *</label>
                        <select class="Access-payFeq-input dynamic-inputs"></select>
                    </div>
                    <div class="TxFree-inputs-holder investmentType-holder" style="display: none;">

                        <label class="TxFree-norm-class">Monthly Investment Amount</label><label class="TxFree-error-class" style="display: none;color:tomato;font-weight: bolder;font-size: 12px;"></label>
                        <input type="text" placeholder="Max is R3 000.00" oninput="validate_decimal(this);" onkeypress="return isNumber(event)" maxlength="13" onblur="TAX_FREE_VALIDATION(this)" class="thereafter_amount_input tax_thereafter_amount_input" />
                        <select class="TxFree-select-input dynamic-input" style="display: none;"></select>
                        <label>Interest Payout Frequency *</label>
                        <select class="TxFree-payFeq-input dynamic-inputs"></select>
                    </div>

                    <div class="cta-button">
                        <button class="primary-ghost-btn">Calculate</button>
                    </div>
                    <div class="re-cta-button" style="display: none;">
                        <button class="primary-ghost-btn">Re-calculate</button>
                    </div>
                    <div class="rec-calc-div-gif" style="display: none;">
                        <img src="/media/be3hjfv1/loaderico.svg" />
                    </div>
                </div>
                <div class="calculator-results col-md-7">
                    <div class="artwork"><img src="/media/umahndqa/inv-cal.png" style="width:100%;" alt="Investment Vehicle" /></div>
                    <div class="i-loader">
                        <img src="/media/be3hjfv1/loaderico.svg" />
                        <h3>Calculating, Please wait..!</h3>
                    </div>
                    <div class="investment-results">
                        <div id="chart-container" style="height: 230px;width:100%;"></div>
                        <div class="row more-results">
                            <div class="col-sm-5 flexbox" style="align-items:center;align-content:center;">
                                <div class="your-return-chosen">
                                    <div class="wrap">
                                        <h2>Your payout on <span class="selected-header-inv-type">Fixed Deposit</span> will be:</h2>
                                        <p class="big-return"></p>
                                        <p class="return-inv-term" style="color: #23273C;"></p>
                                        <div class="primary-btn" onclick="investBtnClicked()"><a href="#">Invest now</a></div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-7 flexbox">
                                <div class="other-returns ">
                                    <h3 style="font-size: 16px;font-weight: 700;color: #000E16;margin: 15px auto 20px;">Checkout other investment options!</h3>
                                    <div class="otherInvestmentTypes"></div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
            <p class="dislcaimer-inv">*Our calculators are only a guide. Actual payout could differ due to the number of days in a month and interest rates at the start date of the investment.</p>
        </div>
    </div>
</section>


<Style>


                minInvestAmount: '@ResourceHelper.GetResource("MinimumInvestmentAmount")',
                monthlyInterPayout: '@ResourceHelper.GetResource("MonthlyInterestPayout")',
                terms: '@ResourceHelper.GetResource("Terms")',
                amount: '@ResourceHelper.GetResource("OnceOffInvestmentAmount")',
                term: '@ResourceHelper.GetResource("Term")',
                interestRatePa: '@ResourceHelper.GetResource("InterestRatePerAnnum")',
                interestEarned: '@ResourceHelper.GetResource("InterestEarned")',
                totalPayout: '@ResourceHelper.GetResource("TotalPayout")',
                interestPayoutFrequency: '@ResourceHelper.GetResource("InterestPayoutFrequency")',
                monthly: '@ResourceHelper.GetResource("MonthlyInvestmentThereafter")',
                period: '@ResourceHelper.GetResource("Period")',
                investmentReturns: '@ResourceHelper.GetResource("InvestmentReturns")',
                AmountMandatory: '@ResourceHelper.GetResource("InvestmentAmountIsMandatory")',
                after: '@ResourceHelper.GetResource("After")',
                months: '@ResourceHelper.GetResource("Months")',
                years: '@ResourceHelper.GetResource("Years")',
                investmentAmountIsMandatory: '@ResourceHelper.GetResource("InvestmentAmountIsMandatory")',
                onceOffInvestmentAmountCannotBeLessThan: '@ResourceHelper.GetResource("OnceOffInvestmentAmountCannotBeLessThan")',
                monthlyInvestmentAmountCannotBeLessThan: '@ResourceHelper.GetResource("MonthlyInvestmentAmountCannotBeLessThan")',
                periodInvested: '@ResourceHelper.GetResource("PeriodInvested")',
                investmentReturnsMessage: '@ResourceHelper.GetResource("InvestmentReturnsMessage")',
                ourOfferAmount: '@ResourceHelper.GetResource("OurOfferAmount")',
                accept: '@ResourceHelper.GetResource("Accept")',
                cancel: '@ResourceHelper.GetResource("Cancel")',
                noticePeriod: '@ResourceHelper.GetResource("NoticePeriod")',
                noticeDescription: '@ResourceHelper.GetResource("NoticeDescription")',
                payoutFreqErrorMessage: '@ResourceHelper.GetResource("PayoutFreqErrorMessage")',
                increaseOnceOff:'@ResourceHelper.GetResource("IncreaseOnceOff")'
            }
        };

        $(window).on('CalculatorLoading', function (e) {
            var _state = e.state;
            var _target = e.target;

            $(".errorcalculatores").hide();

            if (_target !== 'rates') {
                if (_state) {
                    $("#form-preloader").show();
                   // $("#calculatornotice-form").hide();
                    $("#calculator-container").hide();

                    ChangePageControls(false);
                } else {
                    $("#form-preloader").hide();
                    if (hasError) {
                        $(".errorcalculatores").show();
                       // $("#calculatornotice-form").hide();
                        $("#calculator-container").hide();
                    } else {
                        $(".errorcalculatores").hide();
                        //$("#calculatornotice-form").show();
                        $("#calculator-container").show();
                        var isMobileheaderHide = document.getElementsByClassName('tbl-header-selected');
                        if (isMobileheaderHide.length > 0) {
                            $('#calculatornotice-form table thead th.tbl-header-selected').addClass('hidden-xs');
                            $('#calculatornotice-form table thead th.background-interest-selected').removeClass('hidden-xs');
                            $('#calculatornotice-form table tbody td.tbl-header-selected').addClass('hidden-xs');
                            $('#calculatornotice-form table tbody td.background-interest-selected').removeClass('hidden-xs');
                        }
                        var isMobilebodyHide = document.getElementsByClassName('value_calculatorformate');
                        if (isMobilebodyHide.length > 0) {
                            $('#calculatornotice-form table tbody tr td.value_calculatorformate').addClass('hidden-xs');
                            $('#calculatornotice-form table tbody tr td.background-interest-selected').removeClass('hidden-xs');
                        }
                        $('.money').autoNumeric('init', { aSep: ' ', aDec: '.', aSign: 'R' });
                    }
                    ChangePageControls(Calculator.isCalculatorValid('Notice'));
                }
            } else {
                if (_state) {
                    $("#rates-form-preloader").show();
                    $('.rate-table').show();
                } else {
                    $("#rates-form-preloader").hide();
                    $('.rate-table').show();
                }
            }

        });

        $(window).on('CalculatorValidationHandler', function (e) {
            var _state = e.state;

            ChangePageControls(_state);

        });

        $(window).on('Error', function (e) {

            var _target = e.target;

            if (_target) {
                if (_target === 'rates') {
                    if (!e.errorDescription) {
                        $(".rate-table").show();
                        $("#rates-form-preloader").hide();

                        return;
                    }

                    $(".rate-table").hide();
                    $("#rates-form-preloader").hide();
                    $(".errorrates").show();
                } else {
                    if (!e.errorDescription) {
                        hasError = false;

                        $("#form-preloader").hide();
                       // $("#calculatornotice-form").show();
                        $("#calculator-container").show();
                        ChangePageControls(false);

                        $(".errorcalculatores").hide();

                        return;
                    } else {
                        hasError = true;
                        $("#form-preloader").hide();
                       // $("#calculatornotice-form").hide();
                        $("#calculator-container").hide();
                        $(".errorcalculatores").show();
                        ChangePageControls(false);
                    }
                }
            }
        });

        function ChangePageControls(enabled) {
            $(".area_buttons_calculate").hide();
            if (enabled) {
                $("#buttonPrint").removeClass("disabledbutton");
                $(".area_buttons_calculate").show();
            }
            else {
                $("#buttonPrint").addClass("disabledbutton");

            }
        }

        Calculator.init(data);

        $("#buttonPrint").click(function () {
            CalculatorHandler.printRatesDoc(data);
        });
    });

    $(document).on('click', '#calculateNoticeDeposit', function (event) {
        $('#noticeResultsMobile').css('height', '280px');
    });
</script>

}
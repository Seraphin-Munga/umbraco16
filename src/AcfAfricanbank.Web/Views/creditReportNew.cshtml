@inherits Umbraco.Web.Mvc.UmbracoViewPage<ContentModels.PageCampaign>
@using ContentModels = Umbraco.Web.PublishedModels;
@using CustomModels = Web.Models;
@using Web.Helpers
@using Umbraco.Web.Models
@using System.Text.RegularExpressions

@{
    Layout = "Master.cshtml";

    // All Current Page Children
    var children = Model.Children;

    // Get specific Children
 

    var heroBody = children?.Where(c => c.ContentType.Alias.ToLower() == "herobody").FirstOrDefault();
     var bodyFooterTitle = heroBody?.Value("bodyFooterTitle").ToString();
     
      var firstsection = heroBody.Children.Where(c => c.Name == "FirstSection").FirstOrDefault();
      var firstsectioncontent = firstsection.Value<IEnumerable<IPublishedElement>>("tabBodyContent");
      var firstcontent = firstsectioncontent.Where(c => c.ContentType.Alias == "nCTabGenericContent").FirstOrDefault().Value<IEnumerable<IPublishedElement>>("sectionContent");
      
   
}
<link rel="stylesheet" href="/css/projectmagic.css" /> 
<style>
    .registerLogin {
        width: unset;
        text-align: right;
    }

    .onenumbercall {
        text-align: center;
        margin-top: 0;
        margin-bottom: 10px;
        line-height: 1.1;
        display: block;
    }

@@media (min-width: 360px) and (max-width: 416px) {
        .hero-static-banner {
            height: 530px;
        }

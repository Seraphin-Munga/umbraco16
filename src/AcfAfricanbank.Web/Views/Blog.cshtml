    <script>

        function imgMainFix() {

            var deviceWidth = (window.innerWidth > 0) ? window.innerWidth : screen.width;
            if (deviceWidth > 767) {
                $("#imgMain").css("height", $("#divNextblogs").height() - 53 + "px");
            }
        }
        function playStopVid(e) {
            debugger;
        }
        window.onresize = function () {
            imgMainFix();
        }

        $(document).ready(function () {
            $("li.unavailable a").removeAttr("href");
            imgMainFix();

            $('.videoPlay').click(function () {
                if (this.nextElementSibling.children[0].id == "iFrameVidId0") {
                    var url = $('#iFrameVidId1')["0"].src;
                    $('#iFrameVidId1')["0"].src = '';
                    $('#iFrameVidId1')["0"].src = url;
                } else {
                    var url = $('#iFrameVidId0')["0"].src;
                    $('#iFrameVidId0')["0"].src = '';
                    $('#iFrameVidId0')["0"].src = url;
                }
                this.nextElementSibling.style.display = 'block'; this.style.display = 'none';
            });
        });
    </script>

</section>*@

<section class="section ptb-40 bg-grey-60">
<div class="container " >
    <div class="row align-items-center d-flex row-change md-text-center">
        <div class="col-xl-12 col-lg-12 col-md-12">
              <h1 class="color-brand-1 mt-15 mb-20 faqHeader">@bodyTitle</h1>
             <p class="font-md color-brand-1 mb-30">@bodyDescription</p>
               <div class="accordion accordionStyle2" id="accordionFAQ">
                    <div class="row">
                  
                        <div class="col-lg-12">
                            <div class="accordion-item">
                              <h5 class="accordion-header">
                                    <button class="accordion-button text-heading-5">Customer Contact Center</button>
                                </h5>
                                <div id="accordion-body" class="accordion-collapse collapse">
                                    <div class="accordion-body"> @Html.Raw(@heroBody.Value("richTextBox"))</div>
                                </div>
                            </div>
                        </div>
                                                    
                       
                    </div>
                </div>
        </div>
        
    </div>
</div>
</section>   
@section scripts
{
    <script>
  
  $(document).ready(function(){

        $(".accordion-button").click(function(){
            
         
    var isCollapsed = $(this).hasClass('collapsed');
    
           $(".accordion-button").removeClass('collapsed');
           
           if(isCollapsed == false) {
            $(this).toggleClass("collapsed");
           }

           
 var isCollapsedContent = $(this).parent().next(".accordion-collapse").hasClass('collapse');
            $(".accordion-collapse").addClass('collapse');
            if(isCollapsedContent == true) {
                $(this).parent().next(".accordion-collapse").toggleClass('collapse');
           }

           

        });

    });


    </script>
}

            break;
         }
      }
      @*fixed*@
    var imageItemfixed = myWorldBankAccount.Children.Where(x => x.ContentType.Alias == "ebankITItem2").Last();
    String imageValuePathfixed = ((ContentModels.Image)((IPublishedContent)imageItemfixed.Value("ebankITImage"))).Url;
    
     Umbraco.Web.Models.Link buttonDocumentLinkfixed = null;
     if (imageItemfixed.Value("sectionLink") != null) 

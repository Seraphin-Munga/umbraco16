    iosDownloadNow?.EbankItbuttonExternalLink :
    iosDownloadNow.EbankItbuttonInternalLink?.Url;
    iosButtonLink = (string.IsNullOrEmpty(iosButtonLink)) ? "#" : iosButtonLink;
    
    var huaweiButtonLink = "#";

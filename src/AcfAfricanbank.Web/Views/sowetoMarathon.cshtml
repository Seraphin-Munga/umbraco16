    }
    
    <div id="video-header" class="vid_list_item" data-video="@initial_video">
        <div id="video-header-thumb" style="background-image:url('@thumb_img'); background-position: right;">
            <iframe width="100%" height="100%" id="video-ytd" src="" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen></iframe>
                <section id="video-loader">
                    <div class="loader" id="form-preloader-loader">
                        <div class="loader-img"></div>
                    </div>
                </section>
                <div class="video-citation-box">
                    <div class="video-citation"></div>
                    <div class="video-play-button spacer">
                        <span class="vid_list_item" data-video="@initial_video"><i class="fa fa-play-circle fa-3x main-click play-icon css-background-change"></i></span>
                    </div>
                </div>
        </div>
    </div>
    @{
        var noCampcontent = videoItem.Value<IEnumerable<IPublishedElement>>("tabBodyContent");
        var noCampvideos = noCampcontent.Where(c => c.ContentType.Alias == "nCTabGenericContent").FirstOrDefault().Value<IEnumerable<IPublishedElement>>("sectionContent");
        var noCampx = 1;
        
    }
    <div id="video-body">
        <div class="row">
            @if (noCampvideos != null) 
            {
                if (noCampvideos.ToList().Count > 1)
                {
                    foreach (var videoData in noCampvideos)
                    {
                        title = "Episode " + noCampx;
                        description = videoData.Value("nCcardDescription");
                        var img = videoData.Value<IPublishedContent>("nCcardIcon").Url;
                        var videoUrl = videoData.Value("nCcardTitle");
                            <div id="item-@noCampx" class="col-md-4 col-sm-6 vid-list">
                                <div data-video="@videoUrl*@title*@description" class="video-item vid_list_item">
                                    <div class="vid-list-play-botton"><i class="fa fa-play-circle fa-5x"></i></div>
                                        <div class="video-item-img" style="background-image:url(@img)"></div>
                                        <div class="video-item-content">
                                            <div class="video-description-box">
                                                <p class="video-item-description" style="font-weight:400;">@description</p>
                                            </div>
                                                    
                                            <div class="sharethis-inline-share-buttons" data-url="@Request.Url.AbsoluteUri#@videoUrl"></div>
                                        </div>
                                </div>
                            </div>
                        noCampx++;
                    }
                }
                else if (noCampvideos.ToList().Count == 1)
                {
                    foreach (var videoData in noCampvideos)
                    {
                        title = "Episode " + noCampx;
                        description = videoData.Value("nCcardDescription");
                        var img = videoData.Value<IPublishedContent>("nCcardIcon").Url;
                        var videoUrl = videoData.Value("nCcardTitle");
                        <center>
                            <div class="col-md-3"></div>
                            <div id="item-@noCampx" class="col-md-6 col-xs-12 vid-list">
                                <div data-video="@videoUrl*@title*@description" class="video-item vid_list_item">
                                    <div class="vid-list-play-botton"><i class="fa fa-play-circle fa-5x"></i></div>
                                        <div class="video-item-img" style="background-image:url(@img)"></div>
                                        <div class="video-item-content">
                                            <div class="video-description-box">
                                                <p class="video-item-description" style="font-weight:400;">@description</p>
                                            </div>
                                                    
                                            <div class="sharethis-inline-share-buttons" data-url="@Request.Url.AbsoluteUri#@videoUrl"></div>
                                        </div>
                                </div>
                            </div>
                            <div class="col-md-3"></div>
                        </center>
                        noCampx++;
                    }
                }
            }

        </div>
    </div>    
                        
</div>

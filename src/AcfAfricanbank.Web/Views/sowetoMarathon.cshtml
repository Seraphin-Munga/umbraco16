<div class="container">
    <div class="row">
        @{
            foreach(var _contentItem in imageItem)
            {
                if (_contentItem != null) 
                {
                    String imageValuePath = ((ContentModels.Image)((IPublishedContent)_contentItem.Value("ebankITImage"))).Url;

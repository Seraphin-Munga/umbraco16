@section scripts{
    <script src="~/scripts/jquery-ui.js"></script>
    <script src="~/javascripts/reuse/form_validation.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/1000hz-bootstrap-validator/0.11.5/validator.min.js"></script>
    <script type="text/javascript">
            $(document).ready(function () {
                $('#video-header').hide();
                MediaHashVideo();
                $(".vid-list").click(function (e) {
                    $('#video-header').show();
                });
                $(".vid_list_item").click(function (e) {
                    moveHtmlView(50, e);
                });
                
                $(".vid_list_item_campaign").click(function (e) {
                    moveHtmlView(1250, e);
                });
                


                $('.money').autoNumeric('init', { aSep: ' ', aDec: '.', aSign: 'R' });

                function moveHtmlView(position, control) {
                    var selected_video = control.currentTarget.dataset.video.split("*");
                
                    //checking if there is any video
                    if (selected_video[0] !== null && selected_video[0] !== undefined && selected_video[0] != "")
                    {
                        //-->show video loader
                        $("#video-loader").show();
                        $("#video-header-thumb").addClass("video-thumb-none");
                        $("#video-ytd").removeClass("video-ytd-show");
                        $(".video-content").hide();
                
                        //--> header title description
                        if (selected_video.length==3)
                        {
                            $(".landing-video-title").text(selected_video[1]);
                            $(".landing-video-description p").text(selected_video[2]);
                
                        }
                        $("#video-ytd")[0].src = selected_video[0];
                        
                        //$("html, body").animate({ scrollTop: position }, 2000);
                        
                        setTimeout(function () {
                            $('#video-ytd')[0].src += "?autoplay=1";
                            $("#video-ytd").addClass("video-ytd-show");
                            $("#video-loader").hide();
                            
                        }, 5000);
                       
                    }
                }

            });

            function onPage(name) {
                var path = window.location.pathname;
                return name == path.substring(path.lastIndexOf('/') + 1);
            }
            if (onPage('moja-love')) {
                $('.css-background-change').css('background', '#2E0554');
                $('.css-color-change').css('color', '#2E0554');
            };
            $(".main-click").click(function () {
                $(".video-citation-box").hide();
                $("#video-header").css({ 'height': '75vh' });
            });

            function MediaHashVideo() {
                var selected_video = window.location.hash.replace('#', '');
                if (selected_video !== null && selected_video !== undefined && selected_video != "") {
                    //-->show video loader
                    $("#video-loader").show();
                    $(".video-citation-box").hide();
                    //}
                    $("#video-ytd")[0].src = selected_video;
                    setTimeout(function () {
                        $('#video-ytd')[0].src += "?autoplay=1";
                        $("#video-ytd").addClass("video-ytd-show");
                        $("#video-loader").hide();
                    }, 5000);
                }
            }
        </script>
    <script>
        $(document).ready(function () {
            var imageBgCss = "url('" + "@headerImage_large" + "')";
            var imageMdCss = "url('" + "@headerImage_medium" + "')";
            var imageSmCss = "url('" + "@(string.IsNullOrEmpty(headerImage_small) ? headerImage_medium : headerImage_small)" + "')";
            var CheckScreenSize;
            (CheckScreenSize = function () {
                var _width = $(window).outerWidth();
                var _height = $(window).outerHeight();
                if (_width <= 511) {
                    $("#heroHeader").css("background-image", imageSmCss);
                }
                else {
                    $("#heroHeader").css("background-image", imageBgCss);
                }
            })();
            $(window).resize(CheckScreenSize);
        });
        
    </script>
    }
        Header = chestTitle,
        Description = chestDescription,
        BenefitCards = chestCards?.Select(c => c as Card).ToList(),

    };

    //Create your won world of banking

    var tabs = (IEnumerable<IPublishedContent>)heroBody?.Children.Where(c => c.ContentType.Alias.ToLower() == "tabbody").ToList();

    ContentModels.TabBody newWaysOfBanking = null;
    ContentModels.TabBody createOwnWorldOfBanking = null;
    ContentModels.TabBody myWorldTermsAndConditions = null;
    ContentModels.TabBody myWorldBankAccount = null;

    tabs.ToList().ForEach(x =>
    {
        var partialName = x.Value("PartialViewName");

        if (partialName.ToString() == "_cardRenderDescribedCards")
        {
            createOwnWorldOfBanking = (TabBody)x;
        }
        else if (partialName.ToString() == "_renderPDFData")
        {
            myWorldTermsAndConditions = (TabBody)x;
        }
        else if (partialName.ToString() == "_pageRenderCardWithoutCaption")
        {
            newWaysOfBanking = (TabBody)x;
        }
        else
        {
            myWorldBankAccount = (TabBody)x;
        }
    });

    var imageItem = createOwnWorldOfBanking.Children.Where(x => x.ContentType.Alias == "ebankITItem2").ToList();
    // var blackCreditCardItem = createOwnWorldOfBanking.Children.Where(x => x.ContentType.Alias == "ebankITItem2").Last();
    
    var contentItem = imageItem.First().Value("ebankITContent"); 
    var applyNowBtn = imageItem.First().Value("sectionLink");
    
    var imageItem1 = myWorldBankAccount.Children.Where(x => x.ContentType.Alias == "ebankITItem2").FirstOrDefault();
    String imageValuePath1 = ((ContentModels.Image)((IPublishedContent)imageItem1.Value("ebankITImage"))).Url;
    
     Umbraco.Web.Models.Link buttonDocumentLink = null;
     if (imageItem1.Value("sectionLink") != null) 
     {
         foreach (var link in (IEnumerable<Umbraco.Web.Models.Link>)imageItem1.Value("sectionLink"))
         {

    huaweiButtonLink = (string.IsNullOrEmpty(huaweiButtonLink)) ? "#" : huaweiButtonLink;
    
    var applyNowButtonLink = "#";
    applyNowButtonLink = string.IsNullOrEmpty(applyNow?.EbankItbuttonInternalLink?.Url) ?

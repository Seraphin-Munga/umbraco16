    @section scripts
   {
        <script type="text/javascript">
            $(".internet-banking-row:even").css("background", "#FFFFFF 0% 0% no-repeat padding-box");
            $(".internet-banking-row:odd").css("background", "#F6F6F6 0% 0% no-repeat padding-box");
            $(".borderbottom:even").css("background", "#FFFFFF 0% 0% no-repeat padding-box");
            $(".borderbottom:odd").css("background", "#F6F6F6 0% 0% no-repeat padding-box");
            
            $(document).ready(function () {
                var imageBgCss = "url('" + "@headerImage_large" + "')";
                var imageMdCss = "url('" + "@headerImage_medium" + "')";
                var imageSmCss = "url('" + "@(string.IsNullOrEmpty(headerImage_small) ? headerImage_medium : headerImage_small)" + "')";
                var CheckScreenSize;
                (CheckScreenSize = function () {
                    var _width = $(window).outerWidth();
                    var _height = $(window).outerHeight();
                    if (_width <= 511) {
                        $("#heroHeader").css("background-image", imageSmCss);
                    }
                    else {
                        $("#heroHeader").css("background-image", imageBgCss);
                    }
                })();
                $(window).resize(CheckScreenSize);
            });
        </script>
    }

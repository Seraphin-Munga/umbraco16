@{
	Layout = "Master.cshtml";
	    @*All Current Page Children*@
    var children = Model.Children;
    var heroHeader = children?.Where(c => c.ContentType.Alias.ToLower() == "heroheader").FirstOrDefault();
    var heroShoulder1 = children?.Where(c => c.ContentType.Alias.ToLower() == "heroshoulder").FirstOrDefault();

    var heroBody = (HeroBody)children?.Where(c => c.ContentType.Alias.ToLower() == "herobody").FirstOrDefault();
    var footerDescription = heroBody.Value("richTextBox").ToString();

    var cardImageDescriptions = heroBody.Children(x => x is Card).ToList();
    var bodyCards = heroBody?.Children?.Where(c => c.ContentType.Alias.ToLower() == "card");
    var applyDocs = bodyCards?.Select(c => c as Card).FirstOrDefault();
    var cardImage = applyDocs.Value("cardIcon");
      String cardUrl = ((IPublishedContent)cardImage).Url.ToString();
    var cardLink= applyDocs.Value("buttonLink");
   
    var navigate = applyDocs.Value<IEnumerable<Umbraco.Web.Models.Link>>("buttonLink").FirstOrDefault();
   
    var tabGroup = heroBody.Children(x => x.ContentType.Alias.ToLower() == "tabgroup").FirstOrDefault();
    var tabHeader = tabGroup.Children(xx => xx.ContentType.Alias.ToLower() == "tabheader").FirstOrDefault();
    var tabBody = (TabBody)tabHeader.Children(cc => cc.ContentType.Alias.ToLower() == "tabbody").First();
    var headerImage_large = heroHeader?.Value<IPublishedContent>("image")?.Url;
    var headerImage_medium = heroHeader?.Value<IPublishedContent>("imageMedium")?.Url;
    var headerImage_small = heroHeader?.Value<IPublishedContent>("imageSmall")?.Url;
}


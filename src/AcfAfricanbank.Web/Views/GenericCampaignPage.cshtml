@section scripts
{
    <script type="text/javascript">

        function addFormValidation() {
            $('.form-horizontal').bootstrapValidator({
                feedbackIcons: {
                    valid: 'glyphicon glyphicon-ok-sign',
                    invalid: 'glyphicon glyphicon-remove-sign',
                    validating: 'glyphicon glyphicon-refresh'
                },
                fields: {
                    'howCanBankAddMore': {
                        message: 'Value inserted is not valid',
                        validators: {
                            notEmpty: {
                                message: 'Description is required'
                            },
                            regexp: {
                                regexp: /^[a-zA-Z]/,
                                message: 'Please insert a tip'
                            }, stringLength: {
                                max: 500,
                                message: 'Please make sure that your tip description is 500 max characters long.'
                            }
                        }
                    },
                    'firstName': {
                        message: 'Value inserted is not valid',
                        validators: {
                            notEmpty: {
                                message: 'Name required'
                            },
                            regexp: {
                                regexp: /^[a-zA-Z]/,
                                message: 'Please insert a valid name'
                            }, stringLength: {
                                max: 30,
                                message: 'Please make sure that the name is 30 max characters long.'
                            }
                        }
                    },
                    'cellPhone': {
                        message: 'Cellphone number entered is not valid',
                        validators: {
                            notEmpty: {
                                message: 'Cellphone number required'
                            },
                            numeric: {
                                message: 'Value entered can only be numeric'
                            },
                            stringLength: {
                                min: 10,
                                max: 10,
                                message: 'Cellphone can only be 10 characters long'
                            }
                        }
                    },
                    'email': {
                        message: 'Value inserted is not valid',
                        validators: {
                            notEmpty: {
                                message: 'Enter a valid email address'
                            },
                            regexp: {
                                regexp: /^[-a-z0-9~!$%^&*_=+}{\'?]+(\.[-a-z0-9~!$%^&*_=+}{\'?]+)*@@([a-z0-9_][-a-z0-9_]*(\.[-a-z0-9_]+)*\.(aero|arpa|biz|com|coop|edu|gov|info|int|mil|museum|name|net|org|pro|travel|mobi|[a-z][a-z])|([0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}))(:[0-9]{1,5})?$/i,
                                message: 'Please enter a valid email address'
                            }, stringLength: {
                                max: 30,
                                message: 'Please make sure only number is inserted.'
                            }
                        }
                    },
                    'ddInputResult0': {
                        validators: {
                            notEmpty: {
                                message: '@ResourceHelper.GetResource("GenericContactForm_SAID_Required")'
                            },
                            regexp: {
                                regexp: /^[0-9]{1,13}$/,
                                message: '@ResourceHelper.GetResource("GenericContactForm_SAID_ValMessage")'
                            },
                            stringLength: {
                                max: 13,
                                message: '@ResourceHelper.GetResource("GenericContactForm_SAID_LenghtValMessage")'
                            },
                            callback: {
                                callback: function (value, validator, $field) {

                                    var idNumber = value;

                                if (null === idNumber || 0 === idNumber.length) return !1;
                                var correct = !0;
                                    if (13 !== idNumber.length || isNaN(parseFloat(idNumber)) && isFinite(idNumber)) return !1;
                                    var yob = parseInt(idNumber.substring(0, 2));
                                    var currentYear = @DateTime.Now.Year;
                                    if (yob + 2000 < currentYear) {yob = 2000 + yob
                                    } else { yob = yob + 1900; }

                                var tempDate = new Date(idNumber.substring(0, 2), idNumber.substring(2, 4) - 1, idNumber.substring(4, 6)),
                                    id_date = tempDate.getDate(),
                                    id_month = tempDate.getMonth();
                                    if (currentYear - yob >= 70 || currentYear - yob < 18) {
                                        return {
                                            valid: false,
                                            message: '@ResourceHelper.GetResource("GenericContactForm_SAID_InvalidAge")'
                                        }
                                    } // make sure the applicant is not over 70 years of age or younger than 18
                                (tempDate.getYear() != idNumber.substring(0, 2) || id_month != idNumber.substring(2, 4) - 1 || id_date != idNumber.substring(4, 6)) && (correct = !1);
                                                                    for (var tempTotal = 0, checkSum = 0, multiplier = 1, i = 0; 13 > i; ++i) tempTotal = parseInt(idNumber.charAt(i)) * multiplier, tempTotal > 9 && (tempTotal = parseInt(tempTotal.toString().charAt(0)) + parseInt(tempTotal.toString().charAt(1))), checkSum += tempTotal, multiplier = multiplier % 2 === 0 ? 1 : 2;
                                return checkSum % 10 !== 0 && (correct = !1), correct

                                }
                            }
                        }
                    },
                    'ddInputResult1': {
                        message: 'Value inserted is not valid',
                        validators: {
                            notEmpty: {
                                message: 'Surname required'
                            },
                            regexp: {
                                regexp: /^[a-zA-Z]/,
                                message: 'Please insert a valid entry'
                            }
                        }
                    },
                }
            });
        }
        $(document).ready(function () {

            var imageBgCss = "url('" + "@headerImage_large" + "')";
            var imageMdCss = "url('" + "@headerImage_medium" + "')";
            var imageSmCss = "url('" + "@(string.IsNullOrEmpty(headerImage_small) ? headerImage_medium : headerImage_small)" + "')";
            var CheckScreenSize;
            (CheckScreenSize = function () {
                var _width = $(window).outerWidth();
                var _height = $(window).outerHeight();
                if (_width <= 511) {
                    $("#heroHeader").css("background-image", imageSmCss);
                }
                else {
                    $("#heroHeader").css("background-image", imageBgCss);
                }
            })();

            // OptOut Send start
            addFormValidation();
            $('.campaign-button').on('click', function (e) {
                $('.form-horizontal input').each(function () {
                    $(this).val("");
                    $(this).text = "";
                    if ($(this)[0].id !== "") {
                        $('.form-control-feedback[data-bv-icon-for="' + $(this)[0].id + '"]').hide();
                    }
                    $("#sendOptOut").attr("disabled", true);
                });
                $('.form-horizontal').valid()
                $('.form-horizontal input').each(function () {
                    var idError = $(this)[0].id + "-error";
                    if ($(this)[0].id !== "") {
                        $(idError).css("color", "red");
                    }
                });
            });
            $('#sendOptOut').on('click', function (e) {

                e.preventDefault();
                if ($('.form-horizontal').valid()) {
                    $('.hang-tight').show('slow');
                    $.ajax({
                        type: "POST",
                        headers: {'__RequestVerificationToken': $("input[name='__RequestVerificationToken']").val()},
                        url: '@Url.Action("SendSurveyMail", "Custom")',
                        data: $('.form-horizontal').serialize(),
                    }).done(function (html) {

                        console.log(html);
                    }).fail(function (e) {

                        console.log(e.responseText);
                    });
                    setTimeout(function () {
                        $('.hang-tight').hide('slow');

                        $('#generic')[0].children[0].children[0].children[0].children[1].innerHTML = 'Thank you!';
                        $('#generic').modal('show');
                        if ($('#sendOptOut').attr('disabled') === 'disabled') {
                            $('#sendOptOut').removeAttr('disabled');
                        }
                    }, 5000);
                }
            });
            function isFormValid() {
                var isControlEmpty = true;
                return isControlEmpty;
            }
        // OptOut Send end
    });
    </script>
}
<script>
$(document).on('click', '.video-placeholder', function () {
  const videoId = $(this).data('video-id');
  const iframe = `
    <iframe  id="modalIframe" width="100%" height="400"
      src="https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0&modestbranding=1"
      frameborder="0" allow="autoplay; encrypted-media" allowfullscreen>
    </iframe>`;
  $('#videoPlayer').html(iframe);
});

$('#videoModal').on('hidden.bs.modal', function () {
// debugger;
const $iframe = $('#modalIframe');
  // Step 1: Remove the iframe
  if ($iframe.length) {
      // Reset src and remove to ensure video is stopped
      $iframe.attr('src', '');
      $iframe.remove();
    }

    // Recreate empty container to allow reinjection next time
    $('#videoPlayer').remove();
 

  // Step 2: Wait a moment and re-add the container to avoid ghost playback
  setTimeout(function () {
    $('.embed-responsive').append('<div id="videoPlayer" class="embed-responsive-item"></div>');
  }, 100); // Delay ensures iframe removal registers
});




// Handle slide count
$(document).ready(function () {
  function updateSlideNumber() {
    var index = $('#testimonialCarousel .carousel-inner .item.active').index() + 1;
    var total = $('#testimonialCarousel .carousel-inner .item').length;
    $('#slideNumber .current-slide').text(index);
    $('#slideNumber .total-slides').text(total);
  }

  $('#testimonialCarousel').on('slid.bs.carousel', updateSlideNumber);

  // Initial setup
  updateSlideNumber();
});


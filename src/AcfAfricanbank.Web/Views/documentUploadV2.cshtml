<body-section>
  <div class="container">
    <div class="card">
      <h2>Document Upload</h2>
      <div class="subtitle">
        Please fill in the below and upload required documents
      </div>

      <div class="form-content row">
        <div class="form-section col-12 col-lg-6">
          <label for="idNumber">ID Number</label>
          <input type="text" id="idNumber" placeholder="e.g 8511335041094" />
          <span id="idNumber-error" class="error-text"
            >Please enter a valid ID number (13 digits).</span
          >

          <label for="mobileNumber">Mobile Number</label>
          <input type="text" id="mobileNumber" placeholder="e.g 082 123 4567" />
          <span id="mobileNumber-error" class="error-text"
            >Please enter a valid mobile number (10 digits).</span
          >

          <label for="passportNumber">Passport Number</label>
          <input type="text" id="passportNumber" placeholder="e.g AB012345" />

          <label for="email">Email</label>
          <input type="email" id="email" placeholder="e.g john@email.com" />
          <span id="email-error" class="error-text"
            >Please enter a valid email address.</span

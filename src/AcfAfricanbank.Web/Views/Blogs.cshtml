                                            <li><a href="?category=Insurance">Insurance</a></li>
                                        </ul>
                                    </li>
    
                                    <li class="hidden-xs hidden-sm sub-menu-items-bold li-css disabled">
                                        <a href="?category=All">
                                            <i style="padding-right: 5px" class="fa fa-lightbulb-o" aria-hidden="true"></i>
                                            All
                                        </a>
                                    </li>
                                    <li class="hidden-xs hidden-sm sub-menu-items-bold li-css"><a href="?category=Loans">Loans</a></li>
                                    <li class="hidden-xs hidden-sm sub-menu-items-bold li-css"><a href="?category=Investments">Investments</a></li>
                                    <li class="hidden-xs hidden-sm sub-menu-items-bold li-css"><a href="?category=Banking">Banking</a></li>
                                    <li class="hidden-xs hidden-sm sub-menu-items-bold li-css"><a href="?category=Insurance">Insurance</a></li>

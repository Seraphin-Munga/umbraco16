                </div>
            </div>
        </div>
    </div>
    <div class="container main-container">
        <div class="row">
            <div id="notFoundDiv" class="col-xs-12 col-sm-12 col-md-12" style="color: red; font-weight: bold; font-size: 24px; text-align-last: center; margin-top: 10px; display:@showNoContent">No Blogs Found</div>
            <div class="container">
                <div class="row">
                    <div class="col-xs-12 hidden-sm hidden-md hidden-lg search-main">
                        <form id="lg-md-show-search" class="navbar-form  content-padding-10 ng-pristine ng-valid ng-submitted" style="display: flex;" action="?">
                            <input type="text" class="searchTerm" placeholder="Search for blog..." id="searchstring" name="searchstring">
                            <button type="submit" id="btnSubmit" class="searchButton">
                                <i class="fa fa-search"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
    
            @{
                if (!string.IsNullOrEmpty(Request.QueryString["searchstring"]))
                {
                    @Html.Partial("_blogLandingSearchResult");
                }
            }
    
            @if ((indexString == "") || (!string.IsNullOrEmpty(Request.QueryString["category"])))
            {
                foundResults = TupleBlogs.Count();
                if (indexString != "")
                {
                    <div class="col-xs-12 col-sm-12 col-md-12" style="margin-top:20px">
                        Showing (<span>@foundResults</span>) results for: <i class="resulting-span">@indexString</i>
                    </div>
                }
                if (TupleBlogs.Count() != 0)
                {
                    <div id="divMainBlog" class="col-lg-8 col-xs-12 ">
                        <div class="article-card">
                            <div class="video-item video_list_item" style="margin-top: 0px !important;height:100%;">
                                <div class="blog-image">
                                     @if(indexString == "")
                                {
                                    <a class="ahref" href="@TupleBlogs.First().Item5">
                                        <div id="imgMain" class="image" style="background-image: url('@TupleBlogs.First().Item2');"></div>
                                        <div style="height: 0px !important;">
                                            <div id="titleMain" class="article-title">
                                                @TupleBlogs.First().Item3
                                            </div>
                                            <div id="descriptionMain" class="body-content">
                                                @TupleBlogs.First().Item4
                                            </div>
                                            <div id="divMainReadMore">
                                                <div class="readMoreLink">
                                                    <a href="@TupleBlogs.First().Item5"></a>
                                                </div>
                                                <div class="publishDate">
                                                    <span class="date-output"><i>Publish Date: @TupleBlogs.First().Item6.ToShortDateString()</i></span>
                                                </div>
                                            </div>
                                        </div>
                                    </a>
                                }
                                else
                                {
                                    <a class="ahref" href="@TupleBlogs.First().Item5?category=@indexString">
                                        <div id="imgMain" class="image" style="background-image: url('@TupleBlogs.First().Item2');"></div>
                                        <div style="height: 0px !important;">
                                            <div id="titleMain" class="article-title">

@inherits Umbraco.Web.Mvc.UmbracoViewPage
@{
	Layout = "Master.cshtml";
}

@* the fun starts here *@

<style>
    .mb--25{
      margin-top:-25px;  
    }
  .mtb-100 {
    padding-top: 32px;
    margin-bottom: 100px;
  }

  .btn-primary:hover {
    color: #fff;
    background-color: #5dc400;
    border-color: none;
  }

  .section-1-heading {
    font-size: 72px;
    font-style: normal;
    font-weight: 500;
    line-height: 90px;
    letter-spacing: -1.44px;
    margin-top: 64px;
  }

  .btn-Explore {
    display: flex;
    width: 200px;
    height: 48px;
    padding: 12px 16px;
    justify-content: center;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .btn-Explore svg {
    margin-top: 0; /* Remove the negative margin */
  }

  #section-1 {
    min-height: 450px;
  }
  #section-3 {
    height: 266px;
  }
  .customer-container {
    height: 200px;
  }

  .three-cards {
    top: 40px;
    position: relative;
  }

  .flex-container__cta-2 {
    display: flex;
    gap: 34px;
  }

  .icon-box {
    display: flex;
  }

  .icon-box__icon {
    margin-right: 24px;
  }

  .mt-64 {
    margin-top: 64px;
  }

  .welcome-section {
    border-radius: 8px;
    background: #fff;
    padding: 45px 32px;
    box-shadow: 0px 9px 18px 0px rgba(0, 0, 0, 0.15);
  }

  .text-style {
    color: var(--Brand-AB-Blue, #012b60);
    font-size: 30px;
    margin-bottom: 32px;
    font-weight: 600;
    line-height: 38px; /* 126.667% */
  }

  .bottom-section {
    background-color: #5dc300 !important;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 7.906px;
  }
  .image-section {
    margin-bottom: -200px;
  }
  .image-position {
    width: 350px;
    height: 100%;
    margin-top: 12px;
    flex-shrink: 0;
    aspect-ratio: 1/1;
  }

  /*Back button start here*/
  .back-section {
    display: flex;
    background: white;
    min-height: 50px;
    align-items: center;
  }

  .back-section button {
    background: none !important;
    border: none !important;
  }

  /*Back button end here*/

  .custom-card {
    overflow: none;
    border-radius: 10px;
    background-color: white;
  }
  .custom-container {
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  .custom-row {
    flex-grow: 1;
  }

  .bg-nothing-white {
    min-height: 60px;
  }

  .bg-blue {
    background-color: #002b60;
    color: white;
  }
  .bg-white {
    background-color: white;
    color: #012b60;
    margin-bottom: 100px;
  }
  .bg-grey {
    background: linear-gradient(
      180deg,
      rgba(245, 245, 245, 1) 81%,
      rgba(255, 255, 255, 1) 81%
    );
  }

  .content-center {
    display: flex;
    align-content: center;
    align-items: center;
  }
  .content-center-2 {
    display: flex;
    height: 150px;
    align-content: center;
    align-items: flex-end;
  }

  .content-sub-start {
    display: grid;
    align-content: start;
    align-items: start;
  }
  .content-sub-start p {
    margin-right: 250px !important;
  }

  .content-sub-start-2 {
    display: grid;
    align-content: start;
    align-items: start;
  }

  .content-sub-start-3 {
    display: grid;
    align-content: start;
    align-items: start;
    font-size: 15px;
  }

  .mtb-40 {
    margin: 40px 0px !important;
  }
  .mt-40 {
    margin: 40px 0px !important;
  }
  .mtb-32 {
    margin: 32px 0px !important;
  }
  /*Cards Css start here*/
  .business-section {
    padding: 50px 0;
    text-align: center;
  }
  .business-section h2 {
    color: #002f6c;
    font-weight: bold;
  }
  .business-section p {
    font-size: 16px;
    color: #4f5b66;
    max-width: 800px;
    margin: 0 auto;
  }
  .account-card h3 {
    color: var(--Brand-AB-Blue, #012b60);
    /* Heading/H4/Semibold */
    font-family: Montserrat;
    font-size: 24px;
    font-style: normal;
    font-weight: 600;
    line-height: 32px; /* 133.333% */
  }

  .flex__container {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    margin-top: 32px;
    width: 100%px;
    height: 314px;
    padding: 20px;
    text-align: left;
    border-radius: 8px;
    background: var(--Base-White, #fdfdfd);
    /* Shadows Light Mode/MD */
    box-shadow: 0px 9px 18px 0px rgba(0, 0, 0, 0.15);
  }

  .flex-container-content__title {
    font-family: Montserrat;
    font-size: 24px;
    color: #012b60;
    font-weight: 600;
    line-height: 32px; /* 133.333% */
  }
  .account-card {
    width: 344px;
    height: 314px;
    padding: 20px;
    text-align: left;
    border-radius: 8px;
    background: var(--Base-White, #fdfdfd);
    /* Shadows Light Mode/MD */
    box-shadow: 0px 9px 18px 0px rgba(0, 0, 0, 0.15);
  }
  .card-divider {
    width: 100%;
    height: 1px;
    background-color: #5dc303;
    margin: 10px 0;
  }
  .btn-learn {
    border: 1px solid #002f6c;
    color: #002f6c;
    padding: 10px 20px;
    border-radius: 8px;
    transition: 0.3s;
  }
  .btn-learn:hover {
    background-color: #002f6c;
    color: #fff;
  }
  .btn-apply,
  .btn-download {
    background-color: #5dc400;
    border: none;
    padding: 10px 20px;
    border-radius: 2px;
    color: white;
    font-weight: bold;
  }

  .btn-apply:hover,
  .btn-download:hover {
    background-color: #5dc400;
    color: white;
  }

  .btn-apply,
  .btn-outline {
    background-color: #fff;
    border: 1px solid #002b60;
    padding: 10px 20px;
    border-radius: 2px;
    color: #002b60;
    font-weight: bold;
  }

  .btn-apply:hover,
  .btn-outline:hover {
    background-color: #fff;
    color: #002b60;
  }
  .card-image {
    position: absolute;
    top: -15px;
    right: 10px;
    width: 80px;
  }
  .get-in-touch {
    position: fixed;
    right: 0;
    top: 50%;
    background: #002f6c;
    color: white;
    padding: 10px;
    writing-mode: vertical-rl;
    text-orientation: mixed;
    border-radius: 8px 0 0 8px;
    cursor: pointer;
  }
  /*Cards Css end here*/

  .content-sub-heading {
    font-weight: 500;
    font-size: 68px !important;
    line-height: 90px;
    margin-bottom: 72px; /* Paragraph spacing */
    letter-spacing: -2%;
  }

  .section-1-subheading {
    font-size: 20px;
    font-weight: 400;
    line-height: 30px;
    margin-top: 24px;
    margin-bottom: 57px;
  }
  .card-p-text {
    color: var(--Brand-AB-Blue, #012b60);
    /* Body/Medium/Regular */
    font-family: Montserrat;
    font-size: 16px;
    font-style: normal;
    font-weight: 400;
    line-height: 24px; /* 150% */
  }

  @@media (max-width: 768px) {
    /* Add this to reverse column order */
    #section-1 .row {
      display: flex;
      flex-direction: column-reverse;
    }
    
    .flex__container{
      width: 290px;
    }

    .image-section {
      order: -1;
      margin-bottom: 30px !important;
      display: flex;
      justify-content: center;
    }

    /* Previous mobile styles remain */

    .section-1-heading {
      padding: 0 15px;
      font-size: 27px !important;
      line-height: 45px !important;
      letter-spacing: -0.72px;
    }
    #section-1,
    #section-3 {
      height: auto !important;
      padding: 40px 0;
    }

    .customer-container {
      height: auto !important;
    }

    .image-position {
      width: 100%;
      max-width: 300px;
      height: auto;
    }

    .three-cards {
      top: 0 !important;
      position: relative !important;
    }

    .account-card {
      margin-bottom: 30px;
      min-height: auto;
    }

    .content-center {
      height: auto;
      padding: 30px 0;
    }

    .text-style {
      font-size: 24px !important;
      line-height: 32px !important;
    }

    .section-1-subheading {
      font-size: 16px;
      line-height: 24px;
      padding: 0 15px;
    }

    .btn-Explore {
      width: 100% !important;
    }

    .content-sub-start p {
      margin-right: 0 !important;
    }

    .content-center-2 {
      height: auto;
      padding-bottom: 20px;
    }

    .bottom-section {
      width: 100%;
    }
  }
  /* Existing CSS remains the same */
</style>

    </script> 
    
  <script type="text/javascript">
    $(document).ready(function () {

        function OnSuccess(data) { }
        function OnFailure(data) { }

        function DropDown(el) {
            this.dd = el;
            this.placeholder = this.dd.children('span');
            this.opts = this.dd.find('ul.dropdown > li');
            this.val = '';
            this.index = -1;
            this.initEvents();
        }
        DropDown.prototype = {
            initEvents: function () {
                var obj = this;

                obj.dd.on('click', function (event) {
                    $(this).toggleClass('active');
                    $(this).children('input')[0].innerText = $(this)[0].children[1].innerText;
                    if ($("#sendSurvey").attr("disabled") === "disabled") {
                        $("#sendSurvey").attr("disabled", false);
                    }
                    if ($(this)[0].id === "dd0") {
                        $("#validSelection0").css("display", "none");
                        $("#ddInputResult0")[0].value = $(this)[0].children[1].innerText;
                    } else if ($(this)[0].id === "dd1") {
                        $("#validSelection1").css("display", "none");
                        $("#ddInputResult1")[0].value = $(this)[0].children[1].innerText;
                    } else if ($(this)[0].id === "dd2") {
                        $("#validSelection2").css("display", "none");
                        $("#ddInputResult2")[0].value = $(this)[0].children[1].innerText;
                    } else if ($(this)[0].id === "dd3") {
                        $("#validSelection3").css("display", "none");
                        $("#ddInputResult3")[0].value = $(this)[0].children[1].innerText;
                    }
                    return false;
                });

                obj.opts.on('click', function () {
                    var opt = $(this);
                    obj.val = opt.text();
                    obj.index = opt.index();
                    obj.placeholder.text(obj.val);
                });
            },
            getValue: function () {
                return this.val;
            },
            getIndex: function () {
                return this.index;
            }
        }

        $(function () {
            var dd = new DropDown($('#dd0'));
            var dd1 = new DropDown($('#dd1'));
            var dd2 = new DropDown($('#dd2'));
            var dd3 = new DropDown($('#dd3'));
            $(document).click(function () {
                // all dropdowns
                $('.wrapper-dropdown-3').removeClass('active');
            });

        });
        
        
        // Mail Send start
        function addFormValidation() {
            $('.form-horizontal').bootstrapValidator({
                feedbackIcons: {
                    valid: 'glyphicon glyphicon-ok-sign',
                    invalid: 'glyphicon glyphicon-remove-sign',
                    validating: 'glyphicon glyphicon-refresh'
                },
                fields: {
                    'howCanBankAddMore': {
                        message: 'Text entered inserted is not valid',
                        validators: {
                            notEmpty: {
                                message: 'Input required'
                            },
                            regexp: {
                                regexp: /^[a-zA-Z]/,
                                message: 'Please insert a valid name'
                            }, stringLength: {
                                max: 500,
                                message: 'Please make sure the text entered is 500 characters long.'
                            }
                        }
                    },
                    'firstName': {
                        message: 'Value inserted is not valid',
                        validators: {
                            notEmpty: {
                                message: 'Name required'
                            },
                            regexp: {
                                regexp: /^[a-zA-Z]/,
                                message: 'Please insert a valid name'
                            }, stringLength: {
                                max: 30,
                                message: 'Please make sure that the name is 30 max characters long.'
                            }
                        }
                    },
                    'cellPhone': {
                        message: 'Cellphone number entered is not valid',
                        validators: {
                            notEmpty: {
                                message: 'Cellphone number required'
                            },
                            numeric: {
                                message: 'Value entered can only be numeric'
                            },
                            stringLength: {
                                min: 10,
                                max: 10,
                                message: 'Cellphone can only be 10 characters long'
                            }
                        }
                    },
                    'email': {
                        message: 'Value inserted is not valid',
                        validators: {
                            notEmpty: {
                                message: 'Enter a valid email address'
                            },
                            regexp: {
                                regexp: /^[-a-z0-9~!$%^&*_=+}{\'?]+(\.[-a-z0-9~!$%^&*_=+}{\'?]+)*@@([a-z0-9_][-a-z0-9_]*(\.[-a-z0-9_]+)*\.(aero|arpa|biz|com|coop|edu|gov|info|int|mil|museum|name|net|org|pro|travel|mobi|[a-z][a-z])|([0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}))(:[0-9]{1,5})?$/i,
                                message: 'Please enter a valid email address'
                            }, stringLength: {
                                max: 30,
                                message: 'Please make sure only number is inserted.'
                            }
                        }
                    }
                }
            });
        }
        addFormValidation();
            
        $('#sendSurvey').on('click', function (e) {
            e.preventDefault();
                $('.hang-tight').show('slow');
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("SendSurveyMail", "Custom")',
                    data: $('.form-horizontal').serialize(),
                }).done(function (html) {
                    console.log(html);
                    }).fail(function (e) {
                        console.log(e.responseText);
                });
                setTimeout(function () {
                    $('.hang-tight').hide('slow');

                    $('#generic')[0].children[0].children[0].children[0].children[1].innerHTML = 'Thank you!';
                    $('#generic').modal('show');
                    if ($('#sendSurvey').attr('disabled') === 'disabled') {
                        $('#sendSurvey').removeAttr('disabled');
                    }
                }, 5000);
        });
        function isFormValid() {
            var isControlEmpty = false;
            
            if (typeof($("#ddInputResult0")[0]) !== "undefined") {
               if ($("#ddInputResult0")[0].value === "[select from options below]") {
                    isControlEmpty = false;
                    $("#sendSurvey").attr("disabled", true);
                    $("#validSelection0").css("display", "block");
                    return isControlEmpty;
                } else {
                    $("#validSelection0").css("display", "none");
                }
            }
            
            /* if ($("#ddInputResult0")[0].value === "[select from options below]") {
                isControlEmpty = false;
                $("#sendSurvey").attr("disabled", true);
                $("#validSelection0").css("display", "block");
                return isControlEmpty;
            } else {
                $("#validSelection0").css("display", "none");
            } */

            if ($("#ddInputResult1")[0].value === "[select from options below]") {
                isControlEmpty = false;
                $("#sendSurvey").attr("disabled", true);
                $("#validSelection1").css("display", "block");
                return isControlEmpty;
            } else {
                $("#validSelection1").css("display", "none");
            }

            if ($("#ddInputResult2")[0].value === "[select from options below]") {
                isControlEmpty = false;
                $("#sendSurvey").attr("disabled", true);
                $("#validSelection2").css("display", "block");
                return isControlEmpty;
            } else {
                $("#validSelection2").css("display", "none");
            }

            if ($("#ddInputResult3")[0].value === "[select from options below]") {
                isControlEmpty = false;
                $("#sendSurvey").attr("disabled", true);
                $("#validSelection3").css("display", "block");
                return isControlEmpty;
            } else {
                $("#validSelection3").css("display", "none");
            }

            $('.form-horizontal input').each(function () {
                if ($(this).val() === "") {
                    isControlEmpty = false;
                    return isControlEmpty;
                } else if ($(this).val() === "[select from options below]") {
                    isControlEmpty = false;
                    return isControlEmpty;
                }
                else {
                    isControlEmpty = true;
                }
            });
            return isControlEmpty;
        }
        // Mail Send end
        
    });
</script>
}
                                var buttonText = links.Name;
                                var btnId = viewName + "_" + buttonText.ToString().Replace(" ", "") + "_" + "SowetanLiveCampaign";
                                <div class="switch-mobi-view">
                                    <a class="button primary clearfix" href="@links.Url" id="@btnId">
                                       @buttonText
                                    </a>
                                </div>
                            }
                        }
                    }
                </div>
            </div>
        </div>
    }
}


        @*<div class="top_extend item" style="background-size: cover;background: url('/media/2jcjw4xu/landing2.jpg')no-repeat;background-position: 40% 25%;">*@
        <div class="top_extend item" style="background-size: cover;background: url('https://www.africanbank.co.za/media/54605/landing-page_myworld.jpg')no-repeat;background-position: 40% 25%;">
            <div class="container">
                <div class="col-md-8"></div>

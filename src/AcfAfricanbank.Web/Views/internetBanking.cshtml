    // All Current Page Children
    var children = Model.Children;
    var heroHeader = children?.Where(c => c.ContentType.Alias.ToLower() == "heroheader").FirstOrDefault();
    var heroShoulder = children?.Where(c => c.ContentType.Alias.ToLower() == "heroshoulder").FirstOrDefault();
    var heroChest = children?.Where(c => c.ContentType.Alias.ToLower() == "herochest").FirstOrDefault();
    var heroBody = (HeroBody)children?.Where(c => c.ContentType.Alias.ToLower() == "herobody").FirstOrDefault();
    
    var bodyFooterTitle = heroBody?.Value("bodyFooterTitle").ToString();
    // Get Properties from children
    var tableItems = heroBody.Children(x => x is TableChecklist).FirstOrDefault();
    var chestTitle = heroChest?.Value("chestTitle").ToString();
    var chestDescription = heroChest?.Value("chestDescription").ToString();
    var chestCards = heroChest?.Children?.Where(c => c.ContentType.Alias.ToLower() == "card");

    var internetBankingItemsModel = new CustomModels.Benefits
    {
        Header = chestTitle,
        Description = chestDescription,
        BenefitCards = chestCards.Select(c => c as Card).ToList()
    };

    var tabGroup = heroBody.Children(x => x.ContentType.Alias.ToLower() == "tabgroup").FirstOrDefault();
    var tabHeader = tabGroup.Children(xx => xx.ContentType.Alias.ToLower() == "tabheader").FirstOrDefault();
    var tabBody = (TabBody)tabHeader.Children(cc => cc.ContentType.Alias.ToLower() == "tabbody").FirstOrDefault();

    var mobileBlurpData = heroBody.Children(x => x.ContentType.Alias.ToLower() == "richtexteditor").FirstOrDefault();
    var mobileBlurp = mobileBlurpData.Value("TextEditor");
    
    @*NEW CONTENT*@
     var firstsection = heroBody.Children.Where(c => c.Name == "OnlineSection").FirstOrDefault();

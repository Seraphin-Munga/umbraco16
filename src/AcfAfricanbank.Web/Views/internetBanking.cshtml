                    @tabHeader.Value("ebankITIconTitle")
                </li>
            </ul>
        </div>
    </div>
</div>

@Html.Partial("_pageRenderOnlineBankingCard", tabBody as ContentModels.TabBody)

<div class="number-to-call">@Html.Raw(@heroBody.Value("richTextBox"))</div>

<div class="online-banking-container">
    <div class="container">
        <div style="text-align:center">
            <div style="margin-top:20px">
                <h2>Features available online</h2>
            </div>
        </div>

        @{

            int mobiIterator = 1;
            string mobiAccordionName = null;

            foreach (var mobiItem in (IEnumerable<NCtabularInfo>)tableItems.Value("Data"))
            {
                mobiAccordionName = "accordion" + mobiIterator.ToString();
                <div class="mobi-table" style="width:  100%;padding: 0px;left:  0;">
                    <div data-toggle="collapse" data-target=".@mobiAccordionName" class="clickable tr-category">
                        <div class="arrow-container">
                            @{ var mobiIconName = "mobiIcon" + @mobiIterator.ToString(); }
                            <i id="@mobiIconName" style="float: right;"><span class="fa fa-arrow-down"></span></i>
                        </div>
                        <b>@mobiItem.Value("category")</b>
                    </div>
                    @foreach (var mobiData in (IEnumerable<NCtabularData>)mobiItem.Value("tabularData"))
                    {
                        <div class="row @mobiAccordionName collapse" aria-expanded="false" style="text-align: left; width: 100%; margin-top: 0px; padding: 25px; height: 50px;">
                            <h3 style="color: #fff;text-align:  left;font-size: 24px;margin-bottom:  18px;">
                                @mobiData.Value("action")
                            </h3>

                            @{

                                if (mobiItem.Value("category").ToString() == "All")
                                {
                                    <div class="col-xs-4"><img src="/media/cznhvbf1/yes-internet-banking-icon.svg" alt="yes-internet-banking-icon" width="80%"></div>
                                    <div class="col-xs-4"><img src="/media/keig23yt/icon_yes_app.svg" alt="icon-yes-app" width="80%"></div>
                                    <div class="col-xs-4"><img src="/media/0twjqhgz/icon_yes_cell.svg" alt="icon-yes-cell" width="80%"></div>
                                }
                                else
                                {
                                    var mobiOption = (IEnumerable<BankingOptions>)mobiData.Value("bankingOptions");

                                    BankingOptions internetBanking, africanBankApp, cellPhoneBanking = null;

                                    internetBanking = (BankingOptions)mobiOption.ToList()[0];
                                    africanBankApp = (BankingOptions)mobiOption.ToList()[1];
                                    cellPhoneBanking = (BankingOptions)mobiOption.ToList()[2];

                                    if (internetBanking.OptionForBanking == "Internet Banking" && (bool)internetBanking.IsSelected)
                                    {
                                        <div class="col-xs-4"><img src="/media/cznhvbf1/yes-internet-banking-icon.svg" alt="yes-internet-banking-icon" width="80%" /></div>
                                    }
                                    else
                                    {
                                        <div class="col-xs-4"><img src="/media/lxwdcgq3/no-internet-banking-icon.svg" alt="no-internet-banking-icon" width="80%" /></div>
                                    }

                                    if (africanBankApp.OptionForBanking == "African Bank App" && (bool)africanBankApp.IsSelected)
                                    {
                                        <div class="col-xs-4"><img src="/media/keig23yt/icon_yes_app.svg" alt="icon-yes-app" width="80%" /></div>
                                    }
                                    else
                                    {
                                        <div class="col-xs-4"><img src="/media/jd2hm45r/icon_no_app.svg" alt="icon-no-app" width="80%" /></div>
                                    }

                                    if (cellPhoneBanking.OptionForBanking == "CellPhone Banking" && (bool)cellPhoneBanking.IsSelected)
                                    {
                                        <div class="col-xs-4"><img src="/media/0twjqhgz/icon_yes_cell.svg" alt="icon-yes-cell" width="80%" /></div>
                                    }
                                    else
                                    {
                                        <div class="col-xs-4"><img src="/media/w01dqi1p/icon_no_cell.svg" alt="icon-no-cell" width="80%" /></div>
                                    }
                                }
                            }
                        </div>
                    }
                </div>
                ++mobiIterator;
            }

            <div class="row desk-table">
                <div class="col-md-12">
                    <div class="margin-top-50">
                        <form class="form-horizontal">
                            <div class="form-group">
                                <table class="checklist-table" table width="100%" border="1" cellpadding="10" bordercolor="#00132a">
                                    <tr class="checklist-headers">
                                        <th class="empty-table-header"></th>
                                        <th>Internet Banking</th>
                                        <th>African Bank App</th>
                                        <th>CellPhone Banking</th>
                                        <th>Whatsapp Banking</th>
                                    </tr>
                                    @{
                                        int iterator = 1;
                                        string accordionName = null;

                                        foreach (var item in (IEnumerable<NCtabularInfo>)tableItems.Value("Data"))
                                        {
                                            accordionName = "accordion" + iterator.ToString();
                                            <tr data-toggle="collapse" data-target=".@accordionName" class="clickable tr-category">

                                                <td colspan="5">

                                                    <div class="arrow-container">
                                                        <b>@item.Value("category")</b>
                                                        @{ var iconName = "icon" + iterator.ToString(); }
                                                        <i id="@iconName" style="float: right;"><span class="fa fa-arrow-down"></span></i>
                                                    </div>
                                                </td>

                                            </tr>
                                            foreach (var data in (IEnumerable<NCtabularData>)item.Value("tabularData"))
                                            {

                                                if (data.Value("action").ToString() == "Apply online")
                                                {
                                                    if (item.Value("category").ToString() == "LOAN")
                                                    {
                                                        int actionIterator = 0;
                                                        <tr class="@accordionName collapse">
                                                            <td>
                                                                @data.Value("action")
                                                            </td>
                                                            @foreach (var options in (IEnumerable<BankingOptions>)data.Value("bankingOptions"))
                                                            {
                                                                if (actionIterator == 1)
                                                                {
                                                                    <td style="text-align:center">Call back</td>
                                                                    break;
                                                                }
                                                                bool isSelected = (bool)options.Value("isSelected");
                                                                <td style="text-align:center">
                                                                    <i class="@(isSelected ? "fa fas fa-check-circle fa-2x" : "")" style="color:green;"></i>
                                                                </td>
                                                                actionIterator += 1;
                                                            }
                                                            <td style="text-align:center">Call back</td>
                                                        </tr>
                                                    }
                                                    else if (item.Value("category").ToString() == "CREDIT CARD")
                                                    {
                                                        int actionIterator = 0;
                                                        <tr class="@accordionName collapse">
                                                            <td>
                                                                @data.Value("action")
                                                            </td>
                                                            @foreach (var options in (IEnumerable<BankingOptions>)data.Value("bankingOptions"))
                                                            {
                                                                if (actionIterator == 1)
                                                                {
                                                                    <td style="text-align:center"></td>
                                                                    break;
                                                                }
                                                                bool isSelected = (bool)options.Value("isSelected");
                                                                <td style="text-align:center">
                                                                    <i class="@(isSelected ? "fa fas fa-check-circle fa-2x" : "")" style="color:green;"></i>
                                                                </td>
                                                                actionIterator += 1;
                                                            }
                                                            <td style="text-align:center">Call back</td>
                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    <tr class="@accordionName collapse">
                                                        <td>
                                                            @data.Value("action")
                                                        </td>
                                                        @foreach (var options in (IEnumerable<BankingOptions>)data.Value("bankingOptions"))
                                                        {
                                                            bool isSelected = (bool)@options.Value("isSelected");
                                                            <td style="text-align:center">
                                                                <i class="@(isSelected ? "fa fas fa-check-circle fa-2x" : "")" style="color:green;"></i>
                                                            </td>
                                                        }
                                                    </tr>
                                                }


                                            }
                                            ++iterator;
                                        }
                                    }
                                </table>
                            </div>
                        </form>
                    </div>
                </div>

            </div>
        }
    </div>
</div>





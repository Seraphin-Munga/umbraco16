@inherits Umbraco.Web.Mvc.UmbracoViewPage<ContentModels.PageCampaign>
@using ContentModels = Umbraco.Web.PublishedModels;
@using CustomModels = Web.Models;
@using Web.Helpers
@using Umbraco.Web.Models
@using System.Text.RegularExpressions

@{
    Layout = "Master.cshtml";
    var children = Model.Children;
    var heroBody = children?.Where(c => c.ContentType.Alias.ToLower() == "herobody").FirstOrDefault();
    
    
    var bodyCards = heroBody?.Children?.Where(c => c.ContentType.Alias.ToLower() == "card");
    var applyDocs = bodyCards?.Select(c => c as Card).FirstOrDefault();
    var cardImage = applyDocs.Value("cardIcon");
      String cardUrl = ((IPublishedContent)cardImage).Url.ToString();
    var cardLink= applyDocs.Value("buttonLink");
   
    var navigate1 = applyDocs.Value<IEnumerable<Umbraco.Web.Models.Link>>("buttonLink").FirstOrDefault();
    var navigate2 = applyDocs.Value<IEnumerable<Umbraco.Web.Models.Link>>("buttonLink").Last();
    
     var info= heroBody.Children.Where(c => c.Name == "Information").FirstOrDefault();
      var infocard = info.Value<IEnumerable<IPublishedElement>>("tabBodyContent");
      var infocards = infocard.Where(c => c.ContentType.Alias == "nCTabGenericContent").FirstOrDefault().Value<IEnumerable<IPublishedElement>>("sectionContent");
    
}

@inherits Umbraco.Web.Mvc.UmbracoViewPage<ContentModels.PageTalkAndFindUs>
@using ContentModels = Umbraco.Web.PublishedModels;
@using Web.Helpers;
@{
    Layout = "Master.cshtml";
    // All Current Page Children
    var Children = Model.Children;

    // Get specific Children
    // var HeroHeader = Children?.Where(c => c.DocumentTypeAlias.ToLower() == "heroheader").FirstOrDefault();
    var HeroShoulder = Children?.Where(c => c.ContentType.Alias.ToLower() == "heroshoulder").FirstOrDefault();
    var HeroBody = Children?.Where(c => c.ContentType.Alias.ToLower() == "herobody").FirstOrDefault();
    
    // var buttons = HeroBody.Children?.Where(c => c is Umbraco.Web.PublishedContentModels.EbankItabstractButton).ToList(); 
    
    var Tabs = HeroBody.Children.ToList();
    var bodyStyle = ".stick { top: unset; position: unset; z-index: unset; width: unset;}" +
                    ".navPadding {display: none}" +
                    ".hero-static-caption { margin-top: 60px; border-radius: 0px 0px 0 0;}";
}
<!-- HERO BANNER -->
<style type="text/css">
    @bodyStyle
</style>
<!-- HERO CONTINUED-->
@Html.Partial("_pageShoulder", HeroShoulder as ContentModels.HeroShoulder)
<!-- Body -->
@Html.Partial("_partialRegisterOrLogin")
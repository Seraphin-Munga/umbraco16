@functions
    {
    // Server-side browser sniffing (HttpContext.Current/HttpBrowserCapabilities)
    // doesn't exist in ASP.NET Core. The original check only allowlisted
    // Chrome/Opera/Android anyway (didn't even cover Firefox/Safari/Edge,
    // which also support WebP) - virtually every current browser supports
    // WebP now, so this just always serves the .webp variant.
    private static bool CanBrowserHandleWebPImages()
    {
        return true;
    }

    public static Microsoft.AspNetCore.Html.HtmlString PlaceImageBackground(string imageUrl)
    {
        if (CanBrowserHandleWebPImages())
        {
            // Get the file type
            string fileType = Path.GetExtension(imageUrl);
            if (fileType != null)
            {
                imageUrl = imageUrl.Replace(fileType, ".webp");
            }

            return new Microsoft.AspNetCore.Html.HtmlString(String.Format("url('{0}') ", imageUrl));
        }

        return new Microsoft.AspNetCore.Html.HtmlString(String.Format("url('{0}') ", imageUrl));
    }

    public static Microsoft.AspNetCore.Html.HtmlString PlaceImage(string imageUrl, string alt, string cssStyle)
    {
        if (CanBrowserHandleWebPImages())
        {
            // Get the file type
            string fileType = Path.GetExtension(imageUrl);
            if (fileType != null)
            {
                imageUrl = imageUrl.Replace(fileType, ".webp");
            }

            return new Microsoft.AspNetCore.Html.HtmlString(String.Format("<img src=\"{0}\" " + "alt=\"{1}\" " + "style=\"{2}\"  />", imageUrl, alt, cssStyle));
        }

        return new Microsoft.AspNetCore.Html.HtmlString(String.Format("<img src=\"{0}\" " + "alt=\"{1}\" " + "style=\"{2}\"/>", imageUrl, alt, cssStyle));
    }
}
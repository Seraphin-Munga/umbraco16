                                }
                                else {
                                    $(element).attr("src", + "../" + imagePath);
                                }
                                $(element).removeClass('lazyimage');
                                revealNextImage();
                            })
                            // .attr('src', imagePath)
                            .css("background-image", "url(" + imagePath + ")");
                    }
                }

                function revealNextImage() {
                    replaceThisLazyImage($('.lazyimage:not(img):first')[0], true);

       @*new code end*@ 
    ContentModels.TabBody panelWarning = null;
    tabs.ToList().ForEach(x =>
    {
        var partialName = x.Value("partialViewName");

        switch (partialName.ToString())
        {
            case "panelWarning":
                panelWarning = (TabBody)x;
                break;
        }
    });
    
    IEnumerable<IPublishedElement> _panelItemWarning = null;;
    if (_panelItemWarning != null)
    {
        foreach(var panelItem in tabs) 
        {
            if (panelItem.Value("partialViewName") == "panelWarning") 
            {
                panelWarning = (TabBody)panelItem;
            }
        }

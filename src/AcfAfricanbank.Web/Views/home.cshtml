@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@inject Umbraco.Cms.Core.Models.PublishedContent.IVariationContextAccessor VariationContextAccessor
@{
    Layout = "Master.cshtml";
    // Same approach as master.cshtml/Navigation.cshtml: untyped
    // IPublishedContent/IPublishedElement API (IsDocumentType, Value<T>)
    // instead of ModelsBuilder-generated classes (HomePageElements,
    // HeroFeetHome, HomeShoulderItem, ...), since those types don't
    // reliably exist depending on ModelsBuilder state.
    var homePageElements = Model.Children(VariationContextAccessor).Where(o => o.IsDocumentType("homePageElements")).FirstOrDefault();
    var heroFeet = homePageElements?.Children(VariationContextAccessor).Where(c => c.IsDocumentType("heroFeet")).FirstOrDefault();
    var bottomNavigation = homePageElements.Children(VariationContextAccessor).Where(c => c.IsDocumentType("bottomNavigation")).FirstOrDefault();
    var testimonials = heroFeet?.Children(VariationContextAccessor).Where(c => c.IsDocumentType("testimonials")).FirstOrDefault();

    var heroBodyBlog = homePageElements.Children(VariationContextAccessor).Where(x => x.IsDocumentType("heroBody")).FirstOrDefault();
    var heroBodyBlogLink = heroBodyBlog.Children(VariationContextAccessor).Where(x => x.ContentType.Alias.ToLower() == "link").FirstOrDefault();
    var lightbox = heroBodyBlog.Value("richTextBox").ToString();

    var tabs = heroBodyBlog?.Children(VariationContextAccessor).Where(c => c.ContentType.Alias.ToLower() == "tabbody").ToList();
    IPublishedContent panelWarning = null;
    tabs.ToList().ForEach(x =>
    {
        var partialName = x.Value("partialViewName");

        switch (partialName.ToString())
        {
            case "panelWarning":
                panelWarning = x;
                break;
        }
    });
    var panelItemWarning = panelWarning?.Value<IEnumerable<IPublishedElement>>("tabBodyContent").Where(c => c.ContentType.Alias == "nCTabGenericContent").FirstOrDefault().Value("sectionContent");

    var whatsNew = homePageElements.Children(VariationContextAccessor).Where(x => x.ContentType.Alias.ToString().ToLower() == "ebankititem2").FirstOrDefault();

    Umbraco.Cms.Core.Models.Link itemLink = null;
    foreach (var link in heroBodyBlogLink.Value<IEnumerable<Umbraco.Cms.Core.Models.Link>>("UrlLink"))
    {
        itemLink = link;
        break;
    }

    var heroFeetHome = heroFeet?.Children(VariationContextAccessor).Where(c => c.IsDocumentType("heroFeetHome")).FirstOrDefault();

    // var disclaimersData = homePageElements.Children.Where(o => o.ContentType.Alias == "ebankITListSectionText").ToList();

    // var disclaimers = disclaimersData.FirstOrDefault().Children;
    //IPublishedContent disclaimerValue = null;
    //foreach (var content in disclaimers)
    //{
    //    if (HttpContext.Current.Request.Path.ToString().Contains("/banking"))
    //    {
    //        if (content.Value("ebankITTitle").ToString().Contains("Banking"))
    //        {
    //            disclaimerValue = content;
    //        }
    //    }
    //    else
    //    {
    //        disclaimerValue = content;
    //        break;
    //    }
    //}

    var viewName = "home"; //used mainly to identify the page (this view's own name - Server.MapPath/VirtualPath don't exist in ASP.NET Core)
}

<style type="text/css">


    .center {
        display: flex !important;
        align-items: center;
        justify-content: center;
        height: 100vh;
    }

    #lightbox {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: #00000095;
        text-align: center;
        display: none;
        z-index: 2147483648;
    }

    #lb-content {
        color: #222;
        background-color: #fff;
        position: relative;
        text-align: center;
        display: none;
    }

    #lb-close {
        transition: 0.5s;
        display: block;
        background: rgba(34, 34, 34, 0.582);
        color: #fff;
        position: absolute;
        top: 0px;
        right: -15px;
        cursor: pointer;
        text-align: center;
        padding: 9px;
    }

        #lb-close:hover {
            transition: 0.5s;
            background: #222;
        }

    .lightBox-image {
        padding-left: 0px !important;
        padding-right: 0px !important;
    }

    .lightBox-copy > h1 {
        font-size: 26px;
        font-weight: 900;
        color: #002b60;
    }

    .lightBox-copy {
        background: #fafafa;
        padding-top: 15px;
        padding-bottom: 25px;
    }

    #lb-content {
        width: 80%;
    }

    .i_image {
        width: 100%;
        height: 203px;
    }

    .whatsnew-sibling {
        display: block;
    }

    .bank-story-caption {
        margin-left: 0px;
    }

    .whatsnew-title {
        font-size: 30px;
        font-weight: 200;
        line-height: 1.18;
        letter-spacing: -.7px;
        margin-top: 10px;
    }

    .whatsnew-copy {
        color: white;
    }

    .whatsnew {
        text-align: center;
        width: unset;
        background: none;
        margin-left: unset !important;
        width: 50%;
    }

    @@media (min-width: 768px) {
        #lb-content {
            width: 500px;
        }


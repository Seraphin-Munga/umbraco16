        function installmentEstimator(loan, loanterm) {
            var loan_amount = parseInt(loan);
            var term = loanterm;
            var initiation_fee = 0;
            var principal_debt = 0;
            var installment = 0;
            //var loan_amount = 50000.00;
            //var term = 72;
            var vat = 0.15;
            var repo = 3.75;
            var interest_rate = 0.2475;
            var insurance_premium = 0.0045;
            initiation_fee = Math.max(Math.min(Math.min(165 + (loan_amount - 1000) * 0.1, 1050), loan_amount * 0.15), 0);
            principal_debt = loan_amount + initiation_fee * 1.15;
            var service_fee = 60 * 1.15;
            installment = ((principal_debt * interest_rate / 12) / (1 - 1 / Math.pow((1 + interest_rate / 12), term)) + insurance_premium * principal_debt + service_fee).toFixed(2);
            var view = formatter.format(installment);
            view = view.replace("ZAR",'R');
            view = view.replace(","," ");
            
            $('#installment_calc1').val(view);
        }

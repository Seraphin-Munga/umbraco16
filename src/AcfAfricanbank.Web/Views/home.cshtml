            font-size: 25px;
            line-height: normal;
        }

        .hero-caption .hero-title {
            font-size: 17px;
        }
    }

    @@media (max-width: 1400px) and (min-width: 530px) {
        .hero-container .carousel .item {
            height: 100%;
            background-position: 80% 57%;
        }
    }

    @@media (max-width: 1442px) and (min-width: 1440px) {
        .hero-caption {
            right: 119px;
            width: 416px;
        }

        .hero-container .carousel .item {
            background-size: contain;
        }

        .top-header {
            height: 500px;
        }

        .hero-caption {
            margin-top: 160px;
        }

        .cap-title {
            font-size: 39px;
        }
    }

    @@media (min-width: 768px) and (max-width: 1000px) {

        .covidheader {
            margin-top: 0px;
        }
    }

    @@media (min-width: 1000px) and (max-width: 1200px) {

        .covidheader {
            margin-top: 0px;
        }
    }

    @@media (min-width: 1200px) and (max-width: 1700px) {

        .covidheader {
            margin-top: 0px;
        }
    }

    @@media only screen and (min-width: 1824px) {

        .hero-caption {
            padding-top: 34px;
            margin-top: 236px;
            padding: 36px;
            color: #fff;
            height: 565px;
            position: absolute;
            width: 489px;
            right: 88px;
        }
    }
    /* 1440 update */
    @@media (max-width: 767px) {
        .whatsnew-copy {
            color: white;
        }

        .whatsnew {
            width: unset;
        }
    }

    @@media (min-width: 413px) and (max-width: 767px) {
        background: grey !important;
    }

    @@media only screen and (max-width: 768px) {
        .whatsnew {
            width: unset;
        }
    }

    @@media (max-width: 412px) {
        .whatsnew-copy {
            color: unset;
        }

        .whatsnew {
            width: unset;
        }
    }

    @@media (max-width: 360px) {
        .whatsnew-copy {
            color: white;

@inherits Umbraco.Web.Mvc.UmbracoViewPage
@using AcfAfricanbank.Core.Models.Forms
@using ContentModels = Umbraco.Web.PublishedModels;
@using Web.Helpers;
@using System.Configuration;
@using CustomModels = Web.Models;
@{
	Layout = "Master.cshtml";
	
	 var children = Model.Children;
	 
	 var heroBody = children?.Where(c => c.ContentType.Alias.ToLower() == "herobody").FirstOrDefault();
     
      var Firstsection= heroBody.Children.Where(c => c.Name == "First Section").FirstOrDefault();
      var Firstsectioncards = Firstsection.Value<IEnumerable<IPublishedElement>>("tabBodyContent");
      var Firstcards = Firstsectioncards.Where(c => c.ContentType.Alias == "nCTabGenericContent").FirstOrDefault().Value<IEnumerable<IPublishedElement>>("sectionContent");

      var Secondsection= heroBody.Children.Where(c => c.Name == "Second Section").FirstOrDefault();
      var Secondsectioncards = Secondsection.Value<IEnumerable<IPublishedElement>>("tabBodyContent");
      var Second = Secondsectioncards.Where(c => c.ContentType.Alias == "nCTabGenericContent").FirstOrDefault().Value<IEnumerable<IPublishedElement>>("sectionContent");
}

<link rel="stylesheet" href="/css/projectmagic.css" /> 

<style>
    @@media only screen and (min-width:1024px){
   .education-card-text{
        height:80px;
    }
    }
</style>
@* the fun starts here *@

  @{
         int idIterator = 0;
           foreach (var item in Firstcards){
               var tabSubItemImage = item.Value<IPublishedContent>("tabSubItemImage")?.Url;
               var tabSubItemIcon = item.Value<IPublishedContent>("tabSubItemIcon")?.Url;
               var title = item.Value<string>("tabSubItemTitle");
               var description = item.Value<string>("genericCardContent");
              List<Umbraco.Web.Models.Link> itemLink = new List<Umbraco.Web.Models.Link>();

                        foreach (var link in (IEnumerable<Umbraco.Web.Models.Link>)item.Value("tabSubItemLinks"))
                            {
                            itemLink.Add(link);

                            }

                 if (idIterator%2 == 0)
                    {
                        <section class="section pt-45 pb-45 bg-grey-60">
                            <div class="container">
                                <div class="row align-items-center d-flex row-change md-text-center">
                                    <div class="col-xl-6 col-lg-6 col-md-6">
                                        <h1 class="color-brand-1 mt-15 mb-20">@title</h1>
                                        <p class="font-md color-brand-1"> @item.Value("tabSubItemTextContent")</p>
                                          @if(itemLink != null && itemLink.Count() > 0) {
                                        <div class="mt-20 text-start"><a href="@itemLink[0].Url" class="btn btn-brand-1 arrow-right">@itemLink[0].Name</a></div>
                                        }
                                    </div>
                                    <div class="col-xl-6 col-lg-6 col-md-6">
                                        <img Class="d-block"
                                             src="@tabSubItemImage"
                                             alt="" />
                                    </div>
                                </div>
                            </div>
                        </section>
                        }
                        else{
                        
                             <section class="section pt-45 pb-45">
                                <div class="container">
                                    <div class="row align-items-center row-change d-flex flex-row-reverse md-text-center">
                                        <div class="col-xl-6 col-lg-6 col-md-6">
                                            <h1 class="color-brand-1 mb-20">@title</h1>
                                            <p class="font-md color-grey-500">@item.Value("tabSubItemTextContent")</p>
                                       
                
                                        </div>
                                        <div class="col-xl-6 col-lg-6 col-md-6">
                                             <img
                                              Class="d-block"
                                              src="@tabSubItemImage"
                                             alt="" />
                                            
                                        </div>
                                    </div>
                                </div>
                            </section>
                        }
          idIterator += 1;
            }
        }


<section class="section pt-45 pb-45 bg-grey-60">
    <div class="container">
        @{
        int iteration = 0;
        foreach (var item in Second)
                    {
                if(iteration == 0){
                var cards = item.Value<IEnumerable<NCcard>>("genericCardContent");
                  List<Umbraco.Web.Models.Link> itemLink = new List<Umbraco.Web.Models.Link>();

                        foreach (var link in (IEnumerable<Umbraco.Web.Models.Link>)item.Value("tabSubItemLinks"))
                            {
                            itemLink.Add(link);

                            }
                <div class=row>
                    <div class="col-12 text-center">
                        <h1 class="color-brand-1 mb-20">@item.Value("tabSubItemTitle")</h1>
                       @item.Value("tabSubItemTextContent")
                    </div>
                </div>
        
                <div class="row d-flex text-center row-change">
                    @foreach (var mycard in cards)
                    {
                      var cardTitle = mycard.Value<string>("nCcardTitle");
                      var icon = mycard.Value<IPublishedContent>("nCcardIcon");
                                    <div class="col-xl-3 col-lg-3 col-md-3">
                                        <img Class="d-block" src="@icon.Url" alt="@icon.Value("altTag")" />
                                        @Html.Raw(mycard.Value<string>("mediumDescription"))
                                        @Html.Raw(mycard.Value<string>("nClongDescription"))
                                    </div>
                    }
                </div>
                 if(itemLink != null && itemLink.Count() > 0) {
                <div class=row>
                    <div class="col-lg-6 col-md-6 col-xs-12 col-sm-12 text-center">
                        <div class="mt-20 text-start"><a href="@itemLink[0].Url" class="btn btn-brand-1 arrow-right">@itemLink[0].Name</a></div>
                    </div>
                     <div class="col-lg-6 col-md-6 col-xs-12 col-sm-12 text-center">
                        <div class="mt-20 text-start"><a href="@itemLink[1].Url" class="btn btn-brand-1 arrow-right">@itemLink[1].Name</a></div>
                    </div>
                </div>
                }
                }
                iteration++;
        }
        }
    </div>
</section>

<section class="section pt-45 pb-45">
    <div class="container">
         @{
            int iteration1 = 0;
            foreach (var item in Second)
            {
                    if(iteration1 == 1){
                    
                    List<Umbraco.Web.Models.Link> itemLink = new List<Umbraco.Web.Models.Link>();

                        foreach (var link in (IEnumerable<Umbraco.Web.Models.Link>)item.Value("tabSubItemLinks"))
                            {
                            itemLink.Add(link);

                            }
                            
                    var cards = item.Value<IEnumerable<NCcard>>("genericCardContent");
                <div class=row>
                    <div class="col-12 text-center">
                        <h1 class="color-brand-1 mb-20">@item.Value("tabSubItemTitle")</h1>
                         @item.Value("tabSubItemTextContent")
                    </div>
                </div>
                <div class="row d-flex text-center row-change">
                     @foreach (var mycard in cards)
                    {
                                  var cardTitle = mycard.Value<string>("nCcardTitle");
                                  var icon = mycard.Value<IPublishedContent>("nCcardIcon");
                                  
                                <div class="col-xl-4 col-lg-4 col-md-4">
                                    <img Class="d-block" src="@icon.Url" alt="@icon.Value("altTag")" />
                                    @Html.Raw(mycard.Value<string>("mediumDescription"))
                                </div>
                       
                    }
                </div>
                 if(itemLink != null && itemLink.Count() > 0) {
                <div class=row>
                    <div class="col-lg-6 col-md-6 col-xs-12 col-sm-12 text-center">
                        <div class="mt-20 text-start"><a href="@itemLink[0].Url" class="btn btn-brand-1 arrow-right">@itemLink[0].Name</a></div>
                    </div>
                     <div class="col-lg-6 col-md-6 col-xs-12 col-sm-12 text-center">
                        <div class="mt-20 text-start"><a href="@itemLink[1].Url" class="btn btn-brand-1 arrow-right">@itemLink[1].Name</a></div>
                    </div>
                </div>
                }
                }
                iteration1++;
            }
        }
    </div>
</section>
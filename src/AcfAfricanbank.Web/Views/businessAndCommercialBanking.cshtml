 $(document).ready(function () {
      let currentIndex = 0;
      const $slides = $('.my-slide');
      const totalSlides = $slides.length;
      const $indicatorsContainer = $('.slider-indicators');

      // Set the width of the slides container based on the number of slides.
      $('.my-slides').css('width', (totalSlides * 100) + '%');

      // Create indicator dots dynamically.
      for (let i = 0; i < totalSlides; i++) {
        const dot = $('<span class="dot"></span>');
        if (i === 0) { 
          dot.addClass('active');
        }
        dot.attr('data-slide', i);
        $indicatorsContainer.append(dot);
      }

      // Function to move the slider and update indicators.
      function moveSlider(index) {
        $('.my-slides').css("transform", "translateX(-" + (index * 100) + "%)");
        $slides.removeClass('active').eq(index).addClass('active');
        $('.slider-indicators .dot').removeClass('active')
          .filter(`[data-slide="${index}"]`).addClass('active');
        currentIndex = index;
      }

      // Auto slide function.
      function autoSlide() {
        currentIndex = (currentIndex + 1) % totalSlides;
        moveSlider(currentIndex);
      }

      // Set up auto sliding every 3 seconds.
      let sliderInterval = setInterval(autoSlide, 3000);

      // Pause auto sliding on hover and resume on mouse leave.
      $('.my-slideshow-container').hover(
        function () {
          clearInterval(sliderInterval);
        },
        function () {
          sliderInterval = setInterval(autoSlide, 3000);
        }
      );

      // Allow clicking the indicator dots to jump to a slide.
      $('.slider-indicators .dot').click(function () {
        let index = $(this).data('slide');
        moveSlider(index);
      });
    });

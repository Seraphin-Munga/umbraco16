               }
               
               .accordion::after {
                 content: '\276F'; /* Heavy Chevron Unicode character */
                 font-size: 16px; /* Adjust as needed */
                 color: #012B60;
                 position: absolute;
                 right: 20px;
                 top: 50%;
                 transform: translateY(-50%) rotate(90deg);
                 transition: transform 0.4s;
               }
               

<script>
$(function(){
  const $container  = $('.horizontal-scroll-container');
  const $cards      = $('.loan-box');
  const $indicators = $('.indicator2-row .indicator2');

  // ————————————————
  // 0. ALWAYS start on the first card/indicator
  $container.scrollLeft(0);                   // jump to card #0
  $indicators.removeClass('active')
             .first().addClass('active');     // highlight indicator #0

  // 1. Click on indicator → scroll to that card
  $indicators.each(function(i){
    $(this).on('click', function(){
      const cardOffset = $cards.eq(i).position().left + $container.scrollLeft();
      const scrollTo   = cardOffset - ($container.innerWidth() - $cards.eq(i).outerWidth())/2;
      $container.animate({ scrollLeft: scrollTo }, 400);
    });
  });

  // 2. On scroll → update active indicator
  $container.on('scroll', function(){
    const containerMid = $container.scrollLeft() + $container.innerWidth()/2;

    $cards.each(function(i){
      const $c    = $(this);
      const left  = $c.position().left + $container.scrollLeft();
      const right = left + $c.outerWidth();

      if (containerMid >= left && containerMid <= right) {
        $indicators.removeClass('active')
                   .eq(i).addClass('active');
        return false;
      }
    });
  });

  // 3. Trigger scroll once (optional now, since we set the first manually)
  $container.trigger('scroll');
});


function handleContainerClass() {
  if ($(window).width() <= 768) {
    $('.back-section .container').removeClass('container');
  } else {
    // Optionally re-add the class on larger screens
    if (!$('.back-section div').hasClass('container')) {
      $('.back-section div').addClass('container');
    }
  }
}

$(document).ready(handleContainerClass);
$(window).resize(handleContainerClass);




document.addEventListener('DOMContentLoaded', () => {
  // Initialize every carousel on the page
  document.querySelectorAll('.kb-carousel').forEach(carousel => {
    const scrollEl = carousel.querySelector('.kb-scroll');
    const items    = Array.from(scrollEl.children);
    const dotsWrap = carousel.querySelector('.kb-dots');

    // 1) Build dots
    items.forEach((_, idx) => {
      const dot = document.createElement('div');
      dot.className = 'kb-dot';
      dot.dataset.index = idx;
      dot.addEventListener('click', () => {
        items[idx].scrollIntoView({ behavior: 'smooth', inline: 'start' });
      });
      dotsWrap.appendChild(dot);
    });

    const dots = Array.from(dotsWrap.children);

    // 2) Observe visibility to toggle .active
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const i = items.indexOf(entry.target);
          dots.forEach(d => d.classList.toggle('active', +d.dataset.index === i));
        }
      });
    }, {
      root: scrollEl,
      threshold: 0.75
    });

    items.forEach(item => observer.observe(item));
  });
});


document.addEventListener("DOMContentLoaded", function () {
    // Get all tab links
    var tabLinks = document.querySelectorAll('#go_to_tab_content li');

    // Function to activate the correct tab content
    function switchTabs(tabId) {
        // Remove 'active' from all tab panes
        document.querySelectorAll('.tab-content-1 .tab-pane, .tab-content-2 .tab-pane').forEach(function (el) {
            el.classList.remove('active');
        });

        // Add 'active' to matching tab pane
        var activeTab1 = document.querySelector('.tab-content-1 #tab-' + tabId);
        var activeTab2 = document.querySelector('.tab-content-2 #tab-' + tabId);

        if (activeTab1) activeTab1.classList.add('active');
        if (activeTab2) activeTab2.classList.add('active');

        // 🔥 Add this part: toggle active tab in nav
        tabLinks.forEach(function (li) {
            li.classList.remove('active');
        });

        const currentActive = document.querySelector(`#go_to_tab_content li[data-tab-id="${tabId}"]`);
        if (currentActive) currentActive.classList.add('active');
    }

    // Add click event to each <li>
    tabLinks.forEach(function (tabLink) {
        tabLink.addEventListener('click', function () {
            var tabId = tabLink.getAttribute('data-tab-id');
            switchTabs(tabId);
        });
    });
});

</script>

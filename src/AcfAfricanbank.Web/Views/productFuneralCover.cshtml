                                    <a href="#@cardId">
                                        <img class="myWorld-campaign-images" src="@benefit.CardIcon.Url" alt="@benefit.Value("altTag")" />
                                    </a>
                                }
                                else
                                {
                                    <a href="#">
                                        <img class="myWorld-campaign-images" src="@benefit.CardDescription" alt="@benefit.CardTitle" />
                                    </a>
                                }
                            }
                        </div>
                    </div>
                    ++iterator;
                    ++imgIterator;
                }
            }
        </div>
    }


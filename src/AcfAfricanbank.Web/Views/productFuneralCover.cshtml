@* INVESTMENT CALCULATOR *@


<div class="container">
    @{
        int count = 1;
        foreach (var row in items as List<ContentModels.NCcard>)
        {
            <div class="row">
                <div class="container-step margin-bottom-15 margin-right-15 margin-left-15">
                    <div class="col-sm-1 setp-box">
                        <div class="step">
                            <span>@row.Value("nCcardDescription") @count</span>
                        </div>
                    </div>
                    <div class="col-sm-10 box-step-text">
                        <p class="text-step">@row.Value("NCcardTitle")</p>
                    </div>

                </div>
            </div>
            <div class="row">
                <div class="long-description">
                    @Html.Raw(@row.Value("mediumDescription"))
                </div>
            </div>

            if (row.ImageListAndDescriptions != null)
            {
                <div class="row">
                    @{
                        if (row.ImageListAndDescriptions.ToList().Count > 1)
                        {
                            foreach (var _item in row.ImageListAndDescriptions.ToList())
                            {
                                if (_item.Image != null)
                                {
                                    <div class="col-sm-5">
                                        <div class="row">
                                            <div class="col-md-6 col-sm-12 hand-helds">
                                                <img src="@_item.Image.Url" alt="" />
                                            </div>
                                            <div class="col-md-6 col-sm-12 hand-helds">
                                                @Html.Raw(_item.Description)
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            <div class="row">
                                <div class="col-sm-12 long-des">
                                    @Html.Raw(@row.Value("nClongDescription"))
                                </div>
                            </div>
                        }
                        else
                        {
                            if (row.ImageListAndDescriptions.Count() == 1)
                            {
                                if (row.ImageListAndDescriptions.FirstOrDefault().Image != null)
                                {
                                    if (row.ImageListAndDescriptions.FirstOrDefault().Description.ToString() == "")
                                    {
                                        @*</div>*@
                                        <div class="center-align hidden-xs hidden-sm visible-md visible-lg">
                                            <img src="@row.ImageListAndDescriptions.FirstOrDefault().Image.Url" alt="" style="height: 50.7vh;">
                                        </div>

                                        <div class="col-xs-12 center-align visible-xs visible-sm hidden-md hidden-lg">
                                            <img src="@row.NCcardIcon.Url" alt="@row.NCcardIcon.Value("altTag")" /> @* style="height: 70vh;" *@
                                        </div>
                                        @*<div class="container">*@
                                    }
                                    else
                                    {

                                        <div class="col-sm-1"></div>
                                        <div class="col-md-3 col-sm-12 hand-helds">
                                            <img src="@row.ImageListAndDescriptions.FirstOrDefault().Image.Url" alt="" />
                                        </div>
                                        <div class="col-md-8 col-sm-12 hand-helds">
                                            @Html.Raw(row.NClongDescription)
                                        </div>
                                    }
                                    <div class="row">
                                        <div class="col-sm-12 member-margin">
                                            @Html.Raw(row.ImageListAndDescriptions.FirstOrDefault().Description)
                                        </div>
                                    </div>
                                }

                            }
                        }
                    }
                </div>
            }

            count++;
        }
    }

</div>


    <script type="text/javascript">

                    $(document).ready(function () {
                        var imageBgCss = "url('" + "@headerImage_large" + "')";
                        var imageMdCss = "url('" + "@headerImage_medium" + "')";
                        var imageSmCss = "url('" + "@(string.IsNullOrEmpty(headerImage_small) ? headerImage_medium : headerImage_small)" + "')";
                        var CheckScreenSize;
                        (CheckScreenSize = function () {
                            var _width = $(window).outerWidth();
                            var _height = $(window).outerHeight();
                            if (_width <= 511) {
                                $("#heroHeader").css("background-image", imageSmCss);
                            }
                            else {
                                $("#heroHeader").css("background-image", imageBgCss);
                            }
                        })();
                        $(window).resize(CheckScreenSize);
                    });

                    $(function () {
                        var data = {
                            product: 'FUN',
                            rateContainer: '#rates-container',
                            calcFormContainer: '#calculatorfuneral-form',
                            responseCalculatorContainer: '#calculator-container',
                            serviceUrl: '@System.Configuration.ConfigurationManager.AppSettings["ebankit.Portal.Services.Mobile.URL"]',
                            imagesRates: [
                                'myself_small.png',
                                'myself_and_spouse_small.png',
                                'myself_and_children_small.png',
                                'myself_spouse_children_small.png'
                            ],
                            headers: [
                                ['ITSAPP-DEVICE', '@System.Configuration.ConfigurationManager.AppSettings["ebankit.Portal.Services.ITSAPP-DEVICE"]'],
                                ['ITSAPP-DEVICEID', '*'],
                                ['ITSAPP-LANG', 'en-GB'],
                                ['Content-type', 'application/json']
                            ],
                            translations: {
                                coverYourself: '@ResourceHelper.GetResource("CoverYourself")',
                                coverYourselfAndYourSpouse: '@ResourceHelper.GetResource("CoverYourselfAndYourSpouse")',
                                coverYourselfAndUpTo8Children: '@ResourceHelper.GetResource("CoverYourselfAndUpTo8Children")',
                                coverYourselfYourSpouseAndUpTo8Children: '@ResourceHelper.GetResource("CoverYourselfYourSpouseAndUpTo8Children")',
                                additionalMembers: '@ResourceHelper.GetResource("AdditionalMembers")',
                                additionalFeePerMember: '@ResourceHelper.GetResource("AdditionalFeePerMember")',
                                youngerThan26: '@ResourceHelper.GetResource("YoungerThan26")',
                                aged26To64: '@ResourceHelper.GetResource("Aged26To64")',
                                aged65To75: '@ResourceHelper.GetResource("Aged65To75")',
                                myself: '@ResourceHelper.GetResource("Myself")',
                                myselfAndMySpouse: '@ResourceHelper.GetResource("MyselfAndMySpouse")',
                                myselfAndUpTo8Children: '@ResourceHelper.GetResource("MyselfAndUpTo8Children")',
                                myselfMySpouseAndUpTo8Children: '@ResourceHelper.GetResource("MyselfMySpouseAndUpTo8Children")',
                                age: '@ResourceHelper.GetResource("Age")',
                                coverAmount: '@ResourceHelper.GetResource("CoverAmount")',
                                additionalMember: '@ResourceHelper.GetResource("AdditionalMember")',
                                howMuchCoveredMandatory: '@ResourceHelper.GetResource("HowMuchCoveredMandatory")',
                                addMembersIsMandatory: '@ResourceHelper.GetResource("AddMembersIsMandatory")',
                                numberAdditionalMembersMandatory: '@ResourceHelper.GetResource("NumberAdditionalMembersMandatory")',
                                allOptionsMembers: '@ResourceHelper.GetResource("AllOptionsMembers")',
                                whoDoYouWantToCover: '@ResourceHelper.GetResource("WhoDoYouWantToCover")',
                                howMuchCoverDoYouNeed: '@ResourceHelper.GetResource("HowMuchCoverDoYouNeed")',
                                wouldYouLikeToAddAnyAdditionalMembers: '@ResourceHelper.GetResource("WouldYouLikeToAddAnyAdditionalMembers")',
                                howManyAdditionalMembers: '@ResourceHelper.GetResource("HowManyAdditionalMembers")',
                                getThisCoverFor: '@ResourceHelper.GetResource("GetThisCoverFor")',
                                perMonth: '@ResourceHelper.GetResource("PerMonth")',
                                amountCoverNeed: '@ResourceHelper.GetResource("AmountCoverNeed")',
                                addAdditionalMember: '@ResourceHelper.GetResource("AddAdditionalMember")',
                                numberOfAdditionalMembers: '@ResourceHelper.GetResource("NumberOfAdditionalMembers")',
                                ageOfAdditionalMembers: '@ResourceHelper.GetResource("AgeOfAdditionalMembers")',
                                selectCoverAmountForAdditionalMembers: '@ResourceHelper.GetResource("SelectCoverAmountForAdditionalMembers")'
                            }
                        };

                        $(window).on('CalculatorLoadingEvent', function (e) {
                            var _state = e.state;
                            var _target = e.eventName;
                            if (_target !== 'loadingRatesEvent') {
                                if (_state) {
                                    $("#form-preloader").show();
                                    $(data.calcFormContainer).hide();
                                    ChangePageControls(false);
                                } else {
                                    $("#form-preloader").hide();
                                    $(data.calcFormContainer).show();
                                    ChangePageControls(Calculator.isCalculatorValid('FUN'));
                                }
                            } else {
                                if (_state) {
                                    $("#loader-rates-form-preloader").show();
                                    $('#calculatorRates').hide();
                                    ChangePageControls(false);
                                } else {
                                    $("#loader-rates-form-preloader").hide();
                                    $('#calculatorRates').show();
                                    ChangePageControls(Calculator.isCalculatorValid('FUN'));
                                }
                            }
                        });

                        $(window).on('CalculatorValidationHandler', function (e) {
                            var _state = e.state;
                            ChangePageControls(_state);
                        });

                        $(window).on('Error', function (e) {
                            $("#rates-form-preloader").hide();
                            $("#form-preloader").hide();
                            $(data.calcFormContainer).hide();
                            $("#calculator-container").hide();
                            if (!e.errorDescription) {
                                $("#calculator-container").show();
                                $(".errorcalculatores").hide();
                                return;
                            }
                            ChangePageControls(false);
                            $(".errorcalculatores").show();
                        });

                        function ChangePageControls(enabled) {
                            if (enabled) {
                                $("#buttonPrint").removeClass("disabledbutton");
                                return;
                            }
                            $("#buttonPrint").addClass("disabledbutton");
                        }

                        function PrintElem(elem) {
                            Popup($(elem)[0].outerHTML);
                        }

                        function Popup(data) {
                            //var mywindow = window.open('', 'Calculator Results');
                            //mywindow.document.write('<html><head><title>Calculator Results</title>');
                            //mywindow.document.write('<link rel="stylesheet" href="/Content/ebankITMasterCss.min.css?V=1277zadzhbh32" type="text/css"  media="all" />');
                            //mywindow.document.write('</head><body >');
                            //mywindow.document.write(data);
                            //mywindow.document.write('</body><script>window.print();window.close();<\/script></html>');

                            return true;
                        }
                        Calculator1.init(data);
                    });
    </script>
    <script type="text/javascript">

                    $(document).ready(function () {

                        $(".cancel-button").click(function () {

                            $("#collapseExample").bootstrapValidator('resetForm', true);

                            $('#collapseExample').collapse('hide');


                        });

                        $("#rates-form-preloader").hide();

                        $('#funeral_claim').bootstrapValidator({
                            message: '@ResourceHelper.GetResource("GenericContactForm_InvalidValue")',
                            feedbackIcons: {

                            },
                            onSuccess: function (e) {
                                e.preventDefault();
                                SubmitFuneralForm();

                            },
                            fields: {
                                'FormFields.Subject': {
                                    message: '@ResourceHelper.GetResource("GenericContactForm_InvalidValue")',
                                    validators: {
                                        notEmpty: {
                                            message: '@ResourceHelper.GetResource("GenericContactForm_Subject_Required")'
                                        }
                                    },
                                    feedbackIcons: {
                                        valid: '',
                                        invalid: '',
                                        validating: ''
                                    },
                                },
                                'FormFields.Message': {
                                    message: '@ResourceHelper.GetResource("GenericContactForm_InvalidValue")',
                                    validators: {
                                        notEmpty: {
                                            message: '@ResourceHelper.GetResource("GenericContactForm_Message_Required")'
                                        }, stringLength: {
                                            max: 100,
                                            message: '@ResourceHelper.GetResource("GenericContactForm_Message_LenghtValMessage")'
                                        }
                                    },
                                    feedbackIcons: {
                                        valid: '',
                                        invalid: '',
                                        validating: ''
                                    },
                                },

                                'FormFields.FirstName': {
                                    message: '@ResourceHelper.GetResource("GenericContactForm_InvalidValue")',
                                    validators: {
                                        notEmpty: {
                                            message: '@ResourceHelper.GetResource("GenericContactForm_FirstName_Required")'
                                        },
                                        regexp: {
                                            regexp: /^[a-zA-Z]+$/,
                                            message: '@ResourceHelper.GetResource("GenericContactForm_FirstName_ValMessage")'
                                        }, stringLength: {
                                            max: 20,
                                            message: '@ResourceHelper.GetResource("GenericContactForm_FirstName_LenghtValMessage")'
                                        }
                                    }
                                },
                                "FormFields.LastName": {
                                    message: '@ResourceHelper.GetResource("GenericContactForm_InvalidValue")',
                                    validators: {
                                        notEmpty: {
                                            message: '@ResourceHelper.GetResource("GenericContactForm_LastName_Required")'
                                        },
                                        regexp: {
                                            regexp: /^[a-zA-Z]+$/,
                                            message: '@ResourceHelper.GetResource("GenericContactForm_LastName_ValMessage")'
                                        }, stringLength: {
                                            max: 20,
                                            message: '@ResourceHelper.GetResource("GenericContactForm_LastName_LenghtValMessage")'
                                        }
                                    }
                                },

                                "FormFields.IdNumber": {
                                    message: '@ResourceHelper.GetResource("GenericContactForm_InvalidValue")',
                                    validators: {
                                        notEmpty: {
                                            message: '@ResourceHelper.GetResource("GenericContactForm_SAID_Required")'
                                        },
                                        regexp: {
                                            regexp: /^[a-zA-Z0-9]{1,13}$/,
                                            message: '@ResourceHelper.GetResource("GenericContactForm_SAID_ValMessage")'
                                        },
                                        stringLength: {
                                            max: 13,
                                            message: '@ResourceHelper.GetResource("GenericContactForm_SAID_LenghtValMessage")'
                                        }
                                    }
                                },
                                'FormFields.Email': {
                                    message: '@ResourceHelper.GetResource("GenericContactForm_InvalidValue")',
                                    validators: {
                                        notEmpty: {
                                            message: '@ResourceHelper.GetResource("GenericContactForm_Email_Required")'
                                        },
                                        regexp: {
                                            regexp: /^[-a-z0-9~!$%^&*_=+}{\'?]+(\.[-a-z0-9~!$%^&*_=+}{\'?]+)*@@([a-z0-9_][-a-z0-9_]*(\.[-a-z0-9_]+)*\.(aero|arpa|biz|com|coop|edu|gov|info|int|mil|museum|name|net|org|pro|travel|mobi|[a-z][a-z])|([0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}))(:[0-9]{1,5})?$/i,
                                            message: '@ResourceHelper.GetResource("GenericContactForm_Email_ValMessage")'
                                        }
                                    }
                                },
                                "FormFields.CellPhone": {
                                    message: '@ResourceHelper.GetResource("GenericContactForm_InvalidValue")',
                                    validators: {
                                        notEmpty: {
                                            message: '@ResourceHelper.GetResource("GenericContactForm_CellPhone_Required")'
                                        },
                                        numeric: {
                                            message: '@ResourceHelper.GetResource("GenericContactForm_CellPhone_NumericValMessage")'
                                        },
                                        stringLength: {
                                            min: 10,
                                            max: 10,
                                            message: '@ResourceHelper.GetResource("GenericContactForm_CellPhone_LenghtValMessage")'
                                        }
                                    }
                                }
                            }
                        });
                    });


                    function SubmitFuneralForm( /*hasSubmit*/) {


                        var submitedFormDateTime = new Date().toLocaleString()
                        $("#loader-rates-form-preloader").show();
                        $("#log-claim-preloader").show();


                        var data = {
                            FirstName: $('#FirstNameInput').val().trim(),
                            LastName: $('#LastNameInput').val().trim(),
                            Subject: 'Log a claim online - Log a Claim',
                            ProductID: "1",
                            Email: $('#EmailInput').val().trim(),
                            CellPhone: $('#CellPhoneInput').val().trim(),
                            SAID: $('#SAIDInput').val(),
                            HasSubmit: true,
                            TimeEnteredOnPage: "@DateTime.Now.ToIsoString()",
                            SessionId: $('#sessionId').val(),
                            FreeText: $('#MessageInput').val().trim(),
                            ProcessID: $('#processID').val(),
                            ContactType: 'Log a claim Funeral',
                            ExtendedProperties:

                                [
                                    {
                                        "Key": "SubmitedPageDate",
                                        "Value": submitedFormDateTime
                                    },
                                    {
                                        "Key": "CodeName",
                                        "Value": navigator.appCodeName
                                    },
                                    {
                                        "Key": "appName",
                                        "Value": navigator.appName
                                    },
                                    {
                                        "Key": "appVersion",
                                        "Value": navigator.appVersion
                                    }
                                    ,
                                    {
                                        "Key": "userAgent",
                                        "Value": navigator.userAgent
                                    }
                                    ,
                                    {
                                        "Key": "screenWidth",
                                        "Value": screenWidth()
                                    }
                                    ,
                                    {
                                        "Key": "screenHeight",
                                        "Value": screenHeight()
                                    },
                                    {
                                        "Key": "URL",
                                        "Value": window.location.href
                                    }
                                ]

                        }
                        requestInProgress = true;

                        AJAX.rootPath = $.rootPath;
                        AJAX.headers = $.headers;

                        AJAX.request('/public/contacform/submit', {
                            data: data,

                            success: function (e) {
                                $("#loader-rates-form-preloader").hide();
                                $("#log-claim-preloader").hide();

                                if (e.Status == 'Ok') {
                                    //   console.log("The e -->" + JSON.stringify(e.Status));

                                    $("form#funeral_claim").bootstrapValidator("resetForm");
                                    $("form#funeral_claim")[0].reset();
                                    $("#ajax-form-success-log-claim").show();
                                } else {
                                    //      console.log("error " + e.Status);

                                    $("#ajax-form-error-log-claim").show();

                                }

                            },
                            error: function (req, txt, err) {
                                $("#loader-rates-form-preloader").hide();

                                $("#ajax-form-error-log-claim").show();

                                $("#log-claim-preloader").hide();

                            }
                        });
                    }
    </script>
}
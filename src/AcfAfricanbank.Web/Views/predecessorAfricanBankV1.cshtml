@inherits Umbraco.Web.Mvc.UmbracoViewPage<ContentModels.PageMediaCenter>
@using ContentModels = Umbraco.Web.PublishedModels;
@{
    Layout = "Master.cshtml";
    // All Current Page Children
    var Children = Model.Children;
    // Get specific Children
   
    var heroBody = (HeroBody)Children?.Where(c => c.ContentType.Alias.ToLower() == "herobody").FirstOrDefault();
     var emplyecard= heroBody.Children.Where(c => c.Name == "EmployeCards").FirstOrDefault();
     

         var firstcard = emplyecard ?.Children?.Where(c => c.Name == "FirstCard");
         var firstcards = firstcard.Select(c => c as Card).ToList();
          var applyDocsfirst = firstcards?.Select(c => c as Card).FirstOrDefault();
         var navigate = applyDocsfirst.Value<IEnumerable<Umbraco.Web.Models.Link>>("buttonLink").FirstOrDefault();
}

 <link rel="stylesheet" href="/css/projectmagic.css" /> 
 
@if (firstcards!= null && firstcards.Any())
            {

                foreach (Card benefit in firstcards)
                {
   <section class="section pt-50 pb-40  bg-grey-60">
                            <div class="container">
                                <div class="row align-items-center d-flex row-change md-text-center">
                                    <div class="col-xl-6 col-lg-6 col-md-6">
                                        <h1 class="color-brand-1 mt-15 mb-20"> @benefit.CardTitle</h1>
                                    @benefit.CardDescriptionLongText
                                    
                                    </div>
                                    <div class="col-xl-6 col-lg-6 col-md-6">
                                        <img Class="d-block"
                                             src="@benefit.CardIcon.Url"
                                             alt=""/>
                                    </div>
                                </div>
                            </div>
                        </section>
                        }
 }

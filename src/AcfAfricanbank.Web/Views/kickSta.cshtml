@inherits Umbraco.Web.Mvc.UmbracoViewPage
@{
	Layout = "Master.cshtml";
}

<link rel="stylesheet" href="/css/projectmagic.css" /> 

@* the fun starts here *@

<section class="section-800 bg-grey-60">
<div class="container">
    <div class="row align-items-center d-flex row-change">
        <div class="col-xl-6 col-lg-6 col-md-6">
            <h1 class="color-brand-1 mt-15 mb-20">KickStarter Loan</h1>
            <p class="font-md color-brand-1">With a competitive 15% interest rate and flexible terms,take the first step towards your goals!</p>
            <p class="font-md color-brand-1 mt-20">Whether you're aiming to tackle unexpected expenses or seize new opportunities, our 15% Kickstarter Loan is designed for YOU. With flexible repayment options and exclusive financial benefits, we're dedicated to helping you achieve your goals and build the future YOU desire.</p>
            <div class="mt-20 text-start"><a href="" class="btn btn-brand-1 arrow-right"> Open Now </a></div>
        </div>
        <div class="col-xl-6 col-lg-6 col-md-6">
            <img Class="d-block"
            src="/media/oexnetff/what-is-an-overdraft.png"
            alt="" />
        </div>
    </div>
</div>
</section>

<section class="pt-45 pb-45">
    <div class="container">
        <div class="row">
            <div class="col-12 text-center">
               <h1 class="color-brand-1 mt-15 mb-20">More about the 15% Loan</h1> 
            </div>
        </div>
        <div class="row mt-50 align-items-center">
            <div class="col-lg-6">
                <div class="card-offer-small card-we-do">
                    <div class="card-image"></div>
                    <div class="card-info">
                        <h4 class="color-brand-1 mb-10">Flexible Terms</h4>
                        <p>improve your cash flow, repayment terms from 9 to 24 months</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card-offer-small card-we-do">
                    <div class="card-image"></div>
                    <div class="card-info">
                        <h4 class="color-brand-1 mb-10">Fixed Repayments</h4>
                        <p>This allows you to budget accurately and know exactly how much you will be repaying from month to month.</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card-offer-small card-we-do">
                    <div class="card-image"></div>
                    <div class="card-info">
                        <h4 class="color-brand-1 mb-10">Easy Application</h4>
                        <p>You can choose to apply online, over the phone or you can choose to visit your nearest branch.</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card-offer-small card-we-do">
                    <div class="card-image"></div>
                    <div class="card-info">
                        <h4 class="color-brand-1 mb-10">15% Loans up to R50,000</h4>
                        <p>Your 15% Loan will be deposited straight into your bank account.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
                        
<section class="section-800 bg-grey-60">
    <div class="container">
        <div class="row align-items-center d-flex row-change">
                <div class="col-xl-6 col-lg-6 col-md-6">
                <img Class="d-block"
                src="/media/oexnetff/what-is-an-overdraft.png"
                alt="" />
            </div>
            <div class="col-xl-6 col-lg-6 col-md-6">
                <h1 class="color-brand-1 mt-15 mb-20">What you need to apply for a 15% Loan?</h1>
                <p class="font-md color-brand-1">To get a 15% Loan offer suited to your lifestyle, you will need to have the following documents on hand:</p>
                <div class="mt-30 mb-30 inline-checklist">
                    <ul class="list-ticks list-ticks-2">
                        <li>Most recent proof of income e.g latest payslip.</li>
                        <li>You must be over 18 to apply for a loan.</li>
                        <li>latest 3 months bank statements, reflecting 3 salary deposits.</li>
                    </ul>
                </div>
                <div class="mt-20 text-start"><a href="" class="btn btn-brand-1 arrow-right"> Apply Now </a></div>
            </div>
        </div>
    </div>
</section>
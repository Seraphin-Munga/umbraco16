@{

 string getTabName(string TabId) {
            string tabName = "";
            switch(TabId) {
                case "1" :
                tabName = "CallDeposits";
                break;
                case "2" :
                tabName = "PrimeTimeNoticeDeposits";
                break;
                case "3" :
                tabName = "FlexiNoticeDeposits";
                break;
                 case "4" :
                tabName = "Fixeddeposits";
                break;
            }
        
            return tabName;
            
        }
}


@inherits Umbraco.Web.Mvc.UmbracoViewPage
@using AcfAfricanbank.Core.Models.Forms
@using ContentModels = Umbraco.Web.PublishedModels;
@using Web.Helpers;
@using System.Configuration;
@using CustomModels = Web.Models;
@{
	Layout = "Master.cshtml";
	
	 var children = Model.Children;
	 
	 var heroBody = children?.Where(c => c.ContentType.Alias.ToLower() == "herobody").FirstOrDefault();
     
      var Moneycard= heroBody.Children.Where(c => c.Name == "MoneyCards").FirstOrDefault();
      var Moneycardshare = Moneycard.Value<IEnumerable<IPublishedElement>>("tabBodyContent");
      var Moneycards = Moneycardshare.Where(c => c.ContentType.Alias == "nCTabGenericContent").FirstOrDefault().Value<IEnumerable<IPublishedElement>>("sectionContent");
    
      var sharecard= heroBody.Children.Where(c => c.Name == "ShareMoney").FirstOrDefault();
      var sharemoneycards = sharecard.Value<IEnumerable<IPublishedElement>>("tabBodyContent");
      var sharecards = sharemoneycards.Where(c => c.ContentType.Alias == "nCTabGenericContent").FirstOrDefault().Value<IEnumerable<IPublishedElement>>("sectionContent");

      ContentModels.TabBody createOwnWorldOfBanking = null;
      var partialName = sharecard.Value("PartialViewName");
      createOwnWorldOfBanking = (TabBody)sharecard;
      
      
      
    var bodyCards = heroBody?.Children?.Where(c => c.ContentType.Alias.ToLower() == "card");
    var applyDocs = bodyCards?.Select(c => c as Card).FirstOrDefault();
    var cardImage = applyDocs.Value("cardIcon");
      String cardUrl = ((IPublishedContent)cardImage).Url.ToString();
    var cardLink= applyDocs.Value("buttonLink");
   
    var navigate = applyDocs.Value<IEnumerable<Umbraco.Web.Models.Link>>("buttonLink").FirstOrDefault();
}

<link rel="stylesheet" href="/css/projectmagic.css" /> 

@* the fun starts here *@

  @{
         int idIterator = 0;
           foreach (var item in Moneycards){
               var tabSubItemImage = item.Value<IPublishedContent>("tabSubItemImage")?.Url;
               var tabSubItemIcon = item.Value<IPublishedContent>("tabSubItemIcon")?.Url;
    var title = item.Value<string>("tabSubItemTitle");
    var description = item.Value<string>("genericCardContent");
    
    
                
                
                 if (idIterator%2 == 0)
                    {
                        <section class="section-800 bg-grey-60">
                            <div class="container">
                                <div class="row align-items-center d-flex row-change">
                                    <div class="col-xl-6 col-lg-6 col-md-6">
                                        <h1 class="color-brand-1 mt-15 mb-20">@title</h1>
                                        <p class="font-md color-brand-1"> @item.Value("tabSubItemTextContent")</p>
                                       
                                    </div>
                                    <div class="col-xl-6 col-lg-6 col-md-6">
                                        <img Class="d-block"
                                             src="@tabSubItemImage"
                                             alt="" />
                                    </div>
                                </div>
                            </div>
                        </section>
                        }
                        else{
                        
                             <section class="section-800">
                                <div class="container">
                                    <div class="row align-items-center row-change d-flex flex-row-reverse">
                                        <div class="col-xl-6 col-lg-6 col-md-6">
                                            <h1 class="color-brand-1 mb-20">@title</h1>
                                            <p class="font-md color-grey-500">@item.Value("tabSubItemTextContent")</p>
                                       
                
                                        </div>
                                        <div class="col-xl-6 col-lg-6 col-md-6">
                                             <img
                                              Class="d-block"
                                              src="@tabSubItemImage"
                                             alt="" />
                                            
                                        </div>
                                    </div>
                                </div>
                            </section>
                        }
          idIterator += 1;
            }
        }


  <script>
    $(document).ready(function () {
      $(".gallery img, .gallery video").click(function () {
        var content;
        if ($(this).is("img")) {
          content =
            "<img src='" +
            $(this).attr("src") +
            "' class='img-fluid modal-img'>";
        } else {
          var videoSrc = $(this).find("source").attr("src");
          content =
            '<video class="modal-vid" controls autoplay><source src="' +
            videoSrc +
            '" type="video/mp4"></video>';
        }
        $(".modal-body").html(content);
        $("#myModal").modal("show");
      });

      $("#myModal").on("hidden.bs.modal", function () {
        var video = $(".modal-body video").get(0);
        if (video) {
          video.pause();
        }
      });
    });

  

    document.addEventListener("DOMContentLoaded", function () {
      const tabs = document.querySelectorAll(".tab");
      const contents = document.querySelectorAll(".content");

      tabs.forEach((tab, index) => {
        tab.addEventListener("click", function () {
          // Toggle the active class on the tab
          this.classList.toggle("active");

          // Get the content element related to this tab
          const content = contents[index];

          // Check if the clicked tab is active and set the display accordingly
          if (this.classList.contains("active")) {
            content.style.display = "block";
          } else {
            content.style.display = "none";
          }

          // Close all other contents
          contents.forEach((otherContent, otherIndex) => {
            if (otherIndex !== index) {
              otherContent.style.display = "none";
              tabs[otherIndex].classList.remove("active");
            }
          });
        });
      });
    });

    document.addEventListener("DOMContentLoaded", function () {
      const headers = document.querySelectorAll(".accordion-header");

      headers.forEach((header) => {
        header.addEventListener("click", function () {
          // Toggle the "active" class on the header
          this.classList.toggle("active");

          // Select the next element (should be the .accordion-content)
          var content = this.nextElementSibling;

          if (content.style.maxHeight) {
            content.style.maxHeight = null; // This will hide the content
          } else {
            content.style.maxHeight = content.scrollHeight + "px"; // This will expand the content
          }
        });
      });
    });
    
    
    document.addEventListener('DOMContentLoaded', function() {
    var playButtons = document.querySelectorAll('.play-button');

    function formatTime(time) {
        var minutes = Math.floor(time / 60);
        var seconds = Math.floor(time % 60);
        return minutes + ':' + (seconds < 10 ? '0' + seconds : seconds);
    }

    playButtons.forEach(function(button) {

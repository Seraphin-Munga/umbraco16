  <script>
   const line = $(".vertical-timeline-innerline");
                    const verticalTimelineEvents = $(".vertical-timeline-item");
                
                    function showContent(e) {
                        e.attr("done", "true");
                        e.find(".vertical-timeline-point").css("background", "#002B60");
                        e.find(".date").css("opacity", "100%");
                        e.find("p").css({ opacity: "100%", transform: "translateY(0px)" });
                    }
                
                    function hideContent(e) {
                        e.removeAttr("done");
                        e.find(".vertical-timeline-point").css("background", "rgb(228, 228, 228)");
                        e.find("p").css({ opacity: "0%", transform: "translateY(-10px)" });
                    }
                
                    function showEventByYear(year) {
                        verticalTimelineEvents.each((idx, ev) => {
                            if ($(ev).data("year") === year) {
                                showContent($(ev));
                            } else {
                                hideContent($(ev));
                            }
                        });
                    }
                
                    function verticalTimelineProgress(value) {
                        let progress = `${(value / verticalTimelineEvents.length) * 100}%`;
                        if (window.matchMedia("(min-width: 728px)").matches) {
                            line.css({ width: progress, height: "4px" });
                        } else {
                            line.css({ height: progress, width: "4px" });
                        }
                    }
                
                    $(document).ready(() => {
                        // Show the first event initially
                        showEventByYear(2000);
                    });
                
  </script>


@inherits Umbraco.Web.Mvc.UmbracoViewPage<ContentModels.BlogLanding>
@using ContentModels = Umbraco.Web.PublishedModels;
@using CustomModels = Web.Models;
@using Web.Helpers;
@using System.Configuration;
@using Io = System.IO
@using System.Drawing
@using ImageProcessor
@{
    Layout = "Master.cshtml";
    // All Current Page Children
    var children = Model.Children;
    ContainerViewModel containerViewModel = new ContainerViewModel();
    @*search code start*@
    IExamineManager examineManager = ExamineManager.Instance;
    var searcher = examineManager.TryGetIndex("ExternalIndex", out var externalIndex) ? externalIndex.GetSearcher() : null;
    var searchCriteria = searcher.CreateQuery("nodes", Examine.Search.BooleanOperation.Or);
    var indexString = "";
    int foundResults = 0;
    var indexStringAlt = "";
    if (!string.IsNullOrEmpty(Request.QueryString["searchstring"]))
    {
        indexString = Request.QueryString["searchstring"];
        indexStringAlt = "searchstring";

        searchCriteria.Field("nodeName", "blog-detail").And().Field("nodeName", indexString.Boost(5));
    }
    else if (!string.IsNullOrEmpty(Request.QueryString["category"]))
    {
        indexString = Request.QueryString["category"];

        searchCriteria.Field("nodeName", "blog-detail").And().Field("blogCategory", indexString.Boost(5));
    }
    else if (!string.IsNullOrEmpty(Request.QueryString["blogstartdate"]) && !string.IsNullOrEmpty(Request.QueryString["blogenddate"]))
    {
        indexString = Request.QueryString["blogstartdate"];
        indexStringAlt = Request.QueryString["blogenddate"];
    }

    Examine.ISearchResults searchQuery = null;
    if (indexString != "")
    {
        searchQuery = searchCriteria.Field("nodeName", indexString.Boost(8)).Or().Field("nodeName", indexString.Fuzzy()).Execute();
    }
    var searchResults = searchQuery;

    // Get specific Children
    var heroHeader = children?.Where(c => c.ContentType.Alias.ToLower() == "heroheader").FirstOrDefault();
    var heroShoulder = children?.Where(c => c.ContentType.Alias.ToLower() == "heroshoulder").FirstOrDefault();
    var heroBody = children?.Where(c => c.ContentType.Alias.ToLower() == "herobody").FirstOrDefault();
    var heroBodyTabGroup = heroBody.Children?.Where(c => c.ContentType.Alias.ToLower() == "tabgroup").FirstOrDefault();

    //Get specific properties
    var headerImage = heroHeader?.Value<IPublishedContent>("image")?.Url;
    var heroShoulderTitle = heroShoulder?.Value("shoulderTitle").ToString();
    var heroShoulderDescription = heroShoulder?.Value("shouderDescription").ToString();
    
    //Get blog elements
    var TupleBlogs = new List<Tuple<int, string, string, string, string, DateTime, string>>();
    var TupleVideos = new List<Tuple<int, string, string, string, string, DateTime, string>>();
    foreach (var item in children)
    {
        if (item.Id == 41927)
        {
            break;
        }
        if (item.ContentType.Alias == "blogDetail")
        {
            var blogHeader = item.Children.FirstOrDefault().Children.Where(c => c is HeroHeaderBlogDetail).FirstOrDefault();
            var blogBody = item.Children.FirstOrDefault().Children.Where(c => c is HeroBodyBlogDetail).FirstOrDefault();
            var image = blogHeader.Value<int>("image");
            var videoItems = blogHeader.Value<int>("HeroHeaderVideo");

            if (searchResults != null)
            {
                if (searchResults.Count() != 0 && indexString != "")
                {
                    foreach (var result in searchResults)
                    {
                        try
                        {
                            var node = Umbraco.Content(result.Id);

                            if (node == null)
                            {
                                continue;
                            }

                            var nodeParentId = node.Parent.Id;
                            if (indexStringAlt == "searchstring")
                            {
                                nodeParentId = node.Id;
                            }

                            if (item.Id == nodeParentId)
                            {
                                TupleBlogs.Add(new Tuple<int, string, string, string, string, DateTime, string>(
                                    item.Id,
                                    ((IPublishedContent)blogHeader.Value("image")).Url?.ToString() ?? "",
                                    (blogBody.Value("title"))?.ToString() ?? "",
                                    (blogBody.Value("introductionDescription"))?.ToString() ?? "",
                                    ((IPublishedContent)blogHeader.Value("HeroHeaderVideo")).Url?.ToString() ?? "",
                                    Convert.ToDateTime(blogBody.Value("blogDate")),
                                    (blogBody.Value("blogBody"))?.ToString() ?? ""
                                    ));
                            }
                        }
                        catch
                        {
                            Console.WriteLine("Error: ");
                        }
                    }

                }
                else
                {
                    if (indexStringAlt != "searchstring" && indexString != "" && indexStringAlt != "")
                    {
                        DateTime testdate = Convert.ToDateTime(blogBody.Value("publishedAt"));
                        if (testdate == null || testdate == Convert.ToDateTime("01/01/0001 00:00:00"))
                        {
                            testdate = Convert.ToDateTime(blogBody.Value("blogDate"));
                        }
                        DateTime startdate = Convert.ToDateTime(indexString);
                        DateTime enddate = Convert.ToDateTime(indexStringAlt);

                        if (testdate <= startdate || testdate >= enddate)
                        {
                            continue;
                        }
                    }

                    TupleBlogs.Add(new Tuple<int, string, string, string, string, DateTime, string>(
                                    item.Id,
                                    ((IPublishedContent)blogHeader.Value("image")).Url?.ToString() ?? "",
                                    (blogBody.Value("title"))?.ToString() ?? "",
                                    (blogBody.Value("introductionDescription"))?.ToString() ?? "",
                                    ((IPublishedContent)blogHeader.Value("HeroHeaderVideo")).Url?.ToString() ?? "",
                                    Convert.ToDateTime(blogBody.Value("blogDate")),
                                    (blogBody.Value("blogBody"))?.ToString() ?? ""
                                    ));
                }
            }
            else
            {
                
                if (indexStringAlt != "searchstring" && indexString != "" && indexStringAlt != "")
                {
                    DateTime testdate = Convert.ToDateTime(blogBody.Value("publishedAt"));
                    if (testdate == null || testdate == Convert.ToDateTime("01/01/0001 00:00:00"))
                    {
                        testdate = Convert.ToDateTime(blogBody.Value("blogDate"));
                    }
                    DateTime startdate = Convert.ToDateTime(indexString);
                    DateTime enddate = Convert.ToDateTime(indexStringAlt);

                    if (testdate <= startdate || testdate >= enddate)
                    {
                        continue;
                    }
                }

                TupleBlogs.Add(new Tuple<int, string, string, string, string, DateTime, string>(
                                item.Id,
                                ((IPublishedContent)blogHeader.Value("image")).Url?.ToString() ?? "",
                                (blogBody.Value("title"))?.ToString() ?? "",
                                (blogBody.Value("introductionDescription"))?.ToString() ?? "",
                                ((IPublishedContent)blogHeader.Value("HeroHeaderVideo")).Url?.ToString() ?? "",
                                Convert.ToDateTime(blogBody.Value("blogDate")),
                                (blogBody.Value("blogBody"))?.ToString() ?? ""
                                ));
                

            }


        }

    }
    ViewBag.searchstring = indexString;
    ViewBag.searresult = TupleBlogs;
    TempData["Blogs"] = TupleBlogs;

    var showNoContent = "none;";
    TupleBlogs = TupleBlogs.OrderByDescending(b => b.Item6).ThenBy(x => x.Item6.ToShortDateString() == "01/01/0001").ToList();
    if (TupleBlogs.Count() == 0)
    {
        showNoContent = "";
    }

    /*Press Release*/
    var latestPrs = new List<NcArchieve>();
    var prContent = Model.Parent.Children(x => x.Name == "Press Releases").FirstOrDefault().Children(x => x.Name == "Hero Body").FirstOrDefault();
    var tabBody = (TabBody)prContent.Children(x => x is TabBody).FirstOrDefault();
    var prs = (IEnumerable<IPublishedElement>)tabBody.TabBodyContent.Where(c => c.ContentType.Alias == "nCTabGenericContent").FirstOrDefault().Value("sectionContent");
    var count = 0;
    for (int x = prs.Count() - 1; x > 0; x--)
    {
        var lprs = ((List<NcArchieve>)(prs.ToList()[x].Properties.ToList()[1].Value("nCdocuments")));
        foreach (var p in lprs)
        {
            if (count > 3)
            {
                break;
            }
            var a = (NcArchieve)p;
            latestPrs.Add(a);
            count += 1;
        }
    }

}

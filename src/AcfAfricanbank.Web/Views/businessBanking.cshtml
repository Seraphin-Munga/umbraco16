/*
Accordion style start here
*/
.accordion {
  font-weight: bold; /* Explicitly setting font-weight */
  font-family: Montserrat, sans-serif; /* Specifying the font family */
  background-color: #222222;
  color: #9b9b9b;
  cursor: pointer;
  padding: 18px;
  width: 100%;
  text-align: left;
  font-size: 15px;
  transition: 0.4s;
  border-radius: 50px;
  border: none;
  margin-bottom: 10px; /* Space between inactive accordion buttons */
  position: relative; /* Needed for absolute positioning of the arrow */
}

.accordion::after {
  content: '\276F'; /* Heavy Chevron Unicode character */
  font-size: 15px; /* Adjust as needed */
  color: #F9F9F9;
  position: absolute;
  right: 20px;
  top: 50%;
  transform: translateY(-50%);
  transition: transform 0.4s;
}

.active, .accordion:hover {
  background-color: #222222;
}

.active {
  color: #F9F9F9;
  border-radius: 30px 30px 0 0; /* Rounded corners on the top when active */
  margin-bottom: 0; /* Remove space between button and panel for active accordion */
}

.active::after {
  transform: translateY(-50%) rotate(90deg);
}

.panel {
  font-family: Montserrat, sans-serif; /* Specifying the font family */
  padding:  18px 18px 25px 18px;
  background-color: #222222;
  color : #F9F9F9;
  display: none;
  overflow: hidden;
  border-radius: 0 0 30px 30px;; /* Round the bottom corners */
  border-top: none; /* Remove the border top to make it seamless with the button */
  margin-top: -1px; /* This ensures that the panel sits flush with the button */
  box-shadow: inset 0 3px 6px #222222; /* Optional: inner shadow to mimic the button's inset */
}

  .faqHeader {
    font: normal normal bold 42px/52px Montserrat;
    letter-spacing: 0px;
    color: #F9F9F9;
    opacity: 1;
    text-align: center; /* This centers the text within the h4 */
    margin: 0 auto; /* This ensures that the margin is auto on both sides for block-level centering */
    padding: 20px 0; /* Adds some padding above and below the text */
  }
/*
Accordion style end here
*/


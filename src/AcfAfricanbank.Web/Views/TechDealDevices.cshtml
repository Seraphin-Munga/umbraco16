       function updateCategoryUrl(tabtext, type, isRefresh = false) {


            if (tabtext && type) {
                tabtext = tabtext.trim();
                var newURL = window.location.href;
                switch (type) {
                    case "devicetype":
                        if (newURL.indexOf("?DeviceType") > -1) {
                            var urlArr = newURL.split('?');
                            newURL = urlArr[0] + "?DeviceType=" + tabtext;
                            if (isRefresh && urlArr.length > 1 && urlArr[1].indexOf('&') > -1) {
                            var otherParams = urlArr[1].split('&');
                            if(otherParams && otherParams.length) {
                                newURL += ("&" + otherParams[1]);

                                if(otherParams.length === 3) {
                                    newURL += ("&" +  otherParams[2]);
                                }
                            }

                         }
                        } else {
                            newURL = window.location.href + "?DeviceType=" + tabtext;
                        }
                        break;

                    case "category":
                        if (newURL.indexOf("&Category") > -1) {
                            var urlArr = newURL.split('&');
                            newURL = urlArr[0] + "&Category=" + tabtext;
                        } else {
                            newURL = window.location.href + "&Category=" + tabtext;
                        }
                        break;
                    case "devicename":
                        if (newURL.indexOf("&DeviceName") > -1) {
                            var urlArr = newURL.split('&');

                            if(urlArr.length > 2) {
                            newURL = urlArr[0] +"&"+ urlArr[1] + "&DeviceName=" + tabtext;
                            } else {
                            newURL = urlArr[0] + "&DeviceName=" + tabtext;
                            }
                        } else {
                            newURL = window.location.href + "&DeviceName=" + tabtext;
                        }
                        break;
                }
                history.pushState(null, null, newURL);
            }
        }


@inherits Umbraco.Web.Mvc.UmbracoViewPage
@using AcfAfricanbank.Core.Models.Forms
@using ContentModels = Umbraco.Web.PublishedModels;
@using Web.Helpers
@using CustomModels = Web.Models;
@using System.Collections.Generic;

@{
    Layout = "Master.cshtml";

    // All Current Page Children
    var children = Model.Children;

    // Get specific Children
    var heroHeader = children?.Where(c => c.ContentType.Alias.ToLower() == "heroheader").FirstOrDefault();
    var heroShoulder = children?.Where(c => c.ContentType.Alias.ToLower() == "heroshoulder").FirstOrDefault();
    var heroChest = children?.Where(c => c.ContentType.Alias.ToLower() == "herochestinvestments").FirstOrDefault();
    var heroBody = children?.Where(c => c.ContentType.Alias.ToLower() == "herobody").FirstOrDefault();

    var infoGraphic = heroBody.Children.Last().Children.FirstOrDefault();
    TabBody tabInfoGraphicData = (TabBody)heroBody.Children.Last(); // based on the child item node on the parent list
    var buttonLinkData = tabInfoGraphicData.Children.Where(x => x.ContentType.Alias.ToString().ToLower() == "ebankititem2").FirstOrDefault();
    @*var imageUrlString = ((ContentModels.Image)((IPublishedContent)infoGraphic.Value("ebankITImage"))).Url;
    var altTagImageUrl = ((ContentModels.Image)((IPublishedContent)infoGraphic.Value("ebankITImage"))).AltTag;
*@
    var heroKnees = children?.Where(c => c.ContentType.Alias.ToLower() == "heroknees").FirstOrDefault();
    var testimonialTab = children?.Where(c => c.ContentType.Alias.ToLower() == "testimonials").FirstOrDefault();
    var homePageElements = (HomePageElements)Model.Parent.Children.Where(o => o is HomePageElements).FirstOrDefault();

    var viewName = Path.GetFileNameWithoutExtension(Server.MapPath(VirtualPath));

    // Get Specific grand children

    var bodyCards = heroBody?.Children?.Where(c => c.ContentType.Alias.ToLower() == "card");
    var bodyButton = heroBody?.Children?.Where(c => c.ContentType.Alias == "ebankITAbstractButton").FirstOrDefault();

  

    var benefitsHeader = heroChest?.Value("benefitsTitle")?.ToString();
    var benefitsDescription = heroChest?.Value("benefitsDescription")?.ToString();
    var ratesTerms = heroChest?.Value<IEnumerable<string>>("ratesTerms");
    var calculatorIntro = heroChest?.Value("calculatorIntro")?.ToString();
    var calculatorButtonLabel = heroChest?.Value("calculatorButtonLabel")?.ToString();

    var bodyTitle = heroBody?.Value("bodyTitle").ToString();
    var bodyDescription = heroBody?.Value("bodyDescription").ToString();

    var applyDocs = bodyCards.Select(c => c as Card).ToList();

    var headerImage_large = heroHeader?.Value<IPublishedContent>("image")?.Url;
    var headerImage_medium = heroHeader?.Value<IPublishedContent>("imageMedium")?.Url;
    var headerImage_small = heroHeader?.Value<IPublishedContent>("imageSmall")?.Url;

}

<style>

    .card-shadow.rate-card {
        max-width: 230px !important;
    }

    .col-md-offset-1 {
        margin-left: 0.33% !important;
    }

    .card-shadow {
        padding: 20px 10px !important;
    }



    .control-label {
        text-align: left !important;
        width: 100%;
    }

    #calculator {
        top: unset;
        padding-bottom: 0px;
    }

    #fixedDepositInvestmentAmount {
        width: 90% !important;
    }

    .select.area {
        width: 90% !important;
    }

    .campaign-product-container {
        top: unset;
    }

    #fixedDeposit-calculator-container {
        background-color: #f7f7f7;
    }

    .card-shadow.rate-card-fixed-deposit-offer {
        margin: unset;
        text-align: unset;
    }

    #fixedResults {
        margin-top: -300px;
    }

    .btnCalc {
        padding-top: 25px;
    }

    .resultbtn {
        padding: 16px 16px;
    }

    .background-interest-selected {
        background-color: #4c6a8f;
        color: #fff !important;
        border-bottom-color: #f8f8f800 !important;
        border-top-color: #f8f8f800 !important;
    }

    .rightboarder {
        border-right: 1px solid #001f44;
    }

    .spacePush {
        background-color: #002b60;
        color: #002b60;
        border: none;
    }

    .table > tbody > tr > th {
        padding: 12px !important;
    }

    @@media (min-width: 1023px) and (max-width: 1024px) {

        .col-md-offset-1 {
            margin-left: 8.33% !important;
        }


        .col-md-2, .col-sm-6, .col-lg-6 {
            width: 30%;
        }
    }

    @@media (max-width: 767px) {
        .btnCalc {
            margin-bottom: 30px;
            text-align: center;
        }

        #form-preloader {
            top: -30em;
            position: relative;
        }
    }

    @@media (max-width: 425px) {

        .resultbtn {
            padding: 16px 14px;
        }

        .table > tbody > tr.green > td {
            color: #88bc47;
            font-size: 15px;
            font-weight: 600;
        }
    }



    @@media (max-width: 320px) {

        .resultbtn {
            font-size: 12px;
        }
    }
    
        @@media (min-width: 1000px) and (max-width: 10000px) {
        .row-pop {
            margin-top: 10px;
        }
        
        #popUpHuawei {
             margin-right: -59rem;
             margin-top: -125px;
         }
         
          #popUpIOS {
             margin-top: -45px;
             margin-right: -55rem;
         }
         
         #popUpAndroid {
             margin-right: -45px;
         }
         
        .modal-dialog {
            width: 900px !important;
        }
    }
    
    @@media (min-width: 768px) and (max-width: 1024px) {
        .row-pop {
            margin-top: 10px;
        }
        
        #popUpHuawei {
             margin-right: -59rem;
             margin-top: -125px;
         }
         
          #popUpIOS {
             margin-top: -45px;
             margin-right: -55rem;
         }
         
         #popUpAndroid {
             margin-right: -45px;
         }
         
        .modal-dialog {
            width: 800px !important;
        }
    }
</style>




<!-- HERO BANNER -->
@Html.Partial("_pageHeaderImage", heroHeader as ContentModels.HeroHeader)

<!-- HERO CONTINUED-->
@Html.Partial("_pageShoulder", heroShoulder as ContentModels.HeroShoulder)

<div class="container infographic">
    <div class="row">

        <div class="col-md-4">
           @* <img class="info-img" src="@imageUrlString" alt="@altTagImageUrl"> *@
        </div>
        <div class="col-md-8 info-button">
         @* @infoGraphic.Value("ebankItContent")*@
            @{
                if (buttonLinkData != null)
                {
                    Umbraco.Web.Models.Link buttonDocumentLink = null;
                    if (buttonLinkData.Value("sectionLink") != null)
                    {
                        foreach (var link in (IEnumerable<Umbraco.Web.Models.Link>)buttonLinkData.Value("sectionLink"))
                        {
                            buttonDocumentLink = link;
                            break;
                        }
                        if (buttonDocumentLink != null)
                        {
                            var _buttonText = buttonDocumentLink.Name;
                            var btnId = viewName + "_" + _buttonText.ToString().Replace(" ", "") + "_" + "African Bank Fixed deposit";

                            <a class="button primary clearfix" href="@buttonDocumentLink.Url" id="@btnId">
                                @_buttonText
                            </a>
                        }
                    }
                }
            }
        </div>
    </div>
</div>
<!-- POPULAR RATES -->

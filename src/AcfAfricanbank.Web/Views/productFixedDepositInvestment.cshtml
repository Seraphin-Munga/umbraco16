@section scripts
{


    <script type="text/javascript" src="@Url.Content("~/Scripts/handlebars-v4.0.5.min.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Common.JS.Library.Ab/Calculator/jquery.xdomainrequest.min.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Common.JS.Library.Ab/Calculator/calculator.js?ver=2.1")"></script>
    <script type="text/javascript" src="@Url.Content("~/Common.JS.Library.Ab/Calculator/calculator1.min.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Common.JS.Library.Ab/Calculator/calculatorHandler.min.js")"></script>
    <script type="text/javascript">
    
    function getMobileOperatingSystem() 
    {
        var userAgent = navigator.userAgent || navigator.vendor || window.opera;
        
        if (/windows phone/i.test(userAgent)) {
            return "Windows Phone";
        }
    
        if (/android/i.test(userAgent)) {
            return "Android";
        }
    
        if (/iPad|iPhone|iPod/.test(userAgent) && !window.MSStream) {
            return "iOS";
        }
    
        return "unknown";
    }

   $(document).ready(function () {
       
         var downloadPath = window.location.href;
        var hastagDownload = downloadPath.substring(downloadPath.length-9, downloadPath.length);

        var emoji = String.fromCodePoint(0x1F60A);
        var platform = "";
        var appendHTML = "<div class='hidden-sm hidden-md hidden-lg'><div class='row'><div class='col-xs-12'> " +
                        "<span class='copy'> Discover new ways to bank conveniently and safely and do your banking your way. Download our Banking App now.</span>" +
                        "</div></div>" +
                        "<div class='row'><div class='col-xs-12'><a class='app-platform button primary clearfix' style='background-color: #88bc47 !important;' " +
                        "href=''>Get it!</a></div></div></div>" +
                        "<div class='hidden-xs row'><div class='col-xs-12 col-sm-1 col-md-1 col-lg-1' style='padding-left:10%;'>" +
                        "<i class='fa fa-mobile' aria-hidden='true' style='font-size:58px;'></i></div>" +
                        "<div class='col-xs-12 col-sm-7 col-md-7 col-lg-7' style='text-align: left;padding-left: 50px;'>" +
                        "<span class='copy'>For easier navigation and to get familiar with our products - we reckon you should use our app</span></div>" +
                        "<div class='hidden-xs col-sm-3 col-md-3 col-lg-3' style='margin: 9px;padding-right: 2px;'>" +
                        "<a class='app-platform button primary clearfix' style='background-color: #88bc47 !important;' href='' >Get it!</a>" +
                        "</div></div>";

        switch(getMobileOperatingSystem())
        {
            case "Android":
                platform = "https://play.google.com/store/apps/details?id=za.co.android.africanbank";
                
                @*$("#AndroidUrl").attr('href');*@

                $('.modal-title').text('Hi, Android User ' + emoji);
                $('.modal-body').text("");

                $('.modal-body').append(appendHTML);
                $('.app-platform').attr('href', platform);
                @*$('.copy').html('@mobileBlurp');*@
                $('#generic').modal("show");
                break;

            case "iOS":
                platform = platform = "https://itunes.apple.com/us/app/apple-store/id1357204405?mt=8";
                //$("#iOSUrl").attr('href');
                $('.modal-title').text('Hi, iOS User ' + emoji);
                $('.modal-body').text("");
                $('.modal-body').append(appendHTML);
                @*$('.copy').html('@mobileBlurp');*@

                $('.app-platform').attr('href', platform);
                $('#generic').modal("show");
                break;
            default:
                console.log("click");

        }
        
        
    
        var imageBgCss = "url('" + "@headerImage_large" + "')";
        var imageMdCss = "url('" + "@headerImage_medium" + "')";
        var imageSmCss = "url('" + "@(string.IsNullOrEmpty(headerImage_small) ? headerImage_medium : headerImage_small)" + "')";
        var CheckScreenSize;
        (CheckScreenSize = function () {
            var _width = $(window).outerWidth();
            var _height = $(window).outerHeight();
            if (_width <= 511) {
                $("#heroHeader").css("background-image", imageSmCss);
            }
            else {
                $("#heroHeader").css("background-image", imageBgCss);
            }
        })();
        $(window).resize(CheckScreenSize);
    });

    $(function () {
        $(".area_buttons_calculate").hide();
        var hasError = true;
        var data = {
            product: 'Fixed',
            rateContainer: '#rates-container',
            calcFormContainer: '#calculatorfixed-form',
            serviceUrl: '@System.Configuration.ConfigurationManager.AppSettings["ebankit.Portal.Services.Mobile.URL"]',
            headers: [
                   ['ITSAPP-DEVICE', '@System.Configuration.ConfigurationManager.AppSettings["ebankit.Portal.Services.ITSAPP-DEVICE"]'],
                   ['ITSAPP-LANG', 'en-GB'],
                   ['ITSAPP-DEVICEID', '*'],
                   ['Content-type', 'application/json']
            ],
            translations: {
                amount: '@ResourceHelper.GetResource("OnceOffInvestmentAmount")',
                monthlyInterestRateIncrease: '@ResourceHelper.GetResource("MonthlyInterestRateIncrease")',
                period: '@ResourceHelper.GetResource("Period")',
                interestRatePa: '@ResourceHelper.GetResource("InterestRatePerAnnum")',
                interestEarned: '@ResourceHelper.GetResource("InterestEarned")',
                totalPayout: '@ResourceHelper.GetResource("TotalPayout")',
                interestPayoutExpiry: '@ResourceHelper.GetResource("InterestPayoutOnExpiry")',
                semiAnnualInterestPayout: '@ResourceHelper.GetResource("SemiAnnualInterestPayout")',
                annualInterestPayout: '@ResourceHelper.GetResource("AnnualInterestPayout")',
                minInvestAmount: '@ResourceHelper.GetResource("MinimumInvestmentAmount")',
                monthlyInterPayout: '@ResourceHelper.GetResource("MonthlyInterestPayout")',
                terms: '@ResourceHelper.GetResource("Terms",1)',
                term: '@ResourceHelper.GetResource("Term",2)',
                interestPayoutFrequency: '@ResourceHelper.GetResource("InterestPayoutFrequency")',
                interestPayoutFreq: '@ResourceHelper.GetResource("InterestPayoutFreq")',
                AmountMandatory: '@ResourceHelper.GetResource("InvestmentAmountIsMandatory")',
                investmentReturns: '@ResourceHelper.GetResource("InvestmentReturns")',
                after: '@ResourceHelper.GetResource("After")',
                months: '@ResourceHelper.GetResource("Months")',
                years: '@ResourceHelper.GetResource("Years")',
                onceOffInvestmentAmountIsMandatory: '@ResourceHelper.GetResource("OnceOffInvestmentAmountIsMandatory")',
                amountCannotBeLessThan: '@ResourceHelper.GetResource("AmountCannotBeLessThan")',
                interestPayoutFrequency: '@ResourceHelper.GetResource("InterestPayoutFrequency")',
                investmentReturnsMessage: '@ResourceHelper.GetResource("InvestmentReturnsMessage")',
                ourOfferAmount: '@ResourceHelper.GetResource("OurOfferAmount")',
                accept: '@ResourceHelper.GetResource("Accept")',
                cancel: '@ResourceHelper.GetResource("Cancel")',
                increaseCapital: '@ResourceHelper.GetResource("IncreaseCapital")',
                fixedDescription: '@ResourceHelper.GetResource("FixedDescription")',
                payoutFreqErrorMessage: '@ResourceHelper.GetResource("PayoutFreqErrorMessage")',
                monthlyInvestmentThereafter: '@ResourceHelper.GetResource("MonthlyInvestmentThereafter")',
                increaseOnceOff: '@ResourceHelper.GetResource("IncreaseOnceOff")',
                changeInterestOption: '@ResourceHelper.GetResource("ChangeInterestOption")'
            }
        };
        $(window).on('CalculatorLoading', function (e) {


                var isMobileheaderHide = document.getElementsByClassName('tbl-header-selected');
                if (isMobileheaderHide.length > 0) {
                    $('#calculatorfixed-form table thead th.tbl-header-selected').addClass('hidden-xs');
                    $('#calculatorfixed-form table thead th.background-interest-selected').removeClass('hidden-xs');
                    $('#calculatorfixed-form table tbody td.tbl-header-selected').addClass('hidden-xs');
                    $('#calculatorfixed-form table tbody td.background-interest-selected').removeClass('hidden-xs');
                }
                var isMobilebodyHide = document.getElementsByClassName('value_calculatorformate');
                if (isMobilebodyHide.length > 0) {
                    $('#calculatorfixed-form table tbody tr td.value_calculatorformate').addClass('hidden-xs');
                    $('#calculatorfixed-form table tbody tr td.background-interest-selected').removeClass('hidden-xs');
                }

            df=e;
            var _state = e.state;
            var _target = e.target;

            $(".errorcalculatores").hide();

            if (_target !== 'rates') {
                if (_state) {
                    $("#form-preloader").show();
                    // $("#calculatorfixed-form").hide();
                    $("#calculator-container").hide();

                    ChangePageControls(false);
                } else {
                    $("#form-preloader").hide();
                    if (hasError) {
                        $(".errorcalculatores").show();
                        // $("#calculatorfixed-form").hide();
                        $("#calculator-container").hide();
                    } else {
                        $(".errorcalculatores").hide();
                        // $("#calculatorfixed-form").show();
                        $("#calculator-container").show();
                        $('.money').autoNumeric('init', { aSep: ' ', aDec: '.', aSign: 'R' });
                    }

                    ChangePageControls(Calculator.isCalculatorValid('Fixed'));
                }
            } else {
                if (_state) {
                    $("#rates-form-preloader").show();
                    $('.rate-table').show();
                } else {
                    $("#rates-form-preloader").hide();
                    $('.rate-table').show();
                }
            }

        });

        //$(window).on('CalculatorValidationHandler', function (e) {
        //    var _state = e.state;

        //    ChangePageControls(_state);

        //});

        $(window).on('Error', function (e) {

            var _target = e.target;

            if (_target) {
                if (_target === 'rates') {
                    if (!e.errorDescription) {
                        $(".rate-table").show();
                        $("#rates-form-preloader").hide();

                        return;
                    }

                    $(".rate-table").hide();
                    $("#rates-form-preloader").hide();
                    $(".errorrates").show();
                } else {

                    if (!e.errorDescription) {
                        hasError = false;

                        $("#form-preloader").hide();
                        // $("#calculatorfixed-form").show();
                        $("#calculator-container").show();
                        ChangePageControls(false);

                        $(".errorcalculatores").hide();

                        return;
                    } else {

                        hasError = true;
                        $("#form-preloader").hide();
                        // $("#calculatorfixed-form").hide();
                        $("#calculator-container").hide();
                        $(".errorcalculatores").show();
                        ChangePageControls(false);
                    }
                }
            }
        });

        function ChangePageControls(enabled) {
            $(".area_buttons_calculate").hide();
            if (enabled) {
                $("#buttonPrint").removeClass("disabledbutton");
                $(".area_buttons_calculate").show();
            }
            else {
                $("#buttonPrint").addClass("disabledbutton");

            }
        }

      //  console.log("pepe " ,JSON.stringify(data,null,2));
        Calculator.init(data);
        $("#buttonPrint").click(function () {
            CalculatorHandler.printRatesDoc(data);
        });

    });

     $(function () {
                $(window).on('CalculatorLoading', function (e) {
                    var _state = e.state;
                    var _target = e.target;
                    if (_state) {
                        if (_target === 'rates') {
                            $("#rates-form-preloader").show();
                        }
                    } else {
                        if (_target === 'rates') {
                            $("#rates-form-preloader").hide();
                        }
                    }
                })
            });

    $(document).on('click', '#calculateFixedDeposit', function (event) {
        $('#fixedResultsMobile').css('height', '280px');
    });


    $(".btn_ok_modal").click(function () {

      //  window.open($("#linkib").val(), "_blank");
        $('#myModal').modal('hide');
    });

    </script>
}
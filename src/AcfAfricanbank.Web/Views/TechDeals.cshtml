@{
    Layout = "Master.cshtml";

    // All Current Page Children
    var children = Model.Children;

    // Get specific Children
    var heroHeader = children?.Where(c => c.ContentType.Alias.ToLower() == "heroheader").FirstOrDefault();
    var heroShoulder = children?.Where(c => c.ContentType.Alias.ToLower() == "heroshoulder").FirstOrDefault();
    var heroShoulderNew = children?.Where(c => c.ContentType.Alias.ToLower() == "heroshoulder").Last();
    var heroChest = children?.Where(c => c.ContentType.Alias.ToLower() == "herochestvad").FirstOrDefault();
    var chestCards = heroChest.Children.Where(c => c.ContentType.Alias.ToLower() == "card");
    

    var heroBody = children?.Where(c => c is HeroBody).FirstOrDefault();
    var applicationRequirements = heroBody.Children(x => x.ContentType.Alias.ToLower() == "herobodycontactus").FirstOrDefault();
    var footerDescription = heroBody.Value("richTextBox").ToString();

    var oneNumberControl = heroBody.Children.Where(c => c is RichTextEditor).FirstOrDefault();
    var bodyTitle = heroBody.Value("bodyTitle").ToString();
    var bodyDescription = heroBody.Value("bodyDescription").ToString();
    
   TabBody tabInfoGraphicData = (Umbraco.Web.PublishedModels.TabBody) heroBody.Children.Where(c => c is TabBody).FirstOrDefault();
   
   var buttonLinkData = tabInfoGraphicData.Children.Where(x => x.ContentType.Alias.ToString().ToLower() == "ebankititem2").FirstOrDefault();
    var imageUrlString = ((ContentModels.Image)((IPublishedContent)buttonLinkData.Value("ebankITImage"))).Url;
    var altTagImageUrl = ((ContentModels.Image)((IPublishedContent)buttonLinkData.Value("ebankITImage"))).AltTag;
    
 var videoItem = heroBody.Children.Where(c => c.ContentType.Alias.ToLower() == "tabbody").FirstOrDefault();
  var noCampcontent = videoItem.Value<IEnumerable<IPublishedElement>>("tabBodyContent");
        var noCampvideos = noCampcontent.Where(c => c.ContentType.Alias == "nCTabGenericContent").FirstOrDefault().Value<IEnumerable<IPublishedElement>>("sectionContent");
        var noCampx = 1;
        
        
 
    var benefitsModel = new CustomModels.Benefits
    {
        Header = bodyTitle,
        Description = bodyDescription,
        BenefitCards = chestCards.Select(c => c as Card).ToList()
    };

    var documents = ((Umbraco.Web.PublishedModels.HeroBody)heroBody).Documents;
    string brochurePath = documents.FirstOrDefault().File.Url;

    var testimonialTab = children?.Where(c => c.ContentType.Alias.ToLower() == "testimonials").FirstOrDefault();
    var mobileDevicePoppup = children?.Where(c => c.ContentType.Alias.ToLower() == "pagepopup").FirstOrDefault();
     
    var homePageElements = (HomePageElements)Model.Parent.Children.Where(o => o is HomePageElements).FirstOrDefault();

    // Get Specific grand children
    var mainTabs = heroChest?.Children.Where(c => c.ContentType.Alias.ToLower() == "valueaddeddeal");

    var cellPhonesTab = mainTabs.Where(c => c.Value("tabType")?.ToString().ToLower() == "cellphones").FirstOrDefault();
    var tabletsTab = mainTabs.Where(c => c.Value("tabType")?.ToString().ToLower() == "tablets").FirstOrDefault();

    ContainerViewModel containerViewModel = new ContainerViewModel();

    var headerImage_large = heroHeader?.Value<IPublishedContent>("image")?.Url;
    var headerImage_medium = heroHeader?.Value<IPublishedContent>("imageMedium")?.Url;
    var headerImage_small = heroHeader?.Value<IPublishedContent>("imageSmall")?.Url;

    var heroChest1 = children?.Where(c => c.ContentType.Alias.ToLower() == "herochest").FirstOrDefault();
    var chestTitle = heroChest1?.Value("chestTitle").ToString();
    var chestDescription = heroChest1?.Value("chestDescription").ToString();
    var chestCards1 = heroChest1?.Children?.Where(c => c.ContentType.Alias.ToLower() == "card");
    var heroTitle = heroChest1.Children.Where(c => c is RichTextEditor).FirstOrDefault();
    var TechDealModel = new CustomModels.Benefits
    {
        Header = chestTitle,
        Description = chestDescription,
        BenefitCards = chestCards1.Select(c => c as Card).ToList()
    };
    
    var heroChest2 = children?.Where(c => c.ContentType.Alias.ToLower() == "herochest").Last();
    var chestTitle1 = heroChest2?.Value("chestTitle").ToString();
    var chestDescription1 = heroChest2?.Value("chestDescription").ToString();
    var chestCards2 = heroChest2?.Children?.Where(c => c.ContentType.Alias.ToLower() == "card");
    var heroTitle1 = heroChest2.Children.Where(c => c is RichTextEditor).FirstOrDefault();
    var DealModel = new CustomModels.Benefits
    {
        Header = chestTitle1,
        Description = chestDescription1,
        BenefitCards = chestCards2.Select(c => c as Card).ToList()
    };

}

               var initilizePagenation = function(catgoryClass , productlistclass){
                  $('.pagination').empty();
                   $(".FirstTab").css("display", "none");
                   $(".SecondTab").css("display", "none");
                    $(".FirstTab.showpagewiselist").removeClass("showpagewiselist");
            $(".SecondTab.showpagewiselist").removeClass("showpagewiselist");
                 var itemsPerPage = 9; // Adjust the number of items per page as needed
                 var $products = $(catgoryClass + ' > .' + productlistclass);
                    var numPages = Math.ceil($products.length / itemsPerPage);
                if(numPages > 1) {
                    // Create pagination links
                    $('<li class="page-item"><a class="page-link" href="#" aria-label="Previous"><span aria-hidden="true">&laquo;</span><span class="sr-only">Previous</span></a></li>').appendTo('.pagination');
                    for (var i = 1; i <= numPages; i++) {
                     $('<li class="page-item"><a class="page-link" href="#">'+ i +'</a></li>').appendTo('.pagination');
                    }
        
                     $('<li class="page-item"><a class="page-link" href="#" aria-label="Next"><span aria-hidden="true">&raquo;</span><span class="sr-only">Next</span></a></li>').appendTo('.pagination');
        
                    showPage(1); // Show the first page by default
                } else {
                    $("."+productlistclass).css("display", "block");
                }
                    
                    // Handle pagination link click
                    $('.page-link').on('click', function (e) {
                        e.preventDefault();
                        var pageNum = $(this).text();
                        showPage(pageNum);
                    });
        
                    // Function to display products for a given page
                    function showPage(pageNum) {
                        $products.removeClass('showpagewiselist'); // Hide all products
                        var start = (pageNum - 1) * itemsPerPage;
                        var end = start + itemsPerPage;
                        $products.slice(start, end).addClass('showpagewiselist'); // Show products for the selected page
                    }
                  
                }
                
                
                  

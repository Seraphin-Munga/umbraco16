<style>
.mt-24 {
    margin-top:24px;
    
}
.mb-34 {
    margin-bottom:34px;
}

.parent-container{
  height: 89.6vh;
   /* overflow: hidden;*/
    display: flex;
    flex-direction: column;
    justify-content: space-between;
   
}

.step-subtitle{
    font-size: 10px !important;
}

.loader-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(255, 255, 255, 0.8);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.dot-loader {
  width: 40px;
  aspect-ratio: 4;
  background:
    radial-gradient(circle closest-side, red 90%, transparent) 0 50%,
    radial-gradient(circle closest-side, green 90%, transparent) 50% 50%,
    radial-gradient(circle closest-side, blue 90%, transparent) 100% 50%;
  background-size: calc(100%/3) 100%;
  background-repeat: no-repeat;
  clip-path: inset(0 100% 0 0);
  animation: dotAnim 1s steps(4) infinite;
}

@@keyframes dotAnim {
  to {
    clip-path: inset(0 -34% 0 0);
  }
}


    .cookie-notice {
        display: none;
    }
    .glyphicon-ok-sign{
       display:none !important; 
    }
    .glyphicon-remove-sign{
    display:none !important;    
    }
    .has-success .form-control {
    border-color: #DBDBDB !important;
    }
    .navPadding{
       padding-top :0px !important; 
    }

    .notification {
        color: red !important;
    }

    .accordion.error-border {
        border: 1px solid #D0021B;
    }

    

    .check-icon {
        display: none;
        color: green;
        font-size: 16px;
        float: right;
       margin-right:3px;
    }

    .arrow-icon {
        float: right;
        margin-right: 10px;
        font-size: 22px;
        color: #555;
    }
</style>


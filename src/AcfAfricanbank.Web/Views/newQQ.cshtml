$(document).ready(function() {
    const inputs = $('input');
        inputs.on('keydown', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    const currentIndex = inputs.index(this);
                    if (currentIndex < inputs.length - 1) {
                        const nextInput = inputs.eq(currentIndex + 1);
                        nextInput.focus();
                       
 
                        // Scroll into view if field is below visible area
                      //  $('html, body, .qqcontainer').animate({
                        //    scrollTop: nextInput.offset().top - $('.qqcontainer').offset().top + $('.qqcontainer').scrollTop() - 50
                        //}, 500);
                        // Scroll properly inside container (or window)
                const $container = $('.qqcontainer');
                const containerTop = $container.offset().top;
                const containerScroll = $container.scrollTop();
                const inputTop = nextInput.offset().top;

                // Calculate target scroll position relative to the container
                const scrollTo = inputTop - containerTop + containerScroll - 50;

                // Animate to bring the next field into view
                $container.animate({ scrollTop: scrollTo }, 400);
                    } else {
                        $('#step2').submit();
                    }
                }
            });
    // Assuming your steps have a class 'step' and active step has class 'active'
   function focusStep2Input() {
       const fullNameVal = $("#fullname").val().trim();

    // Check if the string length is 0 (empty)
    if (fullNameVal.length === 0) {
        $("#fullname").focus();
    }
   }

    // Call once in case step2 is already active on load
   focusStep2Input();

    // Listen for changes (if you toggle steps via click)
    $(".step").on("click", function() {
        // You may be toggling 'active' class manually
        // Use a small delay to ensure the class has been toggled
        setTimeout(focusStep2Input, 10);
    });
    $(".accordion").on("click", function() {
        // Find the related accordion content
        const targetId = $(this).attr("onclick")?.match(/'(.*?)'/)?.[1];
        if (!targetId) return;

        const $content = $("#" + targetId);

        // Wait a short moment in case of animation / display toggle
        setTimeout(function() {
            // Focus the first input, select, or textarea inside that accordion
            const $firstField = $content.find("input, select, textarea").first();
            if ($firstField.length) {
                $firstField.focus();
            }
        }, 100);
    });
});



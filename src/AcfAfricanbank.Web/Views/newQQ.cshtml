        this.idnumber = idnumber;
        this.mobile   = mobile;
    }

    function IncomeStamp(grosssalary, income, frequency, expenses) {
        this.grossSalary = grosssalary;
        this.netIncome   = income;
        this.frequency   = { value: frequency.value, label: frequency.label };
        this.expenses    = expenses;
    }

    function EmploymentStamp(bank, employmentSector, employer, employmentStatus, employmentStartDate, occupationType) {
        this.bank                = { value: bank.value,             label: bank.label };
        this.employmentSector    = { value: employmentSector.value, label: employmentSector.label };
        this.employer            = employer;
        this.employmentStatus    = { value: employmentStatus.value, label: employmentStatus.label };
        this.employmentStartDate = employmentStartDate;
        this.occupationType      = { value: occupationType.value,   label: occupationType.label };
    }

    window.personalStamp    = null;
    window.incomeStamp      = null;
    window.employmentStamp  = null;

    function tryStampPersonal() {
        var $title   = $('#title');
        var titleVal = $.trim($title.val());
        var fullname = $.trim($('#fullname').val());
        var surname  = $.trim($('#surname').val());
        var idnumber = $.trim($('#idnumber').val());
        var mobile   = $.trim($('#mobile').val());

        if (!titleVal || !fullname || !surname || !idnumber || !mobile) {
            window.personalStamp = null;
            return;
        }
        window.personalStamp = new PersonalStamp(
            { value: titleVal, label: $title.find('option:selected').text() },
            fullname, surname, idnumber, mobile
        );
        console.log('Personal stamp:', window.personalStamp);
    }

    function tryStampIncome() {
        var $frequency  = $('#frequencytype');
        var grosssalary = $.trim($('#grosssalary').val());
        var income      = $.trim($('#income').val());
        var freqVal     = $.trim($frequency.val());
        var expenses    = $.trim($('#expenses').val());

        if (!grosssalary || !income || !freqVal || !expenses) {
            window.incomeStamp = null;
            return;
        }
        window.incomeStamp = new IncomeStamp(
            grosssalary, income,
            { value: freqVal, label: $frequency.find('option:selected').text() },
            expenses
        );
        console.log('Income stamp:', window.incomeStamp);
    }

    function tryStampEmployment() {
        var $bank             = $('#yourbank');
        var $employeeType     = $('#employeeType');
        var $occupationstatus = $('#occupationstatus');
        var $occupationtype   = $('#occupationtype');

        var bankVal          = $.trim($bank.val());
        var employmentSector = $.trim($employeeType.val());
        var employer         = $.trim($('#youremployer').val());
        var employmentStatus = $.trim($occupationstatus.val());
        var startDate        = $.trim($('#datetimeInput').val());
        var occupationType   = $.trim($occupationtype.val());

        if (!bankVal || !employmentSector || !employer || !employmentStatus || !startDate || !occupationType) {
            window.employmentStamp = null;
            return;
        }
        window.employmentStamp = new EmploymentStamp(
            { value: bankVal,          label: $bank.find('option:selected').text() },
            { value: employmentSector, label: $employeeType.find('option:selected').text() },
            employer,
            { value: employmentStatus, label: $occupationstatus.find('option:selected').text() },
            startDate,
            { value: occupationType,   label: $occupationtype.find('option:selected').text() }
        );
        console.log('Employment stamp:', window.employmentStamp);
    }

    $(document).ready(function () {
         addFormValidation();

         // Accordion 1 – Personal details
         $('#title, #fullname, #surname, #idnumber, #mobile')

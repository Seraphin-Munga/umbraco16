@inherits Umbraco.Web.Mvc.UmbracoViewPage
@using AcfAfricanbank.Core.Models.CustomDataType
@using AcfAfricanbank.Core.Utilities
@using ContentModels = Umbraco.Web.PublishedModels
@using Web.Helpers
@{
    Layout = "Master.cshtml";
    var Children = Model.Children;

    // Get specific Children
    var heroHeader = Children?.Where(c => c.ContentType.Alias.ToLower() == "heroheader").FirstOrDefault();
    var heroShoulder = Children?.Where(c => c.ContentType.Alias.ToLower() == "heroshoulder").FirstOrDefault();
    var heroBody = Children?.Where(c => c.ContentType.Alias.ToLower() == "herobodyourcompany").FirstOrDefault();

    var anchorButtonText = heroShoulder?.Value("anchorButton")?.ToString();

    var textblock = heroBody.Value("textBlock");
    var carousel = heroBody.Value("carousel");

    var employeesA = heroBody.Value("employeesA");
    var employeesB = heroBody.Value("employeesB");

    var textblockB = heroBody.Value("textBlockB");
    var theBoardDesc = heroBody.Value<IPublishedElement>("bottomContent");

    var sectionSettings = Children?.Where(c => c.ContentType.Alias.ToLower() == "pagepopup").FirstOrDefault();

    ContainerViewModel containerViewModel = new ContainerViewModel();

    var description = theBoardDesc.Value("title");

    foreach (var prop in heroBody.Properties)
    {

        //<span>@prop.Value</span>
    }
}

<style type="text/css">
 .thumbnail .caption p.title {

    

    font-weight: 600;

    font-size: 16px;

    

}

#TheExecutives .thumbnail, #TheBoard .thumbnail {

    margin-bottom: 0px;

}



#TheExecutives .thumbnail .caption, #TheBoard .thumbnail .caption {

    background-color: #f7f7f7;

    height: 95px;

}

.margin-top-50 {

    margin-top: 20px;

}
.modal .modal-dialog .modal-content .modal-header .close {
    font-size: 40px;
    color: #4a4a4a !important;
    margin-top: 17px !important;
    opacity: 1;
    line-height: 0;
    font-weight: lighter;
}
    .our-mission p {
        width: 100% !important;
    }

    .padded-grey {
        padding: 20px 0px 50px !important;
    }

    @@media (max-width: 767px) {
        .carousel-inner {
            bottom: 20px;
        }
    }
</style>
<!-- HERO HEADER -->
@Html.Partial("_pageHeaderImage", heroHeader as ContentModels.HeroHeader)

<!-- HERO SHOULDER-->
@Html.Partial("_pageShoulder", heroShoulder as ContentModels.HeroShoulder)


<!-- PRODUCT INFORMATION-->
<div class="container margin-bottom-minus-60">
    <div class="campaign-product-container full">
        <div class="margin-top-20 visible-xs"></div>
        @Html.Raw(textblock)
    </div>
</div>


@if (carousel != null)
{
    var _carousel = (NCtextstringRtes)carousel;
    var isFirstItem = true;
    <!-- AFRICAN BANK STORIES -->
    <div id="OurValues" class="bank-story-container no-margin">
        <div class="bank-story-intro">
            <p class="title">@_carousel.Title</p>
        </div>
        <div class="pull-up">
            <div class="bank-story-carousel">
                <div id="bank-story" class="carousel slide" data-ride="carousel" data-interval="false">

                    <!-- Wrapper for slides -->
                    <div class="carousel-inner">
                        @foreach (var item in _carousel.Items)
                        {
                            <div class="item @(isFirstItem ? "active" : "")">
                                <div class="bank-story-img"></div>
                                <div class="bank-story-caption">
                                    @Html.Raw(item.Value<string>("content"))
                                </div>
                            </div>
                            isFirstItem = false;
                        }
                    </div>
                    <!-- Controls -->

                    <a class="left carousel-control" href="#bank-story" role="button" data-slide="prev">
                        <span class="icon-arrow-left"></span>
                    </a>
                    <a class="right carousel-control" href="#bank-story" role="button" data-slide="next">
                        <span class="icon-arrow-right"></span>
                    </a>
                </div>
            </div>
        </div>
    </div>
}

<div id="OurMission" class="container our-mission">
    <div class="text-center padded-white">
        <div class="margin-top-40 hidden-xs"></div>
        @Html.Raw(textblockB)
    </div>
</div>


@if (employeesB != null)
{

    var employeeList = (NCpeople)employeesB;
    var itemGroups = employeeList.Items.GroupBy(4);
    var isFirstRow = true;

    <div id="TheBoard" class="padded-grey">
        <div class="container">
            <h3 class="text-center margin-top-20">@employeeList.Title</h3>
            <p class="text-center descrition-board">@description</p>
            @foreach (var itemGroup in itemGroups)
            {

                <div class="row margin-top-50 eq-height">
                    @foreach (var item in itemGroup)
                        {

                            var b_title = "";
                            var b_desc = "";
                            var b_img = "";
                            var b_name = "";
                            var b_age = "";
                            var b_certification = "";

                            if (sectionSettings.Children.Where(x => x.Name == item.Value("title").ToString()).FirstOrDefault() != null)
                            {
                          

                                var board_member = sectionSettings.Children.Where(x => x.Name.ToLower() == item.Value("title").ToString().ToLower()).FirstOrDefault();
                              
                                var info = board_member as Card;
                                b_title = info.Value("cardTitle").ToString();
                            
                                b_desc = info.Value("cardDescription").ToString();
                                if (info.Value<IPublishedContent>("cardIcon") != null)
                                {
                                    b_img = info.Value<IPublishedContent>("cardIcon").Url;
                                    
                                }
                                else
                                {
                                    b_img = "/images/male-placeholder.jpg";
                                }

                                
                                var temp_b_name = info.Children.Where(x => x.Name == "Name").FirstOrDefault() as EbankItitem1;
                                
                                var temp_b_age = info.Children.Where(x => x.Name == "Age").FirstOrDefault() as EbankItitem1;
                                var temp_b_certification = info.Children.Where(x => x.Name == "Certification").FirstOrDefault() as EbankItitem1;

                                b_name = temp_b_name.Value("ebankITContent").ToString();

                                b_age = temp_b_age.Value("ebankITContent").ToString();
                                b_certification = temp_b_certification.Value("ebankITContent").ToString();
                            

                            }

                        <div class="col-sm-6 col-md-3">
                             <div class="thumbnail shadow name- @item.Value("title")" onclick='executive_info("@b_title",@Html.Raw(Json.Encode(b_desc)), "@b_img","@b_name","@b_age","@b_certification");'>
                                @if (item.Url != null)
                                {
                                    <img src="@item.Url" alt="@item.Value("title")">
                                }
                                else
                                {
                                    <img src="/images/male-placeholder.jpg" alt="">
                                }
                                <div class="caption">
                                    <p class="title">@item.Value("title")</p>
                                    <p>@item.Value("imageSummary")</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                isFirstRow = false;
            }
        </div>
    </div>
}
@if (employeesA != null)
{
    var employeeList = (NCpeople)employeesA;
    var itemGroups = employeeList.Items.GroupBy(4);
    var isFirstRow = true;

    <div id="TheExecutives" class="padded-white">
        <div class="container">
            <div class="padded-white">
                <h3 class="text-center margin-top-20">@employeeList.Title</h3>
                @foreach (var itemGroup in itemGroups)
                {
                    <div class="row margin-top-50 eq-height">
                        @foreach (var item in itemGroup)
                        {

                            <div class="col-sm-3 col-md-3">
                                <div class="thumbnail">
                                    @if (item.Url != null)
                                    {
                                        <img src="@item.Url" alt="@item.Value("title")">
                                    }
                                    else
                                    {
                                        <img src="/images/male-placeholder.jpg" alt="">
                                    }
                                    <div class="caption">
                                        <p class="title">@item.Value("title")</p>
                                        <p>@item.Value("imageSummary")</p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    isFirstRow = false;
                }
            </div>
        </div>
    </div>
}


<!-- HERO FEET -->
@{
    var heroFeet = (HeroFeetAboutUs)Model.Children.Where(o => o is HeroFeetAboutUs).FirstOrDefault();
    if (heroFeet != null)
    {
        var isFirstRow = true;
        <div class="grey-bg">
            <div class="container">
                <div class="padded-grey">
                    <h3 class="text-center margin-top-50">@heroFeet.Title</h3>
                    @if (heroFeet.Items.Any())
                    {
                        var itemGroups = heroFeet.Items.GroupBy(2);
                        foreach (var items in itemGroups)
                        {
                            <div class="row margin-top-@(isFirstRow ? "50" : "30")">
                                @foreach (var item in items)
                                {
                                    <div class="col-sm-6 about-us-bottom-text__item">
                                        <p>
                                            @Html.Raw(item.Value("content"))
                                        </p>
                                    </div>
                                    isFirstRow = false;
                                }

                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    }
}

@Html.Partial("_renderPopUpContent", new ContainerViewModel()
{
    HTMLContent = @<text>

        @*<div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <span>This is the content from the span control</span>
            </div>*@


        <div class="modal-header">
            @*<button type="button" class="close" data-dismiss="modal">&times;</button>*@
            <h4 class="modal-title" id="profile_title"> </h4>
        </div>
        <div class="modal-body exe_profile">
            <div class="row">
                <div class="col-md-6">
                    <img src="" id="profile_img" alt="profile image">
                </div>
                <div class="col-md-6">
                    <div class="row">
                        <div class="col-md-12">
                            <h4 class="profile_lable ">Name</h4>
                            <span class="profile_text" id="profile_name"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <h4 class="profile_lable">Age</h4>
                            <span class="profile_text" id="profile_age"></span>
                        </div>

                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <h4 class="profile_lable">Certification</h4>
                            <p class="profile_text" id="profile_certification"></p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="profile_details">
                    <div id="gen_croller">
                        <p id="profile_about"></p>
                    </div>
                </div>
            </div>
        </div>
    </text>
})
@section scripts{

    <script>
        $(".btn_ok_modal").click(function () {
            $('#generic').modal('hide');
        });
    </script>

}





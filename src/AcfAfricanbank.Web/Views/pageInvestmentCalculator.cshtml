<script type="text/javascript">
    function scrollToCalculator() {
        $('html, body').animate({
            scrollTop: $(".tab-content").closest("div").find(".scrollTo:visible").offset().top - 100
        }, 1500);
    }

    function compareFixedDeposit() {
        var amount = $('#fixedResults').children('.row').children('.col-sm-12').children('.card-shadow').children('.percentage').html();
        var month = $('#fixedResults').children('.row').children('.col-sm-12').children('.card-shadow').children('.offer-style').html();
        var content = '<div class="resultTitle">Fixed Deposit</div><div id="results"><div class="card-shadow rate-card-fixed-deposit-offer" style="background:none !important"><div class="percentage">' + amount + '</div><div class="text-uppercase offer-style" style="color:#002b60;">' + month + '<br/><br/><button onclick="scrollToCalculator()" class="button primary ghostBtn btnReCalc hidden-xs">Re-Calculate</button></div></div></div>';
        $('#linkContent-ProductFixedDeposit').html(content);
        $('#fixedResultsMobile').css('height', '280px');
    }

    function compareNoticeDeposit() {
        var amount = $('#noticeResults').children('.row').children('.col-sm-12').children('.card-shadow').children('.percentage').html();

<script type="text/javascript">

    function switchAndScroll() {

        var selected = $('#selectCompare').val();
        if (selected == 'FixedDeposit') {
            $('.nav-tabs a[href="#ProductFixedDeposit"]').tab('show');
        }
        if (selected == 'NoticeDeposit') {
            $('.nav-tabs a[href="#ProductNoticeDeposit"]').tab('show');
        }
        if (selected == 'AccessAccumulator') {
            $('.nav-tabs a[href="#ProductAccessAccumulator"]').tab('show');
        }
        if (selected == 'TaxFreeInvestment') {
            $('.nav-tabs a[href="#ProductTaxFreeInvestment"]').tab('show');
        }

        scrollToCalculator();
    }

</script>


<link href="~/css/quick_loans.css" rel="stylesheet" />

@{
    Layout = "MasterHeaderOnly.cshtml";

    var Children = Model.Children;

    // Get specific Children
    var HeroHeader = Children?.Where(c => c is HeroHeader).FirstOrDefault();
    var dropOff = Children?.Where(c => c is PagePopup).FirstOrDefault();
    var heroBody = Children?.Where(c => c is HeroBody).FirstOrDefault();
    var login = heroBody.Children.Where(c => c.Name == "Login").FirstOrDefault() as Link;
    var register = heroBody.Children.Where(c => c.Name == "Register").FirstOrDefault() as Link;

    var consolidationLoan = heroBody.Children.Where(c => c.Name == "Consolidation Loan").FirstOrDefault() as Link;
    var fifteenPercentLoan = heroBody.Children.Where(c => c.Name == "15% Loan").FirstOrDefault() as Link;


    var quickTitle = heroBody.Value("bodyTitle");
    var quickBody = heroBody.Value("richTextBox");
    
    var termsAndConditions = heroBody.Value("bodyFooterTitle");

    var salaryFrequencyDropdownId = 5389;
    var bankDropdownId = 5390;
    var bankStatementsDropdownId = 5391;
    var employmentSectorDropdownId = 5382;
    var childMaintenanceDropdownId = 5395;

    var terminateProcess = dropOff.Children.Where(c => c.Name == "Terminate process").FirstOrDefault() as DocumentTypeTitleAndDescription;

    var heroHeaderImage = HeroHeader?.Value<IPublishedContent>("image")?.Url;

    var campaignCode = Request.Params["campaignCode"];

    var utm_source = Request.Params["utm_source"];
    var utm_medium = Request.Params["utm_medium"];
    var utm_campaign = Request.Params["utm_campaign"];

    // Get the utm tagging
    string strPageUrl = Request.RawUrl;
    var shoulderButtonLink = "";
    if (strPageUrl.Contains("?"))
    {
        var strendUrl = strPageUrl.Split('?').Last();
        shoulderButtonLink = String.Format("{1}{2}", shoulderButtonLink, "?", strendUrl);
    }
}

@inherits Umbraco.Web.Mvc.UmbracoViewPage
@{
	Layout = "Master.cshtml";
}

<div class="container text-center">
    <div class="page404">
        <h1>Page not found</h1>
        <p>We can't seem to find the page you're looking for. Sorry about that.</p>
        <div class="page404__box">
            <div class="box-image">
                <img src="/images/404.png" alt="page-not-found-image"/>
            </div>
        </div>
        <div class="bottom-message">
            <a href="/" class="btn-rounded-green">
                <div>Click here</div>
            </a> to go straight to the Home Page or you may also call us at <a href="tel:0861111011">0861 111 011</a> for assistance
        </div>
    </div>
</div>
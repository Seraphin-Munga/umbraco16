<script>


    $(document).ready(function () {
    let currentStep = 1;

    function updateStepper() {
        // Hide all step contents
        $('.step-content').hide();
        // Show current step content
        $('.step-' + currentStep).show();

        // Update step circle state
        $('.step').removeClass('active');
        $('.step[data-step="' + currentStep + '"]').addClass('active');

        // Update button states
        $('.prev').prop('disabled', currentStep === 1);
        $('.next').text(currentStep === 3 ? 'Submit' : 'Submit');
    }
    
    function goToNextStep() {
      if (currentStep < 4) {
        $('.step[data-step="' + currentStep + '"]').removeClass('active').addClass('completed');
        currentStep++;
        updateStepper();
      }
    }

    
      function goToPreviousStep() {
      if (currentStep > 1) {
        $('.step[data-step="' + currentStep + '"]').removeClass('active');
        currentStep--;
        $('.step[data-step="' + currentStep + '"]').removeClass('completed').addClass('active');
        updateStepper();
      }
    }



    $('.next').click(function () {
        if (currentStep < 4) {
            $('.step[data-step="' + currentStep + '"]').removeClass('active').addClass('completed');
            currentStep++;
            updateStepper();
        }
    });

    $('.prev').click(function () {
        if (currentStep > 1) {
            $('.step[data-step="' + currentStep + '"]').removeClass('active');
            currentStep--;
            $('.step[data-step="' + currentStep + '"]').removeClass('completed').addClass('active');
            updateStepper();
        }
    });

    updateStepper(); // Initial call
});
    

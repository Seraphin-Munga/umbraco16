          }, 150000);
        } else if (fileSize > maxSize) {

          message11="File size must be less than 5MB."
          $('.alert-box.error .alert-message').text(message11);
          $('.alert-box.error').fadeIn();
        
          setTimeout(() => {
            $('.alert-box.error').fadeOut();
          }, 150000);
          $(this).val(''); // Reset the input
        }
      }
    });
  });
  

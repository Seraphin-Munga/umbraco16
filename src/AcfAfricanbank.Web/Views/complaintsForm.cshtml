.step-circle {
  position: relative;
  width: 100px;
  height: 100px;
  border-radius: 50%;
  border: 8px solid #eee; /* light gray border as background */
  font-weight: bold;
  font-size: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0px;
  box-sizing: border-box;
  overflow: visible;
}

/* This pseudo-element will act as the colored progress border */
.step-circle::before {
  content: '';
  position: absolute;
  top: -8px;  /* equal to border width */
  left: -8px;
  width: calc(100% + 16px);
  height: calc(100% + 16px);
  border-radius: 50%;
  border: 8px solid green;
  clip-path: polygon(50% 50%, 100% 0, 100% 100%, 0 100%, 0 0); /* initial clip to hide all */
  transform: rotate(-90deg);
  transform-origin: center;
  transition: clip-path 0.3s ease;
  pointer-events: none;
  box-sizing: border-box;
}


.progress-ring__circle {
  transition: stroke-dashoffset 0.35s;
  transform: rotate(-90deg);
  transform-origin: 50% 50%;
  stroke-linecap: round;
}


    .step.active .step-circle {
        border-color: transparent;
        background: conic-gradient(#5DC400 0% 33.3%, #eee 33.3% 100%);
        color: #002B60;
    }

    .step.completed .step-circle {
        background: #5cb85c;
        color: white;
        border: none;
    }

    .step-circle::after {
        content: attr(data-step-label);
        position: relative;
        top: 17%;
        left: 22%;
        transform: translate(-50%, -50%);
        font-weight: bold;
    }

    .step-title {
        display: flex;
        flex-direction: column;
        font-size: 16px;
        line-height: 1.4;
        text-align: left;
    }

    .step-title .next {
        font-size: 14px;
        color: #8A99A3;
    }
    .text-right-xs {
        text-align: right !important;
    }
}


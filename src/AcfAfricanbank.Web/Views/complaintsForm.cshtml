$(document).ready(function () {
    let currentStep = 1;
    const totalSteps = 4;

    function updateStepper() {
        // Step circles and content
        $('.step').each(function () {
            const stepNum = parseInt($(this).attr('data-step'));
            const $circle = $(this).find('.step-circle');

            if (stepNum < currentStep) {
                $(this).addClass('completed').removeClass('active');
                $circle.text('✓');
            } else if (stepNum === currentStep) {
                $(this).addClass('active').removeClass('completed');
                $circle.text(stepNum);
            } else {
                $(this).removeClass('active completed');
                $circle.text(stepNum);
            }
        });

        // Show current step content, hide others
        $('.step-content').hide();
        $('.step-' + currentStep).show();

        // Button states
        $('.prev').prop('disabled', currentStep === 1);
        $('.next').text(currentStep === totalSteps - 1 ? 'Submit' : 'Next');
    }

    $('.next').click(function () {
        if (currentStep < totalSteps) {
            currentStep++;
            updateStepper();
        } else {
            // Finish logic here
            alert('Form completed!');
        }
    });

    $('.prev').click(function () {
        if (currentStep > 1) {
            currentStep--;
            updateStepper();
        }
    });

    updateStepper(); // Initial render
});



$(document).ready(function () {
  function validateForm() {
    const email = $('#email').val().trim();
    const number = $('#number').val().trim();
    let isValid = email !== '' || number !== '';

    if (!isValid) {
      const message14 = "Please enter at least Email address or Contact number.";
      $('.alert-box.error .alert-message').text(message14);
      $('.alert-box.error').fadeIn();

      setTimeout(() => {
        $('.alert-box.error').fadeOut();
      }, 5000); // 5 seconds is enough; 150000ms was likely a typo
    }

    $('#btn-step1').prop('disabled', !isValid);
  }

  $('#email, #number').on('input change', function () {
    validateForm();
  });

  validateForm(); // run on load
});





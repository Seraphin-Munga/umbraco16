$(document).ready(function () {
  const sectionMap = {
    squareCheck1: '#Product-or-Service',
    squareCheck2: '#Service-advice',
    squareCheck3: '#Customer-service',
    squareCheck4: '#Accessing-a-product-or-service'
  };

  // Hide all sections initially
  Object.values(sectionMap).forEach(selector => {
    $(selector).hide();
  });

  // Get selected checkbox values
  function logSelectedValues() {
    const selected = {};
    Object.values(sectionMap).forEach(selector => {
      const values = $(`${selector} input[type="checkbox"]:checked`).map(function () {
        const inputId = $(this).attr('id');
        const labelText = $(`label[for="${inputId}"] .checkbox-label`).text().trim();
        return labelText;
      }).get();

      if (values.length > 0) {
        selected[selector.replace('#', '')] = values;
      }
    });
    return selected;
  }

  // Check if at least one section has values
  function hasAtLeastOneKeyWithValue(obj) {
    if (!obj || typeof obj !== 'object') return false;
    return Object.values(obj).some(value => Array.isArray(value) && value.length > 0);
  }

  // Check if text input has 10 or more characters
  function hasMinimumTextLength() {
    const length = $('#myTextBox').val().trim().length;
    return length >= 10;
  }

  // Enable or disable the Next button
  function updateNextButtonState() {
  
    const hasSelection = hasAtLeastOneKeyWithValue(logSelectedValues());
    const hasEnoughText = hasMinimumTextLength();

    const enable = hasSelection && hasEnoughText;

    $('#btn-step2').prop('disabled', !enable);
  }

  // Live text length tracking
  $('#myTextBox').on('input', function () {
    const text = $(this).val().trim();
    const length = text.length;
    $('#charCount').text(length + ' / 300');

    if (length < 10) {
      const remaining = 10 - length;
      $('#error-message')
        .text('Please enter at least 10 characters. ' + remaining + ' more to go.')
        .show();
    } else {
      $('#error-message').hide();
    }

    updateNextButtonState();
  });

  // Watch checkbox and declare
  $('#declare, input[type="checkbox"]').on('change', function () {
    updateNextButtonState();
  });

  // Initial state
  updateNextButtonState();
});

$(document).ready(function () {
  $('#declare').on('change', function () {
    $('#submit').prop('disabled', !this.checked);
  });

  // Initialize button state on page load
  $('#submit').prop('disabled', !$('#declare').is(':checked'));
});



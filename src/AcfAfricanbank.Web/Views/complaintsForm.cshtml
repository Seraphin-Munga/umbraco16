function getAttachmentFileName() {
  const file = $('#fileInput')[0].files[0];
  return file ? file.name : "";
}

function getAttachmentBase64(callback) {
  const file = $('#fileInput')[0].files[0];
  
  if (!file) {
    callback(" ");
    return;
  }

  const reader = new FileReader();
  reader.onload = function (e) {
    const base64String = e.target.result.split(',')[1]; // Remove data:*/*;base64,
    callback(base64String);
  };
  reader.readAsDataURL(file);
}




 const selected = {};
 
 let base64Attachment = "";

function readAttachmentBase64() {
  const file = $('#fileInput')[0].files[0];

  if (!file) {
    base64Attachment = "";
    return;
  }

  const reader = new FileReader();
  reader.onload = function (e) {
    base64Attachment = e.target.result.split(',')[1];
  };
  reader.readAsDataURL(file);
}



$(document).ready(function () {
  const sectionMap = {
    squareCheck1: '#Product-or-Service',
    squareCheck2: '#Service-advice',
    squareCheck3: '#Customer-service',
    squareCheck4: '#Accessing-a-product-or-service'
  };

  // Hide all sections initially
  Object.values(sectionMap).forEach(selector => {
    $(selector).hide();
  });

  // Function to collect all selected checkbox values in an object
  
  function logSelectedValues() {
  

  Object.values(sectionMap).forEach(selector => {
    const values = $(`${selector} input[type="checkbox"]:checked`).map(function () {
      const inputId = $(this).attr('id');
      const labelText = $(`label[for="${inputId}"] .checkbox-label`).text().trim();
      return labelText;
    }).get();

    if (values.length > 0) {
      selected[selector.replace('#', '')] = values;
    }
  });

  console.log(selected);
  return selected; 
}


  // Handle top-level checkbox toggle
  $.each(sectionMap, function (checkboxId, sectionSelector) {
    $('#' + checkboxId).on('change', function () {
      if ($(this).is(':checked')) {
        $(sectionSelector).slideDown();
      } else {
        $(sectionSelector).slideUp();
        $(sectionSelector).find('input[type="checkbox"]').prop('checked', false);
      }
      logSelectedValues();
    });

    // Handle inner checkbox change as well
    $(sectionSelector).find('input[type="checkbox"]').on('change', logSelectedValues);
  });
}); 

function routerToSuccess(){
    
        $('#successful, #bg-white-2').css('display', 'block');
        $('#main-section').css('display', 'none');
    
}

function startLoader() {
  $('#loader-overlay').addClass('active');
  $('#submit').prop('disabled', true);
}

function stopLoader() {
  $('#loader-overlay').removeClass('active');
  $('#submit').prop('disabled', false);
}

function hasFileSelected() {
  const fileInput = document.getElementById('fileInput');
  return fileInput.files.length > 0 ? true : false;
}


function submitFormData() {
  return new Promise((resolve, reject) => { // Add reject parameter
  
   startLoader();
  
  
    let data = {
      fullName: $('#name').val() + " " + $('#surname').val(),
      email: $('#email').val(),
      clientAccountNumber: $('#Clientnumber').val(),
      complaintDescription: $('#myTextBox').val(),
      complaintType: " ",
      disclaimer: "Yes",
      productService: JSON.stringify(selected['Product-or-Service']) || '',
      productServiceAdvice: JSON.stringify(selected['Service-advice']) || '',
      productServiceAccess: JSON.stringify(selected['Accessing-a-product-or-service']) || '',
      customerService: JSON.stringify(selected['Customer-service']) || '',
      contactNumber: $('#number').val(),
      identityType: " ",
      identityNumber: " ",
      complaintAttachment: base64Attachment,
      hasAttachment: hasFileSelected(),
      complaintAttachmentFileName: getAttachmentFileName()
    };
    
    
    console.log("payload:" , data)

    startLoader();
   
    

    $.ajax({
      url: 'https://prod-49.westeurope.logic.azure.com:443/workflows/ef87a171855f4bddaebbd8708d43e51b/triggers/manual/paths/invoke?api-version=2016-06-01&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=Ue4vqqv6Ra_XOGFJSvmCir5ccu0w-UmOl9ZcQ_ynrUk',
      type: 'POST',
      data: JSON.stringify(data),
      contentType: 'application/json',
      processData: false,
    //   async: false, // Temporary for debugging
      success: function (response) {
        stopLoader();
        console.log("Success:", response.ReferenceNumber);
        document.getElementById('idComplaintDescription1').textContent = response.ReferenceNumber;
        $('html, body').animate({ scrollTop: 0 }, 'slow'); // 👈 Scroll to top1
        routerToSuccess();

          setTimeout(() => {
            $('.alert-box.success').fadeOut();
          }, 150000);
        
        resolve(true); // Pass full response
      },
      error: function (response) {
        stopLoader();
        
        console.error("Error:", response.message);
        
        $('#successful, #bg-white-2').css('display', 'none');
        $('#main-section').css('display', 'block');
        
        
         let message = 'Oops! Something went wrong. Please try again later.';

          if (error.responseJSON && error.responseJSON.message) {
            message = error.responseJSON.message;
          }
        
          $('.alert-box.error .alert-message').text(message);
          $('.alert-box.error').fadeIn();
        
          setTimeout(() => {
            $('.alert-box.error').fadeOut();
          }, 150000);
        
        resolve(false); 
        
      }
    });
  });
}


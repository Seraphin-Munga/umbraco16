/* Hide the native checkbox */
.checkbox-declaration input[type="checkbox"] {
  top:-4px;
  appearance: none;
  -webkit-appearance: none;
  width: 20px;
  height: 20px;
  border: 2px solid #5DC400;
  border-radius: 4px;
  cursor: pointer;
  position: relative;
  vertical-align: middle;
  margin-right: 8px;
  background-color: white;
  transition: background-color 0.3s ease;
}

/* When checked, change background color */
.checkbox-declaration input[type="checkbox"]:checked {
  background-color: #5DC400; /* green */
  border-color: #5DC400;
}

/* Optional: add a checkmark */
.checkbox-declaration input[type="checkbox"]:checked::after {
  content: "";
  position: absolute;
  top: 4px;
  left: 7px;
  width: 5px;
  height: 10px;
  border: solid white;
  border-width: 0 2px 2px 0;
  transform: rotate(45deg);
}

 .alert-content {

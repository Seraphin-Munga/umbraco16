@inherits Umbraco.Web.Mvc.UmbracoViewPage<ContentModels.PageCampaign>
@using AcfAfricanbank.Core.Models.Forms;
@using ContentModels = Umbraco.Web.PublishedModels;

@{
    Layout = "Master.cshtml";
    // All Current Page Children
    var children = Model.Children;
    // Get specific Children
    var chest = children?.Where(c => c.ContentType.Alias.ToLower() == "herochest").FirstOrDefault();
    var heroBody = (HeroBody)children?.Where(c => c.ContentType.Alias.ToLower() == "herobody").FirstOrDefault();
    var heroBodyTabGroup = heroBody.Children?.Where(c => c.ContentType.Alias.ToLower() == "tabgroup").FirstOrDefault();
    var videoLanding = heroBodyTabGroup.Children?.Where(c => c.ContentType.Alias.ToLower() == "tabheader").FirstOrDefault();
    var videoItem = videoLanding.Children.Where(c => c.ContentType.Alias.ToLower() == "tabbody").FirstOrDefault();

    var video_card = heroBody.Children?.Where(c => c.Name == "Video card").FirstOrDefault();
    var styleAtt = "";
    if (video_card != null)
    {
        styleAtt = video_card.Children.Where(c => c.Name == "Style").FirstOrDefault().Value("text").ToString();
    }

    TabBody tabWaysToBank = null;
    TabBody myWorldPDFData = null;

    var tabBodyItems = heroBody.Children.OfType<TabBody>();
    tabBodyItems.ToList().ForEach(xx =>
    {
        if (xx.Value("partialViewName").ToString() == "partialHeroChest")
        {
            tabWaysToBank = (TabBody)xx;
        }
        else if (xx.Value("partialViewName").ToString() == "_renderPDFData")
        {
            myWorldPDFData = (TabBody)xx;
        }
    });

    @*foreach (var tab in heroBody.Children)
        {
            if (tab.ContentType.Alias.ToLower() == "tabbody")
            {
                if (tab.Value("partialViewName").ToString() == "partialHeroChest")
                {
                    tabWaysToBank = (TabBody)tab;
                }
                else if (tab.Value("partialViewName").ToString() == "_renderPDFData")
                {
                    myWorldPDFData = (TabBody)tab;
                }
            }
        }*@

    var sectionCardsContent = (IEnumerable<IPublishedElement>)tabWaysToBank.TabBodyContent.Where(c => c.ContentType.Alias == "nCTabGenericContent").FirstOrDefault().Value("sectionContent");
    var myWorldPDFs = (IEnumerable<IPublishedElement>)myWorldPDFData.TabBodyContent.Where(c => c.ContentType.Alias == "nCTabGenericContent").FirstOrDefault().Value("sectionContent");

    var lastBlurb = videoLanding.Value("ebankITIconContent");

    var disclaimer = heroBody.Children(xx => xx.ContentType.Alias.ToLower() == "richtexteditor").Last();

    IPublishedContent CurrentPage = UmbracoContext.PublishedRequest.PublishedContent;
    var viewName = CurrentPage.Name.Replace(" ", ""); //used mainly to identify the page
    TabGroup tabGroup = null;
     
    var heroHeader = children?.Where(c => c.ContentType.Alias.ToLower() == "heroheader").FirstOrDefault();
    
    if (viewName == "growforit1")
    {
         heroHeader = children?.Where(c => c.ContentType.Alias.ToLower() == "heroheader").FirstOrDefault();
         tabGroup = (TabGroup)heroHeader.Children?.Where(c => c.Name == "Partial").FirstOrDefault() as ContentModels.TabGroup;
    }

    bool isGrowForIt1 = false;

    
    var headerImage_large = videoLanding.Value<IPublishedContent>("ebankITIcon").Url;
    var headerImage_medium = heroHeader?.Value<IPublishedContent>("imageSmall")?.Url;
    var headerImage_small = heroHeader?.Value<IPublishedContent>("imageSmall")?.Url;

}

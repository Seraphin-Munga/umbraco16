    <div class="container row">
        <hr />
        <h4 class="align-center">@tabWaysToBank.Value("partialViewClassName")</h4>
        @{
            int cardIterator = 0;
            bool increaseCardHeight = false;

            foreach (var item in sectionCardsContent)
            {
                var cardTitle = item.Value<string>("NCcardTitle");
                var cardDesc = item.Value<string>("NCcardDescription");
                var icon = item.Value<IPublishedContent>("NCcardIcon");
                <div class="col-sm-4 col-md-4">
                    <div class="loan-summary">
                        <div class="image">
                            <a href="@cardDesc">
                                <div class="img-bg" style="background-image: url('@icon.Url')"></div>
                            </a>
                        </div>
                        <div class="title">
                            <a href="@cardDesc">
                                @cardTitle
                            </a>
                        </div>
                    </div>
                </div>
            }

            @*foreach (var item in sectionCardsContent)
                {
                    if (cardIterator == (int)sectionCardsContent.Count() - 1)
                    {
                        increaseCardHeight = true;
                    }
                    var cardTitle = item.GetPropertyValue<string>("cardTitle");
                    var cardDesc = item.GetPropertyValue<string>("cardDescription");
                    var icon = item.GetPropertyValue<IPublishedContent>("cardIcon");


                    <div class="col-sm-4 margin-bottom-20">
                        <div class="@(increaseCardHeight ? "cellphone-button-banking-campaign" : "")">
                            <div class="text-left center-align white-link-color richtextbox-blue-bg">
                                <img src="@icon.Url" alt="@icon.GetPropertyValue("altTag")" class="circular-images" />
                                <p class="title blue-color font-size-20">@cardTitle</p>
                                <p>@cardDesc</p>
                            </div>
                        </div>
                        @{
                            if (!cardTitle.Contains("App"))
                            {
                                <div class="col-md-4 center-align margin-bottom-20 margin-right-50 banking-options-buttons">
                                    <a class="button span-buttons green-button learn-more-banking " href="~/en/home/online-banking/" target="_blank">Learn More</a>
                                </div>
                            }
                            else
                            {
                                <div class="col-md-4 center-align margin-bottom-20 margin-left-50 banking-options-buttons">
                                    <a class="button span-buttons green-button learn-more-banking " href="~/en/home/online-banking/" target="_blank">Learn More</a>
                                </div>
                            }
                        }
                    </div>
                    cardIterator += 1;
                }*@
        }
    </div>
</div>
<div class="number-to-call">
    @{
        int pipeIterator = 0;
        foreach (var item in myWorldPDFs)
        {
            if (!item.Value("nCcategoryName").ToString().Contains("Pricing Guide"))
            {   
                var linkString = ((ContentModels.File)item.Value("nCebankITDocument")).Url;
                <a rel="noopener noreferrer" href="@linkString" target="_blank" class="tAndC">
                    @item.Value("nCebankITTitle").ToString()
                </a>
            }
        }
    }
    <div class="container">
        <div class="row">
            <div class="col-md-12 col-xs-12">
                @Html.Raw(disclaimer.Value("textEditor"))
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script src="~/scripts/jquery-ui.js"></script>
    <script src="~/javascripts/reuse/form_validation.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/1000hz-bootstrap-validator/0.11.5/validator.min.js"></script>
    <script type="text/javascript">

            /* Grow for it */

            $(document).ready(function () {

                var imageBgCss = "url('" + "@headerImage_large" + "')";
                var imageMdCss = "url('" + "@headerImage_medium" + "')";
                var imageSmCss = "url('" + "@(string.IsNullOrEmpty(headerImage_small) ? headerImage_medium : headerImage_small)" + "')";
                var CheckScreenSize;
                (CheckScreenSize = function () {
                    var _width = $(window).outerWidth();
                    var _height = $(window).outerHeight();
                    if (_width <= 511) {
                        $("#video-header-thumb").css("background-image", imageSmCss);
                    }
                    else {
                        $("#video-header-thumb").css("background-image", imageBgCss);
                    }
                })();
                $(window).resize(CheckScreenSize);

                MediaHashVideo();

                $(".vid_list_item").click(function (e) {
                    moveHtmlView(50, e);
                });

                $(".vid_list_item_campaign").click(function (e) {
                    moveHtmlView(1250, e);
                });

                $('.money').autoNumeric('init', { aSep: ' ', aDec: '.', aSign: 'R' });

                function moveHtmlView(position, control) {
                    var selected_video = control.currentTarget.dataset.video.split("*");

                    //checking if there is any video
                    if (selected_video[0] !== null && selected_video[0] !== undefined && selected_video[0] != "")
                    {
                        //-->show video loader
                        $("#video-loader").show();
                        $("#video-header-thumb").addClass("video-thumb-none");
                        $("#video-ytd").removeClass("video-ytd-show");
                        $(".video-content").hide();

                        //--> header title description
                        if (selected_video.length==3)
                        {
                            $(".landing-video-title").text(selected_video[1]);
                            $(".landing-video-description p").text(selected_video[2]);

                        }
                        $("#video-ytd")[0].src = selected_video[0];

                        $("html, body").animate({ scrollTop: position }, 2000);

                        setTimeout(function () {
                            $('#video-ytd')[0].src += "?autoplay=1";
                            $("#video-ytd").addClass("video-ytd-show");
                            $("#video-loader").hide();

                        }, 5000);

                    }
                }
            });

            function onPage(name) {
                var path = window.location.pathname;
                return name == path.substring(path.lastIndexOf('/') + 1);
            }
            if (onPage('moja-love')) {
                $('.css-background-change').css('background', '#2E0554');
                $('.css-color-change').css('color', '#2E0554');
            };
            $(".main-click").click(function () {
                $(".video-citation-box").hide();
                $("#video-header").css({ 'height': '75vh' });
            });

            function MediaHashVideo() {
                var selected_video = window.location.hash.replace('#', '');
                if (selected_video !== null && selected_video !== undefined && selected_video != "") {
                    //-->show video loader
                    $("#video-loader").show();
                    $(".video-citation-box").hide();
                    //}
                    $("#video-ytd")[0].src = selected_video;
                    setTimeout(function () {
                        $('#video-ytd')[0].src += "?autoplay=1";
                        $("#video-ytd").addClass("video-ytd-show");
                        $("#video-loader").hide();
                    }, 5000);
                }
            }
    </script>

}
<div id="@styleAtt" class="video-section">

    <div class="container">

        @*@Html.Partial("_pageHeaderVideo", videoLanding as TabHeader)*@

        @*Start *@
        @{
            var title = videoLanding.Value("ebankITIconTitle");
            var thumb_img = videoLanding.Value<IPublishedContent>("ebankITIcon").Url;
            var description = videoLanding.Value("ebankITIconContent");
            var initial_video = videoLanding.Value("iconClass");

            var content = videoItem.Value<IEnumerable<IPublishedElement>>("tabBodyContent");
            var videos = content.Where(c => c.ContentType.Alias == "nCTabGenericContent").FirstOrDefault().Value<IEnumerable<IPublishedElement>>("sectionContent");
            var x = 1;

        }

        <div id="video-header" class="vid_list_item" data-video="@initial_video">
            <div id="video-header-thumb" style="background-image:url('@thumb_img'); background-position: right;">
                <iframe width="100%" height="100%" id="video-ytd" src="" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen></iframe>
                <section id="video-loader">
                    <div class="loader" id="form-preloader-loader">
                        <div class="loader-img"></div>
                    </div>
                </section>

            </div>
        </div>

        @*Finish *@

        <div class="video-content">
            <h1 class=" video-title css-color-change">@heroBody.Value("bodyTitle")</h1>
            <div class="video-body">
                <p>@heroBody.Value("bodyDescription")</p>
            </div>

            <div class="row">
                <div class="row">
                    <div class="col-xs-12 col-md-12 col-lg-12" style="color: #857e7e;margin-bottom: 20px;">
                        @Html.Raw(heroBody.RichTextBox)
                    </div>
                </div>
            </div>
        </div>

        <div id="video-body">
            <div class="row">
                @foreach (var videoData in videos)
                {
                    var titleEpisode = "Episode " + x;
                    var descriptionEpisode = videoData.Value("NCcardDescription");
                    var imgEpisode = videoData.Value<IPublishedContent>("NCcardIcon").Url;
                    var videoUrl = videoData.Value("NCcardTitle");

                    <div id="item-@x" class="col-md-4 col-sm-6 vid-list">
                        <div data-video="@videoUrl*@titleEpisode*@descriptionEpisode" class="video-item vid_list_item">
                            <div class="vid-list-play-botton">
                                <i class="fa fa-play-circle fa-5x"></i>
                            </div>
                            <div class="video-item-img" style="background-position:bottom; background-image:url(@imgEpisode)"></div>
                            <div class="video-item-content">
                                <div class="video-description-box">
                                    <p class="video-item-description">@descriptionEpisode</p>
                                </div>
                            </div>
                        </div>
                    </div>


                    x++;
                }
            </div>
        </div>
        <!-- HERO BODY-->

    </div>

</div>

<div class="container @(isGrowForIt1 ? "mobi-padding" : "")">

    <div class="@styleAtt">
        <hr />
        <div class="video-content">
            <div class="row myworld-campaign-section-container">
                <div class="row">
                    <div class="col-xs-12 col-md-12 col-lg-12" style="color: #857e7e;">
                        @Html.Raw(lastBlurb)
                    </div>
                </div>
            </div>
        </div>

        @if (video_card != null)
        {
            int iterator = 0;
            var videoCardData = video_card.Value<IEnumerable<IPublishedElement>>("CardItemDetail");
            <div class="hidden-xs row eq-height @(videoCardData.ToList().Count > 3 ? "card-slider" : "") margin-top-50">
                @foreach (NCcard benefit in videoCardData)
                {
                    <div class="col-md-4 col-sm-3 col-xs-2 video-item list_item" style="margin: 20px">
                        <div class="card-plain showTitleAndDescriptionModal" data-item="@benefit.NCcardTitle*@benefit.NCcardDescription">
                            <div class="center-icon-text">
                                <div class="image">
                                    @if (benefit.NCcardIcon != null)
                                    {
                                        <img style="height:100%;width:100%;"
                                             class="showTitleAndDescriptionModal" data-item="@benefit.NCcardTitle*@benefit.NCcardDescription" src="@benefit.NCcardIcon.Url" alt="@benefit.NCcardIcon.Value("altTag")" />
                                    }
                                </div>
                                <p class="descr showTitleAndDescriptionModal"
                                   data-item="@benefit.NCcardTitle*@benefit.NCcardDescription">
                                    @benefit.NCcardTitle
                                </p>
                            </div>
                        </div>
                    </div>
                    ++iterator;
                }
            </div>
        }

        @if (video_card != null)
        {
            int iterator = 0;
            var videoCardData = video_card.Value<IEnumerable<IPublishedElement>>("CardItemDetail");

            <div class="row hidden-sm hidden-md hidden-lg col-xs-12">
                @foreach (NCcard imageData in videoCardData)
                {
                    String imageDescription = imageData.Value("NCcardDescription").ToString();
                    var img = imageData.NCcardIcon.Url;
                    String storyTitle = imageData.Value("NCcardTitle").ToString();
                    String popupimage = imageData.NCcardIcon.ToString();
                    <div class="col-md-3 col-sm-6 vid-list">
                        <div class="row showTitleAndDescriptionModal">
                            <div class="col-xs-4">
                                <img class="mobi-stories-image showTitleAndDescriptionModal" src="@imageData.NCcardIcon.Url" alt="@imageData.NCcardIcon.Value("altTag")">
                            </div>
                            <div class="col-xs-8">
                                <span class="mobile-description-view css-color-change showTitleAndDescriptionModal">@imageData.NCcardTitle</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    


</div>


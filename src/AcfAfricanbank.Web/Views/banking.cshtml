    var heroKnees = children?.Where(c => c.ContentType.Alias.ToLower() == "heroknees").FirstOrDefault();
    var bankingCards = "/media/jzylorhd/african-bank-banking-myworld-account-card-power-pocket-family-shared400x350.png";

    string urlProtocol = HttpContext.Current.Request.Url.Scheme.ToLower();
    urlProtocol = urlProtocol + "://" + domainUrl + bankingCards;
    var popupAppTitle = "Download the App using one of the following";
    var popQRCode = "/media/ylalxyxb/image001.png";
    var popAndroidApp = "/media/mtjfxi5f/googleplaystoredownloadimagelink.png";
    var popIOsApp = "/media/5pdkgij3/appstoredownloadimagelink.png";
    var popHuaweiApp = "/media/di0py4qr/appgallery-logo-2.png";

    var headerImage_large = heroHeader?.Value<IPublishedContent>("image")?.Url;
    var headerImage_medium = heroHeader?.Value<IPublishedContent>("imageMedium")?.Url;
    var headerImage_small = heroHeader?.Value<IPublishedContent>("imageSmall")?.Url;

    // Schema data
    var description = heroShoulder.Value("shouderDescription");
    var title = heroShoulder.Value("shoulderTitle");

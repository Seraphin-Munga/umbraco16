@if (bankingItemsModel.BenefitCards != null && bankingItemsModel.BenefitCards.Any())
{
    int cardIChestterator = 0;

    <div class="container eq-height @(bankingItemsModel.BenefitCards.Count > 3 ? "card-slider" : "") margin-top-40">
        @foreach (Card benefit in bankingItemsModel.BenefitCards)
        {
            String cardIdTag = "card" + cardIChestterator.ToString();
            <div class="col-sm-4">
                <a href="#@cardIdTag">
                    <div class="card-plain">
                        <div class="center-icon-text">
                            <div class="image">
                                @if (benefit.CardIcon != null)
                                {
                                    <img class="own-world-of-banking-icons" src="@benefit.CardIcon.Url" alt="@benefit.CardIcon.Value("altTag")" />
                                }
                            </div>
                            <div class="title text-uppercase">@benefit.CardTitle</div>
                            <p class="descr">@benefit.CardDescription</p>
                        </div>
                    </div>
                </a>
            </div>

            ++cardIChestterator;
        }
    </div>
}

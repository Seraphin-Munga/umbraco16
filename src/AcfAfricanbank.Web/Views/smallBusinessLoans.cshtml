 <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<script>
  const successScreen = document.getElementById("successScreen");
  const failScreen = document.getElementById("unsuccessfulScreen");
  const formSection = document.getElementById("formSection");

  const submitBtn = document.querySelector(".submit-button");

  submitBtn.addEventListener("click", function (e) {
      e.preventDefault();

      let qualifies = true;

      function check(name, allowedYes = true) {
          const selected = document.querySelector(`input[name="${name}"]:checked`);
          if (!selected) return false;
          return allowedYes ? selected.nextElementSibling.innerText === "Yes" : true;
      }

      if (!check("blackOwned")) qualifies = false;
      if (!check("citizenOwned")) qualifies = false;
      if (!check("employeesSA")) qualifies = false;
      if (!check("permits")) qualifies = false;
      if (!check("municipalLicence")) qualifies = false;
      if (!check("cipc")) qualifies = false;
      if (!check("bankAccount")) qualifies = false;

      const uif = document.querySelector(`input[name="uif"]:checked`);
      if (!uif || uif.nextElementSibling.innerText === "Not willing to register")
          qualifies = false;

      const sars = document.querySelector(`input[name="sars"]:checked`);
      if (!sars || sars.nextElementSibling.innerText === "Not willing to register")
          qualifies = false;

      // Hide form
      formSection.style.display = "none";

      if (qualifies) {
          failScreen.classList.remove("active");
          successScreen.classList.add("active");
          $('.success').fadeIn(300);
      } else {
          successScreen.classList.remove("active");
          failScreen.classList.add("active");
          $('.unsuccessful').fadeIn(300);
      }
  });
</script>


<script>

document.addEventListener("DOMContentLoaded", function() {
    const form = document.querySelector(".info-form");
    const inputs = form.querySelectorAll("input[type='text'], input[type='email']");
    const questionItems = document.querySelectorAll(".question-item");
    const contactInput = document.getElementById("contact");

    // Add error messages dynamically under each question
    questionItems.forEach(q => {
        if (!q.querySelector(".error-message")) {
            const errorMsg = document.createElement("div");
            errorMsg.classList.add("error-message");
            errorMsg.textContent = "Select an option";
            q.appendChild(errorMsg);
        }
    });

    // South African phone validation
    const saPhoneRegex = /^(0[6-8]\d{8}|\+27[6-8]\d{8})$/;

    // Validate radio group
    function validateRadioGroup(question) {
        const radios = question.querySelectorAll("input[type='radio']");
        const anyChecked = Array.from(radios).some(r => r.checked);
        if (!anyChecked) {
            question.classList.add("invalid");
        } else {
            question.classList.remove("invalid");
        }
        return anyChecked;
    }

    // Live validation for text/email inputs
    inputs.forEach(input => {
        input.addEventListener("input", () => {
            let isValid = input.checkValidity() && input.value.trim() !== "";

            if (input === contactInput) {
                const value = input.value.trim().replace(/\s+/g, "");
                isValid = saPhoneRegex.test(value);
            }

            input.classList.toggle("invalid-input", !isValid);
        });
    });

    // Live validation for radio buttons
    questionItems.forEach(q => {
        const radios = q.querySelectorAll("input[type='radio']");
        radios.forEach(r => {
            r.addEventListener("change", () => {
                validateRadioGroup(q);
            });
        });
    });

    // On submit validation
    const submitButton = document.querySelector(".submit-button");
    submitButton.addEventListener("click", e => {
        e.preventDefault();
        let valid = true;

        // Validate inputs
        inputs.forEach(input => {
            let isValid = input.checkValidity() && input.value.trim() !== "";
            if (input === contactInput) {
                const value = input.value.trim().replace(/\s+/g, "");
                isValid = saPhoneRegex.test(value);
            }

            input.classList.toggle("invalid-input", !isValid);
            if (!isValid) valid = false;
        });

        // Validate radios
        questionItems.forEach(q => {
            if (!validateRadioGroup(q)) valid = false;
        });

        if (valid) {
            alert("Form submitted successfully!");
            form.reset();
            inputs.forEach(i => i.classList.remove("invalid-input"));
            questionItems.forEach(q => q.classList.remove("invalid"));
        } else {
            alert("Please complete all required fields correctly.");
        }
    });
});
</script>

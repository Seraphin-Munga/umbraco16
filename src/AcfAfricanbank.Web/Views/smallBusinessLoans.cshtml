  }

  /* Radio buttons default appearance */
.options-group {
  gap: 24px;
  align-items: center;
}

/* Hide native radio */
.radio-input {
  appearance: none;
  -webkit-appearance: none;
  -moz-appearance: none;
  width: 22px;
  height: 22px;
  border: 2px solid #7ed321;
  border-radius: 50%;
  display: inline-block;
  position: relative;
  margin-right: 8px;
  vertical-align: middle;
  cursor: pointer;
  transition: all 0.2s ease;
}

/* Inner green dot when checked */
.radio-input:checked::before {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  width: 12px;
  height: 12px;
  background-color: #7ed321;
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

/* Hover effect (optional) */
.radio-input:hover {
  box-shadow: 0 0 0 3px rgba(126, 211, 33, 0.2);
}

/* Label styling */
.options-group label {
  cursor: pointer;
  display: flex;
  align-items: center;
  color: var(--text-primary-blue, #002B60);
  font-family: Montserrat !important;
  font-size: 16px;
  font-style: normal;
  font-weight: 400;
  line-height: 24px;
}


  /* Checked radio appearance */

input[type="file"]:focus, input[type="radio"]:focus, input[type="checkbox"]:focus {
    outline: none !important; 
    outline-offset: none !important; 
}
  /* Invalid radio outline (red border only) */
  .question-item.invalid .radio-input:not(:checked) {

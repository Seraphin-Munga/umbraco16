                            }
                        ]
                    }
            requestInProgress = true;
            $("#form-loader").show();
            AJAX.request('/leads/apply', {
                    data: data,
                    success: function (e) {
                        call_me_success_close();
                        call_me_success();
                        $("#form-loader").hide();
                    },
                    error: function (req, txt, err) {
                        $("#form-loader").hide();

                        call_me_failed();
                    }
                });
            }
        $("#loan-tracker").click(function () {
            loan_tracker($("#ltSAIDInput").val());
        });
        function loan_tracker(_value) {
            if (_value === "frmLoanTracker" || _value === "" ) { return; }
            var csrfToken = $("input[name='__RequestVerificationToken']").val();
            var _data = JSON.stringify({ "idNumber": _value });

            $("#form-loader").show();
            $.ajax({
                headers: { '__RequestVerificationToken': csrfToken },
                url: '/umbraco/surface/Custom/ClientSearch',
                type: "POST",
                contentType: 'application/json; charset=utf-8',
                data: _data,
                success: function (data, x, y) {

                    $("#form-loader").hide();
                    var result = JSON.parse(data.data);

                    if ((result.resultCode == '204') || (result.resultCode == '200')) {
                        var header = "Thank you";
                        var body = "The status of your loan application will be sent to you via sms shortly."
                        var duration = 3000;
                        notifyCustomer(header, body, duration,
                            '@ResourceHelper.GetResource("GenericContactForm_SAID_Required")',
                            '@ResourceHelper.GetResource("GenericContactForm_SAID_ValMessage")',
                            '@ResourceHelper.GetResource("GenericContactForm_SAID_LenghtValMessage")',
                            '@ResourceHelper.GetResource("GenericContactForm_SAID_InvalidAge")'
                        );
                        $("#form-loader").css("margin-top", "50%");
                    } else {
                        var header = "";
                        var body = "Unfortunately we are experiencing technical issues. Please try again later or log into our banking App to view the status of your loan application."
                        var duration = 3000;
                        notifyCustomer(header, body, duration,
                            '@ResourceHelper.GetResource("GenericContactForm_SAID_Required")',
                            '@ResourceHelper.GetResource("GenericContactForm_SAID_ValMessage")',
                            '@ResourceHelper.GetResource("GenericContactForm_SAID_LenghtValMessage")',
                            '@ResourceHelper.GetResource("GenericContactForm_SAID_InvalidAge")'
                        );
                        $("#form-loader").css("margin-top", "50%");
                    }
                },
                error: function (error) {
                    var header = "";
                    var body = "Unfortunately we are experiencing technical issues. Please try again later or log into our banking App to view the status of your loan application."
                    var duration = 3000;
                    notifyCustomer(header, body, duration,
                        '@ResourceHelper.GetResource("GenericContactForm_SAID_Required")',
                        '@ResourceHelper.GetResource("GenericContactForm_SAID_ValMessage")',
                        '@ResourceHelper.GetResource("GenericContactForm_SAID_LenghtValMessage")',
                        '@ResourceHelper.GetResource("GenericContactForm_SAID_InvalidAge")'
                    );
                    $("#form-loader").css("margin-top", "50%");
                },
            });
        }
        function call_me(form_name, prodId, call_me_subject, call_me_contact_type) {
            var data = {};
            var inputs = document.forms[form_name].getElementsByTagName("input");

            for (var x = 0; x < inputs.length; x++) {
                data[inputs[x].id] = inputs[x].value;
            }
            var utmSource = '@utm_source';
            	var utmMedium = '@utm_medium';
            	var utmCampaign = '@utm_campaign';

            if (utmSource.length >= 3) {
                data["utm_source"] = utmSource;
                data["utm_medium"] = utmMedium;
                data["utm_campaign"] = utmCampaign;
            }


            $("#form-loader").show();

            var csrfToken = $("input[name='__RequestVerificationToken']").val();
            $.ajax({
                headers: { '__RequestVerificationToken': csrfToken },
                url: '/umbraco/surface/Custom/call_me_request',
                type: "POST",
                dataType: 'json',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ form: data, prodId: prodId, call_me_subject: call_me_subject, call_me_contact_type: call_me_contact_type}),
                success: function (data, x, y) {
                    $("#form-loader").hide();
                    if (!data.error) {
                        callMeSuccess(data.data.split(";")[0]);
                        call_me_success_close(9000, data.data.split(";")[0]);
                    } else {
                        if (data.error) {
                            callMeSuccess(JSON.parse(data.data.split(";")[1]));
                            call_me_success_close(9000, JSON.parse(data.data.split(";")[1]));
                        } else {
                            if ($("#st-panel-submit")[0].type == "button") {
                                open_call_me();
                                $("#st-panel-submit").submit();
                            } else if ($("#st-panel-submit")[0].type == "submit") {
                                $("#st-panel-submit").submit();
                            }
                        }
                    }
                },
                error: function (data, x, y) {
                    $("#form-loader").hide();
                    call_me_failed(data, 7000);
                }
            });
        }
        function screenWidth() {
            if (window.screen) {
                return (screen.width);
            } else {
                return (0);
            }
        }
        function screenHeight() {
            if (window.screen) {
                return (screen.height);
            } else {
                return (0);
            }
        }
        function returnHumanReadables(message) {
            var _message = "";
            if (typeof (message.code) === "undefined") {
                _message = message;
            } else {
                switch (message.code) {
                    case "400":
                        _message = "Unfortunately, you do not qualify for a credit product right now. Let African Bank help you to improve your credit score and your financial fitness. Click <a href ='https://ib.africanbank.co.za'>here</a> to apply now for a MyWORLD bank account with zero monthly bank fees";
                        break;
                    case "422":
                        _message = "Unfortunately, we are experiencing technical issues. Please try again in a few minutes.";
                        break;
                    case "500":
                        _message = "Unfortunately, we are experiencing technical issues. Please try again in a few minutes.";
                        break;
                    case "502":
                        _message = "Unfortunately, we are experiencing technical issues. Please try again in a few minutes.";
                        break;
                    case "504":
                        _message = "Unfortunately, we are experiencing technical issues. Please try again in a few minutes.";
                        break;
                    default:
                    // code block
                }
            }
            return _message;
        }
            function callMeSuccess(message) {
                //Display the correct message if request was successful
                $('#call_me_form').hide();

                $('.call_me_success_header_title').text("Request for call back received");
                var messaging = "Thank you for using our call me back.";
                var humanReadable = returnHumanReadables(message);
                $('#call_me_success_body').html(humanReadable + "<br/>" + messaging);

                $('#call_me_success').show();
            }
            function call_me_failed(message, message_duration) {
                //Display failed request
                $('#call_me_form').hide();
                $('#call_me_success').show();
                $('.call_me_success_header_title').text("Request failed");
                $('#call_me_success_body').html("Unfortunately you do not qualify for African Bank Products at this stage.");
                $('#call_me_success_body').css("color,red");
                call_me_success_close(message_duration, message);
            }
            function call_me_success_close(message_duration, message) {
                //timeout to remove success message
                setTimeout(function (duration) {

                    var humanReadbale = returnHumanReadables(message);

                    if (duration == 0) {
                        duration = 5000;
                    } else {
                        duration = message_duration;
                    }
                    $(".st-panel").removeAttr("style");
                    $('#call_me_form').show();
                    $('#call_me_success').hide(); $("form#frmCallMeBack").bootstrapValidator("destroy");
                    $("form#frmCallMeBack")[0].reset();
                    $('.st-button-main.campaing-call').click();
                    var sbject = "<p>Click call me back to speak to our consultants<br/> or apply to create an application online.</p>";
                    $(".st-panel-tip").html(sbject);
                    $("#form_fields").hide();
                    $("#st-panel-submit").prop('type', 'button');
                    $('.call_me_success_header_title').text("Request for call back received");
                    var messaging = "Thank you for using our call me back.";
                    $('#call_me_success_body').html(humanReadbale + "<br/>" + messaging);

                    $(".button-row").css("display", "block");
                    $(".styles_arrow_main").css("display", "none");

                    $('#call_me_success_body').css("color,#6b6f82");
                },
                    message_duration);
            }

            window.addEventListener('DOMContentLoaded', async () => {
                // Wait for MetaMask to be loaded
                await window.ethereum.enable();

                debugger;
                // Initialize web3.js
                if (typeof web3 !== 'undefined') {
                    web3 = new Web3(web3.currentProvider);
                } else {
                    // Handle cases where MetaMask is not available
                    console.error('Please install MetaMask.');
                    return;
                }

                // Get the selected Ethereum address
                const accounts = await web3.eth.getAccounts();
                const selectedAddress = accounts[0];

                // You can use the selected address to retrieve the NFTs
                // and display them in the widget

                // Example: Display the selected address
                document.getElementById('address').innerText = selectedAddress;
            });


            $(document).ready(function () {
                init_fields();
                init_loan_tracker_fields();
                $('.st-button-main.campaing-call').click();

                $('body').on('click', '#s-rall-bn', function () {
                    CloseCookie();
                });
                $('body').on('click', '#s-sv-bn', function () {
                    AcceptCookie();
                });
            });
        </script>

        <script type="text/javascript">

            window.addEventListener('load', function () {

                // obtain plugin
                var cc = initCookieConsent();

                // run plugin with your configuration
                cc.run({

        function setCookie(abname, abvalue, expire) {

          var gdate = new Date();
          gdate.setTime(gdate.getTime() + (expire * 24 * 60 * 60 * 1000));
          var expires = "expires="+gdate.toUTCString();
          document.cookie = abname + "=" + abvalue + ";" + expires + ";path=/";
        }


              // Function to detect the operating system
function detectOS() {
            const userAgent = window.navigator.userAgent;

            if (userAgent.includes("HUAWEI") || userAgent.includes("huawei") || userAgent.includes("Huawei")) {
                return "Huawei"
            }
            if (userAgent.indexOf("Windows") !== -1) {
                return "Windows";
            } else if (userAgent.indexOf("Mac") !== -1) {
                return "MacOS";
            } else if (userAgent.indexOf("Linux") !== -1) {
                return "Linux";
            } else if (userAgent.indexOf("Android") !== -1) {
                return "Android";
            } else if (userAgent.match(/iPhone|iPad|iPod/i)) {
                return "iOS";
            } else {
                return "Unknown OS";
            }
    }

        // Function to get the app store link based on the OS
        function getAppStoreLink(os) {
            switch (os) {
                case "Huawei":
                    return "https://appgallery.huawei.com/app/C103438901"
                case "Android":
                    return "https://play.google.com/store/apps/details?id=za.co.android.africanbank";  // App Store link
                case "Windows":
                    return "https://play.google.com/store/apps/details?id=za.co.android.africanbank";  // App Store link
                case "Linux":
                return "https://play.google.com/store/apps/details?id=za.co.android.africanbank";  // App Store link
                case "MacOS":
                case "iOS":
                    return "https://apps.apple.com/us/app/african-bank/id1357204405"; // App Store link
                default:
                    return "#"; // Placeholder for other operating systems
            }
        }
        

        // Update the HTML content and link using jQuery
        $(document).ready(function() {
            const osName = detectOS();
            const appStoreLink = getAppStoreLink(osName);
            $('#osName').text('You are using ' + osName);

            // Update the button link
            $('#appStoreLink').attr('onclick', 'window.location.href="' + appStoreLink + '"');
        });
    </script>
    

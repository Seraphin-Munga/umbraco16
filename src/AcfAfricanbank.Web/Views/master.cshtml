        function init_loan_tracker_fields() {
            $('#frmLoanTracker').bootstrapValidator({
                feedbackIcons: {
                    valid: 'glyphicon glyphicon-ok-sign',
                    invalid: 'glyphicon glyphicon-remove-sign',

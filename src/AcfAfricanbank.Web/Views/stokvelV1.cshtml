    @{  int idfirstcard = 0;
        <section class="section pt-50 pb-40">
            <div class="container">
                <div class="row mt-50 align-items-center">
                <h2 class="color-brand-1 mt-15 mb-20 text-center ">@createOwnWorldOfBanking.Value("partialViewClassName")</h2>
               
                    @foreach (var item in Allcards)
                   {
                        if(idfirstcard < 6){
                            var cardTitle = item.Value<string>("nCcardTitle");
                            var cardIcon = item.Value<IPublishedContent>("nCcardIcon")?.Url;
                            
                            <div class="col-lg-6">
                                <div class="card-offer-small card-we-do hover-up">
                                    <div class="card-image">
                                        <img class="d-block" src="@cardIcon" alt="iori"> 
                                    </div>
                                    <div class="card-info">
                                       <br/>
                                      <h4 class="color-brand-1">@cardTitle</h4>
                                    </div>
                                    
                                </div>
                            </div>
                        }
                      idfirstcard += 1;
                    }
                </div>
            </div>
        </section>
    }
    
    @*Table*@
    
    <section class="section pb-40 pt-40 bg-grey-60">
        <div class="container">
            <h1 class="color-brand-1" style="text-align:center">@Html.Raw(@heroBody.Value("bodyTitle"))</h1>
            <div class="row d-flex align-items-center row-change">

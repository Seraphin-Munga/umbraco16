@inherits Umbraco.Web.Mvc.UmbracoViewPage<ContentModels.BaseModernUI>
@using CustomModels = Web.Models;
@using ContentModels = Umbraco.Web.PublishedModels;
@using Web.Helpers
@inherits Umbraco.Web.Mvc.UmbracoViewPage
@using AcfAfricanbank.Core.Models.Forms
@{
	Layout = "Master.cshtml";
	 var Children = Model.Children;
	 
	  var herobody = Children?.Where(c => c is HeroBody).FirstOrDefault();
	   var heroheader = Children?.Where(c => c is HeroHeader).FirstOrDefault();
	 
	 var headerImage_large = heroheader?.Value<IPublishedContent>("image")?.Url;
	 var headerImage_Medium = heroheader?.Value<IPublishedContent>("imageMedium")?.Url;
	 var headerImage_Small = heroheader?.Value<IPublishedContent>("imageSmall")?.Url;
	  var headerImage_Last = heroheader?.Value<IPublishedContent>("video")?.Url;

	  
	  var sectioncard = herobody.Children.Where(c => c.Name == "Business Cards").FirstOrDefault();
      var sectioncardAfricanBank = sectioncard.Value<IEnumerable<IPublishedElement>>("tabBodyContent");
      var sectioncards = sectioncardAfricanBank.Where(c => c.ContentType.Alias == "nCTabGenericContent").FirstOrDefault().Value<IEnumerable<IPublishedElement>>("sectionContent");
      
      var homecard = sectioncard?.Children?.Where(c => c.Name == "Home Card");
      var homecards = homecard.Select(c => c as Card).ToList();
      
       var thirdsection = sectioncard?.Children?.Where(c => c.Name == "Third Section");
       var thirdcards = thirdsection.Select(c => c as Card).ToList();
      
       @*var applyDocs = thirdcards?.Select(c => c as Card).FirstOrDefault();
       var navigate1 = applyDocs.Value<IEnumerable<Umbraco.Web.Models.Link>>("buttonLink").First();
       var navigate2 = applyDocs.Value<IEnumerable<Umbraco.Web.Models.Link>>("buttonLink").Last();*@
       
       
        var secondsection = sectioncard?.Children?.Where(c => c.Name == "Second Card");
       var secondcards = secondsection.Select(c => c as Card).ToList();
      
       var applyDocs = secondcards?.Select(c => c as Card).FirstOrDefault();
       var navigate1 = applyDocs.Value<IEnumerable<Umbraco.Web.Models.Link>>("buttonLink").First();
      
	 
   
}

@* the fun starts here *@

<link rel="stylesheet" href="/css/projectmagic-business-banking.css"/>
<style>

.section1-img-bg-image {
    position: relative;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    @*overflow: hidden;*@ /* To ensure the pseudo-element is contained within the parent */
}


.section1-img-bg-image::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: url('@headerImage_large');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0.15; /* Adjust opacity as needed */
  
}


</style>

<!--banner section-->

<section class="section-800 section-bg-black section1-img-bg-image">
    <div class="container">
            <div class="row align-items-center d-flex flex-row-reverse row-change md-text-center">
                @if (homecards!= null && homecards.Any())
            {

                foreach (Card benefit in homecards)
                {
               
              <div class="col-xl-7 col-lg-7 col-md-7 ">
                <h1 class="font-white">@benefit.CardTitle</h1>
                <h1 class="font-blue1">@benefit.CardDescription</h1>
              </div>
               <div class="col-xl-5 col-lg-5 col-md-5 ">
                <img
                  class="d-block"
                  src="@benefit.CardIcon.Url"
                  alt="iori"
                />
              </div>
              }
              }
            </div>
            <div class="container">
            <div class="row d-flex align-items-center md-text-center" style="margin-top: 65px; margin-bottom: 65px !important;">
              <div class="col-xl-12 col-lg-12 col-md-12">
                <div class="deck">
                  @foreach (var item in sectioncards)

                    {
                        var cardTitle = item.Value<string>("nCcardTitle");
                        var Icon = item.Value<IPublishedContent>("nCcardIcon")?.Url;
                       var url = item.Value<string>("abstractButton");
                    <div class="card-deck">
                
                        <div class="card-title">
                
                            <h2 class="font-white">@cardTitle</h2>
                           
                    @Html.Raw(item.Value<string>("mediumDescription"))
                            
                
                
                        </div>

                        <div class="card-link">
                            <div class="icon">
                                <a href="@url">
                                    <img loading="lazy" src="@Icon">
                                </a>  
                            </div>
                        </div>

                    </div>
                   
}

                </div>
              </div>
            </div>
          </div>
    </div>
</section>


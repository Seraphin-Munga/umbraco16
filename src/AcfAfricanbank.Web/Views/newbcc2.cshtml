@{
    var currentUrl = Request.Url.AbsolutePath.ToLower(); // e.g., "/business-loans"
    var activeTab55 = "BusinessLoans"; // default

    var businessUrls = new[] { "/business-funding", "/business-loans", "/apply-now" };
    var propertyUrls = new[] { "/mortgage-financing", "/real-estate", "/commercial" };
    var assetUrls = new[] { "/asset-leasing", "/equipment-finance", "/capital" };
    var investmentUrls = new[] { "/investment", "/advisory", "/banking" };

    if (businessUrls.Contains(currentUrl))
    {
        activeTab55 = "BusinessLoans";
    }
    else if (propertyUrls.Contains(currentUrl))
    {
        activeTab55 = "CommercialPropertyFinance";
    }
    else if (assetUrls.Contains(currentUrl))
    {
        activeTab55 = "CapitalEquipmentFinance";
    }
    else if (investmentUrls.Contains(currentUrl))
    {
        activeTab55 = "InvestmentBanking";
    }
}

@{
    Func<string, string> generateIdFromUrl = url =>
    {
        if (string.IsNullOrEmpty(url)) return "btn-default-id";

        // Take everything after # or ? (anchor/querystring part)
        var uniquePart = url.Contains("#")
            ? url.Substring(url.IndexOf("#") + 1)
            : url.Contains("?")
                ? url.Substring(url.IndexOf("?") + 1)
                : url;

        // Replace invalid HTML id characters with hyphen
        return "btn-" + System.Text.RegularExpressions.Regex.Replace(uniquePart, @"[^A-Za-z0-9\-_]", "-");
    };
}


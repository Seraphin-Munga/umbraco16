<script>
$(document).ready(function() {
    $(".accordion").click(function() {
        // Toggle the current accordion
        $(this).toggleClass("active");
        
        // Get the panel related to this accordion
        var panel = $(this).next(".panel");

        // Check if the panel was already open
        var wasOpen = panel.css("display") === "block";
        
        // Close all panels
        $(".panel").css("display", "none");
        $(".accordion").removeClass("active"); // Optionally remove the 'active' class from all accordions
        
        // If the clicked panel was not already open, open it
        if (!wasOpen) {
            panel.css("display", "block");
            $(this).addClass("active"); // Optionally add 'active' class back to the clicked accordion
        }
    });
});
</script>

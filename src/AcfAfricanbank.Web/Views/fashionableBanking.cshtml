<style>
/*hero section*/
#videoContainer {
    position: relative;
    width: 100%;
    height: 95vh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    }

#placeholder {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(rgba(0, 52, 119, 0.60), rgba(0, 52, 119, 0.60)), url('/media/mtchppa5/african-bank-tvc-banking-483-min.jpg') no-repeat center center;
    background-size: cover;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s;
    }

#placeholderText {
    color: white;
    padding: 10px;
    align-items: center;
    justify-content: flex-start;
    }

#placeholder.hidden {
    transform: translateX(-100%);
    }

#myVideo {
    width: 100%;
    height: 100%;
    border: none;
    display: none;
    z-index:0;
    }

#myButton {
    display: flex;
    align-items: center;
    position: absolute;
    text-transform: uppercase;
   @* top: 70%;
    left: 20%;
    top: 65%;
    left: 12%;*@
    padding: 15px 41px;
    background-color: #5dc300;
    color: white;
    border: none;
    border-radius: 30px;
    cursor: pointer;
    transition: width 0.3s;
    z-index: 10;
    }

.button-icon {
    height: 28px;
    width: 28px;
    border: 1.5px solid #fff;
    border-radius: 50%;
    margin-left: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: absolute;
    right: 7px;
    }

#myButton.expanded {
    min-width: 140px;
    padding: 13px 24px;
}


/*end of hero section*/

.video-container {

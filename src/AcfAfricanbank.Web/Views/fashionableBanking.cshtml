          slidesPerView: 1,
          spaceBetween: 5,
        },
        "@@0.75": {
          slidesPerView: 2,
          spaceBetween: 10,
        },
        "@@1.00": {
          slidesPerView: 3,
          spaceBetween: 20,
        },
        "@@1.50": {
          slidesPerView: 4,
          spaceBetween: 25,
        },
      },
    });
  </script>
  
 <!--banner video control-->
 
 <!--banner video control-->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
$(document).ready(function() {
    var video = $('#myVideo');
    var placeholder = $('#placeholder');
    var placeholderText = $('#placeholderText');
    var myButton = $('#myButton');
    var textH2 = $('#text');  // Target the <h2> and <p> elements

    $('#myButton').click(function() {
        console.log("Button clicked");

        // If the video is visible
        if (video.is(':visible')) {
            // Change button text back to original state and show button text
            $(this).removeClass('expanded').html(`Watch the video <span class="button-icon">▶</span>`);
            // Show the placeholder and text again
            placeholder.removeClass('hidden');
            placeholderText.show(); // Show the placeholder text
            // Show the <h2> and <p> content again
            textH2.show();
            textH2.next('p').show();  // Show the <p> element associated with <h2>
            // Hide the video and clear the video source
            video.attr("src", ""); // Clear the video source
            video.hide();
            // Restore the background of the placeholder
            placeholder.css("background", ""); // Clear the background
        } else {
            // When the video is not visible, show the video and update button text
            video.attr("src", "https://www.youtube.com/embed/3DSeauqrIpI?autoplay=1");
            $(this).addClass('expanded').html(`close <span class="button-icon">x</span>`);
            // Hide the placeholder and text
           
            // Hide the <h2> and <p> content when video is shown
            textH2.hide();  // Hide <h2>
            textH2.next('p').hide();  // Hide <p>
            // Show the video
            video.show();
            // Remove the background of the placeholder
            placeholder.css("background", "none"); // Remove background without hiding element
        }

        // Hide the button text (if you want to hide it completely when the video is shown)
        
    });
});
</script>



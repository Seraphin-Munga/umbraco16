@inherits Umbraco.Web.Mvc.UmbracoViewPage<ContentModels.PageManageYourAccount>
@using CustomModels = Web.Models;
@using ContentModels = Umbraco.Web.PublishedModels;
@using Web.Helpers


@{
    Layout = "Master.cshtml";

    // All Current Page Children
    var children = Model.Children;


    // Get specific Children
    var heroHeader = children?.Where(c => c.ContentType.Alias.ToLower() == "heroheader").FirstOrDefault();
    var heroShoulder = children?.Where(c => c.ContentType.Alias.ToLower() == "heroshoulder").FirstOrDefault();
    var heroChest = children?.Where(c => c.ContentType.Alias.ToLower() == "herochest").FirstOrDefault();
    var heroBody = children?.Where(c => c.ContentType.Alias.ToLower() == "herobody").FirstOrDefault();
    var heroKnees = children?.Where(c => c.ContentType.Alias.ToLower() == "heroknees").FirstOrDefault();
    var testimonialTab = children?.Where(c => c.ContentType.Alias.ToLower() == "testimonials").FirstOrDefault();
   var kneesTabHeaders = heroKnees?.Children?.Select(c => c.Value("title")?.ToString()).ToList();
    var findOutMoreTab = heroKnees?.Children?
        .Where(c => c.ContentType.Alias.ToLower() == "findoutmore").FirstOrDefault();
  

@*newcode*@
      var keybenfits = heroBody.Children.Where(c => c is RichTextEditor).FirstOrDefault();
      var fisrtsection = heroBody.Children.Where(c => c.Name == "FirstSection").FirstOrDefault();
      var fisrtsectioncontent = fisrtsection .Value<IEnumerable<IPublishedElement>>("tabBodyContent");
      var nofisrtsectioncontent = fisrtsectioncontent.Where(c => c.ContentType.Alias == "nCTabGenericContent").FirstOrDefault().Value<IEnumerable<IPublishedElement>>("sectionContent");
      
      var funeralplansection = heroBody.Children.Where(c => c.Name == "Funeral Plan").FirstOrDefault();
      var funeralplansectioncontent = funeralplansection .Value<IEnumerable<IPublishedElement>>("tabBodyContent");
      var nofuneralcontent = funeralplansectioncontent.Where(c => c.ContentType.Alias == "nCTabGenericContent").FirstOrDefault().Value<IEnumerable<IPublishedElement>>("sectionContent");

    var step3 = fisrtsection?.Children?.Where(c => c.ContentType.Alias.ToLower() == "card");
    var step3caards = step3.Select(c => c as Card).ToList();
    
    var step4section = heroBody.Children.Where(c => c.Name == "Step4 Section").FirstOrDefault();
      var step4sectionsectioncontent = step4section .Value<IEnumerable<IPublishedElement>>("tabBodyContent");
      var nostep4content = step4sectionsectioncontent.Where(c => c.ContentType.Alias == "nCTabGenericContent").FirstOrDefault().Value<IEnumerable<IPublishedElement>>("sectionContent");
    
     
    
    
   
@*end newcode*@

    var items = heroKnees.Value("items");
  
    var keyBenefits = heroBody.Children(x => x.ContentType.Alias.ToLower() == "richtexteditor").FirstOrDefault();
    var cardImageDescriptions = heroBody.Children(x => x is Card).ToList();
    var contactUs = heroBody.Children(x => x.ContentType.Alias.ToLower() == "herobodycontactus").FirstOrDefault();

    // Call me back
    // var callMeBack = children?.Where(c => c.ContentType.Alias.ToLower() == "callmeback").FirstOrDefault();

    // Get Specific Grandchildren
    var bodyCards = heroBody?.Children?.Where(c => c.ContentType.Alias.ToLower() == "card");
    var bodyButton = heroBody?.Children?
    .Where(c => c.ContentType.Alias == "ebankITAbstractButton").FirstOrDefault();

    // Get Properties
    var bodyTitle = heroBody?.Value("bodyTitle").ToString();
    // var bodyDescription = heroBody?.Value("bodyDescription").ToString();
    var bodyRedirects = heroKnees?.Value("title").ToString();
    var applyDocs = bodyCards?.Select(c => c as Card).ToList();

    var benefitsModel = new CustomModels.Benefits
    {
        Header = heroChest?.Value("chestTitle").ToString(),
        Description = heroChest?.Value("chestDescription").ToString(),
        BenefitCards = heroChest?.Children?.Where(c => c.ContentType.Alias.ToLower() == "card")?.Select(c => c as Card).ToList()
    };


}


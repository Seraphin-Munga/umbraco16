          });
        });

        function updateFileName(inputElement, fileName) {
          const truncatedFileName =
            fileName.length > 12 ? fileName.substring(0, 9) + "..." : fileName;
          const fileNameElement = inputElement
            .closest(".custom-file-input-container")
            .querySelector(".file-name");
          fileNameElement.textContent = truncatedFileName;
          fileNameElement.style.display = "inline";
          inputElement
            .closest(".custom-file-input-container")
            .querySelector(".custom-file-label").textContent = "Replace";
        }
      });

      function allowOnlyDigits(event) {
        event.target.value = event.target.value.replace(/[^0-9]/g, "");
      }

      document
        .getElementById("CellPhoneInput")
        .addEventListener("input", allowOnlyDigits);
      document
        .getElementById("SAIDInput")
        .addEventListener("input", allowOnlyDigits);

      document
        .getElementById("SAIDInput")
        .addEventListener("blur", function (e) {
          validateField(e.target, 13);
        });

      document
        .getElementById("CellPhoneInput")
        .addEventListener("blur", function (e) {
          validateField(e.target, 10);
        });

      function validateField(inputField, expectedLength) {
        if (
          inputField.value.length !== expectedLength ||
          !/^\d+$/.test(inputField.value)
        ) {
          inputField.classList.add("is-invalid");
          inputField.classList.remove("is-valid");
        } else {
          inputField.classList.add("is-valid");
          inputField.classList.remove("is-invalid");
        }
      }
    </script>
    
    <script>
	var selDiv = "";
		
	document.addEventListener("DOMContentLoaded", init, false);
	
	function init() {
		document.querySelector('#files').addEventListener('change', handleBulkFileSelect, false);
		selDiv = document.querySelector("#selectedFiles");
	}
		
	function handleBulkFileSelect(e) {
		
		if(!e.target.files || !window.FileReader) return;

		selDiv.innerHTML = "";
		
		var files = e.target.files;
		var filesArr = Array.prototype.slice.call(files);
		filesArr.forEach(function(f) {
			var f = files[i];
			if(!f.type.match("image.*")) {
				return;
			}

			var reader = new FileReader();
			reader.onload = function (e) {
				var html = "<img src=\"" + e.target.result + "\">" + f.name + "<br clear=\"left\"/>";
				selDiv.innerHTML += html;				
			}
			reader.readAsDataURL(f); 
		});
		
	}
	</script>

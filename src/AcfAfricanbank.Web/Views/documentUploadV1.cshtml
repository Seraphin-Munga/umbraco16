        async function combineFilesToBase64() {
          const fileInputs = document.querySelectorAll(".custom-file-input");
          const base64Files = await Promise.all(
            Array.from(fileInputs).map((input) => {
              if (input.files.length > 0) {
                return new Promise((resolve) => {
                  const reader = new FileReader();
                  reader.onload = function (event) {
                    resolve(event.target.result.split(",")[1]); // Get base64 string without the prefix
                  };
                  reader.readAsDataURL(input.files[0]);
                });
              }
              return Promise.resolve(null);
            })
          );

          return base64Files.filter(Boolean); // Return an array of base64 strings
        }

        function uploadFileWithProgress(file, progressBar, inputElement) {
          const formData = new FormData();
          formData.append("file", file);

          function simulateProgress(e) {
            if (e.lengthComputable) {
              const percentComplete = (e.loaded / e.total) * 100;
              progressBar.style.width = percentComplete + "%";
              progressBar.textContent = Math.round(percentComplete) + "%";
              progressBar.closest(".progress-container").style.display =
                "block";

              if (percentComplete === 100) {
                progressBar.classList.add("complete");
                $(inputElement)
                  .closest(".custom-file-input-container")
                  .css("border", "1px solid #88BC47");
              } else {
                progressBar.classList.remove("complete");
                $(inputElement)
                  .closest(".custom-file-input-container")
                  .css("border", "");
              }
            }
          }

          // Simulating progress
          let simulatedProgress = 0;
          const progressInterval = setInterval(function () {
            if (simulatedProgress < 100) {
              simulatedProgress += 50; // Simulate progress increment
              simulateProgress({
                lengthComputable: true,
                loaded: simulatedProgress,
                total: 100,
              });
            } else {
              clearInterval(progressInterval);
              console.log("File upload simulation completed");
            }
          }, 500);
        }


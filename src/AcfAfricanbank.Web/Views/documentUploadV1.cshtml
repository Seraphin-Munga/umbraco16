        function validateSAID(idNumber) {
          if (idNumber.length !== 13 || !/^\d+$/.test(idNumber)) {
            return false;
          }
          const birthDate = idNumber.substring(0, 6);
          if (!isValidDate(birthDate)) {
            return false;
          }
          const checksum = calculateLuhnChecksum(idNumber);
          return checksum === parseInt(idNumber[12]);
        }

        function validateCellphone(cellphone) {
          const regex = /^0\d{9}$|^\+27\d{9}$/;
          return regex.test(cellphone);
        }

        function isValidDate(date) {
          const year = parseInt(date.substring(0, 2), 10);
          const month = parseInt(date.substring(2, 4), 10);
          const day = parseInt(date.substring(4, 6), 10);
          if (month < 1 || month > 12) {
            return false;
          }
          const maxDays = [
            31,
            isLeapYear(year) ? 29 : 28,
            31,
            30,
            31,
            30,
            31,
            31,
            30,
            31,
            30,
            31,
          ];
          return day > 0 && day <= maxDays[month - 1];
        }

        function isLeapYear(year) {
          year += 2000; // Adjusting for YY format
          return (year % 4 === 0 && year % 100 !== 0) || year % 400 === 0;
        }

        function calculateLuhnChecksum(idNumber) {
          let sum = 0;
          for (let i = 0; i < 12; i++) {
            const digit = parseInt(idNumber[i]);
            if (i % 2 === 0) {
              sum += digit;
            } else {
              const doubled = digit * 2;
              sum += doubled > 9 ? doubled - 9 : doubled;
            }
          }
          return (10 - (sum % 10)) % 10;
        }


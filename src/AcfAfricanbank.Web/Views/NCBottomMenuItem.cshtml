                    var videos = content.Where(c => c.ContentType.Alias == "nCTabGenericContent").FirstOrDefault().Value<IEnumerable<IPublishedContent>>("sectionContent");
                    var x = 1;
                
                }
    
                <div id="video-header" class="vid_list_item" data-video="@initial_video">

                            var _title = "Episode " + videoIterator;
                            var _description = videoData.Value("nCcardDescription");
                            var _img = videoData.Value<IPublishedContent>("nCcardIcon").Url;
                            var _videoUrl = videoData.Value("nCcardTitle");
                            <div id="item-@videoIterator" class="col-md-3 col-sm-6 vid-list">
                                <div data-video="@_videoUrl*@_title*@_description" class="video-item vid_list_item_campaign">
                                    <div class="vid-list-play-botton"><i class="fa fa-play-circle fa-5x"></i></div>
                                    <div class="video-item-img" style="background-image:url(@_img)"></div>
                                    <div class="video-item-content">
                                        <div class="video-description-box">
                                            <p class="video-item-description">@_description</p>
                                        </div>
                                            <span class="video-item-title css-color-change">@_title</span>
                                            <div class="sharethis-inline-share-buttons" data-url="@Request.Url.AbsoluteUri#@_videoUrl"></div>
                                        </div>
                                    </div>
                            </div>
                            videoIterator+=1;
                        }

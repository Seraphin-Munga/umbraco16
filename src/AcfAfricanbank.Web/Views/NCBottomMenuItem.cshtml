                @{
                    var _content = videoItem.Value<IEnumerable<IPublishedElement>>("tabBodyContent");
                    var _videos = _content.Where(c => c.ContentType.Alias == "nCTabGenericContent").FirstOrDefault().Value<IEnumerable<IPublishedElement>>("sectionContent");
                    var videoIterator = 1;
                }
                <div id="video-body">
                    <div class="row">
                        @foreach (var videoData in _videos)

@inherits Umbraco.Web.Mvc.UmbracoViewPage<ContentModels.PageCampaign>
@using AcfAfricanbank.Core.Models.Forms;
@using ContentModels = Umbraco.Web.PublishedModels;
@using Io = System.IO
@using System.Drawing
@using ImageProcessor
@using Web.Helpers 


@{
    Layout = "Master.cshtml";
    // All Current Page Children
    var children = Model.Children;

    ContainerViewModel containerViewModel = new ContainerViewModel();

    // Get specific Children
    var heroHeader = children?.Where(c => c is HeroHeader).FirstOrDefault();
    var heroShoulder = children?.Where(c => c is HeroShoulder).FirstOrDefault();

    var headerImage_large = heroHeader?.Value<IPublishedContent>("image")?.Url;
    var headerImage_medium = heroHeader?.Value<IPublishedContent>("imageMedium")?.Url;
    var headerImage_small = heroHeader?.Value<IPublishedContent>("imageSmall")?.Url;
    var breadcrumbItems = heroHeader?.Value("breadcrumb")?.ToString()?.Split(',')?.ToList();

    var domainDirectory = System.Web.HttpContext.Current.Request.Url.AbsoluteUri.Replace(System.Web.HttpContext.Current.Request.Url.AbsolutePath, "");
    string currentDirectory = domainDirectory;


    string largeImageFullPath = Server.MapPath(headerImage_large);
    try
    {
        if (Io.File.Exists(largeImageFullPath) && string.IsNullOrEmpty(headerImage_medium))
        {
            var idx = headerImage_large.IndexOf('.', (headerImage_large.Length - 5));
            var fileName = headerImage_large.Substring(0, idx);
            var fileExt = headerImage_large.Substring(idx);
            var generatedMedFile = $"{fileName}_med.gen{fileExt}";
            if (!Io.File.Exists(Server.MapPath(generatedMedFile)))
            {
                byte[] photoBytes = Io.File.ReadAllBytes(largeImageFullPath);
                int quality = 100;
                var size = new Size(900, 380);
                using (var inStream = new MemoryStream(photoBytes))
                {
                    using (var outStream = new MemoryStream())
                    {
                        using (var imageFactory = new ImageFactory(preserveExifData: true))
                        {
                            var res = imageFactory.Load(inStream)
                                 .Resize(size)
                                 .Quality(quality)
                                 .Save(generatedMedFile);
                        }
                    }
                }
            }
            headerImage_medium = generatedMedFile;
        }
    }
    catch (Exception ex)
    {
        // throw ex.InnerException;
    }

    // End Header Section

   
    
    var chest = children?.Where(c => c.ContentType.Alias.ToLower() == "herochest").FirstOrDefault();
    var heroBody = (HeroBody)children?.Where(c => c.ContentType.Alias.ToLower() == "herobody").FirstOrDefault();
    var heroBodyTabGroup = heroBody.Children?.Where(c => c.ContentType.Alias.ToLower() == "tabgroup").FirstOrDefault();
    var videoLanding = heroBodyTabGroup.Children?.Where(c => c.ContentType.Alias.ToLower() == "tabheader").FirstOrDefault();

    var pageBlurp = videoLanding.Value("ebankITIconContent");
    var _schemaDescriptionBody = System.Text.RegularExpressions.Regex.Replace(pageBlurp.ToString(), "<.*?>", String.Empty);


    var videoItem = videoLanding.Children.Where(c => c.ContentType.Alias.ToLower() == "tabbody").FirstOrDefault();

    var video_card = heroBody.Children?.Where(c => c.Name == "Video card").FirstOrDefault();
    var styleAtt = "";
    if (video_card != null)
    {
        styleAtt = video_card.Children.Where(c => c.Name == "Style").FirstOrDefault().Value("text").ToString();
    }
    //Current.PublishedContentRequest.PublishedContent

    IPublishedContent CurrentPage = UmbracoContext.PublishedRequest.PublishedContent;
    var viewName = CurrentPage.Name.Replace(" ", ""); //used mainly to identify the page
    TabGroup tabGroups = null;
    
    if (viewName == "growforit1")
    {
        var _heroHeader = children?.Where(c => c is HeroHeader).FirstOrDefault();
        tabGroups = (TabGroup)_heroHeader.Children?.Where(c => c.Name == "Partial").FirstOrDefault() as ContentModels.TabGroup;
    }

    var content = videoItem.Value<IEnumerable<IPublishedElement>>("tabBodyContent");
    var videos = content.Where(c => c.ContentType.Alias == "nCTabGenericContent").FirstOrDefault().Value<IEnumerable<IPublishedElement>>("sectionContent");
    var x = 1;

    // Take 1 vid and send it to Schema
    var _schemaCarddescription = videos.FirstOrDefault().Value("NCshortcardDescription");
    var _schemaCardDescriptionFriendly = System.Text.RegularExpressions.Regex.Replace(_schemaCarddescription.ToString(), "<.*?>", String.Empty);
    var _schemaDescription = videos.FirstOrDefault().Value("NCcardDescription");
    var _schemaIimg = videos.FirstOrDefault().Value<IPublishedContent>("NCcardIcon").Url;
    String _schemaImgString = currentDirectory + _schemaIimg.ToString();
    var _schemaMetaData = videos.FirstOrDefault().Value("NCcardMetaData");
    var _schemaVideoUrl = currentDirectory + videos.FirstOrDefault().Value("NCcardTitle").ToString();

    bool isGrowForIt1 = false;
    String videoUrl = "";
}


@section scripts{


    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "VideoObject",
      "name": "@_schemaCardDescriptionFriendly",
      "description": "@_schemaDescriptionBody",
      "thumbnailUrl": [ "@_schemaImgString" ],
      "uploadDate": "2020-09-03T08:00:00+08:00",
      "duration": "PT2M18S",
      "contentUrl": "@_schemaVideoUrl",
      "interactionStatistic": {
        "@@type": "InteractionCounter",
        "interactionType": { "@@type": "http://schema.org/WatchAction" },
        "userInteractionCount": 56
      }
    }
    </script>
    <script type="text/javascript">

        function assignImageFlip(e) {
            var image = $(".hero-static-banner");

            image.fadeOut(1000, function () {
                if (typeof(e.originalEvent) !== "undefined" ) {
                    if (e.originalEvent.toElement.style.cssText !== "") {

                        if (e.originalEvent.toElement.style.cssText.split(":")[1] !== null) {
                                var urlPath = e.originalEvent.toElement.style.cssText.split(":")[1].split('"')[1];
                                image.css('background-image', 'url(' + urlPath + ')');
                                image.fadeIn(1000);
                            } else {
                                image.css('background-image', 'url(' + '@headerImage_large' + ')');
                                image.fadeIn(1000);
                            }

                    } else {
                        image.css('background-image', 'url(' + '@headerImage_large' + ')');
                        image.fadeIn(1000);
                        }
                } else {
                        image.css('background-image', 'url(' + '@headerImage_large' + ')');
                        image.fadeIn(1000);
                }
            });
        }

        $(document).ready(function () {

            $(".fa-play").on("click", function (e) {

                if (e.originalEvent.path !== "") {
                    var video = $('.videoPlatformPlayer')[0];
                    var videoPath = null;
                    videoPath = e.originalEvent.path[3].dataset.video.split("*")[0];

                    var path ='@currentDirectory' + videoPath.trim() + '?autoplay=1';

                    video.src = path;
                    video.load();
                    video.play();

                    $('#generic').modal('show');
                }

                $('#generic').on('hide.bs.modal', function () {

                    var video = $('.videoPlatformPlayer')[0];
                    var videoPath = e.originalEvent.path[3].dataset.video.split("*")[0];

                    var path ='@currentDirectory' + videoPath.trim();

                    video.src = path;
                    video.pause();
                })

            });

            $('.box').click(function(e) {
                /*assignImageFlip(e);*/
            });

            var imageBgCss = "url('" + "@headerImage_large" + "')";
            var imageMdCss = "url('" + "@headerImage_medium" + "')";
            var imageSmCss = "url('" + "@(string.IsNullOrEmpty(headerImage_small) ? headerImage_large : headerImage_small)" + "')";

            var CheckScreenSize;
            (CheckScreenSize = function () {
                var _width = $(window).outerWidth();
                var _height = $(window).outerHeight();
                if (_width < 414) {
                    $("#heroHeader").css("background-image", imageSmCss);
                }
                else {
                    $("#heroHeader").css("background-image", imageBgCss);
                }
            })();
            $(window).resize(CheckScreenSize);
        })

    </script>
    <script src="~/scripts/jquery-ui.js"></script>
    <script src="~/javascripts/reuse/form_validation.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/1000hz-bootstrap-validator/0.11.5/validator.min.js"></script>

}
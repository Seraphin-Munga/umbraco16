<!---------Testimonial part start--------------->
<div class="container text-center">
    <h1 class="ab-test-title">Testimonials</h1>
    <h2 class="test-header">@testimonialsNew.Value("testimonialHeading")</h2>
    <div id="carouselExample" class="carousel slide ab-test-adjust" data-ride="carousel">
        @{
            if (testimonialsNew != null)
            {
                <div class="carousel-inner">
                    @{
                        int newCounter = 0;
                        foreach (var testimonyItem in testimonialsNew.TestimonialItems)
                        {
                            var Avatar = ((ContentModels.Image)((IPublishedContent)testimonyItem.Value("testimonialAvatar"))).Url;
                            <div class="carousel-item @((newCounter == 0) ? "active" : "")">
                                <div class="row h-100">
                                    <div class="col col-sm-3 col-sm-offset-4 overlay-img my-auto align-items-center">
                                        <img class="overlay-img" src="@Avatar" loading="lazy" width="90%" height="100%">
                                    </div>
                                    <div class="col col-sm-7 test-desc w-100">
                                        @testimonyItem.Value("testimonialStory")
                                        <p class="ab-test-border"></p>
                                        <p class="ab-test-footer">@testimonyItem.Value("testimonialName")</p>
                                    </div>
                                </div>
                            </div>
                            newCounter++;
                        }
                    }
                </div>
            }
            <a class="carousel-control-prev" href="#carouselExample" role="button" data-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="sr-only">Previous</span>
            </a>
            <a class="carousel-control-next" href="#carouselExample" role="button" data-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="sr-only">Next</span>
            </a>
        }
    </div>
</div>
<!----------Testimonial part end---------->
</style>

<section class="body">

<section class="container">
    <div class="action-bar">
  <a href="#" class="back-link">
    <span class="arrow">
        <img src="/media/cejji4o3/arrow_back.svg">
    </span> Back
  </a>
  <a href="#" class="contact-btn">Contact us</a>
</div>

</section>


<button class="contact-button">Contact us</button>

<div class="container">
  <div class="alert-banner">
    Please <strong>proceed only if your business is actively registered with Companies and Intellectual Property Commission (CIPC).</strong>
    Businesses that are not registered or in the process of deregistration will not be considered.
  </div>
</div>

<div class="card-container container">
    
  <div class="section-header">Pre-qualification check</div>
  <div class="section-description">
    Please complete the questionnaire below to see if your business may pre-qualify for the small enterprise loan.
    Select the option that best applies to each question and <strong>ensure that all sections are completed.</strong>
  </div>

  <!-- Personal and Business Info -->
  <form class="info-form">
    <div class="input-group">
      <label for="name">Name</label>
      <input type="text" id="name" class="text-input" value="">
    </div>

    <div class="input-group">
      <label for="surname">Surname</label>
      <input type="text" id="surname" class="text-input" value="">
    </div>

    <div class="input-group">
      <label for="email">Email address</label>
      <input type="email" id="email" class="email-input" value="">
    </div>

    <div class="input-group">
      <label for="contact">Contact number</label>
      <input type="text" id="contact" class="text-input" value="">
    </div>

    <div class="input-group" style="flex: 1 1 100%;">
      <label for="business">Registered business name</label>
      <input type="text" id="business" class="text-input" value="">
    </div>
  </form>

  <hr class="divider">

  <!-- Questionnaire Section -->
  <div class="questions-wrapper">

    <div class="question-item">
      <label class="radio-question">Is your business at least 51% black-owned?</label>
      <div class="options-group">
        <label><input type="radio" name="blackOwned" class="radio-input" /> <span class="radio-label-text" >Yes</span></label>
        <label><input type="radio" name="blackOwned" class="radio-input" /> <span class="radio-label-text" >No</span></label>
      </div>
    </div>

    <div class="question-item">
      <label class="radio-question">Is your business 100% owned by South African citizens?</label>
      <div class="options-group">
        <label><input type="radio" name="citizenOwned" class="radio-input" /> <span class="radio-label-text" >Yes</span></label>
        <label><input type="radio" name="citizenOwned" class="radio-input" /> <span class="radio-label-text" >No</span></label>
      </div>
    </div>

    <div class="question-item">
      <label class="radio-question">Are your employees at least 70% South African citizens?</label>
      <div class="options-group">
        <label><input type="radio" name="employeesSA" class="radio-input" /> <span class="radio-label-text" >Yes</span></label>
        <label><input type="radio" name="employeesSA" class="radio-input" /> <span class="radio-label-text" >No</span></label>
      </div>
    </div>

    <div class="question-item">
      <label class="radio-question">Do all non-South African employees have valid work permits?</label>
      <div class="options-group">
        <label><input type="radio" name="permits" class="radio-input" /> <span class="radio-label-text" >Yes</span></label>
        <label><input type="radio" name="permits" class="radio-input" /> <span class="radio-label-text" >No</span></label>
      </div>
    </div>

    <div class="question-item">
      <label class="radio-question">Where is your business located?</label>
      <div class="options-group">
        <label><input type="radio" name="location" class="radio-input" /> <span class="radio-label-text" >Township</span></label>
        <label><input type="radio" name="location" class="radio-input" /> <span class="radio-label-text" >Rural</span></label>
        <label><input type="radio" name="location" class="radio-input" /> <span class="radio-label-text" >Other</span></label>
      </div>
    </div>

    <div class="question-item">
      <label class="radio-question">Does your business have a valid municipal licence?</label>
      <div class="options-group">
        <label><input type="radio" name="municipalLicence" class="radio-input" /> <span class="radio-label-text" >Yes</span></label>
        <label><input type="radio" name="municipalLicence" class="radio-input" /> <span class="radio-label-text" >No</span></label>
        <label><input type="radio" name="municipalLicence" class="radio-input" /> <span class="radio-label-text" >Willing to apply</span></label>
        <label><input type="radio" name="municipalLicence" class="radio-input" /> <span class="radio-label-text" >Not willing to apply</span></label>
      </div>
    </div>

    <div class="question-item">
      <label class="radio-question">What is your business type?</label>
      <div class="options-group">
        <label><input type="radio" name="businessType" class="radio-input" /> <span class="radio-label-text" >Cooperative</span></label>
        <label><input type="radio" name="businessType" class="radio-input" /> <span class="radio-label-text" >Sole proprietor</span></label>
        <label><input type="radio" name="businessType" class="radio-input" /> <span class="radio-label-text" >Private company (Pty) Ltd</span></label>
        <label><input type="radio" name="businessType" class="radio-input" /> <span class="radio-label-text" >Partnership</span></label>
        <label><input type="radio" name="businessType" class="radio-input" /> <span class="radio-label-text" >Other</span></label>
      </div>
    </div>

    <div class="question-item">
      <label class="radio-question">Is your business registered with the CIPC?</label>
      <div class="options-group">
        <label><input type="radio" name="cipc" class="radio-input" /> <span class="radio-label-text" >Yes</span></label>
        <label><input type="radio" name="cipc" class="radio-input" /> <span class="radio-label-text" >No</span></label>
      </div>
    </div>

    <div class="question-item">
      <label class="radio-question">Is your business registered with UIF?</label>
      <div class="options-group">
        <label><input type="radio" name="uif" class="radio-input" /> <span class="radio-label-text" >Yes</span></label>
        <label><input type="radio" name="uif" class="radio-input" /> <span class="radio-label-text" >No</span></label>
        <label><input type="radio" name="uif" class="radio-input" /> <span class="radio-label-text" >Willing to register</span></label>
        <label><input type="radio" name="uif" class="radio-input" /> <span class="radio-label-text" >Not willing to register</span></label>
      </div>
    </div>

    <div class="question-item">
      <label class="radio-question">Is your business registered with SARS?</label>
      <div class="options-group">
        <label><input type="radio" name="sars" class="radio-input" /> <span class="radio-label-text" >Yes</span></label>
        <label><input type="radio" name="sars" class="radio-input" /> <span class="radio-label-text" >No</span></label>
        <label><input type="radio" name="sars" class="radio-input" /> <span class="radio-label-text" >Willing to register</span></label>
        <label><input type="radio" name="sars" class="radio-input" /> <span class="radio-label-text" >Not willing to register</span></label>
      </div>
    </div>

    <div class="question-item" style="flex: 1 1 100%;">
      <label class="radio-question">Does your business have a valid business bank account?</label>
      <div class="options-group">
        <label><input type="radio" name="bankAccount" class="radio-input" /> <span class="radio-label-text" >Yes</span></label>
        <label><input type="radio" name="bankAccount" class="radio-input" /> <span class="radio-label-text" >No</span></label>
        <label><input type="radio" name="bankAccount" class="radio-input" /> <span class="radio-label-text" >Willing to open one</span></label>
        <label><input type="radio" name="bankAccount" class="radio-input" /> <span class="radio-label-text" >Not willing to open one</span></label>
      </div>
    </div>

  </div>

  <hr class="divider">

  <div class="consent-section">
    <label>
      <input type="checkbox" name="marketing" class="checkbox-input"/>
     <span class="marketing-msg">I would like to receive marketing updates from African Bank.</span>
    </label>
    <p style="margin-top: 10px;" class="consent-text">
      By clicking <strong>submit</strong>, I hereby declare that the information provided above is <strong>true and correct.</strong>
    </p>
  </div>

  <div class="submit-wrapper">
    <button class="submit-button">Submit</button>
  </div>

</div>

</section>


<script>
document.addEventListener("DOMContentLoaded", function() {
    const form = document.querySelector(".info-form");
    const inputs = form.querySelectorAll("input[type='text'], input[type='email']");
    const questionItems = document.querySelectorAll(".question-item");
    const contactInput = document.getElementById("contact");

    // Add error messages dynamically under each question
    questionItems.forEach(q => {
        if (!q.querySelector(".error-message")) {
            const errorMsg = document.createElement("div");
            errorMsg.classList.add("error-message");
            errorMsg.textContent = "Select an option";
            q.appendChild(errorMsg);
        }
    });

    // South African phone validation
    const saPhoneRegex = /^(0[6-8]\d{8}|\+27[6-8]\d{8})$/;

    // Validate radio group
    function validateRadioGroup(question) {
        const radios = question.querySelectorAll("input[type='radio']");
        const anyChecked = Array.from(radios).some(r => r.checked);
        if (!anyChecked) {
            question.classList.add("invalid");
        } else {
            question.classList.remove("invalid");
        }
        return anyChecked;
    }

    // Live validation for text/email inputs
    inputs.forEach(input => {
        input.addEventListener("input", () => {
            let isValid = input.checkValidity() && input.value.trim() !== "";

            if (input === contactInput) {
                const value = input.value.trim().replace(/\s+/g, "");
                isValid = saPhoneRegex.test(value);
            }

            input.classList.toggle("invalid-input", !isValid);
        });
    });

    // Live validation for radio buttons
    questionItems.forEach(q => {
        const radios = q.querySelectorAll("input[type='radio']");
        radios.forEach(r => {
            r.addEventListener("change", () => {
                validateRadioGroup(q);
            });
        });
    });

    // On submit validation
    const submitButton = document.querySelector(".submit-button");
    submitButton.addEventListener("click", e => {
        e.preventDefault();
        let valid = true;

        // Validate inputs
        inputs.forEach(input => {
            let isValid = input.checkValidity() && input.value.trim() !== "";
            if (input === contactInput) {
                const value = input.value.trim().replace(/\s+/g, "");
                isValid = saPhoneRegex.test(value);
            }

            input.classList.toggle("invalid-input", !isValid);
            if (!isValid) valid = false;
        });

        // Validate radios
        questionItems.forEach(q => {
            if (!validateRadioGroup(q)) valid = false;
        });

        if (valid) {
            alert("Form submitted successfully!");
            form.reset();
            inputs.forEach(i => i.classList.remove("invalid-input"));
            questionItems.forEach(q => q.classList.remove("invalid"));
        } else {
            alert("Please complete all required fields correctly.");
        }
    });
});
</script>




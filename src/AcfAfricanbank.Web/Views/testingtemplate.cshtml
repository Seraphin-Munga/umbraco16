    font-size: 18px;
    font-style: normal;
    font-weight: 400;
    line-height: 28px; /* 155.556% */
  }

  .info-form {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }

  .input-group {
    flex: 1 1 45%;
    display: flex;
    flex-direction: column;
  }

  label {
    font-weight: 600;
    margin-bottom: 2px;
    font-size: 14px;
    color: #002a61;
  }

  .text-input,
  .email-input {
    padding: 10px;
    border: 1px solid #ccc;
    border-radius: 6px;
    font-size: 14px;

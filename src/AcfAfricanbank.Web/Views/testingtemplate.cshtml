@inherits Umbraco.Web.Mvc.UmbracoViewPage
@{
	Layout = null;
}

@* the fun starts here *@

<style>
  .body {
    font-family: Montserrat;
    background-color: #fff;
    margin: 0;
    padding: 0;
    color: #002B60;
  }

/**/

label{
    text-transform: none;
}

.marketing-msg{
    left: 10px;
    bottom: 8px;
    position: relative;
}

.consent-text{
    color: var(--Brand-AB-Blue, #012B60);

    /* Body/Medium/Regular */
    font-family: Montserrat;
    font-size: 16px;
    font-style: normal;
    font-weight: 400;
    line-height: 24px; /* 150% */
}

.consent-section strong {
    color: #012B60 !important;
}

.radio-question{
    color: var(--text-primary-blue, #002B60);

    /* Body/Medium/Semibold */
    font-family: Montserrat;
    font-size: 16px;
    font-style: normal;
    font-weight: 600;
    line-height: 24px; /* 150% */
}

input[type="radio"], input[type="checkbox"] {
    width: 24px;
    height: 24px;
    margin: -4px 0 0;
    margin-top: 1px \9;
    line-height: normal;
}


.radio-label-text{
    color: var(--text-primary-blue, #002B60);
    margin-left: 10px;
    /* Body/Medium/Regular */
    font-family: Montserrat;
    font-size: 16px;
    font-style: normal;
    font-weight: 400;
    line-height: 24px; /* 150% */
}

  /* Invalid input styling */
  .invalid-input {
    border: 2px solid red !important;
  }

  /* Radio buttons default appearance */
.options-group {
  gap: 24px;
  align-items: center;
}

/* Hide native radio */
.radio-input {
  appearance: none;
  -webkit-appearance: none;
  -moz-appearance: none;
  width: 22px;
  height: 22px;
  border: 2px solid #7ed321;
  border-radius: 50%;
  display: inline-block;
  position: relative;
  margin-right: 8px;
  vertical-align: middle;
  cursor: pointer;
  transition: all 0.2s ease;
}

/* Inner green dot when checked */
.radio-input:checked::before {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  width: 12px;
  height: 12px;
  background-color: #7ed321;
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

/* Hover effect (optional) */
.radio-input:hover {
  box-shadow: 0 0 0 3px rgba(126, 211, 33, 0.2);
}

/* Label styling */
.options-group label {
  cursor: pointer;
  display: flex;
  align-items: center;
  color: var(--text-primary-blue, #002B60);
  font-family: Montserrat;
  font-size: 16px;
  font-style: normal;
  font-weight: 400;
  line-height: 24px;
}


  /* Checked radio appearance */

input[type="file"]:focus, input[type="radio"]:focus, input[type="checkbox"]:focus {
    outline: none !important; 
    outline-offset: none !important; 
}
  /* Invalid radio outline (red border only) */
  .question-item.invalid .radio-input:not(:checked) {
    border-color: red !important;
  }

  /* Red “select an option” text */
  .error-message {

    margin-top: 5px;
    display: none;
    color: var(--text-error, #D92020);

    /* Body/Medium/Regular */

    font-size: 16px;
    font-style: normal;
    font-weight: 400;
    line-height: 24px; /* 150% */
  }

  .question-item.invalid .error-message {
    display: block;
  }
  
  
  /**/
.action-bar {
  height: 112px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #ffffff;
  padding: 0 0px;
  box-sizing: border-box;
}

.arrow{
    margin-top: -2px;
}

.back-link {

  color: #002e6d; /* African Bank blue */
  text-decoration: none;
  display: flex;
  align-items: center;
  gap: 6px;
  color: var(--text-primary-blue, #002B60);

font-size: 14px;
font-style: normal;
font-weight: 600;
line-height: 20px; /* 142.857% */
}

.back-link:hover {
  text-decoration: underline;
}

.contact-btn {
  display: inline-flex; /* ✅ enables centering */
  justify-content: center;
  align-items: center;

  width: 220px;
  height: 48px;
  padding: 0 16px;
  gap: 8px;
  flex-shrink: 0;

  font-size: 16px;
  font-weight: 600;
  color: #002e6d;
  text-decoration: none;

  border-radius: var(--border-radius-md, 2px);
  border: 1px solid var(--border-green, #5DC400);
  background: var(--surface-white, #FFF);

  box-shadow: 0 2px 4px 0 rgba(0, 0, 0, 0.08);
  transition: all 0.2s ease;
}

/* Optional hover/focus state */
.contact-btn:hover,
.contact-btn:focus {
  background-color: #5DC400;
  color: #fff;
  text-decoration: none;
}

  
    /* Input invalid state */
  .invalid-input {
      border-color: red !important;
  }

  .card-container {

    margin: 50px auto;
    background-color: #fff;
    padding: 48px;
    border-radius: 0px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    position: relative;
  }

  .alert-banner {
    background-color: #e8f3ff;
    padding: 20px 8px;
    margin-bottom: 30px;
    margin-top: 10px;
    color: #003366;
    border-radius: 8px;
    font-size: 14px;
    line-height: 1.5;
  }

  .alert-banner strong {
    color: #002a61;
  }

  .section-header {
   
    margin-bottom: 48px;
    color: var(--Brand-AB-Blue, #012B60);

    /* Heading/H4/Semibold */

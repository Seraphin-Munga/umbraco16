<script>
    $(document).ready(function () {
        $("#myTabs a").click(function (e) {
            e.preventDefault();

            // Remove "active" class from all tabs
            $("#myTabs a").removeClass("active");
            $(".tab-content > div").removeClass("in active");

            // Add "active" class to the clicked tab
            $(this).addClass("active");

            // Show the corresponding tab content
            $($(this).attr("href")).addClass("in active");
        });

    

     
    });
</script>
<script>
$(document).ready(function(){
     $(".partnershipheading").click(function ()
        {
            $(".parnership").css("display", "block");
            $(".banking").css("display", "none");
        });
        
    $(".banking-heading").click(function ()
        {
            $(".banking").css("display", "block");
            $(".parnership").css("display", "none");
        });
   
});
</script>

    <script>
        $(document).ready(function () {
            var imageBgCss = "url('" + "@headerImage_large" + "')";
            var imageMdCss = "url('" + "@headerImage_medium" + "')";
            var imageSmCss = "url('" + "@(string.IsNullOrEmpty(headerImage_small) ? headerImage_medium : headerImage_small)" + "')";
            var CheckScreenSize;
            (CheckScreenSize = function () {
                var _width = $(window).outerWidth();
                var _height = $(window).outerHeight();
                if (_width <= 511) {
                    $("#heroHeader").css("background-image", imageSmCss);
                }
                else {
                    $("#heroHeader").css("background-image", imageBgCss);
                }
            })();
            $(window).resize(CheckScreenSize);
        });

         
    </script>
    
 
}




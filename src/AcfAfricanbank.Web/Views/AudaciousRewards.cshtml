<section class="audacious-reawards-section">
    @*HERO BANNER*@
    @Html.Partial("_pageHeaderImage", heroHeader as ContentModels.HeroHeader)

    @Html.Partial("_pageShoulderNew", heroShoulder1 as ContentModels.HeroShoulder)

    <div class="campaign-more-container">
        <div class="container audacious-container">

            <div>

                @*HERO SHOULDER*@

                @{
                    var heroShoulder = (HeroShoulderHome)children?.Where(c => c.ContentType.Alias.ToLower() == "heroshoulderhome").FirstOrDefault();

                    if (heroShoulder != null)
                    {
                        <div class="loan-summary-container">
                            <div class="container">
                                <div class="mega-tabs">
                                    @*Nav tabs*@
                                    <ul id="go_to_tab_content" class="nav nav-tabs eq-height" role="tablist">
                                        @{
                                            var isFirstRow = true;
                                            foreach (HomeShoulderItem tab in heroShoulder.Items)
                                            {

                                                <li role="presentation" class="@(isFirstRow ? "active" : "") loan-summary ">
                                                    <a href="#@tab.TabId.Replace(" ", "").Replace(",", "").Replace("%","")" aria-controls="profile " role="tab" data-toggle="tab">
                                                        <span class="tablename-content" style="position: relative;bottom: -19px;">@tab.TabName</span>
                                                        <br /><br
                                                    <span class="tableid-content">@tab.TabId</span><br />
                                                       </a>
                                                    <span class="tableheading-content">@tab.TabHeading</span>
                                                </li>
                                                isFirstRow = false;
                                            }
                                        }
                                    </ul>
                                </div>
                                <!-- Tab panes -->

                                <div class="tab-content">
                                    @{
                                        bool isFirstTab = true;
                                        foreach (HomeShoulderItem tab in heroShoulder.Items)
                                        {
                                            <div role="tabpanel" class="tab-pane @(isFirstTab ? "active" : "")" id="@tab.TabId.Replace(" ", "").Replace(",", "").Replace("%","")">



                                                <div class="row">

                                                    @{
                                                        var item2 = tab.Value<IEnumerable<IPublishedElement>>("tabBodyContent").FirstOrDefault();
                                                    }


                                                    @if (item2 != null)
                                                    {
                                                        <div class="col-sm-10 col-sm-offset-1">
                                                            <div class="campaign-list">
                                                                @{
                                                                    var data = item2.Value<IEnumerable<IPublishedElement>>("sectionContent");
                                                                }
                                                                @foreach (var item in data)
                                                                {
                                                                    var image = item.Value("tabSubItemImage");
                                                                    String url = ((IPublishedContent)image).Url.ToString();
                                                                    String altTag = ((IPublishedContent)image).Value("altTag").ToString();

                                                                    <div class="col-sm-6 banner-image-section img-heigt circle-img">
                                                                        <img class="circle-img-banner " src="@url" alt="@altTag" />

                                                                    </div>


                                                                    <div class="col-sm-10 desc-tab banner-right move-content-left">
                                                                        <div class="article-content">
                                                                            <div class="body-content ul-bullets">
                                                                             @Html.Raw(item.Value("tabSubItemTextContent"))
                                                                            </div>
                                                                        </div>
                                                                        @foreach (var link in (IEnumerable<Umbraco.Web.Models.Link>
                                                                            )item.Value("tabSubItemLinks"))
                                                                        {
                                                                            if (link.Name.Contains("Register") || link.Name.Contains("Join African Bank"))
                                                                            {
                                                                                <div class="ctabuttons">
                                                                                    <div>
                                                                                        <a class="button primary span-buttons" href="@link.Url" target="_blank" style="color: white;">@link.Name</a>
                                                                                    </div>
                                                                                </div>
                                                                            }
                                                                            else if (link.Name.Contains("Learn more MyWORLD"))
                                                                            {
                                                                                <div class="ctabuttons">
                                                                                    <div>
                                                                                        <a class=" download-guide button primary span-buttons " href="@link.Url" target="_blank" style="color: white;">@link.Name</a>
                                                                                    </div>
                                                                                </div>

                                                                            }
                                                                        }
                                                                    </div>


                                                                }
                                                            </div>
                                                        </div>


                                                    }


                                                </div>
                                            </div>
                                            isFirstTab = false;
                                        }

                                    }
                                </div>

                            </div>
                        </div>
                    }
                }

            </div>
        </div>
    </div>

    <div class="infoGraphic-container">
   <video class="desktop-video" width="100%" height="540" loop muted autoplay="autoplay">
      <source src="/media/ntafkpe3/01-african-bank-animation.mp4" type="video/mp4">
      <source src="/media/ntafkpe3/01-african-bank-animation.mp4" muted type="video/mp4">
    </video>

   <video class="mobile-video" width="100%" height="540" loop muted autoplay="autoplay">
      <source src="/media/mnukqjsi/01-african-bank-animation-mobile.mp4" type="video/mp4">
      <source src="/media/mnukqjsi/01-african-bank-animation-mobile.mp4" type="video/mp4">
    </video>
    </div>

    @Html.Partial("_pageRenderAudaciousRewards", tabBody as ContentModels.TabBody)
    
      @* @Html.Raw(@heroBody.Value("richTextBox"))*@
   
   
 
   
      <div class="row hero-fqs">
          
        @* Start here *@
        @{
                var groups = (IEnumerable<QuestionGroup>)questionGroups;
                int intCounter = 0;
                foreach (var group in groups)
                {
                    var questions = group.Value<IEnumerable<IPublishedElement>>("questionsAndAnswers") ?? new List<IPublishedContent>();
                    // var Id = Regex.Replace(name.Replace("African Bank", string.Empty), @"[^0-9a-zA-Z]+", string.Empty);
                    
                    foreach (var question in questions)
                    {
                        var Q = question.Value("question");
                        var A = question.Value("answer");

                        if (intCounter == 1) {

                            <div class="faq-item searchItemList">
                                <div class="item-content">
                                    <h4 class="title text-uppercase">
                                        @Q
                                    </h4>
                                    <div class="faq content">
                                        @A
                                    </div>
                                </div>
                                @*<div class="download-icon faq-button"><i class="fas fa-long-arrow-alt-down" aria-hidden="true"></i></div>*@
                            </div>
                            <div class="col-lg-12 col-md-12">
                                <img src="@applyDocs" />
                            </div>
                        } 
                        else
                        {
                             <div class="faq-item searchItemList" ng-show="stringContains('@Q', searchTerm)">
                                <div class="item-content">
                                    <h4 class="title text-uppercase">
                                        @Q
                                    </h4>
                                    <div class="faq content">
                                        @A
                                    </div>
                                </div>
                                @*<div class="download-icon faq-button" onclick="toggleFAQ(this)"><i class="fa fa-long-arrow-down" aria-hidden="true"></i></div>*@
    
                                <div class="download-icon faq-button"><i class="fas fa-long-arrow-alt-down" aria-hidden="true"></i></div>
                             </div>
                         }
                        intCounter+=1;
                    }
                    
                }
            }
        @* End here *@
          
         
     </div>

    <div class="check-class-name">

        <div class="inner-check">
            @Html.Raw(mobileBlurp)

            <div class="row">
                <div class="col-sm-6">
                    <a class="button primary span-buttons audacious-reward-btn" href="/media/k1kfzq1n/audacious-rewards-terms-and-conditions-v3-1.pdf" target="_blank">Terms & Conditions</a>
                </div>

                <div class="col-sm-6">
                    <a class="button primary span-buttons audacious-reward-btn " href="/media/lzdjob2v/mlp2-faq-s-ss-edit-050122.pdf" target="_blank">Audacious Rewards FAQs</a>

                </div>
            </div>
        </div>



    </div>

  

    <div class="online-banking-container">

        <div class="container">

        </div>
    </div>

    var heroShoulder1 = children?.Where(c => c.ContentType.Alias.ToLower() == "heroshoulder").FirstOrDefault();

    var heroBody = (HeroBody)children?.Where(c => c.ContentType.Alias.ToLower() == "herobody").FirstOrDefault();


    var cardImageDescriptions = heroBody.Children(x => x is Card).ToList();
    var bodyCards = heroBody.Children.Where(c => c.ContentType.Alias.ToLower() == "card").FirstOrDefault();
    var applyDocs = bodyCards.Value("cardIcon"); // ?.Select(c => c as Card).FirstOrDefault();
    
    
    //  var cardImage = applyDocs.Value("cardIcon");
    // Get Properties from children
    var tableItems = heroBody.Children(x => x is TableChecklist).FirstOrDefault();


    var tabGroup = heroBody.Children(x => x.ContentType.Alias.ToLower() == "tabgroup").FirstOrDefault();
    var tabHeader = tabGroup.Children(xx => xx.ContentType.Alias.ToLower() == "tabheader").FirstOrDefault();
    var tabBody = (TabBody)tabHeader.Children(cc => cc.ContentType.Alias.ToLower() == "tabbody").First();
    var tabBodyFAQSections = (TabBody)tabHeader.Children(cc => cc.ContentType.Alias.ToLower() == "tabbody").Last();

    var sectionContent = (ICollection<IPublishedElement>)tabBodyFAQSections.TabBodyContent.Where(c => c.ContentType.Alias == "nCTabGenericContent").FirstOrDefault().Value("sectionContent");
    var questionGroups = sectionContent.Where(c => c.ContentType.Alias == "nCHeroBodyFaq").FirstOrDefault().Value("nCquestionGroups");
    
    var mobileBlurpData = heroBody.Children(x => x.ContentType.Alias.ToLower() == "richtexteditor").FirstOrDefault();
    var mobileBlurp = mobileBlurpData.Value("TextEditor");
}


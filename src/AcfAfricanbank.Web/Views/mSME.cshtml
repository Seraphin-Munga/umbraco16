<!-- Cards logic -->
<script>
(function($){
  $(function(){
    var $viewport = $('#carouselViewport');
    var $cards = $('#cardCustomListitemsTrack').children('.cardCustomListitem');
    var $dots = $('#cardCustomListitemsDots');

    // create dots
    $cards.each(function(i){
      var $btn = $('<button type="button" role="tab" aria-pressed="'+(i===0)+'"></button>');
      $btn.on('click', function(){
        $cards.eq(i)[0].scrollIntoView({ behavior: 'smooth', inline: 'start' });
        $dots.children().attr('aria-pressed','false').eq(i).attr('aria-pressed','true');
      });
      $dots.append($btn);
    });

    // update dots on scroll
    $viewport.on('scroll', function(){
      var viewportLeft = $viewport.scrollLeft();
      var closestIndex = 0;
      var minDiff = Infinity;

      $cards.each(function(i){
        var cardLeft = $(this).position().left + viewportLeft;
        var diff = Math.abs(cardLeft - viewportLeft);
        if(diff < minDiff){ minDiff = diff; closestIndex = i; }
      });

      $dots.children().attr('aria-pressed','false').eq(closestIndex).attr('aria-pressed','true');
    });
  });
})(jQuery);
</script>


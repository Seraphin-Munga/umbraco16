        };

        // Encrypt the data before sending
        const encryptedData = encryptData(obj);

        $.ajax({
            url: 'https://prod-49.westeurope.logic.azure.com:443/workflows/ef87a171855f4bddaebbd8708d43e51b/triggers/manual/paths/invoke?api-version=2016-06-01&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=Ue4vqqv6Ra_XOGFJSvmCir5ccu0w-UmOl9ZcQ_ynrUk',

function displaySelectedValues(selectedValues) {
    // Clear previous content
    $('#selected-values-display').empty();

    // Iterate through each dropdown and its selected values
    $.each(selectedValues, function(dropdownId, values) {
        if (values.length > 0) {
            // Append dropdown header
            $('#selected-values-display').append('<h4>' + dropdownId + ' :</h4>');
            
            // Create a new unordered list for the values
            const ul = $('<ul></ul>');

            // Iterate through selected values and append them as list items
            $.each(values, function(index, value) {
                ul.append('<li>' + value + '</li>');
            });

            // Append the list to the display container
            $('#selected-values-display').append(ul);
        }
    });
}

document.addEventListener("DOMContentLoaded", function() {
        const idRadio = document.getElementById('idType');
        const passportRadio = document.getElementById('passportType');
        const saidInput = document.getElementById('SAIDInput');

        // Event listener for radio buttons
        idRadio.addEventListener('change', function() {
            if (this.checked) {
                updateValidation('ID');
            }
        });

        passportRadio.addEventListener('change', function() {
            if (this.checked) {
                updateValidation('Passport');
            }
        });

        function updateValidation(type) {
            if (type === 'ID') {
                saidInput.setAttribute('maxlength', '13');
                saidInput.setAttribute('pattern', '\\d{13}');
                saidInput.setAttribute('placeholder', 'Enter 13-digit ID number');
                saidInput.setAttribute('title', 'ID number must be 13 digits');
                saidInput.setAttribute('minlength', '13');
                saidInput.setAttribute('maxlength', '13');
            } else {
                saidInput.setAttribute('maxlength', '20');
                saidInput.setAttribute('pattern', '.{6,20}');
                saidInput.setAttribute('placeholder', 'Enter Passport number');
                saidInput.setAttribute('title', 'Passport number must be between 6 and 20 characters');
                saidInput.removeAttribute('minlength');
            }
        }

        // Initial validation setup based on default selection
        if (idRadio.checked) {
            updateValidation('ID');
        } else if (passportRadio.checked) {
            updateValidation('Passport');
        }
    });
    
    
    


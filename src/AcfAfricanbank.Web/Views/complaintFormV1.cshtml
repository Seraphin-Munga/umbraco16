            // Function to initialize dropdowns
            function initializeDropdowns() {
                $('#ApplicationType').change(handleApplicationTypeChange);
    
                $('.custom-dropdown .dropdown-toggle').on('click', function() {
                    $(this).next('.checkbox-dropdown').toggleClass('show');
                    $('.custom-dropdown .dropdown-toggle').css({ 'margin': '0px 0px 15px 0px' });
                });
    
                $('.checkbox-dropdown input[type="checkbox"]').on('change', function() {
                    updateDropdownText($(this));
                });
            }
    
            function showAlert(type, icon, title, message) {
                const alertContainer = $('#customAlert');
                alertContainer.removeClass('alert-success alert-warning alert-danger');
                alertContainer.addClass(type);
                $('.alert-icon').html(icon);
                $('.alert-title').text(title);
                $('.alert-message').text(message);
                alertContainer.fadeIn();
            }
    
            function hideAlert() {
                $('#customAlert').fadeOut();
            }
    
            function alertSuccess(message) {
                showAlert('alert-success', '&#10004;', 'Success', message);
                setTimeout(hideAlert, 13000);
            }
    
            function alertWarning(message) {
                showAlert('alert-warning', '&#9888;', 'Warning', message);
                setTimeout(hideAlert, 3000);
            }
    
            function alertDanger(message) {
                showAlert('alert-danger', '&#10060;', 'Danger', message);
                setTimeout(hideAlert, 3000);
            }
    
            $('#alertOkBtn').on('click', function() {
                hideAlert();
            });
    
            function handleApplicationTypeChange() {
                const selectedValue = $(this).val();
                $('.application-type-dropdown-type2').hide();
                if (['ProductOrService', 'ServiceAdvice', 'CustomerService', 'ProductOrServiceAccess'].includes(selectedValue)) {
                    $('#' + selectedValue).show();
                    $('.application-type-dropdown').css({ 'margin': '0px 0px 15px 0px' });
                } else {
                    $('.d-flex').css({ 'display': 'block' });
                }
            }
    
function updateDropdownText(checkbox) {
    let selected = [];
    checkbox.closest('.checkbox-dropdown').find('input[type="checkbox"]:checked').each(function() {
        selected.push($(this).parent().text().trim());
    });

    let text = selected.length > 0 ? selected.join(', ') : 'Choose Option';

    const maxLength = 50;
    if (text.length > maxLength) {
        text = text.substring(0, maxLength) + '...';
    }

    checkbox.closest('.custom-dropdown').find('.dropdown-toggle').text(text);
}

            function initializeFileUploads() {

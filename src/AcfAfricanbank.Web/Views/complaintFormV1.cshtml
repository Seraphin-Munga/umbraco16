                    }
                }
            
                return JSON.stringify(result.keysWithValues);
            }
            

// A simple XOR function to "encrypt" the string with a key
function xorEncrypt(input, key) {
    let output = "";
    for (let i = 0; i < input.length; i++) {
        output += String.fromCharCode(input.charCodeAt(i) ^ key.charCodeAt(i % key.length));
    }
    return output;
}

// Encrypt the data object using the XOR method, then encode with Base64
function encryptData(data) {
    const secretKey = "your-secret-key"; // Use a strong key
    // Convert the data to a JSON string
    const dataStr = JSON.stringify(data);
    // Encrypt the string with XOR
    const xorEncrypted = xorEncrypt(dataStr, secretKey);
    // Encode the result using Base64 so it can be safely sent in JSON
    return btoa(xorEncrypted);
}


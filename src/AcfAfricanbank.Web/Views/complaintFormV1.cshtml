}

.checkbox-dropdown .dropdown-item {
  display: flex;
  align-items: flex-start;
  overflow: hidden;
  padding-right: 10px; /* Adjust padding to add some space */
}

.checkbox-dropdown .dropdown-item input[type="checkbox"] {
  flex-shrink: 0; /* Prevents the checkbox from shrinking */
  margin-right: 10px; /* Adds space between the checkbox and text */
}

.text-content {
  display: inline-block;
  overflow: hidden;
  text-indent: -18px; /* Indents text to align with the checkbox */
  padding-left: 18px; /* Adds padding equal to the text-indent to create space for the checkbox */
  max-width: 100%; /* Ensures the text does not overflow */
  word-break: break-word; /* Breaks long words to prevent overflow */
}

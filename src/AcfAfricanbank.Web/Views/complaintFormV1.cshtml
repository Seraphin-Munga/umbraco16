function handleNextStep(button) {
    const currentStep = parseInt(button.closest('.claim-step-content').attr('data-step'));
    handleStepData(currentStep);

    if (currentStep === 1 || currentStep === 2) {
        if (!validateStep(currentStep)) return;
    }

    const nextStep = currentStep + 1;

    if (currentStep === 4) {
        // Check if the checkbox is checked
        if (!$('#disclaimer').is(':checked')) {
            alertDanger('Please check the disclaimer to proceed.');
            return; // Prevent moving to the next step if not checked
        }

        postFormData().then((success) => {
            if (success) {
                updateStep(nextStep);
            } else {
                alertDanger('Form submission failed. Please try again.');
            }
        });
    } else {
        updateStep(nextStep);

        // Check if transitioning to step 3
        if (nextStep === 3) {
            logAllFormData();
            populateStep3(formValue);
            logAllFormData();

            // Populate selectedValues in step 3
            displaySelectedValues(selectedValuesStore);
        } else if (nextStep === 4) {
            logAllFormData();
            populateStep4(formValue);
        }
    }
}



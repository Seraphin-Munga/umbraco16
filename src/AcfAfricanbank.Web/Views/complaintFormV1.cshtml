    .custom-dropdown {
        position: relative;
    }


.custom-dropdown .dropdown-toggle {
    margin-bottom: 10px;
    background: white;
    width: 100%;
    padding: 10px;
    border-radius: 30px !important;
    border: none;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    transition: box-shadow 0.3s ease-in-out;
    text-align: left;
    position: relative; /* Allows positioning of the icon */
}

.custom-dropdown .dropdown-toggle .fa,
.custom-dropdown .dropdown-toggle .dropdown-icon {
    position: absolute;
    right: 15px; /* Distance from the right edge of the button */
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none; /* Prevents the icon from capturing clicks */
    font-size: 12px; /* Adjust icon size as needed */
    color: #333; /* Color of the icon */
}

    .custom-dropdown .dropdown-menu {
        width: 100%;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }


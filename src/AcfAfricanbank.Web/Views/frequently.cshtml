@section scripts
{

<script>
    $(document).ready(function () {
        // Show More / Show Less Toggle
        $(".toggleMoreLess").click(function () {
            var groupId = $(this).data("group-id");
            var escapedGroupId = CSS.escape(groupId);
            var moreItems = $("#" + escapedGroupId + " #moreFaqItems");

            if (moreItems.is(":visible")) {
                moreItems.slideUp();
                $(this).text("Show More");
            } else {
                moreItems.slideDown();
                $(this).text("Show Less");
            }
        });

        // Accordion Collapse Toggle
        $(".accordion-button").click(function () {
            var isCollapsed = $(this).hasClass('collapsed');
            $(".accordion-button").removeClass('collapsed');

            if (!isCollapsed) {
                $(this).toggleClass("collapsed");
            }

            var isCollapsedContent = $(this).parent().next(".accordion-collapse").hasClass('collapse');
            $(".accordion-collapse").addClass('collapse');
            if (isCollapsedContent) {
                $(this).parent().next(".accordion-collapse").toggleClass('collapse');
            }
        });

        // Category Change Handler
        $("#cmbCategories").change(function () {
            var selected = $("#cmbCategories option:selected").val();
            $('.sectionHeading').each(function () {
                if (selected === 'allcategories' || selected === '') {
                    $(this).show();
                } else {
                    $(this).toggle($(this).context.id === selected);
                }
            });
        });

        // Input Length Check for SearchKeyUp
        $('#SearchKeyUp').on('keyup', function () {
            var inputLength = $(this).val().length;
            console.log("Input length: " + inputLength);

            // Trigger "Show Less" if inputLength > 0
            if (inputLength > 0) {
                $('.toggleMoreLess').each(function () {
                    var groupId = $(this).data("group-id");
                    var escapedGroupId = CSS.escape(groupId);
                    var moreItems = $("#" + escapedGroupId + " #moreFaqItems");

                    if (!moreItems.is(":visible")) {
                        moreItems.slideDown();
                        $(this).text("Show Less").css("display", "none"); 
                    }
                });
            }
        });
    });
</script>

   

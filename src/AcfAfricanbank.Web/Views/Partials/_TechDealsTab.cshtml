             $('.sortoption').click(function () {  //code for sorting based on price and space
                
                 var selectedValue = $(this).text();
                  if(selectedValue !== "")
                  {
                 var cardList = $('.my-offer-devices.active'); 
                 var cards = cardList.find('.FirstTab , .category-device-list');
                  $("#sortDropdown").text(selectedValue);
                 cards.detach();
                 // Sort the cards based on the selected value
            if (selectedValue === 'Price: Low-High') {
                cards.sort(function (a, b) {
                    var priceA = parseFloat($(a).find('.price').text().replace(/[^\d.-]/g, ''));
                    var priceB = parseFloat($(b).find('.price').text().replace(/[^\d.-]/g, ''));
                    return priceA - priceB;
                });
            } else if (selectedValue === 'Price: High-Low') {
                cards.sort(function (a, b) {
                    var priceA = parseFloat($(a).find('.price').text().replace(/[^\d.-]/g, ''));
                    var priceB = parseFloat($(b).find('.price').text().replace(/[^\d.-]/g, ''));
                    return priceB - priceA;
                });
            }
            else if (selectedValue === 'Storage: High-Low') {
                cards.sort(function (a, b) {
                    var storageA = parseFloat($(a).find('.storage').text().replace(/[^\d.-]/g, ''));
                    var storageB = parseFloat($(b).find('.storage').text().replace(/[^\d.-]/g, ''));
                    return storageB - storageA;
                });
            }
            else if (selectedValue === 'Storage: Low-High') {
                cards.sort(function (a, b) {
                    var storageA = parseFloat($(a).find('.storage').text().replace(/[^\d.-]/g, ''));
                    var storageB = parseFloat($(b).find('.storage').text().replace(/[^\d.-]/g, ''));
                    return storageA - storageB;
                });
            }
            
                // Re-arrange the sorted cards in the cardList
                    cardList.empty();
                    cards.each(function () {
                        cardList.append($(this));
                    });
                  }

@inherits Umbraco.Web.Mvc.UmbracoViewPage
<style type="text/css">
    .container-body {
        box-shadow: 0 2px 6px 0 rgba(69,73,91,.08);
        margin-top: 10px;
        height: inherit;
        position: relative;
        text-align: center;
    }
    .quick-offer-content {
        padding-bottom: 25px;
    }
    .quick-offer-smile {
        margin-bottom: 5%;
        margin-left: 3%;
    }
    .OR-span {
        background: white;
        color: black;
        display: block;
        margin-top: 69px;
        text-align: center;
        position: absolute;
        left: -25px;
        padding: 5px;
        font-size: 25px;
    }
    .quick-offer-option {
        display: inline-block;
        background: #E6E6E6;
        height: 200px;
        width: 1%;
        float: left;
        position: relative;
    }
    
    @@media (max-width: 515px) {
        .quick-offer-option {
            display:none;
        }
        .hero-static-caption {
            margin-top: 0px;
        }
        .quick-offer-content {
            padding-top: 25px;
            padding-bottom: 25px;
        }
        .copy-separator {
            padding-bottom: 50px;
        }
    }
</style>

<div class="container container-body">
    <div class="tab-pane step-content">
        <div class="quick-offer-content">
            <div class="row">
                <div class="col-md-6 col-sm-6 copy-separator">
                    <div class="option-signin">
                        <p>
                            To complete your credit application,select Login if you are registered for internet Banking
                        </p>
                        <a class="button secondary" href="https://ib.africanbank.co.za/">Login</a>
                    </div>
                </div>
                <div class="col-md-6 col-sm-6">
                    <div class="quick-offer-option">
                        <span class="OR-span">OR</span>
                    </div>
                    <div class="option-register">
                        <p>
                            If you are not registered for Internet Banking, please select Register to complete your credit application.
                        </p>
                        <a class="button primary" href="https://ib.africanbank.co.za/modules/Registration/Public/Register.aspx">Register</a>
                    </div>
                </div>
            </div>
        </div>    
    </div>
</div>



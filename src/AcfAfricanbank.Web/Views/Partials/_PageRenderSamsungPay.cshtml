<div class=" audiaus-reward">
    @foreach (var item in cardData)
    {
        var data = item.Value<IEnumerable<IPublishedElement>>("sectionContent");
        int iterator = 0;
        bool isSwappedClass = false;
        bool isContentMoveClass = false;
        foreach (var info in data)
        {
            var image = info.Value("tabSubItemImage");
            String url = ((IPublishedContent)image).Url.ToString();
            String altTag = ((IPublishedContent)image).Value("altTag").ToString();
            String cardId = "card" + iterator.ToString();
            var count = (iterator % 2) == 1;

            <div class="blog-container desktop-blog">
                <div class="row  grey-background-@iterator ">
                    @if ((iterator % 2) == 1 || (iterator % 2) == 2 )
                    {
                        <div class="col-sm-5 ">
                            <img class="banner-image" src="@url" alt="@altTag" />
                        </div>
                        <div class="col-sm-5  container-blog container-blog-mobile container-blog-mobile-two-text" style="position: relative;bottom: -97px;">
                            <div class="body-content ul-bullets">
                                <div class="article-title online-banking test-class">@info.Value("tabSubItemTitle")</div>
                                @info.Value("tabSubItemTextContent")
                            </div>
                          
                        </div>
                    }
                    else
                    {
                        <div class="col-sm-6 col-md-offset-1 container-blog container-blog-mobile-two container-blog-mobile-two-text " style="position: relative; margin-bottom: 30px; margin-top: 50px;">
                            <div class="body-content ul-bullets">
                                <div class="article-title online-banking test-class">@info.Value("tabSubItemTitle")</div>
                                @info.Value("tabSubItemTextContent")
                            </div>
                          
                        </div>
                        <div class="col-sm-1 col-md-offset-4">
                            <img style="float:right" class="banner-image" src="@url" alt="@altTag" />
                        </div>
                    }
                </div>
            </div>
            
            @*tablet*@
            <div class="blog-container tablet-blog">
                <div class="row  grey-background-@iterator">
                    @if ((iterator % 2) == 1)
                    {
                        <div class="col-sm-6 ">
                            <img class="banner-image" src="@url" alt="@altTag" />
                        </div>

                      <div class="col-sm-5  container-blog container-blog-mobile container-blog-mobile-two-text" style="position: relative; bottom: -97px;">
                            <div class="body-content ul-bullets">
                                <div class="article-title online-banking test-class">@info.Value("tabSubItemTitle")</div>
                                @info.Value("tabSubItemTextContent")
                            </div>
                          
                        </div>
                    }
                    else
                    {
                        <div class="col-sm-6 col-md-offset-1 container-blog container-blog-mobile-two container-blog-mobile-two-text " style="position: relative;bottom: -80px;">
                            <div class="body-content ul-bullets">
                                <div class="article-title online-banking test-class">@info.Value("tabSubItemTitle")</div>
                                @info.Value("tabSubItemTextContent")
                            </div>
                          
                        </div>

                        <div class="col-sm-6 col-md-offset-4">
                            <img  class="banner-image" src="@url" alt="@altTag" />
                        </div>
                    }
                </div>
            </div>
            @*Mobile-Blog*@
            <div class="blog-container mobile-blog">
                <div class="row grey-background-@iterator">
                
                        <div class="col-sm-6">
                            <img class="banner-image" src="@url" alt="@altTag" />
                        </div>
                        <div class="col-sm-6  container-blog" style="position: relative;bottom: -170px;left: -40x;left: 23px;">
                            <div class="body-content ul-bullets">
                                <div class="article-title online-banking test-class">@info.Value("tabSubItemTitle")</div>
                                @info.Value("tabSubItemTextContent")
                            </div>
                          
                        </div>
                        
                </div>
            </div>
            iterator++;
        }
    }
</div>
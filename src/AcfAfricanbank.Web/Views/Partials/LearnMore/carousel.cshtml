<script >


$(document).ready(function() {
    $("#learn-more-btn-back").click(function() {
        window.location.href = 'http://cmsdev.africanbank.net/en/home/bank'; // Change '/' to your actual home page URL if needed
    });
});

        // Accordion Script (if applicable)
    $(".accordion").click(function() {
        $(this).toggleClass("active");
        var myPanel = $(this).next(".myPanel");
        var wasOpen = myPanel.css("display") === "block";

        $(".myPanel").css("display", "none");
        $(".accordion").removeClass("active");

        if (!wasOpen) {
            myPanel.css("display", "block");
            $(this).addClass("active");
        }
    });
    
</script>

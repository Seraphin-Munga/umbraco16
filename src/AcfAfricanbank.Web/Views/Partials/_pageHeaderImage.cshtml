@model Umbraco.Web.PublishedModels.HeroHeader
@using Io = System.IO
@using System.Drawing
@using ImageProcessor

@{
    var headerImage_large = Model?.Value<IPublishedContent>("image")?.Url;
    var headerImage_medium = Model?.Value<IPublishedContent>("imageMedium")?.Url;
    var headerImage_small = Model?.Value<IPublishedContent>("imageSmall")?.Url;
    var breadcrumbItems = Model?.Value("breadcrumb")?.ToString()?.Split(',')?.ToList();

    // Search Functionality on Header (if exists)
    HeroTextbox txtWelcomeHeaderValue = null;
    HeroTextbox txtKNValue = null;
    HeroTextbox txtSearchThroughValue = null;
    HeroTextbox txtASKAbby = null;
    if (Model.Children.Count() > 0)
    {
        txtWelcomeHeaderValue = (HeroTextbox)Model.Children(x => x is HeroTextbox).First();
        txtKNValue = (HeroTextbox)Model.Children(x => x is HeroTextbox).Skip(1).FirstOrDefault();
        txtSearchThroughValue = (HeroTextbox)Model.Children(x => x is HeroTextbox).Skip(2).FirstOrDefault();
        txtASKAbby = (HeroTextbox)Model.Children(x => x is HeroTextbox).Last();
    }

    // Code that creates smaller image if necessary
    string largeImageFullPath = Server.MapPath(headerImage_large);
    try
    {
        if (Io.File.Exists(largeImageFullPath) && string.IsNullOrEmpty(headerImage_medium))
        {
            var idx = headerImage_large.IndexOf('.', (headerImage_large.Length - 5));
            var fileName = headerImage_large.Substring(0, idx);
            var fileExt = headerImage_large.Substring(idx);
            var generatedMedFile = $"{fileName}_med.gen{fileExt}";
            if (!Io.File.Exists(Server.MapPath(generatedMedFile)))
            {
                byte[] photoBytes = Io.File.ReadAllBytes(largeImageFullPath);
                int quality = 100;
                var size = new Size(900, 380);
                using (var inStream = new MemoryStream(photoBytes))
                {
                    using (var outStream = new MemoryStream())
                    {
                        using (var imageFactory = new ImageFactory(preserveExifData: true))
                        {
                            var res = imageFactory.Load(inStream)
                                 .Resize(size)
                                 .Quality(quality)
                                 .Save(generatedMedFile);
                        }
                    }
                }
            }
            headerImage_medium = generatedMedFile;
        }
    }
    catch (Exception ex)
    {
        // throw ex.InnerException;
    }
    var altTextImage = Model.Parent.Value("alternateImageText");
}


<style type="text/css">
    .search {
        width: 100%;
        position: relative;
        display: flex;
    }

    .searchTerm {
        width: 100%;
        border: 2px solid #88bc47;
        border-right: none;
        padding: 5px;
        height: 40px;
        border-radius: 21px 0 0 21px;
        outline: none;
        /*background: #555650;*/
        padding-left: 12px;
    }

        .searchTerm:focus {
            /*color: white;*/
        }

    .searchButton:focus {
        border-color: yellow;
    }

    .searchButton {
        width: 40px;
        height: 40px;
        border: 1px solid #98d150;
        background: #98d150;
        text-align: center;
        color: #fff;
        border-radius: 0 21px 21px 0;
        cursor: pointer;
        font-size: 20px;
        outline: none;
        border-radius: none;
    }
</style>

<!-- HERO BANNER -->
<div class="hero-static-container">
    <div class="container-fluid">
        <div class="row no-gutter">
            <div class="col-sm-12">
                <div class="hero-static-banner" id="heroHeader" style="background-image: url('@headerImage_large');">
                    <ol class="breadcrumb">
                        @if (breadcrumbItems != null)
                        {
                            foreach (string breadcrumItem in breadcrumbItems)
                            {
                                var cssClass = breadcrumItem == breadcrumbItems.Last() ? "active" : string.Empty;
                                <li class="@cssClass">@breadcrumItem</li>
                            }
                        }
                    </ol>
                    @if (txtWelcomeHeaderValue != null)
                    {
                        <div class="center-align kh-search-engine">
                            <h2 class="kh-header">@txtWelcomeHeaderValue.Items.FirstOrDefault().Value("value")</h2>
                            <h1 class="kh-h1-margin">@txtKNValue.Items.FirstOrDefault().Value("value")</h1>
                            <p class="kh-header-desc">@txtSearchThroughValue.Items.FirstOrDefault().Value("value")</p>

                            <form id="site_search" class="search-placeholder-text ng-pristine ng-valid" method="post">
                                <div class="wrap">
                                    <div class="search">
                                        <input type="text" class="searchTerm" id="searchstring" name="searchstring" value="@Request["searchstring"]" />
                                        <button type="submit" id="btnSubmit" class="searchButton">
                                            <i class="fa fa-search"></i>
                                        </button>
                                    </div>
                                </div>
                                <div id="searchresults"></div>
                            </form>

                            <p class="askAbby">@txtASKAbby.Items.FirstOrDefault().Value("value")</p>


                        </div>
                        @* <script type="text/javascript" src="~/scripts/search.js"></script>*@
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts  {
    <script>
    $(document).ready(function () {
        var imageBgCss = "url('" + "@headerImage_large" + "')";
        var imageMdCss = "url('" + "@headerImage_medium" + "')";
        var imageSmCss = "url('" + "@(string.IsNullOrEmpty(headerImage_small) ? headerImage_large : headerImage_small)" + "')";
        var CheckScreenSize;
        (CheckScreenSize = function () {
            var _width = $(window).outerWidth();
            var _height = $(window).outerHeight();
            if (_width < 414) {
                $("#heroHeader").css("background-image", imageSmCss);
            }
            else {
                $("#heroHeader").css("background-image", imageBgCss);
            }
        })();
        $(window).resize(CheckScreenSize);
    });

    </script>

}

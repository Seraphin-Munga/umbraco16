                                        background-color: #88bc47;
                                        color: #fff;
                                        font-weight: 400;
                                        font-size: 12px;display:block; margin:auto;width:183px;
                                        margin-bottom:10px;">Download Brochure</a>*@
                </div>
            </div>
        </div>
    }

    </div>

    
</div>

        @if (Model.ShouderDescription != null)
    {
        <div class="row bg-color-desc" >
            <div class="col-sm-12 col-md-12" >
                <div class="hero-static-description" >
                    <p class="hero-static-description-0" style=" width: 100%; font-size: 14px; font-weight: bold;padding:10px; padding-top:24px;padding-bottom:24px;">
                         @Model.ShouderDescription
                    </p>

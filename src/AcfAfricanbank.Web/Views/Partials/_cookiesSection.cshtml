<script>
     function setCookie(name, value, days) {
        let expires = "";
        if (days) {
            let date = new Date();
            date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
            expires = "; expires=" + date.toUTCString();
        }
        document.cookie = name + "=" + value + "; path=/" + expires;
    }

    function getCookie(name) {
        let nameEQ = name + "=";
        let cookies = document.cookie.split(';');
        for (let i = 0; i < cookies.length; i++) {
            let c = cookies[i].trim();
            if (c.indexOf(nameEQ) === 0) return c.substring(nameEQ.length);
        }
        return null;
    }

    function closeNotice() {
        $("#cookieNotice").fadeOut();
    }

    $(document).ready(function () {
        if (getCookie("cookieConsent")) {
            $("#cookieNotice").hide();
        }
        
        
        $("#close-download").click(function (){
     
               $(".app-banner").hide();
        })
        

        $(".acceptAll").click(function () {
         
            setCookie("cookieConsent", "all", 30);
            closeNotice();
             $("#cookieSettingsModal, #overlay").fadeOut();
        });

        $("#acceptNecessary").click(function () {
            setCookie("cookieConsent", "necessary", 30);
            closeNotice();
             $("#cookieSettingsModal, #overlay").fadeOut();
        });

        $("#openSettings").click(function () {
            $("#cookieSettingsModal, #overlay").fadeIn();
        });

        $(".cancelSettings").click(function () {
            $("#cookieSettingsModal, #overlay").fadeOut();
        });
        
        
        $('#cookieAccordion .panel-collapse').on('show.bs.collapse', function () {
    $(this).parent().find(".glyphicon").removeClass("glyphicon-chevron-down").addClass("glyphicon-chevron-up");
});

$('#cookieAccordion .panel-collapse').on('hide.bs.collapse', function () {
    $(this).parent().find(".glyphicon").removeClass("glyphicon-chevron-up").addClass("glyphicon-chevron-down");
});


        $("#acceptSelected").click(function () {
            let performance = $("#performanceCookies").prop("checked") ? "true" : "false";
            let advertisement = $("#advertisementCookies").prop("checked") ? "true" : "false";

            setCookie("performanceCookies", performance, 30);
            setCookie("advertisementCookies", advertisement, 30);
            setCookie("cookieConsent", "custom", 30);

            $("#cookieSettingsModal, #overlay").fadeOut();
            closeNotice();
        });
    });

</script>

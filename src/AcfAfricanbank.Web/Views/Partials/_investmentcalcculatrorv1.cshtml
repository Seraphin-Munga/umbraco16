 function extractDOBFromSAID(idNumber) {
    if (!idNumber || idNumber.length < 6) return "";

    const yy = idNumber.substring(0, 2);
    const mm = idNumber.substring(2, 4);
    const dd = idNumber.substring(4, 6);

    const currentYear = new Date().getFullYear().toString().substring(0, 2);
    const century = parseInt(yy) <= parseInt(new Date().getFullYear().toString().slice(-2))
        ? "20"
        : "19";

    return `${century}${yy}${mm}${dd}`; // Format: YYYYMMDD
}

function extractGenderFromSAID(idNumber) {
    if (!idNumber || idNumber.length < 10) return "";

    const genderDigits = parseInt(idNumber.substring(6, 10));
    return genderDigits >= 5000 ? "M" : "F";
}

function formatMobileNumber(cell) {
    if (!cell) return "";

    cell = cell.replace(/\D/g, ""); // remove non-numeric

    if (cell.startsWith("0")) {
        return cell.substring(1);
    }

    if (cell.startsWith("27")) {
        return cell.substring(2);
    }

    return cell;
}
 
 

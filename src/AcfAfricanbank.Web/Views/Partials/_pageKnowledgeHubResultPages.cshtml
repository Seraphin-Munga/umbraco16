@inherits Umbraco.Web.Mvc.UmbracoViewPage
@model Dictionary<string, List<string>> 
@using ContentModels = Umbraco.Web.PublishedModels;
@using System.Configuration;
@using System.Text.RegularExpressions

@{ 
    foreach (var data in Model)
    {
        if (data.Value.ToList()[0].ToString() == "39599")
        {
            var stringHeader = data.Value.ToList()[0].ToString();
            var stringValue = data.Value.ToList()[1].ToString();
            string linkPart = "../video-hub";
            string linkStringValue = linkPart + "?path=Knowledge Centre/~" + data.Key + "&selected=" + data.Key;
            <div style="padding: 1px 25px 0px 25px;">
                <h5>@data.Key.ToString()</h5>
                <a href="@linkStringValue"><b>Go to guide >></b></a>
                <hr />
            </div>
         }
    }
}
    
                    <div id="ctaButton">
                        <a href="@shoulderButtonLink" class="button primary span-buttons" id="@btnId">
                            @buttonText
                        </a>
                    </div>
                </div>
            </div>
        </div>
            </text>
    })
@section scripts {
<script>


    $(document).ready(function () {


        $('.money').autoNumeric('init', { aSep: ' ', aDec: '.', aSign: 'R' });

        function addFormValidation() {
            $('.form-horizontal').bootstrapValidator({
                feedbackIcons: {
                    valid: 'glyphicon glyphicon-ok-sign',
                    invalid: 'glyphicon glyphicon-remove-sign',
                    validating: 'glyphicon glyphicon-refresh'
                },
                fields: {
                    'firstName': {
                        message: 'Value inserted is not valid',
                        validators: {
                            notEmpty: {
                                message: 'Name is required'
                            },
                            regexp: {
                                regexp: /^[a-zA-Z]/,
                                message: 'Please insert a valid name'
                            }, stringLength: {
                                max: 30,
                                message: 'Please make sure that the name is 30 max characters long.'
                            }
                        }
                    },
                    'itemName': {
                        message: 'Value inserted is not valid',
                        validators: {
                            notEmpty: {
                                message: 'Item name required'
                            },
                            regexp: {
                                regexp: /^[a-zA-Z]/,
                                message: 'Please insert a valid item you are saving for'
                            }, stringLength: {
                                max: 30,
                                message: 'Please make sure that the item is name 30 max characters long.'
                            }
                        }
                    },
                    'email': {
                        message: 'Value inserted is not valid',
                        validators: {
                            notEmpty: {
                                message: 'Enter a valid email address'
                            },
                            regexp: {
                                regexp: /^[-a-z0-9~!$%^&*_=+}{\'?]+(\.[-a-z0-9~!$%^&*_=+}{\'?]+)*@@([a-z0-9_][-a-z0-9_]*(\.[-a-z0-9_]+)*\.(aero|arpa|biz|com|coop|edu|gov|info|int|mil|museum|name|net|org|pro|travel|mobi|[a-z][a-z])|([0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}))(:[0-9]{1,5})?$/i,
                                message: 'Please enter a valid email address'
                            }, stringLength: {
                                max: 30,
                                message: 'Please make sure only number is inserted.'
                            }
                        }
                    }
                }
            });
        }

        function isFormValid() {
            var isControlEmpty = false;
            $('.form-horizontal input').each(function () {
                if ($(this).val() === "") {
                    isControlEmpty = false;
                    return isControlEmpty;
                } else {
                    isControlEmpty = true;
                }
            });
            return isControlEmpty;
        }

        $('#grow-create-certificate').on('click', function (e) {
            if (isFormValid()) {
                $('.hang-tight').show('slow');
                $('#video-header').css("margin-top", "-19px");
                setTimeout(function () {
                    $('.hang-tight').hide('slow');
                    $('#video-header').css("margin-top", "-62px");
                    $('#generic')[0].children[0].children[0].children[0].children[1].innerHTML = 'Thank you!';
                    $('#generic').modal('show');
                    if ($('#grow-create-certificate').attr('disabled') === 'disabled') {
                        $('#grow-create-certificate').removeAttr('disabled');
                    }
                }, 5000);
            }

            $("form.form-horizontal").bootstrapValidator("destroy");
            addFormValidation();
        });

        addFormValidation();

        $(".allownumericwithdecimal").on("keypress keyup blur", function (event) {
            $(this).val($(this).val().replace(/[^0-9\.]/g, ''));
            if ((event.which != 46 || $(this).val().indexOf('.') != -1) && (event.which < 48 || event.which > 57)) {
                event.preventDefault();
            }
            if ($(this).val().indexOf('.') > 5) {
                var currentVal = parseInt($(this).val());
                if (!isNaN(currentVal) && currentVal > 0) {
                    $(this).val("");
                }
            }
        });

        var step =
        {
            fromGrowIt:
                [
                    { name: "amount", control: "worth" },
                    { name: "name", control: "firstName" },
                    { name: "decision", control: "period" },
                    { name: "email", control: "email" },
                    { name: "string", control: "itemName" }
                ]
        };

        Object.keys(step).forEach(function (form) {
            var fields = form_validation_setup(step[form]);
            initialize_form_validation("#" + form, fields);
        });

        function DropDown(el) {
            this.dd = el;
            this.placeholder = this.dd.children('span');
            this.opts = this.dd.find('ul.dropdown > li');
            this.val = '';
            this.index = -1;
            this.initEvents();
        }
        DropDown.prototype = {
            initEvents: function () {
                var obj = this;

                obj.dd.on('click', function (event) {
                    $(this).toggleClass('active');
                    $(this).children('input')[0].innerText = $(this)[0].children[1].innerText;
                    // loop through this: $(this)[0].children[1].children and find a innerHTML = $(this)[0].children[0].innerText + grab i item > $(this)[0].children[1].children[i].dataset.value from there
                    for (var i = 0; i < $(this)[0].children[2].children.length; ++i) {
                        if ($(this)[0].children[1].innerText === $(this)[0].children[2].children[i].innerText) {
                            $("#period")[0].value = $(this)[0].children[2].children[i].dataset.value;
                        }
                    }


                    return false;
                });


                obj.opts.on('click', function () {
                    var opt = $(this);
                    obj.val = opt.text();
                    obj.index = opt.index();
                    obj.placeholder.text(obj.val);
                });
            },
            getValue: function () {
                return this.val;
            },
            getIndex: function () {
                return this.index;
            }
        }

        $(function () {

            var dd = new DropDown($('#dd'));

            $(document).click(function () {
                // all dropdowns
                $('.wrapper-dropdown-3').removeClass('active');
            });

        });
    });
</script>

<script src="~/scripts/jquery-ui.js"></script>
<script src="~/javascripts/reuse/form_validation.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/1000hz-bootstrap-validator/0.11.5/validator.min.js"></script>
}
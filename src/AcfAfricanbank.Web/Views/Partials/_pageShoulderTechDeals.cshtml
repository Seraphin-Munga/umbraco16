@model Umbraco.Web.PublishedModels.HeroShoulder
@using ContentModels = Umbraco.Web.PublishedModels;
@using System.Configuration;
@using Umbraco.Core.Models;
@using Umbraco.Core.PropertyEditors;
@using Umbraco.Web.Composing;

<style>
.hero-static-caption {
    display: flow;
}
.button.primary{
    transition: 0.5s;
    border: solid 1px #88bc47;
    padding: 5px 14px;
    width: 200px;
   /* height: 50px;*/
    border-radius: 25px;
    margin: 10px auto;
    font-size: 14px;
    font-weight: 600;
    outline: none;
    -webkit-outline: none;
    background: #88bc47;
    color: #fff;
    cursor: pointer;
    box-shadow: none;
}
.shoulder-img{
   margin-top: -90px;
    margin-bottom: -20px;
}
.hero-static-caption .button.primary:hover {
    background-color: #88bc47;
    color: #fff;
}
.hero-static-caption {
padding-top: 20px !important;
    padding-bottom: 0px !important;
}
@*.hero-static-caption .hero-static-description, .hero-static-caption p {
    
    line-height: 2.00;
}*@
 @@media(max-width: 767px) and (min-width: 256px) {
 .shoulder-img{
    margin-top:0px;
}
.hero-static-title{
text-align:left;
}
.shoulder-phone-img{
   height:200px !important;
}
.hero-static-caption {
    margin-bottom: 10px;
    
}
 }
</style>

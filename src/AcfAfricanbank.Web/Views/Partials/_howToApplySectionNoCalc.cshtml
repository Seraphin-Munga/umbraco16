@inherits Umbraco.Web.Mvc.UmbracoViewPage
@model acf_africanbankv1.Models.HowToApplyDataContainer
@using System.Configuration;

@{
    var button = Model.ApplyButton;
    var cards = Model.DocumentsCards ?? new List<Card>();
    var cardRows = new List<List<Card>>();
    var currentCardRow = new List<Card>();
    foreach (var c in cards)
    {
        currentCardRow.Add(c);
        if (currentCardRow.Count() == 2 || c.Equals(cards.Last()))
        {
            cardRows.Add(currentCardRow);
            currentCardRow = new List<Card>();
        }
    }
}
<div class="container no-padding">
    <div class="campaign-apply">
        <h2>@Model.Header</h2>
        <div class="row margin-top-20">
            <div class="col-sm-6">
                <p class="body-content">
                    @Model.Description
                </p>
                @if (button != null)
                {
                    var val = button.ExternalLinkType.ToString() ?? string.Empty;
                    var selectedButtonVal = (!string.IsNullOrEmpty(val)) ?
                        umbraco.library.GetPreValueAsString(int.Parse(val)) :
                        string.Empty;
                    var ShoulderButtonLink = ConfigurationManager.AppSettings[selectedButtonVal];
                    var link_to = ShoulderButtonLink;
                    if (link_to==null)
                    {
                        link_to = button.EbankItbuttonExternalLink;
                    }
                    <div class="margin-top-40">
                        <a href="@link_to" class="button primary hidden-xs">
                            @button.EbankItbuttonText
                        </a>
                    </div>
                }
            </div>
            @if (Model.DocumentsCards != null)
            {
                <div class="col-sm-6 text-center">
                    @foreach (var row in cardRows)
                    {
                        <div class="row">
                            @foreach (Card rowCard in row)
                            {
                                <div class="col-sm-6">
                                    <img src="@rowCard.CardIcon.Url" alt="@rowCard.CardIcon.GetPropertyValue("altTag")" height="80" />
                                    <p class="body-content margin-top-20">
                                        @(rowCard.CardDescription ?? rowCard.CardTitle)
                                    </p>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

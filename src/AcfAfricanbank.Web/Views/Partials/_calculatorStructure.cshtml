@using Web.Helpers;
@model string


<style type="text/css">
    .card-shadow.rate-card-fixed-deposit-offer .percentage {
        font-size: 30px;
        font-weight: bold;
        color: #7ed321;
        position: relative;
        letter-spacing: -.06em;
        line-height: normal;
    }

    .card-shadow.rate-card-fixed-deposit-offer {
        text-align: center;
        font-size: 17px;
        max-width: 287px;
        margin: 0 auto 20px;
        line-height: normal;
    }

    .btnCalc .button.primary {
        background-color: #4c6a8f;
    }

    #fixedResults .button.primary{
        background-color: #4c6a8f;
    }
    #accessResults .button.primary {
        background-color: #4c6a8f;
    }
    #noticeResults .button.primary {
        background-color: #4c6a8f;
    }
    #taxResults .button.primary {
        background-color: #4c6a8f;
    }

    @@media (max-width: 425px) {
        .resultbtn {
            margin-top: 10px;
            padding: 16px 4px;
        }
        .card-shadow.rate-card-fixed-deposit-offer .percentage {
            font-size: 24px;
            font-weight: bold;
            color: #7ed321;
            position: relative;
            letter-spacing: -.06em;
            line-height: normal;
        }

        .card-shadow.rate-card-fixed-deposit-offer {
            text-align: center;
            font-size: 17px;
            max-width: 287px;
            margin: 0 auto 20px;
            line-height: normal;
        }

        .btnCalc .button {
            padding: 16px 35px;
            font-size: 17px;
            max-width: 287px;
            margin: 0 auto 20px;
            line-height: normal;

            color: #fff;
            text-align: center;
            font-weight: normal;
            box-shadow: 0 20px 40px 0 rgba(0,0,0,.2);
            -webkit-font-smoothing: antialiased;
            transition: all 1s ease;
            display: inline-block;
            cursor: pointer;
        }

        #fixedResults .button, #accessResults .button, #noticeResults .button, #taxResults .button {
            padding: 16px 10px;
            font-size: 14px;
            color: #fff;
            text-align: center;
            font-weight: normal;
            box-shadow: 0 20px 40px 0 rgba(0,0,0,.2);
            -webkit-font-smoothing: antialiased;
            transition: all 1s ease;
            display: inline-block;
            cursor: pointer;
        }

        .investment-calculator p {
            font-size: 12px;
            color: #fff;
        }
        #calculator {
            top: unset;
            padding-bottom: 10px;
        }
        .table > tbody > tr.green > td {
            color: #88bc47;
            font-size: 15px;
            font-weight: 600;
        }
    }
</style>



<div id="calculator">
    <div class="investment-calculator top-minus-60" id="calculator">

        <div class="ajax-form-success ajax-alert alert alert-success square errorcalculatores" style="display: none;">@ResourceHelper.GetResource("ErrorCalculatores")</div>
        <div id=@Model>
        </div>
    </div>
    <section id="form-preloader" class="form-preloader">
        <div class="loader" id="form-preloader-loader">
            <div class="loader-img"></div>
        </div>
    </section>
    <div id="calculator-container">
        <div class="margin-top-20 visible-xs"></div>
    </div>
</div>

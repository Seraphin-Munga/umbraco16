    .btn-wrap {
        display: block;
        position: relative;
        padding-left: 35px;
        margin-bottom: 12px;
        cursor: pointer;
        font-size: 16px;
        -webkit-user-select: none;
        -moz-user-select: none;
        -ms-user-select: none;
        user-select: none;
        display: flex;
        align-items: center;
    }

        .btn-wrap input {
            position: absolute;
            opacity: 0;
            cursor: pointer;
            height: 0;
            width: 0;
        }

    .checkmark {
        position: absolute;
        top: 0;
        left: 0;
        height: 25px;
        width: 25px;
        border: solid 1px #003B61;
        border-radius: 4px;
        transition: 0.35s;
    }

    .btn-wrap input:checked ~ .checktext {
        font-weight: bold
    }

    .btn-wrap.dice input:checked ~ .checktext {
        transition: 0.35s;
        font-weight: bold;
        background: #1F2F43;
        color: #fff;
    }

    .btn-wrap input:checked ~ .checkmark:after {
        transition: 0.35s;
        display: block;
    }

    .btn-wrap input:checked ~ .checkmark {
        border: solid 1px #003B61;
        border-radius: 7px;
    }

    .btn-wrap .checkmark:after {
        transition: 0.35s;
        left: 8px;
        top: 4px;
        width: 9px;
        height: 14px;
        border: solid #259CD8;
        border-radius: 2px;
        border-width: 0 4px 4px 0;
        box-shadow: 0px 2px 2px #00000015;
        -webkit-transform: rotate( 45deg );
        -ms-transform: rotate(45deg);
        transform: rotate(45deg);
    }

    .checkmark:after {
        content: "";
        position: absolute;
        display: none;
    }

    .primary-ghost-btn {
        transition: 0.5s;
        border: solid 2px #00285B;
        padding: 9px 14px;
        width: 200px;
        height: 50px;
        border-radius: 25px;
        margin: 10px auto;
        font-size: 14px;
        font-weight: 600;
        outline: none;
        -webkit-outline: none;
        background: none;
        color: #00285B;
        cursor: pointer;
    }

        .primary-ghost-btn:hover {
            transition: 0.5s;
            background: #00285B;
            color: #fff;
            box-shadow: 0px 10px 20px #0000045;
        }

    .btn-wrap.dice {
        background: #fefefe;
        height: 90px;
        padding: 0px;
    }

    .btn-wrap input {
        position: absolute;
        opacity: 0;
        cursor: pointer;
        height: 0;
        width: 0;
    }

    .checktext.dice {
        transition: 0.35s;
        background: #ECECEC;
        height: 90px;
        width: 100%;

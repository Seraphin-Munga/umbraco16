<div class="calculator-wrap" style="padding: 83px 0px 80px 0px;">
    <div class="container">
        <div class="row padding-row">
            <div class="calculator-form loan-calc-wrap col-md-push-1 col-md-10 col-xs-12">
                <div id="takeSurvey" class="col-sm-12 page-title">
                    <h1>Complete the information below to unsubscribe.</h1>
                </div>
                <div class="">
                    <div class="calculator-form">
                        <form class="form-horizontal" method="post" id="frmMarketingConsent">
                            @Html.AntiForgeryToken()
                            @Html.Hidden("ddInputResult1")
                            @Html.Hidden("ddInputResult2")
                            @Html.Hidden("ddInputResult3")
                            @Html.Hidden("howCanBankAddMore")
                            <div class="form-group">

                                <div class="col-md-6">
                                    <label class="customlabel">Can we inform you of African Bank specials and offers?</label>
                                </div>
                                <div class="col-md-6 custom-margin">
                                    <div class="col-sm-3 hidden-lg hidden-md"></div>
                                    <div class="col-md-3 col-xs-4">
                                        <label class="radio-wrap">
                                            <span class="radio-text">Yes</span>
                                            <input type="radio" id="rdbYes" name="option" value="1" class="myRadio" checked="checked">
                                            <span class="checkmark radio"></span>
                                        </label>
                                    </div>
                                    <div class="col-md-2 col-xs-3">
                                        <label class="radio-wrap">
                                            <span class="radio-text">No</span>
                                            <input type="radio" id="rdbNo" name="option" value="0" class="myRadio">
                                            <span class="checkmark radio"></span>
                                        </label>
                                    </div>
                                    <div class="col-md-8">
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <div class="col-md-6 ">
                                    <label class="customlabel padding-30">Your name:</label>
                                </div>
                                <div class="col-md-6 custom-align" style="">
                                    <input type="text" class="custom-input" id="firstName" name="firstName" placeholder="Name" />
                                </div>
                            </div>
                            <div class="form-group">
                                <div class="col-md-6">
                                    <label class="customlabel padding-30">Your surname:</label>
                                </div>
                                <div class="col-md-6 custom-align" style="">
                                    <input type="text" class="custom-input" id="surName" name="surName" placeholder="Surname" />
                                </div>
                            </div>
                             <div class="form-group">
                                <div class="col-md-6 ">
                                    <label class="customlabel padding-30">South African ID:</label>
                                </div>
                                <div class="col-md-6 custom-align" style="">
                                    <input type="text" class="custom-input" id="southAfricanID" maxlength="13" name="southAfricanID" placeholder="South African ID" />
                                </div>
                            </div>
                            <div class="form-group">
                                <div class="col-md-6">
                                    <label class="customlabel padding-30">Your cell number:</label>
                                </div>
                                <div class="col-md-6 custom-align" style="">
                                    <input type="text" class="custom-input" id="cellPhone" name="cellPhone" placeholder="Cell Number for SMS" />
                                </div>
                            </div>
                            <div class="form-group">
                                <div class="col-md-6">
                                    <label class="customlabel padding-30">Your alternate number (Optional):</label>
                                </div>
                                <div class="col-md-6 custom-align" style="">
                                    <input type="text" class="custom-input" id="alternateNumber" name="alternateNumber" placeholder="Alternate number for call" />
                                </div>
                            </div>
                            <div class="form-group">
                                <div class="col-md-6">
                                    <label class="customlabel padding-30">Your email address (Optional):</label>
                                </div>
                                <div class="col-md-6 custom-align" style="">
                                    <input type="text" maxlength="50" class="custom-input" id="email" name="email" placeholder="Email" />
                                </div>
                            </div>
                            <div class="form-group">
                                <div class="col-md-6">
                                    <label class="customlabel">What is your preferred method of communication?:</label>
                                </div>
                                <div class="col-md-6 custom-margin ab-options-3">
                                    <div class="col-md-4 col-xs-3">
                                        <label class="btn-wrap abstandardcheckbox">
                                            <input class="" type="checkbox" id="chkIsSms"><span class="checktext">SMS</span>
                                            <span class="checkmark"></span>
                                        </label>
                                    </div>
                                    <div class="col-md-4 col-xs-3">
                                        <label class="btn-wrap abstandardcheckbox">
                                            <input class="" type="checkbox" id="chkIsCall"><span class="checktext">Call</span>
                                            <span class="checkmark"></span>
                                        </label>
                                    </div>
                                    <div class="col-md-4 col-xs-3">
                                        <label class="btn-wrap abstandardcheckbox">
                                            <input class="" type="checkbox" id="chkIsEmail"><span class="checktext">Email</span>
                                            <span class="checkmark"></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <hr />
                            <div class="form-group">
                                <div class="col-md-12">
                                    <p class="notifiedText">I would like to receive notifications of specials and offers on:</p>
                                </div>
                            </div>
                            <div class="form-group custom-margin">
                                <div class="col-md-push-2 col-md-4 col-xs-6">
                                    <label class="btn-wrap dice">
                                        <input class="myCheckBox" type="checkbox" id="chkIsInvestment"><span class="checktext dice">Investments</span>
                                        <span class="checkmark dice"></span>
                                    </label>
                                </div>
                                <div class="col-md-push-2 col-md-4 col-xs-6">
                                    <label class="btn-wrap dice">
                                        <input class="myCheckBox" type="checkbox" id="chkIsInsurance"><span class="checktext dice">Insurance</span>
                                        <span class="checkmark dice"></span>
                                    </label>
                                </div>
                            </div>
                            <div class="form-group">
                                <div class="col-md-push-2 col-md-4 col-xs-6">
                                    <label class="btn-wrap dice">
                                        <input class="myCheckBox" type="checkbox" id="chkIsLoan"><span class="checktext dice">Loan and Credit Cards</span>
                                        <span class="checkmark dice"></span>
                                    </label>
                                </div>
                                <div class="col-md-push-2 col-md-4 col-xs-6">
                                    <label class="btn-wrap dice">
                                        <input class="myCheckBox" type="checkbox" id="chkIsBanking"><span class="checktext dice">Transactional Banking</span>
                                        <span class="checkmark dice"></span>
                                    </label>
                                </div>
                            </div>
                            <div class="form-group">
                                <div class="col-md-12">
                                    <button type="button" id="sendOptOut" class="primary-ghost-btn">Submit</button>
                                </div>
                            </div>
                        </form>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>


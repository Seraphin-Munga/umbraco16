        align-items: center;
        justify-content: center;
        text-align: left;
        font-size: 14px;
        padding: 10px;
    }

    .checkmark.dice {
        background: #fff;
        top: auto;
        left: auto;
        right: -6px;
        bottom: -6px;
    }

    .checktext {
        font-size: 1.7rem;
    }

    .custom-radio {
        text-align: center;
    }

    .page-title {
        padding: 25px;

<div class=" audiaus-reward">

    @foreach (var item in cardData)
    {
        var data = item.Value<IEnumerable<IPublishedElement>>("sectionContent");
        int iterator = 0;

        bool isSwappedClass = false;
        bool isContentMoveClass = false;

        foreach (var info in data)
        {

            var image = info.Value("tabSubItemImage");
            String url = ((IPublishedContent)image).Url.ToString();
            String altTag = ((IPublishedContent)image).Value("altTag").ToString();
            String cardId = "card" + iterator.ToString();
            var count = (iterator % 2) == 1;



            <div class="blog-container desktop-blog">
                <div class="row  grey-background-@iterator">

                    @if ((iterator % 2) == 1)
                    {

                        <div class="col-sm-5">
                            <img class="banner-image" style="height:600px;" src="@url" alt="@altTag" />
                        </div>

                        <div class="col-sm-5  container-blog container-blog-mobile container-blog-mobile-two-text" style="position: relative;bottom: -170px;">
                            <div class="body-content ul-bullets chat-btn-desc">
                                <div class="article-title online-banking test-class">@info.Value("tabSubItemTitle")</div>
                                @info.Value("tabSubItemTextContent")
                            </div>
                            <div class="row   ">

                                @foreach (var link in (IEnumerable<Umbraco.Web.Models.Link>
                            )info.Value("tabSubItemLinks"))
                                {

                                    if (link.Name.Contains("Chat") || link.Name.Contains("Join African Bank"))
                                    {
                                        <div class="col-sm-4">
                                            <a class="button primary span-buttons chat-btn" href="@link.Url" target="_blank" style="color: white;">@link.Name</a>
                                        </div>

                                    }
                                    else if (link.Name.Contains("Terms & Conditions"))
                                    {

                                        <div class="col-sm-4">
                                            <a class=" download-guide button primary span-buttons " href="@link.Url" target="_blank" style="color: white;">@link.Name</a>
                                        </div>
                                    }


                                }


                            </div>

                        </div>

                    }
                    else
                    {

                        <div class="col-sm-6 col-md-offset-1 container-blog container-blog-mobile-two container-blog-mobile-two-text" style="position: relative;bottom: -170px;">
                            <div class="body-content ul-bullets chat-btn-desc">
                                <div class="article-title online-banking test-class">@info.Value("tabSubItemTitle")</div>
                                @info.Value("tabSubItemTextContent")
                            </div>
                            <div class="row ">

                                @foreach (var link in (IEnumerable<Umbraco.Web.Models.Link>
                                    )info.Value("tabSubItemLinks"))
                                {

                                    if (link.Name.Contains("Chat") || link.Name.Contains("Join African Bank"))
                                    {
                                        <div class="col-sm-4">
                                            <a class="button primary span-buttons chat-btn" href="@link.Url" target="_blank" style="color: white;">@link.Name</a>
                                        </div>

                                    }
                                    else if (link.Name.Contains("Terms & Conditions"))
                                    {

                                        <div class="col-sm-4">
                                            <a class=" download-guide button primary span-buttons " href="@link.Url" target="_blank" style="color: white;">@link.Name</a>
                                        </div>
                                    }


                                }


                            </div>

                        </div>

                        <div class="col-sm-1 col-md-offset-4">
                            <img style="float: right;height:600px;" class="banner-image" src="@url" alt="@altTag" />
                        </div>

                    }





                </div>

            </div>


            <div class="blog-container mobile-blog">
                <div class="row grey-background-0">
                        <div class="col-sm-6  container-blog" style="position: relative;bottom: -170px;left: -40x;left: 23px;">
                            <div class="body-content ul-bullets chat-btn-desc">
                                <div class="article-title online-banking test-class">@info.Value("tabSubItemTitle")</div>
                                @info.Value("tabSubItemTextContent")
                            </div>
                            <div class="row ">

                                @foreach (var link in (IEnumerable<Umbraco.Web.Models.Link>)info.Value("tabSubItemLinks"))
                                {

                                    if (link.Name.Contains("Chat") || link.Name.Contains("Join African Bank"))
                                    {
                                        <div class="col-sm-4">
                                            <a class="button primary span-buttons chat-btn" href="@link.Url" target="_blank" style="color: white;">@link.Name</a>
                                        </div>

                                    }
                                    else if (link.Name.Contains("Terms & Conditions"))
                                    {

                                        <div class="col-sm-4">
                                            <a class=" download-guide button primary span-buttons " href="@link.Url" target="_blank" style="color: white;">@link.Name</a>
                                        </div>
                                    }


                                }


                            </div>

                        </div>

                        <div class="col-sm-6">
                            <img class="banner-image" src="@url" alt="@altTag" />
                        </div>
                </div>
            </div>

        iterator++;

        }
    }

</div>


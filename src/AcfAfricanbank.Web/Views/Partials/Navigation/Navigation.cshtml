@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@inject Umbraco.Cms.Core.Models.PublishedContent.IVariationContextAccessor VariationContextAccessor
@inject Umbraco.Cms.Core.Models.PublishedContent.IPublishedValueFallback PublishedValueFallback
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@using System.Linq;
@{
    // Same approach as master.cshtml: untyped IPublishedContent API
    // (IsDocumentType/Value<T>) instead of ModelsBuilder-generated model
    // classes, so this view compiles regardless of ModelsBuilder state.
    IPublishedContent menu = null;

    IPublishedContent homePageElements = null; 


    if (Model.Children(VariationContextAccessor).Where(o => o.IsDocumentType("homePageElements")).FirstOrDefault() != null)
    {
        homePageElements = Model.Children(VariationContextAccessor).Where(o => o.IsDocumentType("homePageElements")).FirstOrDefault();
    }
    else if (Model.Parent.Parent.Children(VariationContextAccessor).Where(o => o.IsDocumentType("homePageElements")).FirstOrDefault() != null)
    {
        homePageElements = Model.Parent.Parent.Children(VariationContextAccessor).Where(o => o.IsDocumentType("homePageElements")).FirstOrDefault();
    }
    else
    {
        homePageElements = Model.Parent.Children(VariationContextAccessor).Where(o => o.IsDocumentType("homePageElements")).FirstOrDefault();
    }

    menu = homePageElements?.Children(VariationContextAccessor).Where(o => o.IsDocumentType("topNavigation")).FirstOrDefault();
}



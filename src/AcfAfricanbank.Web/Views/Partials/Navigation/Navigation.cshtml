                        </span> <span class="visible-xs">Home</span></a></li>
                    <!-- Loop starts here -->

                    @{
                        if (menu != null)
                        {
                            foreach (var menuData in menu.Value<IEnumerable<IPublishedElement>>(PublishedValueFallback, "MenuInfo") ?? Enumerable.Empty<IPublishedElement>())
                            {
                                foreach (var relatedLink in menuData.Value<IEnumerable<Umbraco.Cms.Core.Models.Link>>(PublishedValueFallback, "menuName") ?? Enumerable.Empty<Umbraco.Cms.Core.Models.Link>())
                                {
                                    if (relatedLink.Url != "#")
                                    {
                                        <li><a href="@relatedLink.Url">@relatedLink.Name</a></li>
                                    }
                                    else if (relatedLink.Target != "")
                                    {
                                        <li class="header-mega-menu dropdown">
                                            <a href="~/en/home/" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">
                                                @relatedLink.Name

                                                @if (menuData.Value(PublishedValueFallback, "menus") != null)
                                                {
                                                    <i class="fa fa-angle-down"></i>
                                                }
                                            </a>
                                            @if (menuData.Value(PublishedValueFallback, "menus") != null)
                                            {

                                                <div class="dropdown-menu">
                                                    <div class="container">
                                                        <div class="row eq-height">
                                                            @{

                                                                var categoryItems = menuData.Value<IEnumerable<IPublishedElement>>(PublishedValueFallback, "menus")?.ToList();
                                                                string cssStyleLastCat = null;
                                                               @* var lastItem = categoryItems.Last();*@
                                                                foreach (var categoryItem in categoryItems ?? Enumerable.Empty<IPublishedElement>())
                                                                {
                                                                 @*   if (categoryItem != lastItem) { cssStyleLastCat = ""; }
                                                                    else { cssStyleLastCat = "border-right: 0px !important; "; }*@

                                                                    var categoryName = categoryItem.Value(PublishedValueFallback, "categoryName");
                                                                    var linkData = categoryItem.Value<IEnumerable<IPublishedElement>>(PublishedValueFallback, "link");
                                                                    <div class="col-sm-3">
                                                                        <div class="mega-menu-product" style="@cssStyleLastCat">
                                                                            <div class="product-category">@categoryItem.Value(PublishedValueFallback, "categoryName")</div>

                                                                            @foreach (var linkValue in linkData ?? Enumerable.Empty<IPublishedElement>())
                                                                            {
                                                                                string pageSection = "";
                                                                                if (linkValue.Value(PublishedValueFallback, "pageSection") != null)
                                                                                {
                                                                                    pageSection = linkValue.Value(PublishedValueFallback, "pageSection").ToString();
                                                                                }
                                                                                string _linkString = null;
                                                                                if (linkValue.Value(PublishedValueFallback, "menuList") != null)
                                                                                {
                                                                                    foreach (var link in linkValue.Value<IEnumerable<Umbraco.Cms.Core.Models.Link>>(PublishedValueFallback, "menuList") ?? Enumerable.Empty<Umbraco.Cms.Core.Models.Link>())
                                                                                    {
                                                                                        if (pageSection != "")
                                                                                        {
                                                                                            _linkString = link.Url + pageSection;
                                                                                        }
                                                                                        else
                                                                                        {
                                                                                            _linkString = link.Url;
                                                                                        }

                                                                                        <div class="product">
                                                                                            <a class="title" href=@_linkString>@link.Name</a>
                                                                                            <p class="descr">@linkValue.Value(PublishedValueFallback, "menuDescription")</p>
                                                                                        </div>
                                                                                    }
                                                                                }
                                                                            }
                                                                        </div>
                                                                    </div>
                                                                }
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </li>
                                    }
                                    else
                                    {
                                        <li><a href="@Configuration["online_upload"]" target="_blank">Upload documents</a></li>
                                    }
                                }
                            }
                        }
                    }
                    <!-- Loop ends here -->
             

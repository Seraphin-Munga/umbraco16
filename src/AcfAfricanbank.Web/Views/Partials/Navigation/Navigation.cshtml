.horizontal-list {
  position: relative;
  right: 0; /* Aligns the list container to the left of its positioned parent */
  list-style-type: none; /* Removes bullets */
  padding: 0px 0px 0px 60px; /* Adds left padding only */
  margin: 0;
  display: flex;
  justify-content: flex-start; /* Ensures items are aligned to the left in the row */
}


.horizontal-list li {
  margin-right: 8px; /* Add spacing between items */
}

.horizontal-list li a {
  color: #fff;
  text-decoration: none; /* Remove underline from links */
  opacity: 0.6; /* Set opacity to 60% */
}

.horizontal-list li a:hover {
  text-decoration: none; /* Optional: underline on hover */

@inherits Umbraco.Web.Mvc.UmbracoViewPage
@model Umbraco.Web.PublishedModels.HeroBody
@using ContentModels = Umbraco.Web.PublishedModels;

@{
    var documents = Model.Documents;
    if (documents != null)
    {
        var years = documents.Select(x => x.GetPropertyValue<DateTime>("date").Year).Distinct().OrderByDescending(x => x).ToList();
        var latestYear = years.FirstOrDefault();
        <div class="container margin-bottom-minus-60" ng-controller="ReportsAndArchievesController">
            <div class="campaign-product-container press-release-section investor full">
                <div class="margin-top-20 visible-xs"></div>
                @{
                    var reportModel = new acf_africanbankv1.Utilities.FinancialReportsViewModel
                    {
                        Years = years.ToArray(),
                        LatestYear = latestYear,
                    };
                }
                @Html.Partial("_financialReportsSearchRow", reportModel)
                @foreach (var year in years)
                {
                    var items = documents.Where(x => x.GetPropertyValue<DateTime>("date").Year == year).OrderByDescending(x => x.GetPropertyValue<DateTime>("date")).ToList();
                    <div class="row" ng-show="year === '@year'">
                        @Html.Partial("_reportDownloadItems", items.Select(i => i as NcArchieve))
                    </div>
                }
            </div>
        </div>
    }
}

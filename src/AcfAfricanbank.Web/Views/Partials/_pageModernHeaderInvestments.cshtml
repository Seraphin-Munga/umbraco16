<!-- HERO BANNER -->


<nav>
    <div class="container">
        <div class="row scroll-backgrnd">
            <div class="col-md-5 col-xs-6">
                <ol class="breadcrumb">
                    @if (breadcrumbItems != null)
                    {
                        foreach (string breadcrumItem in breadcrumbItems)
                        {
                            var cssClass = breadcrumItem == breadcrumbItems.Last() ? "active" : string.Empty;
                            <li class="@cssClass">@breadcrumItem</li>
                        }
                    }
                  
               </ol>
            
              
            </div>
            <div class="col-md-7 col-xs-6">
                <div  class="scroll-container">
                    <div class="header content">@Html.Raw(titles.Value("subHeaderTitle"))</div> 
                </div>
            </div>
        </div>
    </div>
    
</nav>


<div class="hero-static-container">
    <div class="hero-static-banner destktop-banner hidden-md hidden-xs hidden-sm visible-lg" id="heroHeader" style="background-image: url('@headerImage_large');">
        <div class="container @*container-fluid*@ ">
            <div class="row @*no-gutter*@ ">
                <div class="col-lg-4 col-md-4 col-sm-4 col-xs-12 blank-col"></div>
                <div class="title col-lg-8 col-md-8 col-sm-8 col-xs-12" @* class="col-sm-12"*@>
                    <div class="@*center-align*@ kh-search-engine">

                        @if (titles != null)
                        {
                            
                            <div class="row header-descr">

                                @{
                                    int cardIterator = 0;
                                    bool increaseCardHeight = false;
                                    foreach (var item in sectionCardsContent)
                                    {
                                        if (cardIterator == (int)sectionCardsContent.Count() - 1)
                                        {
                                            increaseCardHeight = true;
                                        }
                                        Umbraco.Web.Models.Link itemLink = null;
                                        foreach (var link in (IEnumerable<Umbraco.Web.Models.Link>)item.Value("tabSubItemLinks"))
                                        {
                                            itemLink = link;
                                            break;
                                        }
                                        <div class="row">
                                            <div class="ab-business text-header">
                                            <div class="header-title">@Html.Raw(titles.Value("headerTitle"))</div>
                                                @Html.Raw(item.Value("tabSubItemTextContent"))
                                                @if (itemLink != null)
                                                {
                                                    <a class="button primary span-buttons" href="@itemLink.Url" target="_blank">@itemLink.Name</a>
                                                }

                                            </div>
                                        </div>
                                    }
                                }

                            </div>



                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    @*mobile*@
    
    <div class="hero-static-banner hero-static-banner-mbl destktop-banner visible-md visible-xs visible-sm hidden-lg" id="heroHeader" style="background-image: url('@headerImage_large');">

    </div>
    <div class="container visible-md visible-xs visible-sm hidden-lg black-section @*container-fluid*@ ">
        <div class="row @*no-gutter*@ ">
            @*<div class="col-md-4 col-sm-4 blank-col"></div>*@
            <div class="title title-mbl col-lg-8 col-md-8 col-sm-8 col-xs-12" @* class="col-sm-12"*@>
                <div class="@*center-align*@ kh-search-engine">

                    @if (titles != null)
                    {
                        
                        <div class="row header-descr">

                            @{
                                int cardIterator = 0;
                                bool increaseCardHeight = false;
                                foreach (var item in sectionCardsContent)
                                {
                                    if (cardIterator == (int)sectionCardsContent.Count() - 1)
                                    {
                                        increaseCardHeight = true;
                                    }
                                    Umbraco.Web.Models.Link itemLink = null;
                                    foreach (var link in (IEnumerable<Umbraco.Web.Models.Link>)item.Value("tabSubItemLinks"))
                                    {
                                        itemLink = link;
                                        break;
                                    }
                                    <div class="row">
                                        <div class="ab-business">
                                            <div class="header-title">@Html.Raw(titles.Value("headerTitle"))</div>
                                            @Html.Raw(item.Value("tabSubItemTextContent"))
                                            @if (itemLink != null)
                                            {
                                                <a class="button primary span-buttons" href="@itemLink.Url" target="_blank">@itemLink.Name</a>
                                            }

                                        </div>
                                    </div>
                                }
                            }

                        </div>



                    }
                </div>
            </div>
        </div>
    </div>
</div>
    
    
    
    
   



<script>
      $(document).ready(function () {
       
        var imageBgCss = "url('" + "@headerImage_large" + "')";
        var imageMdCss = "url('" + "@headerImage_medium" + "')";
        var imageSmCss = "url('" + "@(string.IsNullOrEmpty(headerImage_small) ? headerImage_large : headerImage_small)" + "')";
        var CheckScreenSize;
        (CheckScreenSize = function () {
            
            var _width = $(window).outerWidth();
            var _height = $(window).outerHeight();
            if (_width <= 414) {
                $("#heroHeader").css("background-image", imageSmCss);
            }
            else {
                $("#heroHeader").css("background-image", imageBgCss);
            }
        })();
        $(window).resize(CheckScreenSize);
    });
</script>



@inherits Umbraco.Web.Mvc.UmbracoViewPage
@{
    var NewTupleBlogs = new List<Tuple<int, string, string, string, string, DateTime, string>>();
    NewTupleBlogs = ViewBag.searresult;
    var newsearchstring = ViewBag.searchstring;
}
<style>

    .btn-clear-search {
        text-align: right;
    }
    .btn-clr {
        padding: 10px 25px;
    }
    @@media (min-width:320px) and (max-width:767px) {
        .btn-clear-search {
            text-align: center;
        }
        .display-search {
            text-align: center;
        }
    }

    @@media (min-width: 768px) and (max-width: 2560px) {
        .main-container {
            padding-top: 100px;
        }
    }
</style>

<div class="container">
    <div class="row">
        @if (NewTupleBlogs.Count() != 0)
        {

            var foundResults = NewTupleBlogs.Count();
            var pageSize = 6;
            var page = 1; int.TryParse(Request.QueryString["page"], out page);
            var totalPages = (int)Math.Ceiling((double)(NewTupleBlogs.Count) / (double)pageSize);
            if (page > totalPages)
            {
                page = totalPages;
            }
            else if (page < 1)
            {
                page = 1;
            }
            var displayresult = pageSize * page;
            if (displayresult > foundResults)
            {
                displayresult = foundResults;
            }
            <div class="col-xs-12 col-sm-6 col-md-6 display-search" style="margin-top:20px">
                Showing (<span>@displayresult of @foundResults</span>) results for: <i class="resulting-span">@newsearchstring</i>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6 btn-clear-search" style="margin-top:20px">
                <a href="/en/home/blog-landing" class="button primary clearfix btn-clr" style="background-color: #88bc47 !important;">
                    Clear Search
                </a>
            </div>
            foreach (var blog in NewTupleBlogs.Skip(((page - 1) * pageSize)).Take(6))
            {
                <div class="col-xs-12 col-sm-6 col-md-4 desktop-items margin-bottom-10">
                    <a class="blogHeaderLink" id="blogHeaderLink" href="@blog.Item5">
                        <div class="article-card remainingBlogItem video-item video_list_item" style="cursor:pointer;">
                            <div class="blog-image">
                                <div class="image remainingBlogImage" style=" height:220px; position: relative; background-image: url('@blog.Item2')"></div>
                            </div>
                            <div class="article-content" style="padding:10px">
                                <div class="article-title">@blog.Item3</div>
                                <div class="body-content article-body-content">
                                    @blog.Item4
                                    <br />
                                    <br />
                                </div>
                                <div class="article-content margin-top-10" style="font-size:11px;color: #cacaca">
                                    <div class="pull-left"><i>Publish Date: @blog.Item6.ToShortDateString()</i></div>
                                </div>
                            </div>
                        </div>
                    </a>
                    <div class="sharethis-inline-share-buttons" data-url="@blog.Item5"></div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-4 col-lg-12 mobi-items">
                    <a class="blogHeaderLink" href="@blog.Item5">
                        <div class="article-card video-item video_list_item" style="cursor:pointer;">
                            <div style="display:flex;" class="row">
                                <div class="col-md-4 hidden-md hidden-sm hidden-xs hidden-lg">
                                    <div class="image" style="background-image: url('@blog.Item2')"></div>
                                </div>
                                <div class="col-xs-12 col-lg-8">
                                    <div class="row">
                                        <div class="col-xs-4 hidden-lg hidden-sm hidden-md hidden-lg">
                                            <div class="image remainingBlogImage hidden-lg " style=" height:220px; position: relative; background-image: url('@blog.Item2')"></div>
                                        </div>
                                        <div class="col-xs-8 hidden-sm hidden-md hidden-lg">
                                            <div class="article-content">
                                                <div class="article-title ">@blog.Item3</div>
                                                <div class="body-content article-body-content">
                                                    @blog.Item4
                                                </div>
                                            </div>
                                            <div class="article-content">
                                                <div class="pull-right hidden-lg"><i>Publish Date: @blog.Item6.ToShortDateString()</i></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </a>
                    <div class="sharethis-inline-share-buttons" data-url="@blog.Item5"></div>
                </div>
            }
            if (totalPages > 1)
            {
                <div class="col-xs-12 col-sm-12 col-md-12">
                    <div class="container hr-line">
                        <hr>
                    </div>
                    <div id="_pageBlogLanding">
                        <ul class="pagination pull-right" role="menubar" aria-label="Pagination">
                            @{var totalPagesRange = Enumerable.Range(1, (int)totalPages); }
                            @if (page != 1)
                            {
                                <li class="arrow"><a href="?searchstring=@newsearchstring&page=@(page - 1)" title="Previous Page"> <i class="fa fa-angle-left" style="font-weight:900; padding-right: 5px"></i> Previous</a></li>
                            }
                            @for (int item = 1; item < totalPages; item++)
                            {
                                if (page > 1 && item < page && item > (page - 3) && item != page)
                                {
                                    <li class="hidden-xs">
                                        <a href="?searchstring=@newsearchstring&page=@item" title="Go to page @item">@item</a>
                                    </li>
                                }

                                if (page == item)
                                {
                                    <li aria-disabled="true">
                                        <a href="?searchstring=@newsearchstring&page=@item" title="Go to page @item"><strong>@item</strong></a>
                                    </li>
                                }

                                if (page < totalPages && item > page && item < (page + 3) && item != page)
                                {
                                    <li class="hidden-xs">
                                        <a href="?searchstring=@newsearchstring&page=@item" title="Go to page @item">@item</a>
                                    </li>
                                }
                            }
                            @if (page != totalPages)
                            {
                                <li class="arrow"><a href="?searchstring=@newsearchstring&page=@(page + 1)" title="Next Page">Next <i class="fa fa-angle-right" style="font-weight:900; padding-left: 5px"></i></a></li>
                            }
                        </ul>
                    </div>
                </div>
            }
        }
    </div>
</div>

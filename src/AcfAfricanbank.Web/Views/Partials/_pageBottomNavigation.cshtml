@inherits UmbracoViewPage<ContentModels.BottomNavigation>

@using Umbraco.Cms.Core.Models;
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@using System.Linq;
@inject Umbraco.Cms.Core.Models.PublishedContent.IPublishedValueFallback PublishedValueFallback
@{
    var _model = Model;
}

@{


    foreach (var menuData in (IEnumerable<IPublishedElement>)_model.LinkItems)
    {
        if (menuData.Value(PublishedValueFallback, "linkItems") != null)
        {
            <div class="col-sm-3 footer-category">
                <div class="heading">@menuData.Value(PublishedValueFallback, "categoryName")</div>
                <ul>
                    @foreach (var relatedLink in (IEnumerable<IPublishedElement>)menuData.Value(PublishedValueFallback, "linkItems"))
                    {
                        if (relatedLink.Value(PublishedValueFallback, "nCurlLink") != null)
                        {
                            string pageSection = "";

                            if (relatedLink.Value(PublishedValueFallback, "nCpageSection") != null)
                            {
                                pageSection = relatedLink.Value(PublishedValueFallback, "nCpageSection").ToString();
                            }
                            foreach (var link in (IEnumerable<Umbraco.Cms.Core.Models.Link>)relatedLink.Value(PublishedValueFallback, "nCurlLink"))
                            {
                                if (link.Url != "#")
                                {
                                    string _linkString = null;
                                    if (pageSection != "")
                                    {
                                        _linkString = link.Url + pageSection;
                                    }
                                    else
                                    {
                                        _linkString = link.Url;
                                    }
                                    <li><a href="@_linkString">@link.Name</a></li>
                                }
                                else
                                {
                                    var filePath = ((ContentModels.File)relatedLink.Value(PublishedValueFallback, "nCdocument"))?.UmbracoFile?.ToString() ?? "";
                                    <li><a href="@filePath" target="_blank">@relatedLink.Value(PublishedValueFallback, "nCtext")</a></li>

                                }
                            }
                        }

                    }
                </ul>
            </div>
        }
    }
    <div class="col-sm-3 footer-category">

        @foreach (var menuData in (IEnumerable<IPublishedElement>)Model.LinkItems)
        {
            if (menuData.Value(PublishedValueFallback, "listOfRichTextItems") != null)
            {

                <div class="heading">@menuData.Value(PublishedValueFallback, "categoryName")</div>
                <ul>
                    <li></li>
                    @foreach (var richTextEditor in (IEnumerable<IPublishedElement>)menuData.Value(PublishedValueFallback, "listOfRichTextItems"))
                    {
                        @Html.Raw(richTextEditor.Value(PublishedValueFallback, "nCtextEditor"))
                    }
                </ul>

            }
        }

    </div>

}

    }
    
    .claim-flex-item1-white-bg-p {
        text-align: right;
        font: normal normal medium 32px/39px Montserrat !important;
        letter-spacing: 0px;
        color: #EEEEEE;
    }
    
.claim-flex-item1-green-bg-p {

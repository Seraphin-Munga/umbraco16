        margin-bottom: 20px;
        border: 1px solid #ddd;
        border-radius: 5px;
        font-size: 1rem;
    }
    
    .stepper-button {
        padding: 10px 20px;
        margin: 10px 5px;
        border: none;
        border-radius: 5px;
        background-color: #007bff;
        color: white;
        cursor: pointer;
        font-size: 0.6rem;
    }
    
    button.claim-prev-button {
        background-color: #6c757d00;
    }
    
    button:hover {
        opacity: 0.9;
    }
    
    .next-button {
        width: 100%;
        background: #C4D82E;
        box-shadow: 2px 5px 10px #00000029;
        border-radius: 50px;
        height: 45px;
        color: white;
        cursor: pointer;
        font-size: 1rem;
    }
    
    .claim-prev-button {
        background: transparent;
        float: left;

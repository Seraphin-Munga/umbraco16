    /* Responsive styles */
    @@media (max-width: 992px) {
        .main-stepper-container {
            margin-top: 0;
        }
    
        .claim-container {
            margin-left: 5%;
            margin-right: 5%;
        }
    
        .form-content {
            width: 85%;
        }
    
        .stepper-container {
            width: 80%;
        }
    
        .input {
            width: 70%;
        }
    
        .claim-flex-container {
            flex-direction: column;
        }
    }
    
    @@media (max-width: 768px) {
    .claim-flex-item1-bg {

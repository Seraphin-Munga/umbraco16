    .main-stepper-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
        margin-top: 20px;
        background-color: transparent;
    }
    
    .stepper-container {
        display: block !important;
        width: 60%;
        padding: 0;
        background: transparent;
    }
    
    .stepper-header {
        display: flex;
        justify-content: space-between;
        padding: 10px 0;
        background-color: transparent;
        border: none;
        margin-bottom: 20px;
    }
    
    .step {
        flex: 1;
        text-align: center;
        padding: 10px 0;
        cursor: pointer;
        position: relative;
        font-size: 1rem;
        color: #6c757d;
        font-weight: 500;
    }
    
    .step.active {
        font-size: 20px !important;
        text-decoration: underline !important;
        text-decoration-color: #C4D82E !important; 
        text-underline-offset: 5px !important;
        font-weight: bold !important;
        color: #00285a !important;
    }
    
    .step:not(:last-child)::after {
        content: '\203A';
        display: inline-block;
        margin-left: 10px;
        margin-right: 10px;
        color: #6c757d;
    }
    
    .claim-step-content {
        display: none;
    }
    
    .claim-step-content.active {
        display: block;
    }
    
    p {
        margin: 0px 0px
    }
    
    h2 {
        color: #007bff;
        margin-bottom: 10px;
    }
    
    .stepper-p {
        margin-bottom: 20px;
        color: #666;
    }
    
    .stepper-label {
        display: block;
        margin-bottom: 5px;
        font-weight: bold;
        color: #000000;
    }
    
    .stepper-input {
        margin-top: 15px;

<script>
    $(document).ready(function () {
  var investmentTypes = [
        {value: "Fixed Deposit", key: "Fixed Deposit"}, 
        {value: "Notice Deposit", key: "Notice Deposit"}, 
        {value: "Access Accumulator", key: "Access Accumulator"},
        {value: "Tax Free", key: "TxFree"},
    ];

    // Populate the select element with options
    var selectElement = $('.investmentType');
    $.each(investmentTypes, function (index, value) {
        selectElement.append($('<option>', {
            value: value.key,
            text: value.value
        }));
    });

    var path = window.location.pathname;
    console.log("Path: " + path);

    var modifiedString = path.replace(/\/en\/home\//g, "");

    var accumulator = modifiedString.indexOf("accumulator");
    var investment = modifiedString.indexOf("fixed-deposit-investment");
    var tax = modifiedString.indexOf("product-tax-free");
    var notice = modifiedString.indexOf("notice");

    var investmentData = "";

    if (accumulator !== -1) {
        investmentData = "Access Accumulator";
    } else if (notice !== -1) {
        investmentData = "Notice Deposit";
    } else if (tax !== -1) {
        investmentData = "TxFree";
    } else if (investment !== -1) {
        investmentData = "Fixed Deposit";
    }

    // Set the selected option based on investmentData
    selectElement.val(investmentData);   
        
        var investmentName = '@InvestmentNameStr' // Example investment name
        
      sessionStorage.setItem("InvestmentNameStr", investmentName);
        
        var filteredTypes = investmentTypes.filter(function(type) {
            return type.includes(investmentName);
           
        });
        
        // Set the value of the select element to the first matching element
        if (filteredTypes.length > 0) {
            $('.investmentType').val(filteredTypes[0]);
        }
    });
</script>






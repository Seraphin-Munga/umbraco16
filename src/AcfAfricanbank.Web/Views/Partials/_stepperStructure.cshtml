@inherits Umbraco.Web.Mvc.UmbracoViewPage
<style>
    /* Combined styles.css */
    
    /* General styles */
    
    .claim-flex-item1-white-bg-p {
        text-align: right;
        font: normal normal medium 32px/39px Montserrat !important;
        letter-spacing: 0px;
        color: #EEEEEE;
    }
    
.claim-flex-item1-green-bg-p {
    margin: 20px 0px !important;
    text-align: right;
    font: italic normal 800 62px / 39px Montserrat;
    letter-spacing: 0px;
    color: #C4D82E !important;
}
    
    .claim-flex-item1-bg{
       
        background-color:#00285A !important;
    }
    
    .has-success .form-control {
    border-color: #C4D82E !important;
}
    
    .stepper-text-header{
        font: normal normal 600 14px/15px Montserrat;
        letter-spacing: 0px;
        color: #00132A;
        opacity: 1;
    }

    
    .main-stepper-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
        margin-top: 20px;
        background-color: transparent;
    }
    
    .stepper-container {
        display: block !important;
        width: 60%;
        padding: 0;
        background: transparent;
    }
    
    .stepper-header {
        display: flex;
        justify-content: space-between;
        padding: 10px 0;
        background-color: transparent;
        border: none;
        margin-bottom: 20px;
    }
    
    .step {
        flex: 1;
        text-align: center;
        padding: 10px 0;
        cursor: pointer;
        position: relative;
        font-size: 1rem;
        color: #6c757d;
        font-weight: 500;
    }
    
    .step.active {
        font-size: 20px !important;
        text-decoration: underline !important;
        text-decoration-color: #C4D82E !important; 
        text-underline-offset: 5px !important;
        font-weight: bold !important;
        color: #00285a !important;
    }
    
    .step:not(:last-child)::after {
        content: '\203A';
        display: inline-block;
        margin-left: 10px;
        margin-right: 10px;
        color: #6c757d;
    }
    
    .claim-step-content {
        display: none;
    }
    
    .claim-step-content.active {
        display: block;
    }
    
    h2 {
        color: #007bff;
        margin-bottom: 10px;
    }
    
    .stepper-p {
        margin-bottom: 20px;
        color: #666;
    }
    
    .stepper-label {
        display: block;
        margin-bottom: 5px;
        font-weight: bold;
        color: #000000;
    }
    
    .stepper-input {
        width: 50%;
        padding: 10px;
        margin-bottom: 20px;
        border: 1px solid #ddd;
        border-radius: 5px;
        font-size: 1rem;
    }
    
    .stepper-button {
        padding: 10px 20px;
        margin: 10px 5px;
        border: none;
        border-radius: 5px;
        background-color: #007bff;
        color: white;
        cursor: pointer;
        font-size: 0.6rem;
    }
    
    button.claim-prev-button {
        background-color: #6c757d00;
    }
    
    button:hover {
        opacity: 0.9;
    }
    
    .next-button {

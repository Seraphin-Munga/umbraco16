        background: #C4D82E;
        box-shadow: 2px 5px 10px #00000029;
        border-radius: 50px;
        height: 45px;
        color: white;
        cursor: pointer;
        font-size: 1rem;
    }
    
    .claim-prev-button {
        background: transparent;
        float: left;
        gap: 5px;
        display: flex;
        align-items: center;
        border: none;
        padding: 10px;
        color: white !important;
        cursor: pointer;
    }
    
    .claim-prev-button svg {
        transition: all 0.3s ease;
    }
    
    .claim-prev-button p {
        margin: 0;
        font-size: 16px;
    }
    
    .claim-prev-button:hover svg {

@inherits Umbraco.Web.Mvc.UmbracoViewPage
@model Umbraco.Core.Models.IPublishedContent
@using ContentModels = Umbraco.Web.PublishedModels;
@using System.Configuration;
@{
    var children = Model;

    // Get calculator Children
    var calculatorBody = children; // ?.Where(c => c.DocumentTypeAlias.ToLower() == "loancalculatortype").FirstOrDefault();
    var calculatorData = calculatorBody.GetPropertyValue<IEnumerable<IPublishedContent>>("CalculatorView");
    var panelItem = calculatorBody.Children.Where(x => x.DocumentTypeAlias.ToString().ToLower() == "panel").FirstOrDefault();
    var panelData = panelItem.GetPropertyValue<IEnumerable<IPublishedContent>>("PanelListitems");

    var applyNowButton = panelItem.Children.Where(c => c.DocumentTypeAlias.ToLower() == "ebankitabstractbutton").FirstOrDefault();
    var buttonLink = "#";
    var buttonLinkVal = applyNowButton?.GetPropertyValue("ebankITButtonExternalLink")?.ToString();
    var buttonText = applyNowButton?.GetPropertyValue("ebankITButtonText")?.ToString();
    buttonLink = (string.IsNullOrEmpty(buttonLinkVal)) ? buttonLink : buttonLinkVal;

    var termConditionLink = panelItem.Children.Where(c => c.DocumentTypeAlias.ToLower() == "elementsindocumentcategory").FirstOrDefault();
    var finalLynk = "#";
    var linkValue = termConditionLink.GetPropertyValue<IEnumerable<IPublishedContent>>("documents");
    foreach (var tcItem in linkValue)
    {
        var tcButton = tcItem.GetPropertyValue<IPublishedContent>("file").Url;
        finalLynk = (string.IsNullOrEmpty(tcButton)) ? finalLynk : tcButton;
    }
    var linkText = termConditionLink?.GetPropertyValue("category")?.ToString();
}

<link href="~/css/loan_calculator.css" rel="stylesheet" />

<style>
    .instant-application {
        padding-bottom: 1px;
        max-width: 920px;
        min-height: 400px;
        margin: auto;
        box-shadow: 0px 10px 20px rgba(0,0,0,0.22);
    }

    .right-form {
        background: #011F44;
        border-top-right-radius: 10px;
        border-bottom-right-radius: 10px;
        color: #fff;
        height: 456px;
        padding: 25px;
        text-align: center;
        /* padding-bottom: 10px; */
    }

    .button.primary:hover {
        background-color: #fff;
        color: #002b60;
    }

    .disabled {
        pointer-events: none;
    }

    @@media (min-width: 768px) and (max-width: 1024px) {
        .right-form {
            background: #011F44;
            border-top-right-radius: 0px;
            border-bottom-right-radius: 0px;
            color: #fff;
            height: 456px;
            padding: 70px;
            text-align: center;
            top: 50px;
            /* padding-bottom: 10px; */
        }

        .left-form {
            background: #002B60;
            border-top-left-radius: 0px;
            border-bottom-left-radius: 0px;
            color: #fff;
            padding: 0px;
        }

        .loan-form {
            padding: 17px;
            text-align: center;
        }

        .changer {
            border-top: solid 1px #011F44;
            background: #002B60;
            height: 50px;
            width: 100%;
            border-bottom-left-radius: 0px;
        }
    }

    @@media (min-width: 320px) and (max-width: 425px) {
        .right-form {
            background: #011F44;
            border-top-right-radius: 0px;
            border-bottom-right-radius: 0px;
            color: #fff;
            height: 456px;
            padding: 25px;
            text-align: center;
            /* padding-bottom: 10px; */
        }
    }
    /*For value bubble*/
    .range-wrap {
        /*width: 500px;*/
        position: relative;
        top: 10px;
    }

    .range-value {
        position: absolute;
        top: -50%;
    }

        .range-value span {
            width: 50px;
            top: -40px;
            height: 24px;
            line-height: 24px;
            text-align: center;
            background: #03a9f4;
            color: #fff;
            font-size: 12px;
            display: block;
            position: absolute;
            left: 55%;
            transform: translate(-50%, 0);
            border-radius: 2px;
        }

            .range-value span:before {
                content: "";
                position: absolute;
                width: 0;
                height: 0;
                border-top: 10px solid #03a9f4;
                border-left: 5px solid transparent;
                border-right: 5px solid transparent;
                top: 100%;
                left: 50%;
                margin-left: -5px;
                margin-top: -1px;
            }

    input:focus, select:focus {
        outline: none;
    }
</style>

<div class="container">
    <h1 style="text-align: center">Instant Loan Application</h1>
    <div class="instant-application">
        <div class="row the-form">
            @* <div class="col-md-12 left-form">*@
            <div class="col-md-12">
                @{
                    if (calculatorData != null)
                    {
                        int idCounter = 1;
                        foreach (var calItem in calculatorData)
                        {
                            <form class="loan-form form@(idCounter)">
                                <h1 style="text-align: center">@calItem.GetPropertyValue("headingDescription")</h1>
                                <label id="error-loanamount@(idCounter)" style="color:red"></label>
                                <input id="input-Amount@(idCounter)" class="loan-inpt" type="text" value="5000" onkeypress="return (event.charCode == 8 || event.charCode == 0 || event.charCode == 13) ? null : event.charCode >= 48 && event.charCode <= 57">
                                <div class="row" style="margin-bottom: -7px">
                                    <div class="col-xs-4" style="text-align: left; font-size:10px;top:15px">R@(calItem.GetPropertyValue("startamount"))</div>
                                    <div class="col-xs-4"></div>
                                    <div class="col-xs-4" style="text-align: right; font-size:10px;top:15px">R@(calItem.GetPropertyValue("endamount"))</div>
                                </div>
                                <div class="range-wrap">
                                    <div class="range-value" id="rangeV@(idCounter)"></div>
                                    <input id="slide-range@(idCounter)" type="range" class="loan-range" min="@calItem.GetPropertyValue("startamount")" max="@calItem.GetPropertyValue("endamount")" step="500" value="5000">
                                </div>
                                <select class="loan-select-term" id="term@(idCounter)">
                                    <option value="3">3 Months</option>
                                    <option value="6">6 Months</option>
                                    <option value="12" selected>12 Months</option>
                                    <option value="48">48 Months</option>
                                    <option value="60">60 Months</option>
                                    <option value="72">72 Months</option>
                                </select>
                                <div class="row" style="margin-bottom: -7px">
                                    <div class="col-xs-4" style="text-align: left; font-size:10px; top:5px">@calItem.GetPropertyValue("startTerm")</div>
                                    <div class="col-xs-4"></div>
                                    <div class="col-xs-4" style="text-align: right; font-size:10px; top:5px ">@calItem.GetPropertyValue("endTerm")</div>
                                </div>
                                <input id="input-month@(idCounter)" type="range" class="loan-range" min="3" max="72" value="12">
                                <div class="repayment">
                                    <div class="col-md-6">@calItem.GetPropertyValue("outputDescription")</div>
                                    <div class="col-md-6 repayment-amount"><input id="installment_calc@(idCounter)" style="color:#89BC47;" class="loan-inpt-return" type="text" value="" readonly>	</div>
                                </div>
                            </form>
                            idCounter++;
                        }
                    }
                }

                <div class="changer">
                    <div class="col-xs-10 switch-text"><p>Calculate based on your monthly repayment budget </p></div>
                    <div class="col-xs-1 switch-loan"><img src="~/media/53020/baseline_compare_arrows_white_48dp.png" width="30" alt="" /></div>
                </div>
            </div>
            
            @*
            <div class="col-md-4 right-form">
                <h4 style="color:#ffffff">@panelItem.GetPropertyValue("headingDescription")</h4>
                <div class="required-documents">
                    @{
                        if (panelData != null)
                        {
                            foreach (var item in panelData)
                            {
                                if ((bool)item.GetPropertyValue("isControlVisible") == true)
                                {
                                    var imgsrc = item.GetPropertyValue<IPublishedContent>("ebankITImage").Url;
                                    <div style="float:left; margin-right: 15px"><img src="@imgsrc" width="27" alt="" /></div><p> @item.GetPropertyValue("ebankITContent")</p>
                                    <br>
                                }
                            }
                        }
                    }

                </div>
                <p class="loan-disclaimer">* Please note that the amounts calculated  are indicative.</p>
                @if (applyNowButton != null)
                {
                    <a id="btnApply" href="@buttonLink" class="button primary clearfix" style="background-color: #88bc47 !important;">
                        @buttonText
                    </a>
                }
                <div class="terms-con"><a href="@finalLynk" style="color:white">@linkText</a></div>
            </div>
            
             *@
        </div>
    </div>
</div>

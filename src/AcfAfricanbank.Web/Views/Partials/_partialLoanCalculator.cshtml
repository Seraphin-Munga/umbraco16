Note: section script will only work if it's called from the parent (Personal Loan) - if you call it from here; it will not work 

@section scripts {
    <script>
        jQuery(document).ready(function () {
            jQuery(".changer").click(function () {
                jQuery(".form1").slideToggle('swing');
                jQuery(".form2").slideToggle('swing');
            });
            var loan = $("#input-Amount1").val();
            /******set color for range slider********************/
            var valPercent = (loan - parseInt($('#slide-range1').attr('min'))) /
                (parseInt($('#slide-range1').attr('max')) - parseInt($('#slide-range1').attr('min')));
            $('#slide-range1').css('background-image', '-webkit-gradient(linear, 0% 0%, 100% 0%, color-stop(' + valPercent + ', #05f1f5), color-stop(' + valPercent + ', #074FA8))');

            var loanterm = $('#term1').val();
            var valPercent = (loanterm - parseInt($('#input-month1').attr('min'))) /
                (parseInt($('#input-month1').attr('max')) - parseInt($('#input-month1').attr('min')));
            $('#input-month1').css('background-image', '-webkit-gradient(linear, 0% 0%, 100% 0%, color-stop(' + valPercent + ', #05f1f5), color-stop(' + valPercent + ', #074FA8))');
            /***************** End of set color**********************/
            $('#error-loanamount1').css('display', 'none');
            installmentEstimator(loan, loanterm);
            var afordibility = $("#input-Amount2").val();
            /******set color for range slider********************/
            var valPercent2 = (afordibility - parseInt($('#slide-range2').attr('min'))) /
                (parseInt($('#slide-range2').attr('max')) - parseInt($('#slide-range2').attr('min')));
            $('#slide-range2').css('background-image', '-webkit-gradient(linear, 0% 0%, 100% 0%, color-stop(' + valPercent2 + ', #05f1f5), color-stop(' + valPercent2 + ', #074FA8))');

            var newloanterm = $('#term2').val();
            var valPercent = (loanterm - parseInt($('#input-month2').attr('min'))) /
                (parseInt($('#input-month2').attr('max')) - parseInt($('#input-month2').attr('min')));
            $('#input-month2').css('background-image', '-webkit-gradient(linear, 0% 0%, 100% 0%, color-stop(' + valPercent + ', #05f1f5), color-stop(' + valPercent + ', #074FA8))');
            /***************** End of set color**********************/
            $('#error-loanamount2').css('display', 'none');
            loanSizeCalculator(afordibility, newloanterm);
            /**************** value bubble show hide on mouse hover*************************/
            $("#slide-range1").on("mouseup", function () {
                $("#rangeV1").css("display", "none");
            });
            $("#slide-range1").on("mousedown", function () {
                $("#rangeV1").css("display", "block");
            });
            $("#slide-range2").on("mouseup", function () {
                $("#rangeV2").css("display", "none");
            });
            $("#slide-range2").on("mousedown", function () {
                $("#rangeV2").css("display", "block");
            });
            /**************** end of bubble show hide on mouse hover*************************/
        });

        $('#slide-range1').on('input', function () {
            var newVal = $(this).val();
            $("#input-Amount1").val(newVal);
            /**************display value bubble*********************/
            var newValue = Number((newVal - $('#slide-range1').attr('min')) * 100 / ($('#slide-range1').attr('max') - $('#slide-range1').attr('min')));
            var newPosition = 10 - (newValue * 0.2);
            $('#rangeV1').append('<span>' + newVal + '</span>');
            $('#rangeV1').css('left', 'calc(' + newValue + '% + (' + newPosition + 'px))');
            /******************End of dispaly value bubble********************/
            /********************Set color for range slider**********************/
            var valPercent = (newVal - parseInt($('#slide-range1').attr('min'))) /
                (parseInt($('#slide-range1').attr('max')) - parseInt($('#slide-range1').attr('min')));
            $('#slide-range1').css('background-image', '-webkit-gradient(linear, 0% 0%, 100% 0%, color-stop(' + valPercent + ', #05f1f5), color-stop(' + valPercent + ', #074FA8))');
            /****************End of set color**************************************/
            var loanterm = $('#term1').val();
            installmentEstimator(newVal, loanterm);
        });
        $('#input-Amount1').on('input', function () {
            var loan = $(this).val();
            if (parseInt(loan) < 2000 || parseInt(loan) > 250000 || loan == "") {
                $('#error-loanamount1').css('display', 'block');
                $('#error-loanamount1').text('Please enter loan amount in between R2000 to R250000');
                $('#btnApply').addClass('disabled');
            }
            else {
                $('#slide-range1').val(loan);
                var loanterm = $('#term1').val();
                installmentEstimator(loan, loanterm);
                $('#error-loanamount1').text('');
                $('#error-loanamount1').css('display', 'none');
                $('#btnApply').removeClass('disabled');
            }
            /********************Set color for range slider**********************/
            var valPercent = (loan - parseInt($('#slide-range1').attr('min'))) /
                (parseInt($('#slide-range1').attr('max')) - parseInt($('#slide-range1').attr('min')));
            $('#slide-range1').css('background-image', '-webkit-gradient(linear, 0% 0%, 100% 0%, color-stop(' + valPercent + ', #05f1f5), color-stop(' + valPercent + ', #074FA8))');
            /****************End of set color**************************************/
        });

        $('#term1').on('input', function () {
            var newVal = $(this).val();
            $("#input-month1").val(newVal);
            var loan = $("#input-Amount1").val();
            installmentEstimator(loan, newVal);
            /******set color for range slider********************/
            var valPercent = (newVal - parseInt($('#input-month1').attr('min'))) /
                (parseInt($('#input-month1').attr('max')) - parseInt($('#input-month1').attr('min')));
            $('#input-month1').css('background-image', '-webkit-gradient(linear, 0% 0%, 100% 0%, color-stop(' + valPercent + ', #05f1f5), color-stop(' + valPercent + ', #074FA8))');
            /***************** End of set color**********************/
        });
        $('#input-month1').on('input', function () {
            var loanterm = $(this).val();
            var newloanterm;
            if (loanterm >= 3 && loanterm <= 5)
                newloanterm = 3;
            else if (loanterm >= 6 && loanterm <= 11)
                newloanterm = 6;
            else if (loanterm >= 12 && loanterm <= 47)
                newloanterm = 12;
            else if (loanterm >= 48 && loanterm <= 59)
                newloanterm = 48;
            else if (loanterm >= 60 && loanterm <= 71)
                newloanterm = 60;
            else
                newloanterm = 72
            $('#term1').val(newloanterm);
            var loan = $("#input-Amount1").val();
            installmentEstimator(loan, newloanterm);
            /******set color for range slider********************/
            var valPercent = (loanterm - parseInt($('#input-month1').attr('min'))) /
                (parseInt($('#input-month1').attr('max')) - parseInt($('#input-month1').attr('min')));
            $('#input-month1').css('background-image', '-webkit-gradient(linear, 0% 0%, 100% 0%, color-stop(' + valPercent + ', #05f1f5), color-stop(' + valPercent + ', #074FA8))');
            /***************** End of set color**********************/
        });

        function installmentEstimator(loan, loanterm) {
            var loan_amount = parseInt(loan);
            var term = loanterm;
            var initiation_fee = 0;
            var principal_debt = 0;
            var installment = 0;
            //var loan_amount = 50000.00;
            //var term = 72;
            var vat = 0.15;
            var repo = .0375;
            var interest_rate = 0.2475;
            var insurance_premium = 0.0045;
            initiation_fee = Math.max(Math.min(Math.min(165 + (loan_amount - 1000) * 0.1, 1050), loan_amount * 0.15), 0);
            principal_debt = loan_amount + initiation_fee * 1.15;
            var service_fee = 60 * 1.15;
            installment = ((principal_debt * interest_rate / 12) / (1 - 1 / Math.pow((1 + interest_rate / 12), term)) + insurance_premium * principal_debt + service_fee).toFixed(2);
            $('#installment_calc1').val(installment);
        }
        /********************************************* Loan Size Estimator *******************************************************************************************/
        $('#slide-range2').on('input', function () {
            var newVal = $(this).val();
            $("#input-Amount2").val(newVal);
            /******************* Display value bubble****************/
            var newValue = Number((newVal - $('#slide-range2').attr('min')) * 100 / ($('#slide-range2').attr('max') - $('#slide-range2').attr('min')));
            var newPosition = 10 - (newValue * 0.2);
            $('#rangeV2').append('<span>' + newVal + '</span>');
            $('#rangeV2').css('left', 'calc(' + newValue + '% + (' + newPosition + 'px))');
            /****************End of display value bubble******************/
            /********************Set color for range slider**********************/
            var valPercent = (newVal - parseInt($('#slide-range2').attr('min'))) /
                (parseInt($('#slide-range2').attr('max')) - parseInt($('#slide-range2').attr('min')));
            $('#slide-range2').css('background-image', '-webkit-gradient(linear, 0% 0%, 100% 0%, color-stop(' + valPercent + ', #05f1f5), color-stop(' + valPercent + ', #074FA8))');
            /**********************End of set colour*************************/
            var loanterm = $('#term2').val();
            var affordibility = $("#input-Amount2").val();
            loanSizeCalculator(affordibility, loanterm);
        });
        $('#input-Amount2').on('input', function () {
            var loan = $(this).val();
            if (parseInt(loan) < 500 || parseInt(loan) > 50000 || loan == "") {
                $('#error-loanamount2').css('display', 'block');
                $('#error-loanamount2').text('Please enter affordibility amount in between R500 to R50000');
                $('#btnApply').addClass('disabled');
            }
            else {
                $('#slide-range2').val(loan);
                var loanterm = $('#term2').val();
                var affordibility = $("#input-Amount2").val();
                loanSizeCalculator(affordibility, loanterm);
                $('#error-loanamount2').css('display', 'none');
                $('#error-loanamount2').text('');
                $('#btnApply').removeClass('disabled');
            }
            /********************Set color for range slider**********************/
            var valPercent = (loan - parseInt($('#slide-range2').attr('min'))) /
                (parseInt($('#slide-range2').attr('max')) - parseInt($('#slide-range2').attr('min')));
            $('#slide-range2').css('background-image', '-webkit-gradient(linear, 0% 0%, 100% 0%, color-stop(' + valPercent + ', #05f1f5), color-stop(' + valPercent + ', #074FA8))');
            /****************End of set color**************************************/
        });
        $('#term2').on('input', function () {
            var newVal = $(this).val();
            /******set color for range slider********************/
            var valPercent = (newVal - parseInt($('#input-month2').attr('min'))) /
                (parseInt($('#input-month2').attr('max')) - parseInt($('#input-month2').attr('min')));
            $('#input-month2').css('background-image', '-webkit-gradient(linear, 0% 0%, 100% 0%, color-stop(' + valPercent + ', #05f1f5), color-stop(' + valPercent + ', #074FA8))');
            /***************** End of set color**********************/
            $("#input-month2").val(newVal);
            var afordibility = $("#input-Amount2").val();
            loanSizeCalculator(afordibility, newVal);
        });
        $('#input-month2').on('input', function () {
            var loanterm = $(this).val();
            var newloanterm;
            if (loanterm >= 3 && loanterm <= 5)
                newloanterm = 3;
            else if (loanterm >= 6 && loanterm <= 11)
                newloanterm = 6;
            else if (loanterm >= 12 && loanterm <= 47)
                newloanterm = 12;
            else if (loanterm >= 48 && loanterm <= 59)
                newloanterm = 48;
            else if (loanterm >= 60 && loanterm <= 71)
                newloanterm = 60;
            else
                newloanterm = 72
            $('#term2').val(newloanterm);
            var afordibility = $("#input-Amount2").val();
            loanSizeCalculator(afordibility, newloanterm);
            /******************set colour for range slider****************/
            var valPercent = (loanterm - parseInt($('#input-month2').attr('min'))) /
                (parseInt($('#input-month2').attr('max')) - parseInt($('#input-month2').attr('min')));
            $('#input-month2').css('background-image', '-webkit-gradient(linear, 0% 0%, 100% 0%, color-stop(' + valPercent + ', #05f1f5), color-stop(' + valPercent + ', #074FA8))');
            /**********************End of set colour************************/
        });


        function loanSizeCalculator(afordibility, loanterm) {
            var afordibility = parseInt(afordibility);
            var term = loanterm;
            var vat = 0.15;
            var repo = .0375;
            var interest_rate = 0.15;
            var insurance_premium = 0.0045;
            var service_fee = 60 * 1.15;
            var principal_debt = (((afordibility - service_fee) * (1 - Math.pow((1 + interest_rate / 12), -term))) / (interest_rate / 12 + insurance_premium * (1 - Math.pow((1 + interest_rate / 12), -term)))).toFixed(2);
            var LC1a = (principal_debt - 165 * (1 + vat)).toFixed(2);
            var LC1b = ((principal_debt - (165 - 0.1 * 1000) * (1 + vat)) / (1 + 0.1 * (1 + vat))).toFixed(2);
            var LC1 = (Math.min(LC1a, LC1b)).toFixed(2);
            var LC2 = (principal_debt - 1050 * (1 + vat)).toFixed(2);
            var LC3 = (principal_debt / (1 + 0.15 * (1 + vat))).toFixed(2);
            var loanAmount = (Math.min(Math.max((Math.floor(Math.max(LC1, LC2, LC3) / 50, 0) * 50), 2000), 250000)).toFixed(2);
            $('#installment_calc2').val(loanAmount);
        }

    </script>
}

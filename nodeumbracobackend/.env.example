# Copy this file to .env and fill in real values. .env is gitignored.

PORT=3000

# --- Database (ported from Platform/Web/Web.config <connectionStrings>) ---
DB_HOST=
DB_INSTANCE=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# --- External APIs (ported from Platform/Web/Web.config <appSettings>) ---
# NOTE: "creditLife" and "quickLoanApi" are read by the legacy controllers via
# ConfigurationManager.AppSettings but were never actually defined in Web.config,
# so they were effectively null in production. Left blank here for parity;
# fill in if you know the real values.
CREDIT_LIFE_API_URL=
CREDIT_API_URL=https://api.stg.africanbank.net/v2/leads
INVESTMENT_API_URL=https://api.stg.africanbank.net/v2/leads
APPLICATION_TRACKER_API_URL=https://api.stg.africanbank.net/v2/clients/search
GET_APPLICATION_TRACKER_API_URL=https://api.stg.africanbank.net/v2/applications/search
GET_APPLICATION_TRACKER_GET_OFFER_API_URL=https://api.stg.africanbank.net/rest/abPsCreditService/application/offers
GET_APPLICATION_TRACKER_GET_DOCUMENTS_API_URL=https://api.stg.africanbank.net/rest/abPsEbanKITDocumentService/required/list
SEND_SMS_API_URL=https://api.stg.africanbank.net/v2/communications/sms
QUICK_LOAN_API_URL=

# --- ebankit Basic Auth (per-environment passwords, ported from ReturnBasicAuth) ---
EBANKIT_AUTH_USERNAME=ebankit
EBANKIT_AUTH_PASSWORD_DEV=
EBANKIT_AUTH_PASSWORD_INT=
EBANKIT_AUTH_PASSWORD_STG=
EBANKIT_AUTH_PASSWORD_TRN=
EBANKIT_AUTH_PASSWORD_DEFAULT=

# --- Investment calculator (ebankit, separate fixed creds) ---
INVESTMENT_CALCULATOR_QUOTES_URL=http://api.int.africanbank.net/v2/quotes
INVESTMENT_CALCULATOR_AUTH_USERNAME=ebankit
INVESTMENT_CALCULATOR_AUTH_PASSWORD=

# --- Outbound mail (Call Me Back / campaign survey notifications) ---
SMTP_HOST=
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
MAIL_TO=

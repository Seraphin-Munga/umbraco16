# Overrides for docker-compose.yml - copy to .env and edit as needed.
# Every value here already has a default in docker-compose.yml matching
# this project's current server (37.27.4.29) - only set what you need to
# change for a different environment.

MSSQL_SA_PASSWORD=Sera1234!@
MSSQL_DATABASE=Umbraco16_AB_CMS_10Sept
MSSQL_MEMORY_LIMIT_MB=1536

# Host path holding the real uploaded media files (bind-mounted into the
# backend container at /app/wwwroot/media).
MEDIA_HOST_PATH=/root/platform-umbraco16-media

UMBRACO_ADMIN_NAME=Admin
UMBRACO_ADMIN_EMAIL=sngoymunga733@gmail.com
UMBRACO_ADMIN_PASSWORD=UmbracoAdmin1!

# Where a browser can actually reach the backend - baked into the frontend
# bundle at build time (Vite inlines VITE_* then, not at container start).
PUBLIC_BACKEND_URL=http://37.27.4.29:889

BACKEND_PORT=889
FRONTEND_PORT=8070

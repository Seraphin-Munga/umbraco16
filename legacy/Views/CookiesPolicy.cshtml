@inherits Umbraco.Web.Mvc.UmbracoViewPage<ContentModels.PageManageYourAccount>
@using ContentModels = Umbraco.Web.PublishedModels;
@using CustomModels = Web.Models;
@using Web.Helpers
@using Umbraco.Web.Models
@using System.Collections.Generic;
@using System.Text.RegularExpressions
@{

    Layout = "Master.cshtml";

    // All Current Page Children
    var Children = Model.Children;

    // Get specific Children
    var heroHeader = Children?.Where(c => c.ContentType.Alias.ToLower() == "heroheader").FirstOrDefault();
    var heroShoulder = Children?.Where(c => c.ContentType.Alias.ToLower() == "heroshoulder").FirstOrDefault();

    var _heroBody = Children?.Where(c => c.ContentType.Alias.ToLower() == "herobody").FirstOrDefault();

    var bodyBlurpDescription = _heroBody.Value("richTextBox");
    var footBlurpDescription = _heroBody.Value("bodyFooterTitle");

    var tabGroup = _heroBody.Children(x => x.ContentType.Alias.ToLower() == "tabgroup").FirstOrDefault();

    var tabHeader = tabGroup.Children(xx => xx.ContentType.Alias.ToLower() == "tabheader").FirstOrDefault();

    var tabBody = (TabBody)tabHeader.Children(cc => cc.ContentType.Alias.ToLower() == "tabbody").FirstOrDefault();

    var heroChest = (HeroChestFaq)Children?.Where(c => c.ContentType.Alias.ToLower() == "herochestfaq").FirstOrDefault();

    var sectionContent = (ICollection<IPublishedElement>)tabBody.TabBodyContent.Where(c => c.ContentType.Alias == "nCTabGenericContent").FirstOrDefault().Value("sectionContent");

    var questionGroups = sectionContent.Where(c => c.ContentType.Alias == "nCHeroBodyFaq").FirstOrDefault().Value("nCquestionGroups");
    //var dts = ApplicationContext.Current.Services.DataTypeService;

    var searchString = Request["searchstring"];

    var categoriesDropdownId = 18428;

    int isShowingCookie = 0;
    var viewName = Umbraco.AssignedContentItem.Name.Replace(" ", "");
    if (viewName == "CookiePolicy")
    {
        isShowingCookie = 1;
    }
}

<!-- HERO BANNER -->
@Html.Partial("_pageHeaderImage", heroHeader as ContentModels.HeroHeader)

<!-- HERO CONTINUED-->
@Html.Partial("_pageShoulder", heroShoulder as ContentModels.HeroShoulder)

<!-- HERO CHEST -->
<div class="container">

    @*@{
            if (isShowingCookie == 1) {
                @Html.Raw(bodyBlurpDescription)
            } else
            {
                 <div class="margin-top-100 hidden-xs"></div>

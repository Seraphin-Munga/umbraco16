    <div class="margin-top-100 hidden-xs"></div>

    <!-- HERO BODY-->

    <div class="margin-bottom-minus-60" ng-controller="ReportsAndArchievesController">
        <div class="campaign-product-container faq-section full">
            <div class="margin-top-20 visible-xs"></div>
            @{
                var groups = (IEnumerable<QuestionGroup>)questionGroups;
                var sections = groups.Select(x => x.Value("groupName")).ToList();

                foreach (var group in groups)
                {
                    var name = group.Value("groupName")?.ToString() ?? string.Empty;
                    var questions = group.Value<IEnumerable<IPublishedElement>>("questionsAndAnswers") ?? new List<IPublishedContent>();
                    var Id = Regex.Replace(name.Replace("African Bank", string.Empty), @"[^0-9a-zA-Z]+", string.Empty);

                    <div id="@name.Replace(" ", string.Empty).ToLower()" class="row sectionHeading">
                        <h3 id="@Id" class="main-title @name.Replace(" ", string.Empty).ToLower() searchItemHeader">
                            @name
                        </h3>

                        @foreach (var question in questions)
                        {
                            var Q = question.Value("question");
                            var A = question.Value("answer");

                            <div class="faq-item searchItemList" ng-show="stringContains('@Q', searchTerm)">
                                <div class="item-content">
                                    <h4 class="title text-uppercase">
                                        @Q
                                    </h4>
                                    <div class="faq content">
                                        @A
                                    </div>
                                </div>
                                @*<div class="download-icon faq-button" onclick="toggleFAQ(this)"><i class="fa fa-long-arrow-down" aria-hidden="true"></i></div>*@

                                <div class="download-icon faq-button"><i class="fas fa-long-arrow-alt-down" aria-hidden="true"></i></div>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>

    @*@{
            if (isShowingCookie == 1) {
                @Html.Raw(footBlurpDescription)
            }
        }*@

</div>
@section scripts
{
    <script>
        @*$(".faq-button").click(function(){

            $(this).siblings(".item-content").children(".content").toggle(200);

            if ($(this).parent().hasClass("active")) {
                $(this).parent().removeClass("active");
            } else {
                $(this).parent().addClass("active");
            }

        });*@

        $(".faq-item").click(function(){
            $(this).siblings(".faq-item").removeClass("active");
            $(this).addClass("active");
            $(this).siblings(".faq-item").children(".item-content").children(".content:visible").toggle(200);
            $(this).siblings(".faq-item").children(".download-icon").children(".fa-long-arrow-up").removeClass("fa-long-arrow-up").addClass("fa-long-arrow-down");
            $(this).children(".item-content").children(".content").toggle(200);
            $(this).children(".download-icon").children(".fa-long-arrow-up").removeClass("fa-long-arrow-up").addClass("fa-long-arrow-down");

        });
        $(document).ready(function () {
            $("#cmbCategories").change(function () {
                //var anchor = "." + $("#cmbCategories option:selected").val();
                //scroll to the achor
                //$("html, body").animate({ scrollTop: $($(anchor)).offset().top }, 500);
                var selected = $("#cmbCategories option:selected").val();
                $('.sectionHeading').each(function () {
                    if (selected == 'allcategories' || selected == '') { // show all categories
                        $(this).show();
                    }
                    else {
                        if ($(this).context.id == selected) {
                            $(this).show();
                        }
                        else {
                            $(this).hide();
                        }
                    }
                });

            });
        })
    </script>
}



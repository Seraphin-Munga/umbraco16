</style>
@{
    Layout = "MasterHeaderOnly.cshtml";

    var Children = Model.Content.Children;

    // Get specific Children
    var HeroHeader = Children?.Where(c => c.DocumentTypeAlias.ToLower() == "heroheader").FirstOrDefault();
    var dropOff = Children?.Where(c => c.DocumentTypeAlias.ToLower() == "pagepopup").FirstOrDefault();
    var heroBody = Children?.Where(c => c.DocumentTypeAlias.ToLower() == "herobody").FirstOrDefault();
    var login = heroBody.Children.Where(c => c.Name == "Login").FirstOrDefault() as Link;
    var register = heroBody.Children.Where(c => c.Name == "Register").FirstOrDefault() as Link;
    var quickTitle = heroBody.GetPropertyValue("bodyTitle");
    var quickBody = heroBody.GetPropertyValue("richTextBox"); ;

    var dts = ApplicationContext.Current.Services.DataTypeService;

    var salaryFrequencyDropdownId = 5389;
    var bankDropdownId = 5390;
    var bankStatementsDropdownId = 5391;
    var employmentSectorDropdownId = 5382;
    var childMaintenanceDropdownId = 5395;

    var terminateProcess = dropOff.Children.Where(c => c.Name == "Terminate process").FirstOrDefault() as DocumentTypeTitleAndDescription;
    var terminateToCall = dropOff.Children.Where(c => c.Name == "Call me back").FirstOrDefault() as DocumentTypeTitleAndDescription; ;

    var heroHeaderImage = HeroHeader.GetPropertyValue<IPublishedContent>("image")?.Url;

    @*foreach (var data in dropOff.Children)
        {
            <span>Child name @data</span>
        }*@
}
<!-- BODY -->
<div class="wizad-container container">
    <!--Start-------------drop off popup------------------->
    <div id="quick-drop-off">
        <div id="terminate-process">
            <h4>@terminateProcess.BodyTitle</h4>
            <p>@terminateProcess.BodyDescription</p>
            <a class="button secondary" href="/">Find Branch</a>
        </div>

        <div id="terminate-to-call-me">
            <p>@terminateToCall.BodyDescription</p>
            <form>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="call-id">SOUTH AFRICAN ID</label>
                            <input type="text" class="form-control" id="call-id">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="call-number">CELLPHONE NUMBER</label>
                            <input type="text" class="form-control" id="call-number">
                        </div>
                    </div>
                </div>
            </form>
        </div>

    </div>
    <!--END-------------drop off popup------------------->

    @{ var quickLoanForm = Model.Content; }
    <div ng-cosdsdntroller="Expense">
        <!--START-----------Submition pause---------------->
        <section id="form-preloader" class="pause-form">
            <div class="loader" id="form-preloader-loader">
                <div class="loader-img"></div>
            </div>
            <h4 class="form-preloader-title align-center">Please wait...</h4>
        </section>
        <!--END-------------Submittion pause--------------->
        <!-- SmartWizard html -->
        <div id="smartwizard" class="wizard">
            <ul>
                <li>
                    <a href="#step-1">
                        <span class="badge">@quickLoanForm.GetPropertyValue("step1Name")</span>
                        <p>@quickLoanForm.GetPropertyValue("step1ShortDescription")</p>
                    </a>
                </li>
                <li><a href="#step-2"><span class="badge">@quickLoanForm.GetPropertyValue("step2Name")</span><p>@quickLoanForm.GetPropertyValue("step2ShortDescription")</p></a></li>
                <li><a href="#step-3"><span class="badge">@quickLoanForm.GetPropertyValue("step3Name")</span><p>@quickLoanForm.GetPropertyValue("step3ShortDescription")</p></a></li>
                <li><a href="#step-4"><span class="badge">@quickLoanForm.GetPropertyValue("step4Name")</span><p>@quickLoanForm.GetPropertyValue("step4ShortDescription")</p></a></li>
                <li><a href="#step-5"><span class="badge">@quickLoanForm.GetPropertyValue("step5Name")</span><p>@quickLoanForm.GetPropertyValue("step5ShortDescription")</p></a></li>
            </ul>

            <div>


                <div id="step-1">
                    @*<small class="border-bottom border-gray pb-2">@quickLoanForm.GetPropertyValue("step1Heading")</small>*@
                    <div class="form-field row">
                        <form id="frmStep1">
                            @Html.AntiForgeryToken()
                            <div class="form-field row">
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label class="label">@ResourceHelper.GetResource(quickLoanForm.GetPropertyValue("quickLoansIDNumber").ToString())</label>
                                        <input type="text" id="idNumber" name="idNumber" class="form-control" placeholder="@ResourceHelper.GetResource(quickLoanForm.GetPropertyValue("quickLoansIDNumber").ToString())">
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label class="label">@ResourceHelper.GetResource(quickLoanForm.GetPropertyValue("quickLoansCellphoneNo").ToString())</label>
                                        <input type="text" id="telephoneNumber" name="telephoneNumber" class="form-control" placeholder="@ResourceHelper.GetResource(quickLoanForm.GetPropertyValue("quickLoansCellphoneNo").ToString())"
                                               required maxlength="12">
                                    </div>
                                </div>
                            </div>
                        </form>
                        <form id="frmStep1_1">
                            @Html.AntiForgeryToken()
                            <div class="form-field row form-field-hide">
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label class="label">@ResourceHelper.GetResource("title")</label>
                                        <select id="title" name="title" class="form-control">
                                            <option selected value="">Select title</option>
                                            <option value="MR">Mr</option>
                                            <option value="Mrs">Mrs</option>
                                            <option value="MISS">Miss</option>
                                        </select>
                                        <span class="glyphicon glyphicon-menu-down form-control-feedback"></span>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label class="label">@ResourceHelper.GetResource(quickLoanForm.GetPropertyValue("quickLoansName").ToString())</label>

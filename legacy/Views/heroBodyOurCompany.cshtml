        }

        .sw-toolbar-bottom {
            width: 100%;
            bottom: 10px;
            text-align: center;
            margin-left: 0px;
            position: fixed;
        }

        .sw-btn-next, .sw-btn-prev {
            width: 125px;
        }

        .sw-theme-arrows > ul.step-anchor > li {

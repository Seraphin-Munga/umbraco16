            <div class="container">
                <div class="col-md-8"></div>
                <div class="col-md-4" style="padding-top: 83px;padding-bottom: 133px;">
                    <h2 class="hero-title">
                        <span class="cap-title">@campaignFooter.GetPropertyValue("ebankITTitle")</span><br>
                        <span class="switch-content-view">@campaignFooter.GetPropertyValue("ebankITContent")</span>
                    </h2>
                    <div class="hero-description">
                        @campaignFooter.GetPropertyValue("ebankITContent")
                    </div>
                    @{
                        if (campaignFooterLink.Any())
                        {
                            foreach (var links in campaignFooterLink)
                            {
                                var buttonText = links.Caption;
                                var btnId = viewName + "_" + buttonText.ToString().Replace(" ", "") + "_" + "SowetanLiveCampaign";
                                <div class="switch-mobi-view">
                                    <a class="button primary clearfix" href="@links.Link" id="@btnId">
                                        @buttonText
                                    </a>
                                </div>
                            }
                        }
                    }
                </div>
            </div>
        </div>
    }
}


<script type="text/javascript">
    $(document).ready(function () {

        function OnSuccess(data) { }
        function OnFailure(data) { }

        function DropDown(el) {
            this.dd = el;
            this.placeholder = this.dd.children('span');
            this.opts = this.dd.find('ul.dropdown > li');
            this.val = '';
            this.index = -1;
            this.initEvents();
        }
        DropDown.prototype = {
            initEvents: function () {
                var obj = this;

                obj.dd.on('click', function (event) {
                    $(this).toggleClass('active');
                    $(this).children('input')[0].innerText = $(this)[0].children[1].innerText;
                    if ($("#sendSurvey").attr("disabled") === "disabled") {
                        $("#sendSurvey").attr("disabled", false);
                    }
                    if ($(this)[0].id === "dd0") {
                        $("#validSelection0").css("display", "none");
                        $("#ddInputResult0")[0].value = $(this)[0].children[1].innerText;
                    } else if ($(this)[0].id === "dd1") {
                        $("#validSelection1").css("display", "none");
                        $("#ddInputResult1")[0].value = $(this)[0].children[1].innerText;
                    } else if ($(this)[0].id === "dd2") {
                        $("#validSelection2").css("display", "none");
                        $("#ddInputResult2")[0].value = $(this)[0].children[1].innerText;
                    } else if ($(this)[0].id === "dd3") {
                        $("#validSelection3").css("display", "none");
                        $("#ddInputResult3")[0].value = $(this)[0].children[1].innerText;
                    }
                    return false;
                });

                obj.opts.on('click', function () {
                    var opt = $(this);
                    obj.val = opt.text();
                    obj.index = opt.index();
                    obj.placeholder.text(obj.val);
                });
            },
            getValue: function () {
                return this.val;
            },
            getIndex: function () {
                return this.index;
            }
        }

        $(function () {
            var dd = new DropDown($('#dd0'));
            var dd1 = new DropDown($('#dd1'));
            var dd2 = new DropDown($('#dd2'));
            var dd3 = new DropDown($('#dd3'));
            $(document).click(function () {
                // all dropdowns
                $('.wrapper-dropdown-3').removeClass('active');
            });

        });
    });
</script>
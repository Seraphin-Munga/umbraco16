    }
    .blue-button2
    {
        background-color: none;
        color:black;
    }
    .blue-button3
    {
        background-color: #C1D56F;
        color:#002B60;
    }
    .noShadow
    {
        box-shadow: none;
    }
    .testimonials-container
    {
       padding-bottom: 30px; 
    }
    .hero-static-caption

                            {
                                "Key": "URL",
                                "Value": window.location.href
                            }
                        ]
                    }
            requestInProgress = true;
            $("#form-loader").show();
            debugger;
                    //AJAX.request('/public/contacform/submit', {
            AJAX.request('/leads/apply', {
                        data: data,
                        success: function (e) {
                            debugger;
                            call_me_success_close();
                            call_me_success();
                            $("#form-loader").hide();
                        },
                        error: function (req, txt, err) {
                            debugger;
                            $("#form-loader").hide();

                            call_me_failed();

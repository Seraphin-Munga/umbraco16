        {
            <style>
                /*Ipad  potrait*/
                @@media only screen and (max-width: 768px) {
                    .right-bottom {
                        bottom: 13em;
                    }
                }
                /*Ipad  landscape*/
                @@media only screen and (max-width: 1024px) and (orientation: landscape) {
                    .top-header {
                        height: 65%;
                    }
                }


                /*Iphone x 812  potrait */
                @@media only screen and (max-width: 812px) {
                    /*START-----------------------------------------call me back-----------------------------------------*/
                    .st-panel {
                        height: auto;
                    }

                    .right-bottom {
                        bottom: 1em;
                    }
                    /*END-----------------------------------------call me back-----------------------------------------*/
                }


                /*Iphone 7  414 potrait */
                @@media only screen and (max-width: 414px) {
                    /*START-----------------------------------------call me back-----------------------------------------*/
                    .st-panel {
                        height: auto;
                    }

                    .right-bottom {
                        bottom: 1em;
                    }
                    /*END-----------------------------------------call me back-----------------------------------------*/
                }


                /*Nexus 5X 412 potrait*/
                @@media (max-width: 412px) {

                    .area_search {
                        margin-top: 0%;
                    }
                    /*START-----------------------------------------call me back-----------------------------------------*/
                    .st-panel {
                        height: auto;
                    }

                    .right-bottom {
                        bottom: 1em;
                    }
                    /*END-----------------------------------------call me back-----------------------------------------*/
                }
                /*landscape for Nexus 5X   412*/
                @@media only screen and (max-width: 736px) and (orientation: landscape) {
                    /*START-----------------------------------------call me back-----------------------------------------*/
                    .right-bottom {
                        bottom: 1em;
                    }
                    /*END-----------------------------------------call me back-----------------------------------------*/
                }


                @@media only screen and (max-width: 360px) {
                    .right-bottom {
                        bottom: 1em;
                    }
                }

                @@media only screen and (max-width: 640px) and (orientation: landscape) {
                    .top-header {
                        height: 58%;
                    }

                    .right-bottom {
                        bottom: 2em;
                    }
                }

                @@media (max-width: 767px) {
                    .right-bottom {
                        bottom: 7em;
                    }
                }
            </style>
        }
    }

</head>

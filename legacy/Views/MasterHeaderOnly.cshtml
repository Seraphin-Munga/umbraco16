        <script defer type="text/javascript">
        function clear_validation() {
            $("form#frmCallMeBack").bootstrapValidator("destroy");
        }

        function init_fields() {
            $('#frmCallMeBack').bootstrapValidator({
                feedbackIcons: {
                    valid: 'glyphicon glyphicon-ok-sign',
                    invalid: 'glyphicon glyphicon-remove-sign',
                    validating: 'glyphicon glyphicon-refresh'
                },
                onSuccess: function (e) {
                    e.preventDefault();

                    call_me("frmCallMeBack",@prodID , '@call_me_subject', '@call_me_contact_type');
                },
                fields: {
                    'FormFields.message': {
                        message: '@ResourceHelper.GetResource("GenericContactForm_InvalidValue")',
                        validators: {
                            notEmpty: {
                                message: '@ResourceHelper.GetResource("GenericContactForm_Message_Required")'
                            }, stringLength: {
                                max: 100,
                                message: '@ResourceHelper.GetResource("GenericContactForm_Message_LenghtValMessage")'
                            }
                        },
                        feedbackIcons: {
                            valid: '',
                            invalid: '',
                            validating: ''
                        },
                    },
                    'FormFields.firstName': {
                        message: '@ResourceHelper.GetResource("GenericContactForm_InvalidValue")',
                        validators: {
                            notEmpty: {
                                message: '@ResourceHelper.GetResource("GenericContactForm_FirstName_Required")'
                            },
                            regexp: {
                                regexp: /^[a-zA-Z-\s]+$/,
                                message: '@ResourceHelper.GetResource("GenericContactForm_FirstName_error")'
                            }, stringLength: {
                                max: 30,
                                message: '@ResourceHelper.GetResource("GenericContactForm_FirstName_LenghtValMessage")'
                            }

                        }
                    },
                    "FormFields.lastName": {
                        message: '@ResourceHelper.GetResource("GenericContactForm_InvalidValue")',
                        validators: {
                            notEmpty: {
                                message: '@ResourceHelper.GetResource("GenericContactForm_LastName_Required")'
                            },
                            regexp: {
                                regexp: /^[a-zA-Z-\s]+$/,
                                message: '@ResourceHelper.GetResource("GenericContactForm_LastName_error")'
                            }, stringLength: {
                                max: 30,
                                message: '@ResourceHelper.GetResource("GenericContactForm_LastName_LenghtValMessage")'
                            }
                        }
                    },
                    "FormFields.identityNumber": {
                        validators: {
                            notEmpty: {
                                message: '@ResourceHelper.GetResource("GenericContactForm_SAID_Required")'
                            },
                            regexp: {
                                regexp: /^[0-9]{1,13}$/,
                                message: '@ResourceHelper.GetResource("GenericContactForm_SAID_ValMessage")'
                            },
                            stringLength: {
                                max: 13,
                                message: '@ResourceHelper.GetResource("GenericContactForm_SAID_LenghtValMessage")'
                            },
                            callback: {
                                callback: function (value, validator, $field) {

                                    var idNumber = value;

                                if (null === idNumber || 0 === idNumber.length) return !1;
                                var correct = !0;
                                    if (13 !== idNumber.length || isNaN(parseFloat(idNumber)) && isFinite(idNumber)) return !1;
                                    var yob = parseInt(idNumber.substring(0, 2));
                                    var currentYear = @DateTime.Now.Year;
                                    if (yob + 2000 < currentYear) {yob = 2000 + yob
                                    } else { yob = yob + 1900; }

                                var tempDate = new Date(idNumber.substring(0, 2), idNumber.substring(2, 4) - 1, idNumber.substring(4, 6)),
                                    id_date = tempDate.getDate(),
                                    id_month = tempDate.getMonth();
                                    if (currentYear - yob >= 70 || currentYear - yob < 18) {
                                        return {
                                            valid: false,
                                            message: '@ResourceHelper.GetResource("GenericContactForm_SAID_InvalidAge")'
                                        }
                                    } // make sure the applicant is not over 70 years of age or younger than 18
                                (tempDate.getYear() != idNumber.substring(0, 2) || id_month != idNumber.substring(2, 4) - 1 || id_date != idNumber.substring(4, 6)) && (correct = !1);
                                                                    for (var tempTotal = 0, checkSum = 0, multiplier = 1, i = 0; 13 > i; ++i) tempTotal = parseInt(idNumber.charAt(i)) * multiplier, tempTotal > 9 && (tempTotal = parseInt(tempTotal.toString().charAt(0)) + parseInt(tempTotal.toString().charAt(1))), checkSum += tempTotal, multiplier = multiplier % 2 === 0 ? 1 : 2;
                                return checkSum % 10 !== 0 && (correct = !1), correct

                                }
                            }
                        }
                    },
                    'FormFields.email': {
                        message: '@ResourceHelper.GetResource("GenericContactForm_InvalidValue")',
                        validators: {
                            notEmpty: {
                                message: '@ResourceHelper.GetResource("GenericContactForm_Email_Required")'
                            },
                            regexp: {
                                regexp: /^[-a-z0-9~!$%^&*_=+}{\'?]+(\.[-a-z0-9~!$%^&*_=+}{\'?]+)*@@([a-z0-9_][-a-z0-9_]*(\.[-a-z0-9_]+)*\.(aero|arpa|biz|com|coop|edu|gov|info|int|mil|museum|name|net|org|pro|travel|mobi|[a-z][a-z])|([0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}))(:[0-9]{1,5})?$/i,
                                message: '@ResourceHelper.GetResource("GenericContactForm_Email_ValMessage")'
                            },
                            stringLength: {
                                max: 50,
                                message: '@ResourceHelper.GetResource("GenericContactForm_EMAIL_LenghtValMessage")'
                            }
                        }
                    },
                    "FormFields.mobileNumber": {
                        message: '@ResourceHelper.GetResource("GenericContactForm_InvalidValue")',
                        validators: {
                            notEmpty: {
                                message: '@ResourceHelper.GetResource("GenericContactForm_CellPhone_Required")'
                            },
                            numeric: {
                                message: '@ResourceHelper.GetResource("GenericContactForm_CellPhone_NumericValMessage")'
                            },
                            stringLength: {
                                min: 10,
                                max: 10,
                                message: '@ResourceHelper.GetResource("GenericContactForm_CellPhone_LenghtValMessage")'
                            },
                             callback: {
                                callback: function (value, validator, $field) {

                                    var cellNumber = value;
                                    if (null === cellNumber || 0 === cellNumber.length || 10 !== cellNumber.length || cellNumber == '0000000000') return !1; // not 0000000
                                    if ('0' != cellNumber.substring(0,1)) return !1; // starts with 0
                                    return !0;
                                }
                            }
                        }
                    }
                }
            });
        };
        function SubmitForm( /*hasSubmit*/) {
                    var submitedFormDateTime = new Date().toLocaleString()
                    var data = {
                        FirstName: $('#FirstNameInput').val().trim(),
                        LastName: $('#LastNameInput').val().trim(),
                        Subject: "@call_me_subject" + ' - undefined',
                        ProductID: "@prodID",
                        Email: $('#EmailInput').val().trim(),
                        CellPhone: $('#CellPhoneInput').val().trim(),
                        SAID: $('#SAIDInput').val(),
                        HasSubmit: true,
                        TimeEnteredOnPage: "@DateTime.Now.ToIsoString()",
                        SessionId: $('#sessionId').val(),
                        FreeText: $('#MessageInput').val().trim(),
                        ProcessID: $('#processID').val(),
                        ContactType:"@call_me_contact_type",
                        ExtendedProperties:
                        [
                            {
                                "Key": "SubmitedPageDate",
                                "Value": submitedFormDateTime
                            },
                            {
                                "Key": "CodeName",
                                "Value": navigator.appCodeName

@{
    string CacheVersion = "V1.1";
    Layout = null;
    // Get basic design settings from the homepage
    ContentModels.PageHome home = Model.Root() as ContentModels.PageHome;
    var colorTheme = " Blue";
    var font = "arial";

    var allKids = Model.Children.ToList();
    var currentPage = Umbraco.AssignedContentItem;
    ContentModels.CallMeBack floatingForm = null;
    if (allKids.Where(c => c is ContentModels.CallMeBack).Any())
    {
        @*All pages except home*@
    floatingForm = (ContentModels.CallMeBack)allKids.Where(c => c is ContentModels.CallMeBack).FirstOrDefault();
}
else
{
    foreach (var t in allKids)
    {
        if (t.Children.Where(c => c is ContentModels.CallMeBack).Any() && currentPage.Id == 40240)
        {
            floatingForm = (ContentModels.CallMeBack)t.Children.Where(c => c is ContentModels.CallMeBack).FirstOrDefault();
            break;
        }

    }
}

HomePageElements homePageElements = null;
var call_me_subject = floatingForm?.Value("ProductSubject") ?? "";
var call_me_contact_type = floatingForm?.Value("contactType") ?? "";
var prodID = floatingForm?.Value("productID") ?? "";
var check_open = floatingForm?.Value<bool>("callMeBackDifferentLocation");

if (Model.Children.Where(o => o is HomePageElements).FirstOrDefault() != null)
{
    homePageElements = (HomePageElements)Model.Children.Where(o => o is HomePageElements).FirstOrDefault();
}
else if (Model.Parent.Parent.Children.Where(o => o is HomePageElements).FirstOrDefault() != null)
{
    homePageElements = (HomePageElements)Model.Parent.Parent.Children.Where(o => o is HomePageElements).FirstOrDefault();
}
else
{
    homePageElements = (HomePageElements)Model.Parent.Children.Where(o => o is HomePageElements).FirstOrDefault();
}

var disclaimersData = homePageElements.Children.Where(o => o.ContentType.Alias == "ebankITListSectionText").ToList();

var disclaimers = disclaimersData.FirstOrDefault().Children;
IPublishedContent disclaimerValue = null;

foreach (var content in disclaimers)
{
    if (HttpContext.Current.Request.Path.ToString().Contains("/banking"))
    {
        if (content.Value("ebankITTitle").ToString().Contains("Banking"))
        {
            disclaimerValue = content;
        }
    }
    else
    {
        disclaimerValue = content;
        break;
    }
}

var heroBodyBlog = (HeroBody)homePageElements.Children.Where(x => x is HeroBody).FirstOrDefault();
var heroBodyBlogLink = heroBodyBlog.Children.Where(x => x.ContentType.Alias.ToLower() == "link").FirstOrDefault();

//Umbraco.Web.Models.RelatedLink itemLink = null;
//foreach (var link in (Umbraco.Web.Models.RelatedLinks)((Link)heroBodyBlogLink).UrlLink)
//{
//    itemLink = link;
//    break;
//}
var bottomNavigation = (BottomNavigation)homePageElements.Children.Where(c => c is BottomNavigation).FirstOrDefault();
// var CacheVersion = "ver=" + AfricanBank.Cms.Portal.Helpers.CacheFactory.CacheVersion();
var seo_title = Model.Value("title_tag");
var seo_description = Model.Value("descrition_tag");
var seo_keywords = Model.Value("keywords_tag");
String twitter_default_image = "/media/51288/ab-logo_icon_blue_30x30-2.png";

if (Model.Value<IPublishedContent>("image") != null)
{
    twitter_default_image = Model.Value("image").ToString();
}
//check if blog image exist
if (Model.Children.Where(c => c is BlogDetailsElements).FirstOrDefault() != null)
{
    var headerItem = Model.Children.Where(c => c is BlogDetailsElements).FirstOrDefault().Children.Where(x => x is HeroHeaderBlogDetail).FirstOrDefault();

    ContentModels.Image imageData = (ContentModels.Image)headerItem.Value("Image");
    if (imageData != null)
    {
        twitter_default_image = ((ContentModels.Image)headerItem.Value("Image")).Url;
    }
}
var utm_source = Request.Params["utm_source"];
var utm_medium = Request.Params["utm_medium"];
var utm_campaign = Request.Params["utm_campaign"];
}
<!doctype html>
<html ng-app="africanBankApp">
<head>

    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">

    @{
        var url = Request.Url.OriginalString.Trim();
        var uri = new Uri(url);

        var query = HttpUtility.ParseQueryString(uri.Query);

        if (url.EndsWith("/"))
        {
            <link rel="canonical" href="@url" />
        }
        else
        {
            <link rel="canonical" href="@url/" />
        }
    }


    @if (!string.IsNullOrEmpty(query.ToString()))
    {
        <title>African Bank</title>
        <meta name="robots" content="noindex">
        <meta name="googlebot" content="noindex">
    }
    else
    {
        <title>@seo_title</title>
        <meta name="description" content="@seo_description">
        <meta name="author" content="@seo_keywords">
    }

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@Html.Raw("@")AfricanBank">
    <meta name="twitter:creator" content="@Html.Raw("@")AfricanBank">
    <meta name="twitter:title" content="African Bank | @seo_title.ToString()">
    <meta name="twitter:description" content="@seo_description">
    <meta name="twitter:image" content="@System.Configuration.ConfigurationManager.AppSettings["site_domain"]@twitter_default_image">

    <meta property="og:title" content="African Bank | @seo_title.ToString()" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@Model.Url(mode: UrlMode.Absolute)" />
    <meta property="og:description" content="@seo_description" />
    <meta property="og:image" content="@System.Configuration.ConfigurationManager.AppSettings["site_domain"]@twitter_default_image" />




    @RenderSection("Header", required: false)


<div class="container">

    <!-- HERO BANNER -->
    <div class="row">
        <div class="" style="width:100%">
            <div style="margin:10px">
                <div style="padding:5px" class="searchItemList">
                    <form style="margin-top: 30px">
                        <a class="back-button" href="" onclick="history.back()"><< Go back</a>
                    </form>
                    <div class="item-content">
                        <div class="card">
                            <div class="card-header" role="tab" id="tabHeading0">
                                <h5>
                                    <span class="triangle-nav sublink-collapsables title text-uppercase" data-toggle="collapse"
                                          href="#heading0" aria-expanded="true" aria-controls="collapseThree">
                                        &nbsp;&nbsp;@selectedItemString
                                    </span>
                                </h5>
                            </div>
                            <hr />
                           <div id="heading0" class="collapse in" role="tabpanel" aria-labelledby="tabHeading0" data-parent="#accordion">
                                <div class="container margin-left-50 faq content card-body">
                                    <div class="platform-icon-display row text-center margin-top-30 margin-bottom-30">
                                         @{
                                             int platformIterator = 0;
                                             bool isCellPhonePlatform = false;
                                             bool isAppPlatform = false;
                                             bool isOnlinePlatform = false;
                                             foreach (var platform in availablePlatformItems)
                                             {
                                                 if (platformIterator == 0) { isAppPlatform = true; }
                                                 if (platformIterator == 1) { isOnlinePlatform = true; }
                                                 if (platformIterator == 2) { isCellPhonePlatform = true; }
                                                 var imageValue = (IPublishedContent)platform.Value("nCebankITDocument"); //  (IPublishedContent)platform.Value("nCebankITDocument");
                                                 string iconClassName = "platform-icon" + platformIterator.ToString();
                                                 var stringPath = imageValue.Url;
                                                 //   var stringPath = ((Umbraco.Web.Models.ImageCropDataSet)imageValue.Value("umbracoFile")).Src.ToString();
                                                <div class="col-xs-4" style="text-align: @(isAppPlatform ? "right" : ""); text-align: @(isCellPhonePlatform ? "left" : "")">
                                                    @if (isCellPhonePlatform && cellphoneIconLink != null)
                                                    {
                                                        <img src="@stringPath" width="70" class="@iconClassName"
                                                             onclick='playVideoPlatform("@cellphoneIconLink.Value("answer").ToString()", "@iconClassName", "@selectedPlatformCellPDFValue")' 
                                                             alt="@imageValue.Value("altTag")" />
                                                             <br>
                                                             <span class="cell-display">CELLPHONE</span>
                                                    }
                                                    else if (isAppPlatform && appIconLink != null)
                                                    {
                                                        <img src="@stringPath" width="70" class="@iconClassName"
                                                             onclick='playVideoPlatform("@appIconLink.Value("answer").ToString()", "@iconClassName", "@selectedPlatformAppPDFValue")' 
                                                             alt="@imageValue.Value("altTag")" />
                                                             <br>
                                                             <span class="cell-display web-app-text-display">APP</span>
                                                    }
                                                    else if (isOnlinePlatform && onlineIconLink != null)
                                                    {
                                                        <img src="@stringPath" width="70" class="@iconClassName"
                                                             onclick='playVideoPlatform("@onlineIconLink.Value("answer").ToString()", "@iconClassName", "@selectedPlatformOnlinePDFValue")' 
                                                             alt="@imageValue.Value("altTag")" />
                                                             <br>
                                                             <span class="cell-display">ONLINE</span>
                                                    }
                                                    else
                                                    {
                                                        <img src="@stringPath" width="70" class="@iconClassName" alt="@imageValue.Value("altTag")" />
                                                            <p>
                                                                <i class="glyphicon glyphicon-remove" 
                                                                style="content: &quot;\e013&quot;;
                                                                     font-family: 'Glyphicons Halflings';
                                                                     font-size: 12px;
                                                                     color: #ef0843;
                                                                     @(isAppPlatform ? "margin-right:28px": "");
                                                                     @(isCellPhonePlatform ? "margin-left:30px" : "")"></i>
                                                            </p>
                                                    }
                                                </div>
                                                platformIterator += 1;
                                                isCellPhonePlatform = false;
                                                isAppPlatform = false;
                                                isOnlinePlatform = false;
                                            }
                                        }
                                    </div> 
                                    
                                    <div class="text-center">
                                        <video autoplay class="videoPlatformPlayer" width="100%" controls="controls">
                                            <source src='@selectedVideo' />
                                            Your browser does not support the video tag.
                                        </video>
                                    </div>
                                    <div class="row text-center margin-top-40 ">
                                        <div class="col-md-2"></div>
                                        @{
                                            foreach (var buttons in videoButtonItems)
                                            {
                                                var imageValue = (IPublishedContent)buttons.Value("nCebankITDocument");
                                                // var stringPath = ((Umbraco.Web.Models.ImageCropDataSet)imageValue.Value("umbracoFile")).Src.ToString();
                                                var stringPath = imageValue.Url;
                                                <div class="col-md-12">
                                                    <a class="video_list_item" href="@selectedPDF" target="_blank" style="margin-right: 2%;">
                                                        <img src="@stringPath" width="200" alt="@imageValue.Value("altTag")" />
                                                    </a>
                                                </div>
                                            }
                                        }
                                        <div class="col-md-2"></div>
                                    </div>

                                    <h1 class="video-title css-color-change">
                                        @heroBody.Value("bodyTitle")
                                    </h1>
                                    <div class="video-body">
                                        <p>@heroBody.Value("bodyDescription")</p>
                                        <p> @Html.Raw(heroBody.RichTextBox)</p>
                                    </div>
                                </div>
                            </div> 
                        </div>
                    </div>
                </div>
                <hr />
                <div style="padding:5px" class="searchItemList">
                    <div class="item-content">
                        <div class="card">
                            <div class="card-header" role="tab" id="tabHeading1">
                                <h5>
                                    <span class="triangle-nav collapsed sublink-pointer-flexer title text-uppercase" data-toggle="collapse" href="#heading1" aria-expanded="false" aria-controls="collapseThree">
                                        &nbsp;&nbsp;@viewMoreHowTos
                                    </span>
                                </h5>
                            </div>
                            <div id="heading1" class="collapse" role="tabpanel" aria-labelledby="tabHeading1" data-parent="#accordion">
                                <div style="margin-left: 5%" class="margin-left-50 faq content card-body">
                                    <div class="col-md-12 video-content">
                                        <div class="container">
                                            @Html.Partial("_pageRelatedVideos", videos as ICollection<NChelpGuide>)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div> 
                </div>
                <br>
                <!--FAQ-->
                <div style="font-size: 5vh;font-weight: 600;color: #88bc47;">
                    @faqs.EbankIticonTitle
                    <img class="faq-image-item" src="@faqImagePath" alt="@faqImageAltTagData.Value("altTag")" />
                    <span class="top-3-faqs-description">@faqLongString</span>
                </div>
                <br />
                <div class="container">
                    <div class="faq-section full" ng-controller="ReportsAndArchievesController">
    <div class="margin-top-20 visible-xs"></div>
    @{
        var groups = (IEnumerable<IPublishedElement>)sectionContent;
        var sections = groups.Select(x => x.Value("groupName")).ToList();

        foreach (var group in groups)
        {
            var questions = (IEnumerable<QuestionItem>) group.Value("questionsAndAnswers");
            int headingId = 0;
            <div class="row sectionHeading">
                <div style="background-color:#335580;padding: 10px; margin-bottom:5px;margin-top:5px;" id="accordion" role="tablist">
                    <div style="margin:10px">
                        @foreach (var question in questions)
                        {
                            var Q = question.Value("question");
                            var A = question.Value("answer");
                            var headingSting = "_heading" + headingId.ToString();
                            var tabStringHeader = "_tabHeading" + headingId.ToString();
                            <div style="border: solid #7e7e7e;border-width: 1px 1px;padding:5px" class="searchItemList" ng-show="stringContains('@Q', searchTerm)">
                                <div class="item-content">
                                    <div class="card">
                                        <div class="card-header" role="tab" id="@tabStringHeader">
                                            <h5>
                                                <span class="triangle-nav collapsed faq-link-pointer title text-white" data-toggle="collapse" href="#@headingSting" aria-expanded="false" aria-controls="collapseThree">
                                                    &nbsp;&nbsp;@Q
                                                </span>
                                            </h5>
                                        </div>
                                        <div id="@headingSting" class="collapse" role="tabpanel" aria-labelledby="@tabStringHeader" data-parent="#accordion">
                                            <div style="margin-left: 5%" class="margin-left-50 text-white faq content card-body">
                                                @A
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <br />
                            headingId += 1;
                        }
                    </div>
                </div>
            </div>
        }
    }
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- HERO BODY-->
</div>
<script>
    $(document).ready(function () {
        MediaHashVideo();
    });
    function playVideoPlatform(videoPath, classIconName, pdfPath) {
        if (videoPath !== null) {
            for (var i = 0; i <= 2; i++) {
                $(".platform-icon" + i).css("background", "#002b60");
                $(".platform-icon" + i).css("transition", "0.5s");
            }
            
            // update the PDF button link
            $('.video_list_item').attr('href', '@currentDirectory' + pdfPath);
            // end PDF button link
            
            $('.' + classIconName).css("background", "#001f44");
            $('.videoPlatformPlayer').attr('src', '@currentDirectory' + videoPath);
            $(".videoPlatformPlayer").each(function () {
                $(this).get(0).play();
                $("html, body").animate({ scrollTop: 0 }, 2000);
            });
        }
    }
    function onPage(name) {
        var path = window.location.pathname;
        return name == path.substring(path.lastIndexOf('/') + 1);
    }
    if (onPage('video-hub')) {
        $('.css-background-change').css('background', '#2E0554');
        $('.css-color-change').css('color', '#2E0554');
    };
    $(".main-click").click(function () {
        $(".video-citation-box").hide();
        $("#video-header").css({ 'height': '75vh' });
    });

    function MediaHashVideo() {
        var selected_video = window.location.hash.replace('#', '');
        if (selected_video !== null && selected_video !== undefined && selected_video != "") {
            //-->show video loader
            $("#video-loader").show();
            $(".video-citation-box").hide();
            //}
            $("#video-ytd")[0].src = selected_video;
            setTimeout(function () {
                $('#video-ytd')[0].src += "?autoplay=1";
                $("#video-ytd").addClass("video-ytd-show");
                $("#video-loader").hide();
            }, 5000);
        }
    }
</script>
<script type="text/javascript" src="~/scripts/search.js"></script>
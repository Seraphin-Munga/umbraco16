@inherits Umbraco.Web.Mvc.UmbracoViewPage<ContentModels.PageCampaign>
@using ContentModels = Umbraco.Web.PublishedModels;
@using AcfAfricanbank.Core.Models.Forms;
@using System.Text.RegularExpressions
@using CustomModels = Web.Models;
@{
    Layout = "Master.cshtml";
    var domainDirectory = System.Web.HttpContext.Current.Request.Url.AbsoluteUri.Replace(System.Web.HttpContext.Current.Request.Url.AbsolutePath, "");
    string currentDirectory = domainDirectory;
    int resultIndex = currentDirectory.IndexOf("?path");
    if (resultIndex != -1)
    {
        currentDirectory = currentDirectory.Substring(0, resultIndex);
    }
    var children = Model.Children;
    var chest = children?.Where(c => c is HeroChest).FirstOrDefault();
    var heroBody = (HeroBody)children?.Where(c => c is HeroBody).FirstOrDefault();
    var heroBodyTabGroup = heroBody.Children?.Where(c => c is TabGroup).FirstOrDefault();
    var selectedItemString = Request["selected"];

    ContentModels.TabHeader videoLanding = null;
    ContentModels.TabHeader faqs = null;

    heroBodyTabGroup.Children?.Where(c => c is TabHeader).ToList().ForEach(x =>
    {
        if (x.Name.ToString() == "FAQ")
        {
            faqs = (TabHeader)x;
        }
        else
        {
            videoLanding = (TabHeader)x;
        }
    });

    var videoBody = videoLanding.Children.Where(x => x is TabBody).FirstOrDefault();

    var videoArchive = videoLanding.Children.Where(x => x is TabBody).Skip(1).FirstOrDefault();
    IEnumerable<NCtabGenericContent> _tabVideoContent = (IEnumerable<NCtabGenericContent>)videoArchive.Value("tabBodyContent");
    var _videoArchive = (IEnumerable<IPublishedElement>)_tabVideoContent.Where(c => c is NCtabGenericContent).FirstOrDefault().Value("sectionContent");
    ICollection<NChelpGuide> videos = new List<NChelpGuide>();
    string[] searchParams = selectedItemString.Split(' ');
    string[] searchValue = selectedItemString.Split('-');

    ICollection<IPublishedContent> selected_videoArchives = new List<IPublishedContent>();

    foreach (var videoCollection in _videoArchive.Select(x => x.GetProperty("mediaItems")).ToList()) // .Select(cc => cc.Alias == "mediaItems")
    {
        foreach (var _videoData in (ICollection<NChelpGuide>)videoCollection.Value("mediaItems"))
        {
            if (searchParams.Any(o => _videoData.Value("question").ToString().Contains(o)))
            {
                videos.Add(_videoData);
            }
        }
    }
    var pdfArchive = videoLanding.Children.Where(x => x is TabBody).Skip(2).FirstOrDefault();
    IEnumerable<NCtabGenericContent> _tabPDFContent = (IEnumerable<NCtabGenericContent>)pdfArchive.Value("tabBodyContent");
    var _pdfArchive = (IEnumerable<IPublishedElement>)_tabPDFContent.Where(c => c is NCtabGenericContent).FirstOrDefault().Value("sectionContent");
    ICollection<NChelpGuide> pdfs = new List<NChelpGuide>();

    foreach (var pdfCollection in _pdfArchive.Select(x => x.GetProperty("mediaitems")).ToList()) // .Select(cc => cc.Value)
    {
        int counter = 0;
        foreach (var _pdfData in (ICollection<NChelpGuide>)pdfCollection.Value("mediaItems"))
        {

            pdfs.Add(_pdfData);
            @*<script>
                console.log('@counter');
            </script>*@
        counter += 1;
    }
}

var tabs = (IEnumerable<IPublishedContent>)heroBody?.Children.Where(c => c is TabBody).ToList();

TabBody tabBodyFAQ = null;
ImageItem subBodyFAQs = null;

faqs.Children.ToList().ForEach(x =>
{
    if (x.Name == "Frequently Asked Questions")
    {
        tabBodyFAQ = (TabBody)x;
    }
    else if (x.Name == "Sub Header FAQ")
    {
        subBodyFAQs = (ImageItem)x;
    }
    if (x is TabBody)
    {

    }
});

var frequentlyAQ = subBodyFAQs.Children.FirstOrDefault().Value("ebankITImage");
String faqLongString = subBodyFAQs.Children.FirstOrDefault().Value("ebankITTitle").ToString();
String faqImagePath = ((ContentModels.Image)frequentlyAQ).UmbracoFile.Src.ToString();
var faqImageAltTagData = ((ContentModels.Image)frequentlyAQ);

//var sectionContent = (IEnumerable<IPublishedElement>)tabBodyFAQ.TabBodyContent.Where(c => c is NCtabGenericContent).FirstOrDefault().SectionContent;

var sectionContent = ((Umbraco.Web.PublishedModels.HeroBodyFaq)tabBodyFAQ.Children.Where(x => x.Name == "Questions and Answers").FirstOrDefault()).QuestionGroups;

ContentModels.TabBody _availablePlatforms = null;
ContentModels.TabBody _videoButtonControls = null;

tabs.ToList().ForEach(x =>
{
    var partialName = x.GetProperty("PartialViewName");

    if (x.Value("PartialViewName").ToString() == "_platforms")
    {
        _availablePlatforms = (TabBody)x;
    }
    else if (x.Value("PartialViewName").ToString() == "_buttonControls")
    {
        _videoButtonControls = (TabBody)x;
    }
});

var availablePlatformItems = (IEnumerable<IPublishedElement>)_availablePlatforms.TabBodyContent.Where(c => c is NCtabGenericContent).FirstOrDefault().Value("sectionContent");
var videoButtonItems = (IEnumerable<IPublishedElement>)_videoButtonControls.TabBodyContent.Where(c => c is NCtabGenericContent).FirstOrDefault().Value("sectionContent");

string selectedVideo = "";
string queryStr = null;
string questionValue = null;
string[] questionArrayPhrase = null;
foreach (var video in videos)
{
    questionArrayPhrase = video.Value("question").ToString().Split('-');
    questionValue = questionArrayPhrase[1].ToString().TrimStart(' ');
    queryStr = searchValue[0].ToString().TrimStart(' ');
    if (questionValue.Contains(queryStr))
    {
        selectedVideo = video.Value("answer").ToString();
        break;
    }
}

// Video Platforms
var cellphoneIconLinkData = videos.ToList().Where(x => x.Value("answer").ToString().Contains("cellphone")).ToList();
var cellphoneIconLink = cellphoneIconLinkData.Where(x=> x.Value("question").ToString().ToLower().Contains(selectedItemString.ToLower())).FirstOrDefault();

var onlineIconLinkData = videos.ToList().Where(x => x.Value("answer").ToString().Contains("online")).ToList();
var onlineIconLink = onlineIconLinkData.Where(x => x.Value("question").ToString().ToLower().Contains(selectedItemString.ToLower())).FirstOrDefault();

var appIconLinkData = videos.ToList().Where(x => x.Value("question").ToString().ToLower().Contains(selectedItemString.ToLower())).ToList();
var appIconLink = videos.Where(x => x.Value("question").ToString().ToLower().Contains(selectedItemString.ToLower())).ToList()
    .Where(xx => xx.Value("question").ToString().Split('-')[0].ToString().ToLower().Trim() == "app").FirstOrDefault();

string _appIconLink = "";
// IPublishedContent appIconLink = null;
string trimmedfoundLinkValue = null;
string[] foundLinkValue = null;
string _answerString = null;
queryStr = null;
foreach (var video in videos)
{
    queryStr = searchValue[0].ToString().TrimStart(' ').ToLower();
    foundLinkValue = video.Value("question").ToString().Split('-');
    var answer = video.Value("question").ToString();
    _answerString = video.Value("answer").ToString();
    trimmedfoundLinkValue = foundLinkValue[0].ToString().TrimStart(' ').ToLower();

    if ((foundLinkValue[0].ToString().Trim() == "Cellphone") && (trimmedfoundLinkValue == queryStr))
    {
        cellphoneIconLink = video;
    }
    if ((foundLinkValue[0].ToString().Trim() == "Online") && (trimmedfoundLinkValue.Contains(queryStr)))
    {
        onlineIconLink = video;
    }
    if ((foundLinkValue[0].ToString().Trim() == "App") && (trimmedfoundLinkValue.Contains(queryStr)))
    {
        // appIconLink = (IPublishedContent) video.Value("answer");
        selectedVideo = video.Value("answer").ToString();
    }
}

string selectedPDF = "";
questionArrayPhrase = null;
questionValue = null;
foreach (var pdf in pdfs)
{
    questionArrayPhrase = pdf.Value("question").ToString().Split('-');
    questionValue = questionArrayPhrase[1].ToString().TrimStart(' ').ToLower();
    queryStr = searchValue[0].ToString().TrimStart(' ').ToLower();
    if (questionValue.Contains(queryStr))
    {
        selectedPDF = pdf.Value("answer").ToString();
        break;
    }
}


// for the selected PDF platform
string selectedPlatformAppPDFValue = null;
string selectedPlatformCellPDFValue = null;
string selectedPlatformOnlinePDFValue = null;

foreach (var pdf in pdfs)
{

    questionArrayPhrase = pdf.Value("question").ToString().Split('-');
    string platformPDF = questionArrayPhrase[0].ToString().Trim();
    questionValue = questionArrayPhrase[1].ToString().TrimStart(' ').ToLower();
    queryStr = searchValue[0].ToString().TrimStart(' ').ToLower();

    if ((platformPDF == "App") && (questionValue.Contains(queryStr))) {
        selectedPlatformAppPDFValue = pdf.Value("answer").ToString();
    }
    else if ((platformPDF == "Online") && (questionValue.Contains(queryStr))) {
        selectedPlatformOnlinePDFValue = pdf.Value("answer").ToString();
    }
    else if ((platformPDF == "Cellphone") && (questionValue.Contains(queryStr))) {
        selectedPlatformCellPDFValue = pdf.Value("answer").ToString();;
    }
}

var sourcePath = Request["path"];
String viewMoreHowTos = "View Related Videos";


}


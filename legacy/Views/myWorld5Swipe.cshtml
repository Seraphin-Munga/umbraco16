                            <p>@Html.Raw(mainDescription)</p>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-12 col-md-3 col-md-offset-9 registerLogin margin-bottom-20">
                            @*<a href="@openNowButtonLink" class="button blue-button" id="">
                                    @buttonText
                                </a>*@
                            <a href="@learnMoreButtonLink" class="button span-buttons blue-button" id="">

<div class="container payments-section full margin-bottom-30">
    @*<div class="margin-top-20 visible-xs"></div>*@
    <div class="row">
        <h4 class="container margin-bottom-20 align-center">@createOwnWorldOfBanking.Value("partialViewClassName")</h4>
        @{
            int cardIterator = 0;
            bool increaseCardHeight = false;

            foreach (var item in ownWorldItems)
            {

                if (cardIterator == (int)ownWorldItems.Count() - 1)
                {
                    increaseCardHeight = true;
                }
                var cardTitle = item.Value<string>("nCcardTitle");
                var cardDesc = item.Value<string>("nCcardDescription");
                var icon = item.Value<IPublishedContent>("nCcardIcon");
                <div class="col-sm-4 margin-bottom-20">
                    <div class="@(increaseCardHeight ? "cellphone-button-banking-campaign" : "")">
                        <div class="text-left center-align white-link-color richtextbox-blue-bg">
                            <img src="@icon.Url" alt="@icon.Value("altTag")" class="image-center-resizer" />
                            <p class="title blue-color font-size-20">@cardTitle</p>
                            <p>@cardDesc</p>
                        </div>
                    </div>
                    @{
                        if (!cardTitle.Contains("App"))
                        {
                            <div class="col-md-4 center-align margin-bottom-20 margin-right-50 banking-options-buttons">
                                <a href="@learnMoreButtonLink" class="button span-buttons green-button" id="">
                                    @onlineButtonText
                                </a>
                            </div>
                        }
                        else
                        {
                            <div class="col-md-4 center-align margin-bottom-20 margin-left-50 banking-options-buttons">
                                <span class="button span-buttons green-button view_OnlineApps downloadNow" data-item="@popupAppTitle*@popQRCode*@popAndroidApp*@popIOsApp" target="_blank">@downloadNow.EbankItbuttonText</span>
                            </div>
                        }
                    }
                </div>
                cardIterator += 1;
            }
        }
    </div>
</div>



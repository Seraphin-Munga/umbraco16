@inherits Umbraco.Web.Mvc.UmbracoViewPage<ContentModels.PageManageYourAccount>
@using ContentModels = Umbraco.Web.PublishedModels;
@using System.Text.RegularExpressions
@using Web.Helpers

@{
    Layout = "Master.cshtml";
    var children = Model.Children;

    var myModel = new Web.Models.KnowledgeCentreModels.SearchResultsModel()
    {
        DisplayResults = new List<Web.Models.KnowledgeCentreModels.DisplayResults>()
    };

    var heroHeader = children.Where(c => c is HeroHeader).FirstOrDefault();
    var heroShoulder = (HeroShoulder)children.Where(c => c is HeroShoulder).FirstOrDefault();
    ContentModels.CardItem cardItem = null;
    if (heroShoulder.Children != null)
    {
        cardItem = (CardItem)heroShoulder.Children.Where(c => c is CardItem).FirstOrDefault();
    }

    var heroBody = (HeroBody)children.Where(c => c is HeroBody).FirstOrDefault();

    ContentModels.Card homeCardItem = null;
    if (heroBody.Children != null)
    {
        homeCardItem = (Card)heroBody.Children.Where(c => c is Card).FirstOrDefault();
    }
    String homeCardItemPath = ((Umbraco.Core.Models.PublishedContent.PublishedContentWrapped)homeCardItem.Value("cardIcon")).Url.ToString();
    String homeCardItemAltTag = ((Umbraco.Core.Models.PublishedContent.PublishedContentWrapped)homeCardItem.Value("cardIcon")).Value("altTag").ToString();
    var tabGroup = heroBody.Children(x => x.ContentType.Alias.ToLower() == "tabgroup").FirstOrDefault();

    ImageItem faqsImageItem = null;
    TabBody tabBodyVideos = null;
    TabBody tabBodyPDFs = null;
    TabBody tabBody = null;

    //foreach (var item in tabGroup.Children.ToList())
    //{
    //    var t = item.Value("tabHeader");
    //    tabBody = (TabBody) t;

    //}

    tabGroup.Children.ToList().ForEach(x =>
    {
        if (x.Children != null)
        {
            x.Children.ToList().ForEach(xx =>
            {
                if (xx.ContentType.Alias.ToLower() == "imageitem")
                {
                    faqsImageItem = (ImageItem)xx;
                }
                else if (xx.ContentType.Alias.ToLower() == "tabbody")
                {
                    if (xx.Name == "Video Archive")
                    {
                        tabBodyVideos = (TabBody)xx;
                    }
                    else if (xx.Name == "PDF Archive")
                    {
                        tabBodyPDFs = (TabBody)xx;
                    }
                    else
                    {
                        tabBody = (TabBody)xx;
                    }
                }
            });
        }
    });

    String faqImagePath = ((ContentModels.Image)faqsImageItem.Children.FirstOrDefault().Value("ebankITImage")).Url;

    var sectionContent = (ICollection<QuestionGroup>)tabBody.Children.Where(c => c.ContentType.Alias == "heroBodyFaq").FirstOrDefault().Value("questionGroups");
    String sectionHeaderTitle = tabBody.Value("partialViewName").ToString();
    List<Umbraco.Web.PublishedModels.File> pdfFiles = new List<ContentModels.File>();
    Dictionary<string, List<string>> _pdfFields = new Dictionary<string, List<string>>();
    Dictionary<string, List<string>> _videoFields = new Dictionary<string, List<string>>();
    Dictionary<string, List<string>> _pagesFields = new Dictionary<string, List<string>>();

    List<string> shoulderButtonColors = new List<string>()
{
    "#98d150", "#466b8b", "#39b7b9"
    };
    String pathUsed = "";

    bool isHowTo = false;
    bool isAskAbby = false;
    bool isFAQ = false;
    int colorItem = 0;

    var values = "Advanced Search";


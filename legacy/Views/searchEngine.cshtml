<!-- HERO BANNER -->
@Html.Partial("_pageHeaderImage", heroHeader as ContentModels.HeroHeader)
<!--End-->
<div class="container">
    <!-- HERO SHOULDER -->
    @if (cardItem != null)
    {
        <div class="row">
            <div class="col-md-2 col-sm-0"></div>
            <div class="col-md-8 col-sm-12">
                <div class="col-xs-12 myTabs">
                    @{
                        var cardList = (ICollection<NCcard>)cardItem.Value("cardItemDetail");
                        foreach (var item in cardList)
                        {

                            string anchorValue = item.Value("nCcardTitle").ToString().Trim().Replace("'", "");
                            string anchorValueClick = "";
                            if (anchorValue == "ASK KARABO")
                            {
                                anchorValueClick = " onclick=javascript:document.getElementById('custom-care-button').click()";
                            }
                            if (item.Value("nCcardTitle").ToString().Contains("ASK KARABO")) { isAskAbby = true; }
                            @*<img id="cropperImage"  src="@Url.GetCropUrl(item, propertyAlias: "image", cropAlias: "banner", useCropDimensions:true, furtherOptions: "&format=webp&quality=80")" />*@

                            var imagePath = ((Umbraco.Core.Models.PublishedContent.PublishedContentWrapped)(@item.Value("nCcardIcon"))).Url;
                            var imageData = ((Umbraco.Core.Models.PublishedContent.PublishedContentWrapped)(item.Value("nCcardIcon")));
                            <div class="col-xs-4 myTab">
                                <a href="#@anchorValue" @anchorValueClick>
                                    <div style="background-color: @shoulderButtonColors[colorItem].ToString();" class="myCard">
                                        <div class="text-white">
                                            <div class="cardTitle" style="">@item.Value("nCcardTitle")</div>
                                            <h5 class="hide-xs">@item.Value("nCcardDescription")</h5>
                                            <img src="@imagePath" width="40" alt="@imageData.Value("altTag")" style="padding-bottom:10px;" />
                                        </div>
                                    </div>
                                </a>
                            </div>
                            colorItem += 1;

                        }
                    }
                </div>
            </div>
            <div class="col-md-2 col-sm-0"></div>
        </div>
    }
    <div id="results-wait-loader" class="container">
        <div class="loader" id="loader-rates-form-preloader">
            <div class="loader-img"></div>
        </div>
    </div>

    @*Advanced Search*@



    <div id="accordion">
        <div style="margin-top:-1%">
            <button type="button" class="open-table accordion-toggle" id="btnFeaturesTable" style="outline:none">
                <i id="iTag" class="fa fa-filter" aria-hidden="true" style="font-size: 30px;"></i>
            </button>
        </div>
        <div class="accordion-content" style="display: none;">
            <div class="row">
                <div class="col-md-12">
                    <div class="row margin-bottom-30">
                        <div class="col-sm-12 col-md-12">
                            <form id="frmAdvancedSearchOptions">
                                <div class="row">
                                    <div class="col-xs-12 col-sm-8 col-md-6">
                                        <p class="adv-headers">Search Sources</p>
                                        <div class="form-group" style="float: left; ">
                                            <div class="row">
                                                @{
                                                    Dictionary<string, string> keyValuePairs = SearchHelper.ReturnJSONSearchNodes();
                                                    foreach (var valuePair in keyValuePairs)
                                                    {
                                                        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                                                            <span style="float:left;">
                                                                <input type="checkbox" id="@valuePair.Key.Trim(" ").ToString()" value="@valuePair.Value" name="@valuePair.Key.Trim(" ").ToString()"> @valuePair.Key<br>
                                                            </span>
                                                        </div>
                                                    }
                                                }
                                            </div>

                                        </div>

                                    </div>
                                    <div class="col-xs-12 col-sm-4 col-md-4 margin-top-20" style="text-align:center">
                                        <a id="advance-search" class="button primary">Apply Filter(s)</a>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <hr />

    @*Andvanced Search end*@
    <div id="box" class="margin-top-30">
        @*@Html.Partial("_pageSearchKnowledgeHubResult", myModel)*@
    </div>
    <div id="pager"></div>
    <div class="container">
        <div class="row">
            <div class="selected-button-value shoulder-buttons">
                <div id="@homeCardItem.Value("cardTitle").ToString().Trim().Replace("'", "").ToString()" style="margin-bottom: 32px;color:#002b60;">
                    @homeCardItem.Value("cardTitle") <img style="margin-bottom: 17px;" src="@homeCardItemPath" width="50" alt="@homeCardItemAltTag">
                    <span class="how-to-value" id="@homeCardItem.Value("cardDescription")">@homeCardItem.Value("cardDescription")</span>
                </div>
            </div>
        </div>
        <!--start mobi knowledge hub components-->
        <div class="row">
            @{
                int mobiIterator = 1;
                string mobiAccordionName = null;

                var mobiTabHeader = tabGroup.Children.Where(x => x.ContentType.Alias.ToLower() == "tabheader").Skip(1).Take(1).FirstOrDefault();
                foreach (var group in mobiTabHeader.Children)
                {
                    if ((group.Name != "Video Archive") && (group.Name != "PDF Archive"))
                    {
                        var groupData = group.Value("ebankITTitle");
                        var id = Regex.Replace(groupData.ToString(), @"[^0-9a-zA-Z]+", "");
                        var cssClass = group.Equals(mobiTabHeader.Children.First()) ? "active" : string.Empty;
                        int mobiHeadingLandingId = 0;
                        var mobiTabHeaderSub = group;
                        mobiAccordionName = "accordion" + mobiIterator.ToString();
                        <div class="mobi-table" style="width:  100%;padding: 0px;left:  0;">
                            <div data-toggle="collapse" data-target=".@mobiAccordionName" class="text-white clickable tr-category">
                                <div class="arrow-container">
                                    @{ var mobiIconName = "mobiIcon" + @mobiIterator.ToString(); }
                                    <i id="@mobiIconName" style="float: right;"><span class="fa fa-arrow-down"></span></i>
                                </div>
                                <b>@groupData</b>
                            </div>

                            @foreach (var bankingDetail in group.Children)
                            {
                                string tabStringHeader = "mobiTabHeadingLanding" + mobiHeadingLandingId + mobiIterator;
                                string headingSting = "mobiHeadingLanding" + mobiHeadingLandingId + mobiIterator;

                                <ul class="@mobiAccordionName" style="list-style: none; margin-bottom:0px">
                                    <li>
                                        <hr style="margin-bottom:unset; margin-top:unset; border-color: darkgrey" />
                                        <div class="row" style="padding: 10px;">
                                            <div class="col-sm-12">
                                                <div class="card-header" role="tab" id="@tabStringHeader">
                                                    <h5>
                                                        <span class="triangle-nav collapsed sublink-collapsables title text-uppercase" data-toggle="collapse" href="#@headingSting" aria-expanded="false" aria-controls="collapseThree">
                                                            &nbsp;&nbsp;
                                                            @bankingDetail.Name
                                                        </span>
                                                    </h5>
                                                </div>
                                            </div>
                                        </div>
                                        @{
                                            if (bankingDetail.Children != null)
                                            {
                                                <div id="@headingSting" class="collapse" role="tabpanel" aria-labelledby="@tabStringHeader" data-parent="#accordion">
                                                    <div style="margin-left: 2%; margin-bottom: 3%" class="margin-left-50 text-white faq content card-body">
                                                        <ul>
                                                            @foreach (var bankingDetailChild in bankingDetail.Children)
                                                            {
                                                                Umbraco.Web.Models.Link itemLink = null;
                                                                foreach (var link in (IEnumerable<Umbraco.Web.Models.Link>)((Link)bankingDetailChild).UrlLink)
                                                                {
                                                                    itemLink = link;
                                                                    if (itemLink != null)
                                                                    {
                                                                        pathUsed = pathUsed + "/" + itemLink.Name;
                                                                        string linkStringValue = itemLink.Url + "?path=Knowledge Centre/~" + pathUsed + "/" + bankingDetailChild.Name + "&selected=" + bankingDetailChild.Name;
                                                                        <li class="listed-item-color sublink-pointer"><a href="@linkStringValue">@bankingDetailChild.Name</a></li>
                                                                    }
                                                                    else
                                                                    {
                                                                        <li class="listed-item-color sublink-pointer"><a href="@itemLink.Url">@bankingDetailChild.Name</a></li>
                                                                    }
                                                                    pathUsed = "";
                                                                }
                                                            }
                                                        </ul>
                                                    </div>
                                                </div>
                                            }
                                        }
                                    </li>
                                </ul>
                                mobiHeadingLandingId += 1;
                            }

                        </div>
                        ++mobiIterator;
                    }
                }
            }
            <!--end mobu knowledge hub components-->
            <div class="knowledge-hub-components">
                <div class="vertical-tab" role="tabpanel">
                    <ul class="nav nav-tabs" role="tablist">
                        @{
                            var tabHeader = tabGroup.Children.Where(x => x.ContentType.Alias.ToLower() == "tabheader").Skip(1).Take(1).FirstOrDefault();
                            foreach (var group in tabHeader.Children)
                            {
                                if ((group.Name != "Video Archive") && (group.Name != "PDF Archive"))
                                {
                                    var groupData = group.Value("ebankITTitle");
                                    var id = Regex.Replace(groupData.ToString(), @"[^0-9a-zA-Z]+", "");
                                    var cssClass = group.Equals(tabHeader.Children.First()) ? "active" : string.Empty;
                                    <li role="presentation" class="@cssClass"><a href="#@id" aria-controls="@groupData" role="tab" data-toggle="tab">@groupData</a></li>
                                }
                            }
                        }
                    </ul>
                    <div class="tab-content tabs" style="width: 100%;padding: unset;">
                        @{
                            var tabHeaderSub = tabGroup.Children.Where(x => x.ContentType.Alias.ToLower() == "tabheader").Skip(1).Take(1).FirstOrDefault();
                            int headingLandingId = 0;
                            foreach (var linkedValues in tabHeaderSub.Children)
                            {
                                var links = linkedValues.Children;
                                var id = Regex.Replace(linkedValues.Name.ToString(), @"[^0-9a-zA-Z]+", "");
                                var cssClass = linkedValues.Equals(tabHeaderSub.Children.First()) ?
                                                            "tab-pane fade in active" :
                                                            "tab-pane fade";
                                <div role="tabpanel" class="@cssClass" id="@id">
                                    <div class="card">

                                        @{
                                            if (linkedValues.Children.Count() == 0)
                                            {
                                                <p class="text-center" style="font-size:18px;color:#002b60;padding: 177px;">(Coming Soon...)</p>
                                            }
                                            else
                                            {
                                                foreach (var link in links)
                                                {
                                                    var headingSting = "headingLanding" + headingLandingId.ToString();
                                                    var tabStringHeader = "tabHeadingLanding" + headingLandingId.ToString();
                                                    <ul style="list-style: none; margin-bottom:0px">
                                                        <li>
                                                            <hr style="margin-bottom:unset; margin-top:unset; border-color: darkgrey" />
                                                            <div class="row" style="padding: 10px;">
                                                                <div class="col-sm-12">
                                                                    <div class="card-header" role="tab" id="@tabStringHeader">
                                                                        <h5>
                                                                            <span class="triangle-nav collapsed sublink-collapsables title text-uppercase" data-toggle="collapse" href="#@headingSting" aria-expanded="false" aria-controls="collapseThree">
                                                                                &nbsp;&nbsp;@link.Name
                                                                            </span>
                                                                        </h5>
                                                                    </div>
                                                                    <div id="@headingSting" class="collapse" role="tabpanel" aria-labelledby="@tabStringHeader" data-parent="#accordion">
                                                                        <div style="margin-left: 2%" class="margin-left-50 text-white faq content card-body">
                                                                            @{
                                                                                if (link.Children.Count() == 0)
                                                                                {
                                                                                    <p style="color:#002b60;">(Coming Soon...)</p>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <ul>
                                                                                        @{
                                                                                            foreach (var sublink in link.Children)
                                                                                            {
                                                                                                Umbraco.Web.Models.Link itemLink = null;
                                                                                                foreach (var _link in (IEnumerable<Umbraco.Web.Models.Link>)((Link)sublink).UrlLink)
                                                                                                {
                                                                                                    itemLink = _link;

                                                                                                    if (itemLink != null)
                                                                                                    {
                                                                                                        pathUsed = pathUsed + "/" + itemLink.Name;
                                                                                                        string linkStringValue = itemLink.Url + "?path=Knowledge Centre/~" + pathUsed + "/" + link.Name + "&selected=" + itemLink.Name;
                                                                                                        <li class="listed-item-color sublink-pointer"><a href="@linkStringValue">@itemLink.Name</a></li>
                                                                                                    }
                                                                                                    else
                                                                                                    {
                                                                                                        <li class="listed-item-color sublink-pointer"><a href="@itemLink.Url">@itemLink.Name</a></li>
                                                                                                    }
                                                                                                    pathUsed = "";
                                                                                                }
                                                                                            }
                                                                                        }
                                                                                    </ul>
                                                                                }
                                                                            }
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </li>
                                                    </ul>
                                                    headingLandingId += 1;
                                                }
                                            }
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="faq-section full" ng-controller="ReportsAndArchievesController">
                <div class="margin-top-20 visible-xs"></div>
                @{
                    var groups = (IEnumerable<QuestionGroup>)sectionContent;
                    var sections = groups.Select(x => x.Value("groupName")).ToList();

                    foreach (var group in groups)
                    {
                        var name = group.Value("groupName")?.ToString() ?? string.Empty;
                        var questions = group.Value<IEnumerable<IPublishedElement>>("questionsAndAnswers") ?? new List<IPublishedElement>();
                        var Id = tabBody.Value("partialViewName").ToString().Trim().Replace("'", "");
                        int headingId = 0;

                        <div id="@name.Replace(" ", string.Empty).ToLower()">
                            <div id="@Id" class="main-title @name.Replace(" ", string.Empty).ToLower() searchItemHeader"
                                 style="background-image: url(@faqImagePath);height: 201px;background-position: 40%;background-repeat: no-repeat;margin-bottom: 5px;">
                                <span class="middle-banner-faq">
                                    <h3 class="faq-section-header-title">@sectionHeaderTitle</h3>
                                    @name
                                </span>
                            </div>
                            <div style="background-color:#002b60cc;padding: 10px; margin-bottom:5px;" id="accordion" role="tablist">
                                <div style="margin:10px">
                                    @foreach (var question in questions)
                                    {
                                        var Q = question.Value("question");
                                        var A = question.Value("answer");
                                        var headingSting = "heading" + headingId.ToString();
                                        var tabStringHeader = "tabHeading" + headingId.ToString();

                                        <div style="border: solid #7e7e7e;border-width: 1px 1px;padding:5px" class="searchItemList" ng-show="stringContains('@Q', searchTerm)">

                                            <div class="item-content">
                                                <div class="card">
                                                    <div class="card-header" role="tab" id="@tabStringHeader">
                                                        <h5>
                                                            <span class="triangle-nav faq-link-pointer collapsed" data-toggle="collapse" data-target="#@headingSting">
                                                                &nbsp;&nbsp;
                                                                @Q
                                                            </span>
                                                        </h5>
                                                    </div>
                                                    <div id="@headingSting" class="collapse" role="tabpanel" aria-labelledby="@tabStringHeader" data-parent="#accordion">
                                                        <div style="margin-left: 5%" class="margin-left-50 text-white faq content card-body">
                                                            @A
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <br />
                                        headingId += 1;
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>
@section scripts
{
    <script type="text/javascript">
        $("#btnFeaturesTable").click(function () {
            $(".accordion-content").toggle(200);
            if ($("#iTag").hasClass("fa fa-filter")) {
                $("#iTag").removeClass("fa fa-filter");
                $("#iTag").addClass("fa fa-times");
            } else {
                $("#iTag").removeClass("fa fa-times");
                $("#iTag").addClass("fa fa-filter");
            }
        });
    </script>
    <script type="text/javascript">
        var _content = $('#searchstring').val();

        $(document).ready(function () {
            var pageNum = 0;
            var _allResultPages;

            var _content = $('#searchstring').val();
            $('.same_viewbtn').on('click', function (e) {
                getResults();
            });
            $('#btnSubmit').on('click', function (e) {
                getResults();
            });
            $(".show_modal").click(function (e) {
                var item = e.target.dataset.item;
                var deal_title = item;
                $("#modal-title").html(deal_title);
                $('#generic').modal('show');
            });
            $('#advance-search').on('click', function (e) {
                getResults();
                $('#generic').modal('hide');
            });

            $(document).on("keyup", "#searchstring", debounce(function (e) {
                e.preventDefault();
                getResults();
            }, 300));

            function populateResults() {
                $("#box").empty();
                var maxResultPerPage = 3;
                var currentResultList = maxResultPerPage * pageNum;
                var i = 0;

                var htmlResultFound = "<div class='row'><div class='col-md-12' style='margin-bottom:10px'><b>Results found: " + _allResultPages.length + "</b></div></div>";

                $("#box").append(htmlResultFound);
                while (currentResultList < _allResultPages.length && i < maxResultPerPage) {
                    var _appendString = $('<div>' +
                                            '<h4 style="font-weight:500;"><a class="margin-left-20" href="' + $(_allResultPages).eq(currentResultList)[0].ResultLink + '" target="_self">' +
                                            $(_allResultPages).eq(currentResultList)[0].Header + '</a ></h4> ' +
                                            '<p>' + $(_allResultPages).eq(currentResultList)[0].Description + '</p>' +
                                          '</div>');
                    $("#box").append(_appendString[0].innerHTML + "<br>").hide().fadeIn('slow');
                    i++;
                    currentResultList++;
                }
                pageNum++;
                if (currentResultList == _allResultPages.length) {
                    $("#next").prop("disabled", true);
                }
                 implementPaging(1);
            }
            function showPage(pageNumber) {
                if (pageNumber > 0) {
                    pageNumber = pageNumber - 1;
                } else {
                    pageNumber = 0;
                }
                $("#box").empty();
                var maxResultsPerPage = 3;
                var currentResultList = maxResultsPerPage * pageNumber;
                var i = 0;

                while (currentResultList < _allResultPages.length && i < maxResultsPerPage) {
                    var _appendString = $('<div>' +
                                            '<h4 style="font-weight:500;"><a class="margin-left-20" href="' + $(_allResultPages).eq(currentResultList)[0].ResultLink + '" target="_self">' +
                                                $(_allResultPages).eq(currentResultList)[0].Header + '</a ></h4> ' +
                                            '<p>' + $(_allResultPages).eq(currentResultList)[0].Description + '</p>' +
                                          '</div>');
                    $("#box").append(_appendString[0].innerHTML + "<br>").hide().fadeIn('slow');;
                    i++;
                    currentResultList++;
                }
                $("html, body").animate({ scrollTop: $(".myTabs").offset().top }, "slow");
                implementPaging(pageNumber+1);
            }
            function implementPaging(pageNumber) {
                var pages = Math.ceil($(_allResultPages).length/3);
                $("#pager").empty();

                if(pageNumber > 1)
                {
                     $('#pager').append(' <a class="pageClick" style="cursor:pointer" cpage="'+(pageNumber-1)+'">Previous</a>');
                }
                for (var i = 1; i < pages; i++) {
                    if (pageNumber > 1 && i < pageNumber && i > (pageNumber - 3) && i != pageNumber)
                    {
                        $('#pager').append('<a class="hidden-xs pageClick" style="cursor:pointer" cpage="'+ i +'">' + i + '</a> ');
                    }
                    if(i == pageNumber)
                    {
                        $('#pager').append('<a class="pager-selected"style="cursor:pointer" cpage="'+ i +'">' + i + '</a> ');
                    }
                    if (pageNumber < pages && i > pageNumber && i < (pageNumber + 3) && i != pageNumber)
                    {
                          $('#pager').append('<a class="hidden-xs pageClick" style="cursor:pointer" cpage="'+ i +'">' + i + '</a> ');
                    }

                }
                if(pageNumber != pages)
                {
                    $("#pager").append('<a  id="next" style="cursor:pointer" class="pageClick" cpage="'+(pageNumber+1)+'" >Next</a> ');
                }
                $('.pageClick').on('click', function (e) {
                    showPage($(this).attr("cpage"));
                });
            }

            function getResults() {
                var _advancedSearch = JSON.stringify('frmAdvancedSearchOptions');
                var _data = {
                    searchTerm: $("#searchstring").val(),
                    pagingGroupSize: 3,
                    pageSize: 20,
                    whichPlatforms: null
                }
                var _whichPlatforms = [];
                $('#frmAdvancedSearchOptions').find('input:checkbox:checked').each(function () {
                    _whichPlatforms.push($(this)[0].name);
                });
                _data.whichPlatforms = _whichPlatforms;

                $('#results-wait-loader').show();
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("SubmitSearchForm", "SearchSurface", new { searchTerm = Request["searchstring"],  pagingGroupSize = 3, pageSize = 20 })',
                    dataType: 'json',
                    contentType: 'application/json; charset=utf-8',
                    data: JSON.stringify(_data), // JSON.stringify({ form: $('form').serialize() }),
                }).done(function (data) {
                    $('#results-wait-loader').hide();

                    currentResultList = 0;
                    maxResultPerPage = 0;
                    pageNum = 0;

                    _allResultPages = data.results
                    if (data.results != null) {

                        if (data.results.length > 0) {
                            populateResults();
                            //implementPaging(1);
                            $('.pageClick').on('click', function (e) {
                                showPage($(this).attr('cpage'));
                            });
                        }
                        else {
                            clearValues();
                        }
                    } else {
                       clearValues()
                    }
                }).fail(function (e) {
                    $('#results-wait-loader').hide();
                    console.log(e.responseText);
                });
            }
            function clearValues() {
                $("#box").empty();
                $('#pager').empty();
                currentResultList = 0;
                $("#box").append("<p> No results to display </p>");
            }
            function debounce(func, wait, immediate) {
                var timeout;
                return function () {
                    var context = this, args = arguments;
                    var later = function () {
                        timeout = null;
                        if (!immediate) func.apply(context, args);
                    };
                    var callNow = immediate && !timeout;
                    clearTimeout(timeout);
                    timeout = setTimeout(later, wait);
                    if (callNow) func.apply(context, args);
                };
            }


            function beginPaging(args) {
                // Animate
                $('#box').fadeOut('normal');
            }
            function successPaging() {
                // Animate
                $('#box').fadeIn('normal');
                $('a').tooltip();
            }
            function failurePaging() {
                alert("Could not retrieve list.");
            }

        });
    </script>
}
# Base URL of the running Umbraco 16 site (AcfAfricanbank.Web), used to call
# its Content Delivery API.
#
# Leave blank in local dev - vite.config.ts already proxies /umbraco/* to
# https://localhost:44315, so a relative fetch reaches the backend through
# that proxy without hitting CORS or the backend's self-signed dev cert.
# Only set this to call a backend directly (e.g. a deployed environment
# with the Delivery API's CORS settings configured for this app's origin).
VITE_UMBRACO_API_BASE_URL=

# Mirrors the "online_upload" appsetting Navigation.cshtml reads via
# Configuration["online_upload"] for the fallback "Upload documents" link.
VITE_ONLINE_UPLOAD_URL=

# URL of the third-party "Karabo" chat widget SCRIPT (matches master.cshtml's
# own <script defer src="..."> - see src/components/KaraboChat/KaraboChat.tsx),
# not a page/iframe URL. That script injects its own floating chat button and
# chat window into the page. Leave blank to use the real production script
# URL (the component's own default) - only set this to point at a different
# environment's Karabo script.
VITE_KARABO_CHAT_URL=

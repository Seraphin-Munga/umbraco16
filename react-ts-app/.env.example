# Base URL of the running Umbraco 16 site (AcfAfricanbank.Web), used to call
# its Content Delivery API. Leave blank to call the API on the same origin
# this React app is served from (e.g. behind a dev proxy or reverse proxy).
VITE_UMBRACO_API_BASE_URL=https://localhost:44315/

# Mirrors the "online_upload" appsetting Navigation.cshtml reads via
# Configuration["online_upload"] for the fallback "Upload documents" link.
VITE_ONLINE_UPLOAD_URL=
